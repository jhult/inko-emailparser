amends "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.55.0/hk@1.55.0#/Builtins.pkl"

// Issue refs are synced explicitly (`grite sync`), not from a hook: doing it
// here made every commit pull and push over the network, and fail offline.
local linters = new Mapping<String, Step> {
    ["inko-fmt"] {
        glob = "*.inko"
        check = "inko fmt --check {{files}}"
        fix = "inko fmt {{files}}"
    }
    ["inko-test"] {
        // No glob: the tests cover the whole package, so anything that can
        // change behaviour (inko.pkg, fixtures, sources) must run them.
        check = "inko test --release"
    }
    ["license-eye"] {
        check = "license-eye header check {{files}}"
        fix = "license-eye header fix {{files}}"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
}
