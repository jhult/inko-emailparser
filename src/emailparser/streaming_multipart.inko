# Streaming Multipart Parser with State Machine
#
# Implements boundary-aware async multipart parsing that scans for boundaries
# incrementally without loading entire parts into memory. Uses a state machine
# to track parsing progress through multipart structure.

import emailparser.error (Error)
import emailparser.error (Severity)
import emailparser.header (
  eq_ignore_case, extract_filename_param, parse_headers_impl,
)
import emailparser.limits (MAX_HEADERS_SECTION_SIZE)
import emailparser.validation (is_valid_boundary)
import std.bytes (ByteArray)
import std.option (Option)
import std.result (Result)

# Parser states for multipart boundary scanning
type pub enum MultipartState {
  # Reading content before first boundary (usually empty)
  case Preamble

  # At a boundary marker, ready to read part headers
  case AtBoundary

  # Reading MIME headers for current part
  case ReadingHeaders

  # Reading body content for current part
  case ReadingBody

  # At the final boundary marker (--boundary--)
  case AtEndBoundary

  # Parsing complete
  case Done

  # Convert state to integer for comparison
  fn pub to_int -> Int {
    match self {
      case Preamble -> 0
      case AtBoundary -> 1
      case ReadingHeaders -> 2
      case ReadingBody -> 3
      case AtEndBoundary -> 4
      case Done -> 5
    }
  }
}

# Current part context for tracking active part metadata
type pub CurrentPartContext {
  let pub @index: Int
  let pub @headers: Array[(String, String)]
  let pub @content_type: String
  let pub @content_disposition: String
  let pub @content_transfer_encoding: String
  let pub @is_attachment: Bool
  let pub @filename: Option[String]
  let pub @content_id: Option[String]
  let pub @bytes_read: Int
}

# Context stack entry for nested multipart handling
type pub ContextStackEntry {
  let pub @boundary: String
  let pub @depth: Int
  let pub @parent_context: Option[CurrentPartContext]
}

# Handler trait for multipart streaming events
#
# Implement this trait to process multipart data incrementally.
trait pub MultipartStreamHandler {
  # Called when a new part begins (after headers are parsed)
  fn pub mut on_part_begin(
    headers: ref Array[(String, String)],
    content_type: String,
    is_attachment: Bool,
  ) -> Result[Int, Error]

  # Called when part body data is available
  fn pub mut on_part_data(
    data: ref ByteArray,
    content_transfer_encoding: String,
  ) -> Result[Int, Error]

  # Called when a part ends (before next boundary)
  fn pub mut on_part_end -> Result[Int, Error]
}

# Multipart streaming parser with state machine
#
# Processes multipart MIME content incrementally, emitting callbacks as
# parts are discovered. Supports nested multipart with configurable depth limits.
type pub MultipartStreamParser {
  let mut @state: MultipartState
  let @boundary: String
  let mut @buffer: ByteArray
  let @max_depth: Int
  let @strict_mode: Bool
  let @max_headers: Int
  let mut @current_context: Option[CurrentPartContext]
  let mut @context_stack: Array[ContextStackEntry]
  let mut @attachment_count: Int
  let mut @default_encoding: String
}

impl MultipartStreamParser {
  # Create a new multipart streaming parser
  #
  # Parameters:
  # - boundary: The boundary string (without leading --)
  # - max_depth: Maximum nesting depth (default 10)
  # - chunk_size: Chunk size for reading (default 65536)
  # - strict_mode: Enable strict MIME validation
  # - max_headers: Maximum number of headers per part
  # - max_attachment_size: Maximum attachment size in bytes
  fn pub static new(
    boundary: String,
    max_depth: Int,
    chunk_size: Int,
    strict_mode: Bool,
    max_headers: Int,
    max_attachment_size: Int,
  ) -> Result[MultipartStreamParser, Error] {
    if !is_valid_boundary(boundary.clone) {
      return Result.Error(
        Error.InvalidBoundary(
          Severity.Error,
          'exceeds 70 characters or contains invalid characters',
          Option.None,
          Option.None,
          Option.Some(boundary.clone),
        ),
      )
    }

    Result.Ok(
      MultipartStreamParser(
        state: MultipartState.Preamble,
        boundary: boundary,
        buffer: ByteArray.new,
        max_depth: max_depth,
        strict_mode: strict_mode,
        max_headers: max_headers,
        current_context: Option.None,
        context_stack: [],
        attachment_count: 0,
        default_encoding: '',
      ),
    )
  }

  # Get current nesting depth
  fn pub current_depth -> Int {
    @context_stack.size
  }

  # Feed data to the parser
  #
  # Processes incoming data and emits handler callbacks as parts are discovered.
  # Returns Ok(0) on success, Error on parse errors.
  fn pub mut feed[H: mut + MultipartStreamHandler](
    data: ref ByteArray,
    handler: mut H,
    default_encoding: String,
  ) -> Result[Int, Error] {
    # Append new data to buffer
    let mut i = 0

    while i < data.size {
      match data.get(i) {
        case Ok(byte) -> @buffer.push(byte)
        case Error(_) -> {}
      }

      i = i + 1
    }

    @default_encoding = default_encoding

    # Process buffer according to current state
    drain_buffer(self, handler, default_encoding, false)
  }

  # Finalize parsing
  #
  # Must be called after all data has been fed to ensure proper validation
  # and cleanup. Returns Ok(0) if parsing completed successfully.
  fn pub mut finish[H: mut + MultipartStreamHandler](
    handler: mut H,
  ) -> Result[Int, Error] {
    # Drain with EOF semantics: flush any retained body tail and process every
    # buffered part instead of stopping after a fixed number of iterations.
    match drain_buffer(self, handler, @default_encoding, true) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    # Ensure we're in a valid end state
    match @state {
      case AtEndBoundary -> Result.Ok(0)
      case Done -> Result.Ok(0)
      case Preamble -> {
        # No parts found - could be valid for empty multipart
        if @strict_mode {
          Result.Error(
            Error.MultipartWithoutParts(
              Severity.Error,
              Option.None,
              Option.None,
              Option.None,
            ),
          )
        } else {
          Result.Ok(0)
        }
      }
      case AtBoundary -> {
        # Parser stopped at boundary - still incomplete after processing
        Result.Error(
          Error.BoundaryNotFound(
            Severity.Error,
            Option.None,
            Option.None,
            Option.None,
          ),
        )
      }
      case ReadingHeaders -> {
        # Parser stopped while reading headers
        # This is OK if we're not in the middle of processing a part
        # (e.g., after processing the last boundary)
        match @current_context {
          case None -> Result.Ok(0)
          case Some(_) -> {
            Result.Error(
              Error.MalformedHeader(
                Severity.Error,
                'incomplete multipart message: stopped while reading headers',
                Option.None,
                Option.None,
                Option.None,
              ),
            )
          }
        }
      }
      case ReadingBody -> {
        # Emit the retained tail and accept a delimiter truncated by EOF
        match process_reading_body(self, handler, '', true) {
          case Ok(_) -> {}
          case Error(e) -> return Result.Error(e)
        }

        # If the part is still open the closing delimiter is missing: treat
        # EOF as the end of the part instead of dropping its body.
        match @current_context {
          case Some(_) -> {
            match handler.on_part_end {
              case Ok(_) -> {}
              case Error(e) -> return Result.Error(e)
            }

            @current_context = Option.None
            Result.Ok(0)
          }
          case None -> Result.Ok(0)
        }
      }
    }
  }
}

# Drain the parser buffer until no more progress can be made
#
# Progress means the state advanced or the buffer shrank. The iteration cap is
# a safety net only: every productive iteration consumes at least one byte, so
# a buffer of N bytes cannot require more than N + 32 iterations. This avoids
# the old fixed 1000-iteration budget, which silently truncated messages with
# roughly 333 parts.
fn drain_buffer[H: mut + MultipartStreamHandler](
  parser: mut MultipartStreamParser,
  handler: mut H,
  default_encoding: String,
  at_eof: Bool,
) -> Result[Int, Error] {
  let max_iterations = parser.buffer.size + 32
  let mut iterations = 0

  while iterations < max_iterations {
    let old_state = parser.state.to_int
    let old_buffer_size = parser.buffer.size

    match parser.state {
      case Preamble -> {
        match process_preamble(parser, handler) {
          case Ok(_) -> {}
          case Error(e) -> return Result.Error(e)
        }
      }
      case AtBoundary -> {
        match process_at_boundary(parser, handler) {
          case Ok(_) -> {}
          case Error(e) -> return Result.Error(e)
        }
      }
      case ReadingHeaders -> {
        match process_reading_headers(parser, handler, default_encoding) {
          case Ok(_) -> {}
          case Error(e) -> return Result.Error(e)
        }
      }
      case ReadingBody -> {
        match process_reading_body(parser, handler, default_encoding, at_eof) {
          case Ok(_) -> {}
          case Error(e) -> return Result.Error(e)
        }
      }
      case AtEndBoundary -> return Result.Ok(0)
      case Done -> return Result.Ok(0)
    }

    iterations = iterations + 1

    if
      parser.state.to_int == old_state and parser.buffer.size == old_buffer_size
    {
      break
    }
  }

  Result.Ok(0)
}

# Process Preamble state
#
# Scans buffer for first boundary marker. Preamble content is typically
# discarded as it's not part of any MIME part.
fn process_preamble[H: mut + MultipartStreamHandler](
  parser: mut MultipartStreamParser,
  handler: mut H,
) -> Result[Int, Error] {
  let boundary_marker = '--' + parser.boundary
  let boundary_bytes = boundary_marker.to_byte_array

  # Scan for first boundary
  match find_boundary_in_buffer(ref parser.buffer, ref boundary_bytes, false) {
    case Some(pos) -> {
      # Found boundary - advance to AtBoundary state
      # Remove everything up to and including the boundary
      let new_buffer = ByteArray.new
      let skip_to = pos + boundary_bytes.size

      # Skip past boundary (but keep all newlines - they are part of headers)
      let mut i = skip_to

      # Copy remaining data to new buffer
      while i < parser.buffer.size {
        match parser.buffer.get(i) {
          case Ok(byte) -> new_buffer.push(byte)
          case Error(_) -> {}
        }

        i = i + 1
      }

      parser.buffer = new_buffer
      parser.state = MultipartState.AtBoundary
      Result.Ok(0)
    }
    case None -> {
      # Boundary not found yet - keep buffering
      # Trim buffer if it grows too large (keep last boundary_marker.size * 2)
      let max_preamble = boundary_marker.size * 2

      if parser.buffer.size > max_preamble {
        let keep_size = boundary_marker.size
        let skip_size = parser.buffer.size - keep_size
        let new_buffer = ByteArray.new

        let mut i = skip_size

        while i < parser.buffer.size {
          match parser.buffer.get(i) {
            case Ok(byte) -> new_buffer.push(byte)
            case Error(_) -> {}
          }

          i = i + 1
        }

        parser.buffer = new_buffer
      }

      Result.Ok(0)
    }
  }
}

# Process AtBoundary state
#
# At this point we're positioned right after a boundary marker.
# Transition to reading headers for the next part.
fn process_at_boundary[H: mut + MultipartStreamHandler](
  parser: mut MultipartStreamParser,
  handler: mut H,
) -> Result[Int, Error] {
  # Check if this is end boundary (--boundary--)
  if parser.buffer.size >= 2 {
    match parser.buffer.get(0) {
      case Ok(b1) -> {
        match parser.buffer.get(1) {
          case Ok(b2) -> {
            if b1 == 45 and b2 == 45 {
              # This is the end boundary
              parser.state = MultipartState.AtEndBoundary
              return Result.Ok(0)
            }
          }
          case Error(_) -> {}
        }
      }
      case Error(_) -> {}
    }

    # Not an end boundary - start reading headers
    parser.state = MultipartState.ReadingHeaders
  } else {
    # Buffer too small, need more data to determine
    # Stay in AtBoundary state
  }

  Result.Ok(0)
}

# Process ReadingHeaders state
#
# Reads MIME headers for current part. Headers end with double CRLF.
fn process_reading_headers[H: mut + MultipartStreamHandler](
  parser: mut MultipartStreamParser,
  handler: mut H,
  default_encoding: String,
) -> Result[Int, Error] {
  # Look for double newline indicating end of headers
  let header_end = find_double_newline(ref parser.buffer)

  match header_end {
    case Some(end_pos) -> {
      # Extract header bytes
      # The buffer may start with the CRLF/LF that terminated the boundary.
      # Skip the full line break (2 bytes for CRLF, 1 for LF); skipping only
      # one CRLF byte leaves a leading LF and makes the first header look like
      # an empty line, which drops every header.
      let header_start = leading_line_break_size(ref parser.buffer)

      let mut header_bytes = ByteArray.new
      let mut i = header_start

      while i < end_pos {
        match parser.buffer.get(i) {
          case Ok(byte) -> header_bytes.push(byte)
          case Error(_) -> {}
        }

        i = i + 1
      }

      # Parse headers
      let headers_string = header_bytes.into_string
      let headers = match
        parse_part_headers(
          headers_string,
          parser.max_headers,
          parser.strict_mode,
        )
      {
        case Ok(h) -> h
        case Error(e) -> return Result.Error(e)
      }

      # Extract key header values
      # RFC 2045 section 5.2: a part without Content-Type defaults to
      # text/plain.
      let content_type = get_header_value(ref headers, 'Content-Type').or(
        'text/plain',
      )
      let content_disposition = get_header_value(
        ref headers,
        'Content-Disposition',
      )
        .or('')
      let content_transfer_encoding = get_header_value(
        ref headers,
        'Content-Transfer-Encoding',
      )
        .or(default_encoding)
      let content_id = get_header_value(ref headers, 'Content-ID')

      # Determine if attachment (RFC 2183 values are case-insensitive)
      #
      # Classification mirrors the regular parser: explicit attachment
      # dispositions, inline parts with a filename or image type, and any
      # non-text/non-multipart part (which has no text body to live in).
      let disp_lower = content_disposition.to_lower
      let ct_lower = content_type.to_lower
      let is_text_part = ct_lower.starts_with?('text/plain')
        or ct_lower.starts_with?('text/html')
      let is_multipart_part = ct_lower.starts_with?('multipart/')
      let is_attachment = disp_lower.starts_with?('attachment')
        or disp_lower.starts_with?('file')
        or (
          disp_lower.starts_with?('inline')
            and disp_lower.contains?('filename=')
        )
        or (
          disp_lower.starts_with?('inline') and ct_lower.starts_with?('image/')
        )
        or (!is_text_part and !is_multipart_part)

      # Extract filename if present
      let filename = if is_attachment {
        extract_filename_from_disposition(content_disposition)
      } else {
        Option.None
      }

      # Get attachment index for this part
      let att_index = if is_attachment { parser.attachment_count } else { -1 }

      # Increment attachment counter if this is an attachment
      if is_attachment { parser.attachment_count = parser.attachment_count + 1 }

      # Notify handler before creating context (to avoid moving headers)
      match
        handler.on_part_begin(ref headers, content_type.clone, is_attachment)
      {
        case Ok(_) -> {}
        case Error(e) -> return Result.Error(e)
      }

      # Create part context
      let context = CurrentPartContext(
        index: att_index,
        headers: headers,
        content_type: content_type,
        content_disposition: content_disposition,
        content_transfer_encoding: content_transfer_encoding,
        is_attachment: is_attachment,
        filename: filename,
        content_id: content_id,
        bytes_read: 0,
      )

      parser.current_context = Option.Some(context)

      # Remove headers from buffer (including leading newline and double newline)
      # Determine skip length based on what we found (\n\n or \r\n\r\n)
      let mut skip_len = 2

      if parser.buffer.size >= (end_pos + 4) {
        match parser.buffer.get(end_pos) {
          case Ok(b1) -> {
            match parser.buffer.get(end_pos + 1) {
              case Ok(b2) -> {
                match parser.buffer.get(end_pos + 2) {
                  case Ok(b3) -> {
                    match parser.buffer.get(end_pos + 3) {
                      case Ok(b4) -> {
                        if b1 == 13 and b2 == 10 and b3 == 13 and b4 == 10 {
                          skip_len = 4
                        }
                      }
                      case Error(_) -> {}
                    }
                  }
                  case Error(_) -> {}
                }
              }
              case Error(_) -> {}
            }
          }
          case Error(_) -> {}
        }
      }

      let new_buffer = ByteArray.new
      let skip_to = end_pos + skip_len

      let mut j = skip_to

      while j < parser.buffer.size {
        match parser.buffer.get(j) {
          case Ok(byte) -> new_buffer.push(byte)
          case Error(_) -> {}
        }

        j = j + 1
      }

      parser.buffer = new_buffer
      parser.state = MultipartState.ReadingBody
      Result.Ok(0)
    }
    case None -> {
      # Headers not complete yet - keep buffering
      # Check buffer size to prevent excessive memory use
      if parser.buffer.size > MAX_HEADERS_SECTION_SIZE {
        return Result.Error(
          Error.HeaderValueTooLarge(
            Severity.Error,
            parser.buffer.size,
            MAX_HEADERS_SECTION_SIZE,
            Option.None,
            Option.None,
            Option.None,
          ),
        )
      }

      Result.Ok(0)
    }
  }
}

# Process ReadingBody state
#
# Reads body content until next boundary is found.
fn process_reading_body[H: mut + MultipartStreamHandler](
  parser: mut MultipartStreamParser,
  handler: mut H,
  default_encoding: String,
  at_eof: Bool,
) -> Result[Int, Error] {
  let boundary_marker = '--' + parser.boundary
  let boundary_bytes = boundary_marker.to_byte_array

  # Scan for next boundary
  match find_boundary_in_buffer(ref parser.buffer, ref boundary_bytes, at_eof) {
    case Some(pos) -> {
      # Found boundary - emit body data before it
      let mut body_data = ByteArray.new
      let mut i = 0

      # Copy body data up to boundary.
      # Per RFC 2046 the CRLF before the boundary belongs to the delimiter.
      # A bare LF is only treated as delimiter padding at EOF, matching the
      # existing behaviour for well-formed LF-only messages.
      let body_end = if pos >= 2 {
        match parser.buffer.get(pos - 1) {
          case Ok(b1) -> {
            match parser.buffer.get(pos - 2) {
              case Ok(b2) -> {
                if b1 == 10 and b2 == 13 {
                  pos - 2
                } else if at_eof and b1 == 10 {
                  pos - 1
                } else {
                  pos
                }
              }
              case Error(_) -> pos
            }
          }
          case Error(_) -> pos
        }
      } else if pos >= 1 {
        match parser.buffer.get(pos - 1) {
          case Ok(b1) -> if at_eof and b1 == 10 { pos - 1 } else { pos }
          case Error(_) -> pos
        }
      } else {
        pos
      }

      while i < body_end {
        match parser.buffer.get(i) {
          case Ok(byte) -> body_data.push(byte)
          case Error(_) -> {}
        }

        i = i + 1
      }

      # Emit body data
      if body_data.size > 0 {
        match parser.current_context {
          case Some(ctx) -> {
            match
              handler.on_part_data(ref body_data, ctx.content_transfer_encoding)
            {
              case Ok(_) -> {}
              case Error(e) -> return Result.Error(e)
            }
          }
          case None -> {}
        }
      }

      # Notify end of part
      match handler.on_part_end {
        case Ok(_) -> {}
        case Error(e) -> return Result.Error(e)
      }

      # Remove body and boundary from buffer
      let new_buffer = ByteArray.new
      let skip_to = pos + boundary_bytes.size

      # Skip past boundary and trailing CRLF
      let mut j = skip_to

      while j < parser.buffer.size {
        match parser.buffer.get(j) {
          case Ok(byte) -> {
            if byte == 13 or byte == 10 { j = j + 1 } else { break }
          }
          case Error(_) -> break
        }
      }

      while j < parser.buffer.size {
        match parser.buffer.get(j) {
          case Ok(byte) -> new_buffer.push(byte)
          case Error(_) -> {}
        }

        j = j + 1
      }

      parser.buffer = new_buffer
      parser.current_context = Option.None
      parser.state = MultipartState.AtBoundary
      Result.Ok(0)
    }
    case None -> {
      # Boundary not found - emit available data except for safety buffer.
      # At EOF there is nothing left to arrive, so emit everything.
      let boundary_size = boundary_bytes.size
      let safety_buffer = if at_eof { 0 } else { boundary_size + 10 }

      if parser.buffer.size > safety_buffer {
        let emit_size = parser.buffer.size - safety_buffer
        let mut body_data = ByteArray.new

        let mut i = 0

        while i < emit_size {
          match parser.buffer.get(i) {
            case Ok(byte) -> body_data.push(byte)
            case Error(_) -> {}
          }

          i = i + 1
        }

        # Emit body data
        match parser.current_context {
          case Some(ctx) -> {
            match
              handler.on_part_data(ref body_data, ctx.content_transfer_encoding)
            {
              case Ok(_) -> {}
              case Error(e) -> return Result.Error(e)
            }
          }
          case None -> {}
        }

        # Remove emitted data from buffer
        let new_buffer = ByteArray.new
        let mut j = emit_size

        while j < parser.buffer.size {
          match parser.buffer.get(j) {
            case Ok(byte) -> new_buffer.push(byte)
            case Error(_) -> {}
          }

          j = j + 1
        }

        parser.buffer = new_buffer
      }

      Result.Ok(0)
    }
  }
}

# Find boundary marker in buffer
#
# Returns the position where boundary starts, or None if not found.
fn find_boundary_in_buffer(
  buffer: ref ByteArray,
  boundary: ref ByteArray,
  at_eof: Bool,
) -> Option[Int] {
  if buffer.size < boundary.size { return Option.None }

  let mut i = 0
  let max_i = buffer.size - boundary.size

  while i <= max_i {
    # RFC 2046: the delimiter must start a line, i.e. be at the start of the
    # buffer or immediately follow an LF (the CR of a CRLF is optional).
    if
      is_line_start(ref buffer, i)
        and bytes_match_at(ref buffer, ref boundary, i)
        and is_valid_boundary_tail(ref buffer, i + boundary.size, at_eof)
    {
      return Option.Some(i)
    }

    i = i + 1
  }

  Option.None
}

# Whether position `pos` starts a line in `buffer`
fn is_line_start(buffer: ref ByteArray, pos: Int) -> Bool {
  if pos == 0 { return true }

  match buffer.get(pos - 1) {
    case Ok(b) -> b == 10
    case Error(_) -> false
  }
}

# Whether `needle` occurs in `buffer` starting at `pos`
fn bytes_match_at(
  buffer: ref ByteArray,
  needle: ref ByteArray,
  pos: Int,
) -> Bool {
  let mut j = 0

  while j < needle.size {
    match buffer.get(pos + j) {
      case Ok(buf_byte) -> {
        match needle.get(j) {
          case Ok(needle_byte) -> if buf_byte != needle_byte { return false }
          case Error(_) -> return false
        }
      }
      case Error(_) -> return false
    }

    j = j + 1
  }

  true
}

# Whether the bytes after a boundary marker form a valid delimiter tail
#
# RFC 2046 allows transport padding (spaces/tabs) followed by CRLF, a bare LF,
# or a second "--" for the close delimiter. An incomplete tail (end of buffer)
# is rejected while streaming so a partial delimiter is not mistaken for a
# boundary. At EOF (`at_eof`) an incomplete tail is accepted: the message was
# simply truncated rather than split across reads.
fn is_valid_boundary_tail(buffer: ref ByteArray, pos: Int, at_eof: Bool) -> Bool
{
  if pos >= buffer.size { return at_eof }

  match buffer.get(pos) {
    case Ok(b) -> {
      if b == 13 {
        if pos + 1 >= buffer.size { return at_eof }

        match buffer.get(pos + 1) {
          case Ok(b2) -> b2 == 10
          case Error(_) -> false
        }
      } else if b == 10 {
        true
      } else if b == 45 {
        # Close delimiter is exactly "--"
        if pos + 1 >= buffer.size { return at_eof }

        match buffer.get(pos + 1) {
          case Ok(b2) -> b2 == 45
          case Error(_) -> false
        }
      } else if b == 32 or b == 9 {
        valid_transport_padding(ref buffer, pos, at_eof)
      } else {
        false
      }
    }
    case Error(_) -> false
  }
}

# Whether `pos` begins transport padding terminated by CRLF/LF
fn valid_transport_padding(
  buffer: ref ByteArray,
  pos: Int,
  at_eof: Bool,
) -> Bool {
  let mut i = pos

  loop {
    if i >= buffer.size { return at_eof }

    match buffer.get(i) {
      case Ok(b) -> {
        if b == 32 or b == 9 {
          i = i + 1
        } else if b == 13 {
          if i + 1 >= buffer.size { return at_eof }

          match buffer.get(i + 1) {
            case Ok(b2) -> return b2 == 10
            case Error(_) -> return false
          }
        } else if b == 10 {
          return true
        } else {
          return false
        }
      }
      case Error(_) -> return false
    }
  }
}

# Number of bytes taken up by a line break at the start of the buffer
#
# Returns 2 for CRLF, 1 for a lone CR or LF, and 0 otherwise.
fn leading_line_break_size(buffer: ref ByteArray) -> Int {
  if buffer.size == 0 { return 0 }

  let mut size = 1

  match buffer.get(0) {
    case Ok(b) -> {
      if b == 13 {
        if buffer.size >= 2 {
          match buffer.get(1) {
            case Ok(b2) -> if b2 == 10 { size = 2 }
            case Error(_) -> {}
          }
        }
      } else if b != 10 {
        size = 0
      }
    }
    case Error(_) -> size = 0
  }

  size
}

# Find double newline in buffer (header/body separator)
# Handles both \n\n and \r\n\r\n line endings
fn find_double_newline(buffer: ref ByteArray) -> Option[Int] {
  if buffer.size < 2 { return Option.None }

  let mut i = 0
  let max_i = buffer.size - 1

  while i < max_i {
    match buffer.get(i) {
      case Ok(b1) -> {
        match buffer.get(i + 1) {
          case Ok(b2) -> {
            # Look for \n\n
            if b1 == 10 and b2 == 10 { return Option.Some(i) }

            # Look for \r\n\r\n - need at least 4 bytes
            if buffer.size >= (i + 4) {
              match buffer.get(i + 2) {
                case Ok(b3) -> {
                  match buffer.get(i + 3) {
                    case Ok(b4) -> {
                      if b1 == 13 and b2 == 10 and b3 == 13 and b4 == 10 {
                        return Option.Some(i)
                      }
                    }
                    case Error(_) -> {}
                  }
                }
                case Error(_) -> {}
              }
            }
          }
          case Error(_) -> {}
        }
      }
      case Error(_) -> {}
    }

    i = i + 1
  }

  Option.None
}

# Parse part headers
fn parse_part_headers(
  headers_raw: String,
  max_headers: Int,
  strict_mode: Bool,
) -> Result[Array[(String, String)], Error] {
  match
    parse_headers_impl(
      headers_raw,
      strict_mode,
      MAX_HEADERS_SECTION_SIZE,
      max_headers,
    )
  {
    case Ok(headers) -> Result.Ok(headers)
    case Error(e) -> Result.Error(e)
  }
}

# Get header value by name (case-insensitive)
fn get_header_value(
  headers: ref Array[(String, String)],
  name: String,
) -> Option[String] {
  for (key, value) in headers.iter {
    if eq_ignore_case(key.clone, name) { return Option.Some(value.clone) }
  }

  Option.None
}

# Extract and sanitize the filename from a Content-Disposition header
fn extract_filename_from_disposition(disposition: String) -> Option[String] {
  extract_filename_param(disposition)
}
