# Streaming Multipart Parser with State Machine
#
# Implements boundary-aware async multipart parsing that scans for boundaries
# incrementally without loading entire parts into memory. Uses a state machine
# to track parsing progress through multipart structure.

import emailparser.boundary (find_boundary, is_line_start)
import emailparser.error (Error, Severity)
import emailparser.header (
  extract_filename_param, find_header_separator_bytes, get_header_value_impl,
  parse_headers_impl,
)
import emailparser.limits (MAX_HEADERS_SECTION_SIZE)
import emailparser.mime (classify_part)
import emailparser.validation (is_valid_boundary)
import std.bytes (ByteArray)
import std.option (Option)
import std.result (Result)

# Parser states for multipart boundary scanning
type pub enum MultipartState {
  # Reading content before first boundary (usually empty)
  case Preamble

  # At a boundary marker, ready to read part headers
  case AtBoundary

  # Reading MIME headers for current part
  case ReadingHeaders

  # Reading body content for current part
  case ReadingBody

  # At the final boundary marker (--boundary--)
  case AtEndBoundary

  # Convert state to integer for comparison
  fn pub to_int -> Int {
    match self {
      case Preamble -> 0
      case AtBoundary -> 1
      case ReadingHeaders -> 2
      case ReadingBody -> 3
      case AtEndBoundary -> 4
    }
  }
}

# Metadata for the part currently being read
#
# Only the transfer encoding survives here: it is needed to label subsequent
# `on_part_data` calls, while the remaining part metadata is emitted once
# through `on_part_begin`.
type pub CurrentPartContext {
  let pub @content_transfer_encoding: String
}

# Handler trait for multipart streaming events
#
# Implement this trait to process multipart data incrementally.
trait pub MultipartStreamHandler {
  # Called when a new part begins (after headers are parsed)
  fn pub mut on_part_begin(
    headers: ref Array[(String, String)],
    content_type: String,
    is_attachment: Bool,
  ) -> Result[Int, Error]

  # Called when part body data is available
  fn pub mut on_part_data(
    data: ref ByteArray,
    content_transfer_encoding: String,
  ) -> Result[Int, Error]

  # Called when a part ends (before next boundary)
  fn pub mut on_part_end -> Result[Int, Error]
}

# Multipart streaming parser with state machine
#
# Processes multipart MIME content incrementally, emitting callbacks as
# parts are discovered. Supports nested multipart with configurable depth limits.
type pub MultipartStreamParser {
  let mut @state: MultipartState
  let @boundary: String
  let mut @buffer: ByteArray
  let @strict_mode: Bool
  let @max_headers: Int
  let mut @current_context: Option[CurrentPartContext]

  # Whether the first buffered byte is known to follow a line break. Buffer
  # trimming drops bytes from the front, so position 0 is not automatically a
  # line start for a streaming parser.
  let mut @head_line_start: Bool
}

impl MultipartStreamParser {
  # Create a new multipart streaming parser
  #
  # Parameters:
  # - boundary: The boundary string (without leading --)
  # - strict_mode: Enable strict MIME validation
  # - max_headers: Maximum number of headers per part
  #
  # Depth and attachment-size limits are enforced by the caller
  # (`StreamingParser`), which owns the nesting and size accounting.
  fn pub static new(
    boundary: String,
    strict_mode: Bool,
    max_headers: Int,
  ) -> Result[MultipartStreamParser, Error] {
    if !is_valid_boundary(boundary.clone) {
      return Result.Error(
        Error.InvalidBoundary(
          Severity.Error,
          'exceeds 70 characters or contains invalid characters',
          Option.None,
          Option.None,
          Option.Some(boundary.clone),
        ),
      )
    }

    Result.Ok(
      MultipartStreamParser(
        state: MultipartState.Preamble,
        boundary: boundary,
        buffer: ByteArray.new,
        strict_mode: strict_mode,
        max_headers: max_headers,
        current_context: Option.None,
        head_line_start: true,
      ),
    )
  }

  # Feed data to the parser
  #
  # Processes incoming data and emits handler callbacks as parts are discovered.
  # Returns Ok(0) on success, Error on parse errors.
  fn pub mut feed[H: mut + MultipartStreamHandler](
    data: ref ByteArray,
    handler: mut H,
  ) -> Result[Int, Error] {
    # Once the closing boundary has been seen, the epilogue is not part of the
    # message. Drop it instead of accumulating it in the buffer.
    match @state {
      case AtEndBoundary -> return Result.Ok(0)
      case _ -> {}
    }

    # Append new data to buffer. `append` copies the whole chunk at once; a
    # per-byte get/push loop is much slower on the hot path.
    @buffer.append(data)

    # Process buffer according to current state
    drain_buffer(self, handler, false)
  }

  # Finalize parsing
  #
  # Must be called after all data has been fed to ensure proper validation
  # and cleanup. Returns Ok(0) if parsing completed successfully.
  fn pub mut finish[H: mut + MultipartStreamHandler](
    handler: mut H,
  ) -> Result[Int, Error] {
    # Drain with EOF semantics: flush any retained body tail and process every
    # buffered part instead of stopping after a fixed number of iterations.
    match drain_buffer(self, handler, true) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    # Ensure we're in a valid end state
    match @state {
      case AtEndBoundary -> Result.Ok(0)
      case Preamble -> {
        # No parts found - could be valid for empty multipart
        if @strict_mode {
          Result.Error(
            Error.MultipartWithoutParts(
              Severity.Error,
              Option.None,
              Option.None,
              Option.None,
            ),
          )
        } else {
          Result.Ok(0)
        }
      }
      case AtBoundary -> {
        # Parser stopped at boundary - still incomplete after processing
        Result.Error(
          Error.BoundaryNotFound(
            Severity.Error,
            Option.None,
            Option.None,
            Option.None,
          ),
        )
      }
      case ReadingHeaders -> {
        # Parser stopped while reading headers
        # This is OK if we're not in the middle of processing a part
        # (e.g., after processing the last boundary)
        match @current_context {
          case None -> Result.Ok(0)
          case Some(_) -> {
            Result.Error(
              Error.MalformedHeader(
                Severity.Error,
                'incomplete multipart message: stopped while reading headers',
                Option.None,
                Option.None,
                Option.None,
              ),
            )
          }
        }
      }
      case ReadingBody -> {
        # Emit the retained tail and accept a delimiter truncated by EOF
        match process_reading_body(self, handler, true) {
          case Ok(_) -> {}
          case Error(e) -> return Result.Error(e)
        }

        # If the part is still open the closing delimiter is missing: treat
        # EOF as the end of the part instead of dropping its body.
        match @current_context {
          case Some(_) -> {
            match handler.on_part_end {
              case Ok(_) -> {}
              case Error(e) -> return Result.Error(e)
            }

            @current_context = Option.None
            Result.Ok(0)
          }
          case None -> Result.Ok(0)
        }
      }
    }
  }
}

# Drain the parser buffer until no more progress can be made
#
# Progress means the state advanced or the buffer shrank. The iteration cap is
# a safety net only: every productive iteration consumes at least one byte, so
# a buffer of N bytes cannot require more than N + 32 iterations. This avoids
# the old fixed 1000-iteration budget, which silently truncated messages with
# roughly 333 parts.
fn drain_buffer[H: mut + MultipartStreamHandler](
  parser: mut MultipartStreamParser,
  handler: mut H,
  at_eof: Bool,
) -> Result[Int, Error] {
  let max_iterations = parser.buffer.size + 32
  let mut iterations = 0

  while iterations < max_iterations {
    let old_state = parser.state.to_int
    let old_buffer_size = parser.buffer.size

    match parser.state {
      case Preamble -> {
        match process_preamble(parser, handler, at_eof) {
          case Ok(_) -> {}
          case Error(e) -> return Result.Error(e)
        }
      }
      case AtBoundary -> {
        match process_at_boundary(parser, handler) {
          case Ok(_) -> {}
          case Error(e) -> return Result.Error(e)
        }
      }
      case ReadingHeaders -> {
        match process_reading_headers(parser, handler) {
          case Ok(_) -> {}
          case Error(e) -> return Result.Error(e)
        }
      }
      case ReadingBody -> {
        match process_reading_body(parser, handler, at_eof) {
          case Ok(_) -> {}
          case Error(e) -> return Result.Error(e)
        }
      }
      case AtEndBoundary -> return Result.Ok(0)
    }

    iterations = iterations + 1

    if
      parser.state.to_int == old_state and parser.buffer.size == old_buffer_size
    {
      break
    }
  }

  Result.Ok(0)
}

# Process Preamble state
#
# Scans buffer for first boundary marker. Preamble content is typically
# discarded as it's not part of any MIME part.
fn process_preamble[H: mut + MultipartStreamHandler](
  parser: mut MultipartStreamParser,
  handler: mut H,
  at_eof: Bool,
) -> Result[Int, Error] {
  let boundary_marker = '--' + parser.boundary
  let boundary_bytes = boundary_marker.to_byte_array

  # Scan for first boundary
  match
    find_boundary(
      ref parser.buffer,
      ref boundary_bytes,
      at_eof,
      parser.head_line_start,
    )
  {
    case Some(pos) -> {
      # Found boundary - advance to AtBoundary state
      # Remove everything up to and including the boundary
      let skip_to = pos + boundary_bytes.size

      parser.head_line_start = is_line_start(ref parser.buffer, skip_to)

      let next_buffer = parser
        .buffer
        .slice(skip_to, parser.buffer.size)
        .to_byte_array

      parser.buffer = next_buffer
      parser.state = MultipartState.AtBoundary
      Result.Ok(0)
    }
    case None -> {
      # Boundary not found yet - keep buffering
      # Trim buffer if it grows too large (keep last boundary_marker.size * 2)
      let max_preamble = boundary_marker.size * 2

      if parser.buffer.size > max_preamble {
        # Keep the marker plus the line break that precedes it. The marker
        # itself can arrive split across reads, so retaining exactly its size
        # would drop the leading '-' of a straddling delimiter and make it
        # unmatchable once the rest arrives.
        let keep_size = boundary_marker.size + 2
        let skip_size = parser.buffer.size - keep_size

        parser.head_line_start = is_line_start(ref parser.buffer, skip_size)

        let next_buffer = parser
          .buffer
          .slice(skip_size, parser.buffer.size)
          .to_byte_array

        parser.buffer = next_buffer
      }

      Result.Ok(0)
    }
  }
}

# Process AtBoundary state
#
# At this point we're positioned right after a boundary marker.
# Transition to reading headers for the next part.
fn process_at_boundary[H: mut + MultipartStreamHandler](
  parser: mut MultipartStreamParser,
  handler: mut H,
) -> Result[Int, Error] {
  # Check if this is end boundary (--boundary--)
  if parser.buffer.size >= 2 {
    match parser.buffer.get(0) {
      case Ok(b1) -> {
        match parser.buffer.get(1) {
          case Ok(b2) -> {
            if b1 == 45 and b2 == 45 {
              # This is the end boundary
              parser.state = MultipartState.AtEndBoundary
              return Result.Ok(0)
            }
          }
          case Error(_) -> {}
        }
      }
      case Error(_) -> {}
    }

    # Not an end boundary - start reading headers
    parser.state = MultipartState.ReadingHeaders
  } else {
    # Buffer too small, need more data to determine
    # Stay in AtBoundary state
  }

  Result.Ok(0)
}

# Process ReadingHeaders state
#
# Reads MIME headers for current part. Headers end with double CRLF.
fn process_reading_headers[H: mut + MultipartStreamHandler](
  parser: mut MultipartStreamParser,
  handler: mut H,
) -> Result[Int, Error] {
  # Look for the header/body separator (LF LF or CR LF CR LF)
  let separator = find_header_separator_bytes(ref parser.buffer, 0)

  match separator {
    case Some((end_pos, separator_size)) -> {
      # Extract header bytes
      # The buffer may start with the CRLF/LF that terminated the boundary.
      # Skip the full line break (2 bytes for CRLF, 1 for LF); skipping only
      # one CRLF byte leaves a leading LF and makes the first header look like
      # an empty line, which drops every header.
      let header_start = leading_line_break_size(ref parser.buffer)

      # Parse headers
      let headers_string = if end_pos > header_start {
        parser.buffer.slice(header_start, end_pos).to_string
      } else {
        ''
      }
      let headers = match
        parse_part_headers(
          headers_string,
          parser.max_headers,
          parser.strict_mode,
        )
      {
        case Ok(h) -> h
        case Error(e) -> return Result.Error(e)
      }

      # Extract key header values
      # RFC 2045 section 5.2: a part without Content-Type defaults to
      # text/plain.
      let content_type = get_header_value_impl(ref headers, 'Content-Type').or(
        'text/plain',
      )
      let content_disposition = get_header_value_impl(
        ref headers,
        'Content-Disposition',
      )
        .or('')
      # RFC 2045 section 6: a part without Content-Transfer-Encoding is 7bit.
      # The message-level encoding applies to the message body only, so parts
      # never inherit it.
      let content_transfer_encoding = get_header_value_impl(
        ref headers,
        'Content-Transfer-Encoding',
      )
        .or('7bit')
      # Determine if attachment (RFC 2183 values are case-insensitive)
      #
      # Use the shared classifier so the streaming and buffered parsers agree
      # on what is a body and what is an attachment (including "file"
      # dispositions and RFC 2231 filename parameters).
      let mut filename = extract_filename_param(content_disposition.clone)
      let is_attachment = match
        classify_part(
          content_type.clone,
          content_disposition.clone,
          ref filename,
        )
      {
        case Attachment -> true
        case _ -> false
      }

      if !is_attachment { filename = Option.None }

      # Notify handler before creating context (to avoid moving headers)
      match
        handler.on_part_begin(ref headers, content_type.clone, is_attachment)
      {
        case Ok(_) -> {}
        case Error(e) -> return Result.Error(e)
      }

      # Create part context
      let context = CurrentPartContext(
        content_transfer_encoding: content_transfer_encoding,
      )

      parser.current_context = Option.Some(context)

      # Remove headers from buffer (including leading newline and separator)
      let skip_to = end_pos + separator_size

      parser.head_line_start = is_line_start(ref parser.buffer, skip_to)

      let next_buffer = parser
        .buffer
        .slice(skip_to, parser.buffer.size)
        .to_byte_array

      parser.buffer = next_buffer
      parser.state = MultipartState.ReadingBody
      Result.Ok(0)
    }
    case None -> {
      # Headers not complete yet - keep buffering
      # Check buffer size to prevent excessive memory use
      if parser.buffer.size > MAX_HEADERS_SECTION_SIZE {
        return Result.Error(
          Error.HeaderValueTooLarge(
            Severity.Error,
            parser.buffer.size,
            MAX_HEADERS_SECTION_SIZE,
            Option.None,
            Option.None,
            Option.None,
          ),
        )
      }

      Result.Ok(0)
    }
  }
}

# Process ReadingBody state
#
# Reads body content until next boundary is found.
fn process_reading_body[H: mut + MultipartStreamHandler](
  parser: mut MultipartStreamParser,
  handler: mut H,
  at_eof: Bool,
) -> Result[Int, Error] {
  let boundary_marker = '--' + parser.boundary
  let boundary_bytes = boundary_marker.to_byte_array

  # Scan for next boundary
  match
    find_boundary(
      ref parser.buffer,
      ref boundary_bytes,
      at_eof,
      parser.head_line_start,
    )
  {
    case Some(pos) -> {
      # Found boundary - emit body data before it

      # Copy body data up to boundary.
      #
      # Per RFC 2046 the line break before the delimiter belongs to the
      # delimiter, so it is not body data. parse_stream normalises the message
      # to LF-only, so a bare LF must be stripped everywhere and not just at
      # EOF; strip the CR too when the line break is a CRLF.
      let mut body_end = pos

      if pos >= 1 {
        match parser.buffer.get(pos - 1) {
          case Ok(b1) -> {
            if b1 == 10 {
              body_end = pos - 1

              if body_end >= 1 {
                match parser.buffer.get(body_end - 1) {
                  case Ok(b2) -> if b2 == 13 { body_end = body_end - 1 }
                  case Error(_) -> {}
                }
              }
            }
          }
          case Error(_) -> {}
        }
      }

      let body_data = parser.buffer.slice(0, body_end).to_byte_array

      # Emit body data
      if body_data.size > 0 {
        match parser.current_context {
          case Some(ctx) -> {
            match
              handler.on_part_data(ref body_data, ctx.content_transfer_encoding)
            {
              case Ok(_) -> {}
              case Error(e) -> return Result.Error(e)
            }
          }
          case None -> {}
        }
      }

      # Notify end of part
      match handler.on_part_end {
        case Ok(_) -> {}
        case Error(e) -> return Result.Error(e)
      }

      # Remove body and boundary from buffer. Leave the line break after the
      # delimiter in place: process_reading_headers strips exactly one leading
      # line break, so an empty header section (headerless part) is preserved.
      let skip_to = pos + boundary_bytes.size
      let j = skip_to

      parser.head_line_start = is_line_start(ref parser.buffer, j)

      let next_buffer = parser.buffer.slice(j, parser.buffer.size).to_byte_array

      parser.buffer = next_buffer
      parser.current_context = Option.None
      parser.state = MultipartState.AtBoundary
      Result.Ok(0)
    }
    case None -> {
      # Boundary not found - emit available data except for safety buffer.
      # At EOF there is nothing left to arrive, so emit everything.
      let boundary_size = boundary_bytes.size
      let safety_buffer = if at_eof { 0 } else { boundary_size + 10 }

      if parser.buffer.size > safety_buffer {
        let emit_size = parser.buffer.size - safety_buffer
        let body_data = parser.buffer.slice(0, emit_size).to_byte_array

        # Emit body data
        match parser.current_context {
          case Some(ctx) -> {
            match
              handler.on_part_data(ref body_data, ctx.content_transfer_encoding)
            {
              case Ok(_) -> {}
              case Error(e) -> return Result.Error(e)
            }
          }
          case None -> {}
        }

        # Remove emitted data from buffer
        parser.head_line_start = is_line_start(ref parser.buffer, emit_size)

        let next_buffer = parser
          .buffer
          .slice(emit_size, parser.buffer.size)
          .to_byte_array

        parser.buffer = next_buffer
      }

      Result.Ok(0)
    }
  }
}

# Number of bytes taken up by a line break at the start of the buffer
#
# Returns 2 for CRLF, 1 for a lone CR or LF, and 0 otherwise.
fn leading_line_break_size(buffer: ref ByteArray) -> Int {
  if buffer.size == 0 { return 0 }

  let mut size = 1

  match buffer.get(0) {
    case Ok(b) -> {
      if b == 13 {
        if buffer.size >= 2 {
          match buffer.get(1) {
            case Ok(b2) -> if b2 == 10 { size = 2 }
            case Error(_) -> {}
          }
        }
      } else if b != 10 {
        size = 0
      }
    }
    case Error(_) -> size = 0
  }

  size
}

# Parse part headers
fn parse_part_headers(
  headers_raw: String,
  max_headers: Int,
  strict_mode: Bool,
) -> Result[Array[(String, String)], Error] {
  match
    parse_headers_impl(
      headers_raw,
      strict_mode,
      MAX_HEADERS_SECTION_SIZE,
      max_headers,
    )
  {
    case Ok(headers) -> Result.Ok(headers)
    case Error(e) -> Result.Error(e)
  }
}
