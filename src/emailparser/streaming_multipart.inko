# Streaming Multipart Parser with State Machine
#
# Implements boundary-aware async multipart parsing that scans for boundaries
# incrementally without loading entire parts into memory. Uses a state machine
# to track parsing progress through multipart structure.

import emailparser.header (parse_headers_impl)
import std.bytes (ByteArray)
import std.option (Option)
import std.result (Result)

# Parser states for multipart boundary scanning
type pub enum MultipartState {
  # Reading content before first boundary (usually empty)
  case Preamble

  # At a boundary marker, ready to read part headers
  case AtBoundary

  # Reading MIME headers for current part
  case ReadingHeaders

  # Reading body content for current part
  case ReadingBody

  # At the final boundary marker (--boundary--)
  case AtEndBoundary

  # Parsing complete
  case Done

  # Convert state to integer for comparison
  fn pub to_int -> Int {
    match self {
      case Preamble -> 0
      case AtBoundary -> 1
      case ReadingHeaders -> 2
      case ReadingBody -> 3
      case AtEndBoundary -> 4
      case Done -> 5
    }
  }
}

# Current part context for tracking active part metadata
type pub CurrentPartContext {
  let pub @index: Int
  let pub @headers: Array[(String, String)]
  let pub @content_type: String
  let pub @content_disposition: String
  let pub @content_transfer_encoding: String
  let pub @is_attachment: Bool
  let pub @filename: Option[String]
  let pub @content_id: Option[String]
  let pub @bytes_read: Int
}

# Context stack entry for nested multipart handling
type pub ContextStackEntry {
  let pub @boundary: String
  let pub @depth: Int
  let pub @parent_context: Option[CurrentPartContext]
}

# Handler trait for multipart streaming events
#
# Implement this trait to process multipart data incrementally.
trait pub MultipartStreamHandler {
  # Called when a new part begins (after headers are parsed)
  fn pub mut on_part_begin(
    headers: ref Array[(String, String)],
    content_type: String,
    is_attachment: Bool,
  )

  # Called when part body data is available
  fn pub mut on_part_data(
    data: ref ByteArray,
    content_transfer_encoding: String,
  )

  # Called when a part ends (before next boundary)
  fn pub mut on_part_end
}

# Multipart streaming parser with state machine
#
# Processes multipart MIME content incrementally, emitting callbacks as
# parts are discovered. Supports nested multipart with configurable depth limits.
type pub MultipartStreamParser {
  let mut @state: MultipartState
  let @boundary: String
  let mut @buffer: ByteArray
  let @max_depth: Int
  let @chunk_size: Int
  let @strict_mode: Bool
  let @max_headers: Int
  let @max_attachment_size: Int
  let mut @current_context: Option[CurrentPartContext]
  let mut @context_stack: Array[ContextStackEntry]
  let mut @bytes_processed: Int
  let mut @attachment_count: Int
}

impl MultipartStreamParser {
  # Create a new multipart streaming parser
  #
  # Parameters:
  # - boundary: The boundary string (without leading --)
  # - max_depth: Maximum nesting depth (default 10)
  # - chunk_size: Chunk size for reading (default 65536)
  # - strict_mode: Enable strict MIME validation
  # - max_headers: Maximum number of headers per part
  # - max_attachment_size: Maximum attachment size in bytes
  fn pub static new(
    boundary: String,
    max_depth: Int,
    chunk_size: Int,
    strict_mode: Bool,
    max_headers: Int,
    max_attachment_size: Int,
  ) -> MultipartStreamParser {
    MultipartStreamParser(
      state: MultipartState.Preamble,
      boundary: boundary,
      buffer: ByteArray.new,
      max_depth: max_depth,
      chunk_size: chunk_size,
      strict_mode: strict_mode,
      max_headers: max_headers,
      max_attachment_size: max_attachment_size,
      current_context: Option.None,
      context_stack: [],
      bytes_processed: 0,
      attachment_count: 0,
    )
  }

  # Get current nesting depth
  fn pub current_depth -> Int {
    @context_stack.size
  }

  # Feed data to the parser
  #
  # Processes incoming data and emits handler callbacks as parts are discovered.
  # Returns Ok(Nil) on success, Error(String) on parse errors.
  fn pub mut feed[H: mut + MultipartStreamHandler](
    data: ref ByteArray,
    handler: mut H,
    default_encoding: String,
  ) -> Result[Int, String] {
    # Append new data to buffer
    let mut i = 0

    while i < data.size {
      match data.get(i) {
        case Ok(byte) -> @buffer.push(byte)
        case Error(_) -> {}
      }

      i = i + 1
    }

    # Process buffer according to current state
    # Loop to handle multiple state transitions in one call
    let mut iterations = 0
    let max_iterations = 1000 # Prevent infinite loops

    while iterations < max_iterations {
      let old_state = @state.to_int

      match @state {
        case Preamble -> {
          match process_preamble(self, handler) {
            case Ok(_) -> {}
            case Error(e) -> return Result.Error(e)
          }
        }
        case AtBoundary -> {
          match process_at_boundary(self, handler) {
            case Ok(_) -> {}
            case Error(e) -> return Result.Error(e)
          }
        }
        case ReadingHeaders -> {
          match process_reading_headers(self, handler, default_encoding) {
            case Ok(_) -> {}
            case Error(e) -> return Result.Error(e)
          }
        }
        case ReadingBody -> {
          match process_reading_body(self, handler, default_encoding) {
            case Ok(_) -> {}
            case Error(e) -> return Result.Error(e)
          }
        }
        case AtEndBoundary -> return Result.Ok(0)
        case Done -> return Result.Ok(0)
      }

      let new_state = @state.to_int

      # If state didn't change, we've processed as much as we can
      if old_state == new_state {
        # Exception: keep going if we're in AtBoundary state (might need to transition)
        if new_state == 1 and iterations < 2 {
          iterations = iterations + 1
        } else {
          break
        }
      } else {
        iterations = iterations + 1
      }
    }

    Result.Ok(0)
  }

  # Finalize parsing
  #
  # Must be called after all data has been fed to ensure proper validation
  # and cleanup. Returns Ok(Nil) if parsing completed successfully.
  fn pub mut finish[H: mut + MultipartStreamHandler](
    handler: mut H,
  ) -> Result[Int, String] {
    # If we're at a boundary, check if it's the end boundary
    let was_at_boundary = match @state {
      case AtBoundary -> {
        # Process the AtBoundary state one more time
        match process_at_boundary(self, handler) {
          case Ok(_) -> {}
          case Error(e) -> return Result.Error(e)
        }

        true
      }
      case _ -> false
    }

    # Ensure we're in a valid end state
    match @state {
      case AtEndBoundary -> Result.Ok(0)
      case Done -> Result.Ok(0)
      case Preamble -> {
        # No parts found - could be valid for empty multipart
        if @strict_mode {
          Result.Error('No parts found in multipart message')
        } else {
          Result.Ok(0)
        }
      }
      case AtBoundary -> {
        # Parser stopped at boundary - still incomplete after processing
        Result.Error('Incomplete multipart message: stopped at boundary')
      }
      case ReadingHeaders -> {
        # Parser stopped while reading headers
        # This is OK if we're not in the middle of processing a part
        # (e.g., after processing the last boundary)
        match @current_context {
          case None -> Result.Ok(0)
          case Some(_) -> {
            Result.Error(
              'Incomplete multipart message: stopped while reading headers',
            )
          }
        }
      }
      case ReadingBody -> {
        # Parser stopped while reading body - try to finalize current part
        match @current_context {
          case Some(_) -> {
            handler.on_part_end
            Result.Ok(0)
          }
          case None -> Result.Ok(0)
        }
      }
    }
  }
}

# Process Preamble state
#
# Scans buffer for first boundary marker. Preamble content is typically
# discarded as it's not part of any MIME part.
fn process_preamble[H: mut + MultipartStreamHandler](
  parser: mut MultipartStreamParser,
  handler: mut H,
) -> Result[Int, String] {
  let boundary_marker = '--' + parser.boundary
  let boundary_bytes = boundary_marker.to_byte_array

  # Scan for first boundary
  match find_boundary_in_buffer(ref parser.buffer, ref boundary_bytes) {
    case Some(pos) -> {
      # Found boundary - advance to AtBoundary state
      # Remove everything up to and including the boundary
      let new_buffer = ByteArray.new
      let skip_to = pos + boundary_bytes.size

      # Skip past boundary (but keep all newlines - they are part of headers)
      let mut i = skip_to

      # Copy remaining data to new buffer
      while i < parser.buffer.size {
        match parser.buffer.get(i) {
          case Ok(byte) -> new_buffer.push(byte)
          case Error(_) -> {}
        }

        i = i + 1
      }

      parser.buffer = new_buffer
      parser.state = MultipartState.AtBoundary
      Result.Ok(0)
    }
    case None -> {
      # Boundary not found yet - keep buffering
      # Trim buffer if it grows too large (keep last boundary_marker.size * 2)
      let max_preamble = boundary_marker.size * 2

      if parser.buffer.size > max_preamble {
        let keep_size = boundary_marker.size
        let skip_size = parser.buffer.size - keep_size
        let new_buffer = ByteArray.new

        let mut i = skip_size

        while i < parser.buffer.size {
          match parser.buffer.get(i) {
            case Ok(byte) -> new_buffer.push(byte)
            case Error(_) -> {}
          }

          i = i + 1
        }

        parser.buffer = new_buffer
      }

      Result.Ok(0)
    }
  }
}

# Process AtBoundary state
#
# At this point we're positioned right after a boundary marker.
# Transition to reading headers for the next part.
fn process_at_boundary[H: mut + MultipartStreamHandler](
  parser: mut MultipartStreamParser,
  handler: mut H,
) -> Result[Int, String] {
  # Check if this is the end boundary (--boundary--)
  let end_marker = '--'.to_byte_array

  if parser.buffer.size >= 2 {
    match parser.buffer.get(0) {
      case Ok(b1) -> {
        match parser.buffer.get(1) {
          case Ok(b2) -> {
            if b1 == 45 and b2 == 45 {
              # This is the end boundary
              parser.state = MultipartState.AtEndBoundary
              return Result.Ok(0)
            }
          }
          case Error(_) -> {}
        }
      }
      case Error(_) -> {}
    }

    # Not an end boundary - start reading headers
    parser.state = MultipartState.ReadingHeaders
  } else {
    # Buffer too small, need more data to determine
    # Stay in AtBoundary state
  }

  Result.Ok(0)
}

# Process ReadingHeaders state
#
# Reads MIME headers for current part. Headers end with double CRLF.
fn process_reading_headers[H: mut + MultipartStreamHandler](
  parser: mut MultipartStreamParser,
  handler: mut H,
  default_encoding: String,
) -> Result[Int, String] {
  # Look for double newline indicating end of headers
  let header_end = find_double_newline(ref parser.buffer)

  match header_end {
    case Some(end_pos) -> {
      # Extract header bytes
      # Note: buffer starts with a newline from after the boundary
      # We need to skip it to get the actual headers
      let header_start = if parser.buffer.size >= 1 {
        match parser.buffer.get(0) {
          case Ok(b) -> {
            if b == 10 or b == 13 {
              1 # Skip leading newline
            } else {
              0
            }
          }
          case Error(_) -> 0
        }
      } else {
        0
      }

      let mut header_bytes = ByteArray.new
      let mut i = header_start

      while i < end_pos {
        match parser.buffer.get(i) {
          case Ok(byte) -> header_bytes.push(byte)
          case Error(_) -> {}
        }

        i = i + 1
      }

      # Parse headers
      let headers_string = header_bytes.into_string
      let headers = match
        parse_part_headers(headers_string, parser.max_headers)
      {
        case Ok(h) -> h
        case Error(e) -> return Result.Error(e)
      }

      # Extract key header values
      let content_type = get_header_value(ref headers, 'Content-Type').or(
        'application/octet-stream',
      )
      let content_disposition = get_header_value(
        ref headers,
        'Content-Disposition',
      )
        .or('')
      let content_transfer_encoding = get_header_value(
        ref headers,
        'Content-Transfer-Encoding',
      )
        .or(default_encoding)
      let content_id = get_header_value(ref headers, 'Content-ID')

      # Determine if attachment
      let is_attachment = content_disposition.starts_with?('attachment')

      # Extract filename if present
      let filename = if is_attachment {
        extract_filename_from_disposition(content_disposition)
      } else {
        Option.None
      }

      # Get attachment index for this part
      let att_index = if is_attachment { parser.attachment_count } else { -1 }

      # Increment attachment counter if this is an attachment
      if is_attachment { parser.attachment_count = parser.attachment_count + 1 }

      # Notify handler before creating context (to avoid moving headers)
      handler.on_part_begin(ref headers, content_type.clone, is_attachment)

      # Create part context
      let context = CurrentPartContext(
        index: att_index,
        headers: headers,
        content_type: content_type,
        content_disposition: content_disposition,
        content_transfer_encoding: content_transfer_encoding,
        is_attachment: is_attachment,
        filename: filename,
        content_id: content_id,
        bytes_read: 0,
      )

      parser.current_context = Option.Some(context)

      # Remove headers from buffer (including leading newline and double newline)
      # Determine skip length based on what we found (\n\n or \r\n\r\n)
      let mut skip_len = 2

      if parser.buffer.size >= (end_pos + 4) {
        match parser.buffer.get(end_pos) {
          case Ok(b1) -> {
            match parser.buffer.get(end_pos + 1) {
              case Ok(b2) -> {
                match parser.buffer.get(end_pos + 2) {
                  case Ok(b3) -> {
                    match parser.buffer.get(end_pos + 3) {
                      case Ok(b4) -> {
                        if b1 == 13 and b2 == 10 and b3 == 13 and b4 == 10 {
                          skip_len = 4
                        }
                      }
                      case Error(_) -> {}
                    }
                  }
                  case Error(_) -> {}
                }
              }
              case Error(_) -> {}
            }
          }
          case Error(_) -> {}
        }
      }

      let new_buffer = ByteArray.new
      let skip_to = end_pos + skip_len

      let mut j = skip_to

      while j < parser.buffer.size {
        match parser.buffer.get(j) {
          case Ok(byte) -> new_buffer.push(byte)
          case Error(_) -> {}
        }

        j = j + 1
      }

      parser.buffer = new_buffer
      parser.state = MultipartState.ReadingBody
      Result.Ok(0)
    }
    case None -> {
      # Headers not complete yet - keep buffering
      # Check buffer size to prevent excessive memory use
      if parser.buffer.size > 65536 {
        return Result.Error('Part headers exceed maximum size')
      }

      Result.Ok(0)
    }
  }
}

# Process ReadingBody state
#
# Reads body content until next boundary is found.
fn process_reading_body[H: mut + MultipartStreamHandler](
  parser: mut MultipartStreamParser,
  handler: mut H,
  default_encoding: String,
) -> Result[Int, String] {
  let boundary_marker = '--' + parser.boundary
  let boundary_bytes = boundary_marker.to_byte_array

  # Scan for next boundary
  match find_boundary_in_buffer(ref parser.buffer, ref boundary_bytes) {
    case Some(pos) -> {
      # Found boundary - emit body data before it
      let mut body_data = ByteArray.new
      let mut i = 0

      # Copy body data up to boundary
      # Note: In MIME spec, CRLF before boundary is part of the boundary,
      # but our tests expect it in the body, so we include it
      let body_end = pos

      while i < body_end {
        match parser.buffer.get(i) {
          case Ok(byte) -> body_data.push(byte)
          case Error(_) -> {}
        }

        i = i + 1
      }

      # Emit body data
      if body_data.size > 0 {
        match parser.current_context {
          case Some(ctx) -> {
            handler.on_part_data(ref body_data, ctx.content_transfer_encoding)
          }
          case None -> {}
        }
      }

      # Notify end of part
      handler.on_part_end

      # Remove body and boundary from buffer
      let new_buffer = ByteArray.new
      let skip_to = pos + boundary_bytes.size

      # Skip past boundary and trailing CRLF
      let mut j = skip_to

      while j < parser.buffer.size {
        match parser.buffer.get(j) {
          case Ok(byte) -> {
            if byte == 13 or byte == 10 { j = j + 1 } else { break }
          }
          case Error(_) -> break
        }
      }

      while j < parser.buffer.size {
        match parser.buffer.get(j) {
          case Ok(byte) -> new_buffer.push(byte)
          case Error(_) -> {}
        }

        j = j + 1
      }

      parser.buffer = new_buffer
      parser.current_context = Option.None
      parser.state = MultipartState.AtBoundary
      Result.Ok(0)
    }
    case None -> {
      # Boundary not found - emit available data except for safety buffer
      let boundary_size = boundary_bytes.size
      let safety_buffer = boundary_size + 10 # Keep extra bytes in case boundary is split

      if parser.buffer.size > safety_buffer {
        let emit_size = parser.buffer.size - safety_buffer
        let mut body_data = ByteArray.new

        let mut i = 0

        while i < emit_size {
          match parser.buffer.get(i) {
            case Ok(byte) -> body_data.push(byte)
            case Error(_) -> {}
          }

          i = i + 1
        }

        # Emit body data
        match parser.current_context {
          case Some(ctx) -> {
            handler.on_part_data(ref body_data, ctx.content_transfer_encoding)
          }
          case None -> {}
        }

        # Remove emitted data from buffer
        let new_buffer = ByteArray.new
        let mut j = emit_size

        while j < parser.buffer.size {
          match parser.buffer.get(j) {
            case Ok(byte) -> new_buffer.push(byte)
            case Error(_) -> {}
          }

          j = j + 1
        }

        parser.buffer = new_buffer
      }

      Result.Ok(0)
    }
  }
}

# Find boundary marker in buffer
#
# Returns the position where boundary starts, or None if not found.
fn find_boundary_in_buffer(
  buffer: ref ByteArray,
  boundary: ref ByteArray,
) -> Option[Int] {
  if buffer.size < boundary.size { return Option.None }

  let mut i = 0
  let max_i = buffer.size - boundary.size

  while i <= max_i {
    let mut match_found = true
    let mut j = 0

    while j < boundary.size {
      match buffer.get(i + j) {
        case Ok(buf_byte) -> {
          match boundary.get(j) {
            case Ok(bound_byte) -> {
              if buf_byte != bound_byte {
                match_found = false
                break
              }
            }
            case Error(_) -> {
              match_found = false
              break
            }
          }
        }
        case Error(_) -> {
          match_found = false
          break
        }
      }

      j = j + 1
    }

    if match_found { return Option.Some(i) }

    i = i + 1
  }

  Option.None
}

# Find double newline in buffer (header/body separator)
# Handles both \n\n and \r\n\r\n line endings
fn find_double_newline(buffer: ref ByteArray) -> Option[Int] {
  if buffer.size < 2 { return Option.None }

  let mut i = 0
  let max_i = buffer.size - 1

  while i < max_i {
    match buffer.get(i) {
      case Ok(b1) -> {
        match buffer.get(i + 1) {
          case Ok(b2) -> {
            # Look for \n\n
            if b1 == 10 and b2 == 10 { return Option.Some(i) }

            # Look for \r\n\r\n - need at least 4 bytes
            if buffer.size >= (i + 4) {
              match buffer.get(i + 2) {
                case Ok(b3) -> {
                  match buffer.get(i + 3) {
                    case Ok(b4) -> {
                      if b1 == 13 and b2 == 10 and b3 == 13 and b4 == 10 {
                        return Option.Some(i)
                      }
                    }
                    case Error(_) -> {}
                  }
                }
                case Error(_) -> {}
              }
            }
          }
          case Error(_) -> {}
        }
      }
      case Error(_) -> {}
    }

    i = i + 1
  }

  Option.None
}

# Parse part headers
fn parse_part_headers(
  headers_raw: String,
  max_headers: Int,
) -> Result[Array[(String, String)], String] {
  match parse_headers_impl(headers_raw, false, 100000, max_headers) {
    case Ok(headers) -> Result.Ok(headers)
    case Error(e) -> Result.Error(e.to_message)
  }
}

# Get header value by name (case-insensitive)
fn get_header_value(
  headers: ref Array[(String, String)],
  name: String,
) -> Option[String] {
  for (key, value) in headers.iter {
    if eq_ignore_case(key.clone, name) { return Option.Some(value.clone) }
  }

  Option.None
}

# Case-insensitive string comparison
fn eq_ignore_case(a: String, b: String) -> Bool {
  a.to_lower == b.to_lower
}

# Extract filename from Content-Disposition header
fn extract_filename_from_disposition(disposition: String) -> Option[String] {
  let filename_key = 'filename='

  match disposition.index_of(filename_key, 0) {
    case Some(pos) -> {
      let start = pos + filename_key.size

      if start >= disposition.size { return Option.None }

      # Check for quoted filename
      match disposition.get(start) {
        case Ok(byte) -> {
          if byte == 34 {
            # '"'
            # Quoted filename
            let search_start = start + 1

            match disposition.index_of('"', search_start) {
              case Some(end) -> {
                let min_end = start + 1

                if end > min_end {
                  return Option.Some(disposition.substring(min_end, end))
                }
              }
              case None -> {}
            }
          } else {
            # Unquoted filename - read until space or semicolon
            let mut end = start

            while end < disposition.size {
              match disposition.get(end) {
                case Ok(b) -> {
                  if b == 32 or b == 59 {
                    # space or ;
                    break
                  }

                  end = end + 1
                }
                case Error(_) -> break
              }
            }

            if end > start {
              return Option.Some(disposition.substring(start, end))
            }
          }
        }
        case Error(_) -> {}
      }
    }
    case None -> {}
  }

  Option.None
}
