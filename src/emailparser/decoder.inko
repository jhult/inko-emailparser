# ==============================================================================
# Content Transfer Encoding Decoder Module
# ==============================================================================
#
# This module provides decoding functions for email content transfer encodings
# as specified in RFC 2045. It handles the most common encodings used in email:
# - Base64 (RFC 2045 section 6.8)
# - Quoted-Printable (RFC 2045 section 6.7)
# - RFC 2047 encoded-words for non-ASCII headers
#
# ## Purpose
#
# Email messages use various encoding schemes to transport binary data and
# non-ASCII text over protocols that only support 7-bit ASCII. This module
# centralizes all decoding logic:
# - Email body decoding (base64, quoted-printable, 7bit, 8bit, binary)
# - Header value decoding (RFC 2047 encoded-words)
# - Character encoding handling
#
# ## Architecture
#
# The module is organized into three layers:
#
# 1. **Core decoders** (private implementation):
#    - `decode_body_impl`: Main entry point for body decoding
#    - `decode_quoted_printable_impl`: Quoted-printable implementation
#    - `decode_hex_sequence`: Low-level hex sequence parser
#
# 2. **Public API**:
#    - `decode_quoted_printable`: Decode quoted-printable text
#    - `decode_rfc2047_word`: Decode RFC 2047 encoded-words
#    - `decode_rfc2047_quoted_printable`: Decode RFC 2047 QP encoding
#
# 3. **Error handling**:
#    - Invalid encoding returns empty string or original input
#    - Replacement characters (�) for undecodable bytes
#    - Fails-safe rather than throwing exceptions
#
# ## RFC Compliance
#
# - RFC 2045 section 6: Content-Transfer-Encoding
#   - 6.7: Quoted-Printable Encoding
#   - 6.8: Base64 Encoding
# - RFC 2047 section 6: Encoded-Word Syntax
#
import emailparser.ascii (
  ASCII_CR, ASCII_EQUALS, ASCII_HT, ASCII_LF, ASCII_QUESTION, ASCII_SPACE,
  BASE64_CHUNK_SIZE, BASE64_DECODED_SIZE, QP_SAFETY_FACTOR,
  UNICODE_REPLACEMENT_CHAR_UTF8,
)
import emailparser.error (Error)
import emailparser.error (Severity)
import emailparser.hex (parse_hex_byte, two_bytes_to_hex_string)
import emailparser.size_tracker (SizeTracker)
import std.base64 (Decoder)
import std.bytes (ByteArray)
import std.result (Result)

fn decode_body_impl(
  raw: String,
  encoding: String,
  max_size: Int,
) -> Result[String, Error] {
  let enc_lower = encoding.to_lower

  if enc_lower == 'base64' {
    # Estimate decoded size after whitespace removal
    # Base64: 4 chars -> 3 bytes ratio, accounting for padding
    let result_bytes = ByteArray.new
    let mut i = 0

    while i < raw.size {
      match raw.get(i) {
        case Ok(byte) -> {
          if
            byte != ASCII_LF
              and byte != ASCII_CR
              and byte != ASCII_SPACE
              and byte != ASCII_HT
          {
            result_bytes.push(byte)
          }

          i = i + 1
        }
        case Error(_) -> i = i + 1
      }
    }

    let cleaned = result_bytes.into_string

    let cleaned_size = cleaned.size

    let padding = if cleaned_size >= 2 and cleaned.ends_with?('==') {
      2
    } else if cleaned_size >= 1 and cleaned.ends_with?('=') {
      1
    } else {
      0
    }

    let estimated_size = ((cleaned_size - padding) * BASE64_DECODED_SIZE)
      / BASE64_CHUNK_SIZE

    match SizeTracker.check_allocation(0, estimated_size, max_size) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    let decoder = Decoder.new
    let output = ByteArray.new

    match decoder.decode(cleaned.to_byte_array, output) {
      case Ok(_) -> Result.Ok(output.into_string)
      case Error(_) -> {
        Result.Error(
          Error.DecodingFailed(
            Severity.Error,
            encoding,
            'base64 decoding failed',
            Option.None,
            Option.None,
            Option.None,
          ),
        )
      }
    }
  } else if enc_lower == 'quoted-printable' {
    # Early size check for quoted-printable
    # QP encoding uses =XX (3 chars) per encoded byte
    # Conservative estimate: assume 75% of bytes are encoded
    # Worst case: all bytes encoded (3:1 ratio)
    # Use QP_SAFETY_FACTOR (4) for conservative estimate
    let estimated_size = raw.size / QP_SAFETY_FACTOR

    match SizeTracker.check_allocation(0, estimated_size, max_size) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    let decoded = decode_quoted_printable_impl(raw)

    match SizeTracker.check_allocation(0, decoded.size, max_size) {
      case Ok(_) -> Result.Ok(decoded)
      case Error(e) -> Result.Error(e)
    }
  } else {
    match SizeTracker.check_allocation(0, raw.size, max_size) {
      case Ok(_) -> Result.Ok(raw)
      case Error(e) -> Result.Error(e)
    }
  }
}

fn decode_hex_sequence(
  text: String,
  underscore_is_space: Bool,
  preserve_equals_on_error: Bool,
) -> String {
  let result_bytes = ByteArray.new
  let mut i = 0

  while i < text.size {
    match text.get(i) {
      case Ok(byte) -> {
        if byte == 95 and underscore_is_space {
          result_bytes.push(ASCII_SPACE)
          i = i + 1
        } else if byte == ASCII_EQUALS {
          if i + 2 < text.size {
            match text.get(i + 1) {
              case Ok(next1) -> {
                if next1 == ASCII_CR {
                  match text.get(i + 2) {
                    case Ok(next2) -> {
                      if next2 == ASCII_LF {
                        i = i + 3
                      } else {
                        if preserve_equals_on_error {
                          result_bytes.push(ASCII_EQUALS)
                        }

                        i = i + 1
                      }
                    }
                    case Error(_) -> {
                      if preserve_equals_on_error {
                        result_bytes.push(ASCII_EQUALS)
                      }

                      i = i + 1
                    }
                  }
                } else if next1 == ASCII_LF {
                  i = i + 2
                } else {
                  match text.get(i + 2) {
                    case Ok(hex2) -> {
                      let hex_str = two_bytes_to_hex_string(next1, hex2)

                      match parse_hex_byte(hex_str) {
                        case Some(decoded_byte) -> {
                          result_bytes.push(decoded_byte)
                          i = i + 3
                        }
                        case None -> {
                          if preserve_equals_on_error {
                            result_bytes.push(ASCII_EQUALS)
                          } else {
                            for byte in UNICODE_REPLACEMENT_CHAR_UTF8.iter {
                              result_bytes.push(byte)
                            }
                          }

                          i = i + 1
                        }
                      }
                    }
                    case Error(_) -> {
                      if preserve_equals_on_error {
                        result_bytes.push(ASCII_EQUALS)
                      } else {
                        for byte in UNICODE_REPLACEMENT_CHAR_UTF8.iter {
                          result_bytes.push(byte)
                        }
                      }

                      i = i + 1
                    }
                  }
                }
              }
              case Error(_) -> {
                if preserve_equals_on_error {
                  result_bytes.push(ASCII_EQUALS)
                } else {
                  for byte in UNICODE_REPLACEMENT_CHAR_UTF8.iter {
                    result_bytes.push(byte)
                  }
                }

                i = i + 1
              }
            }
          } else {
            if preserve_equals_on_error {
              result_bytes.push(ASCII_EQUALS)
            } else {
              for byte in UNICODE_REPLACEMENT_CHAR_UTF8.iter {
                result_bytes.push(byte)
              }
            }

            i = i + 1
          }
        } else {
          result_bytes.push(byte)
          i = i + 1
        }
      }
      case Error(_) -> {
        # Push Unicode replacement character U+FFFD (UTF-8: 239, 191, 189)
        for byte in UNICODE_REPLACEMENT_CHAR_UTF8.iter {
          result_bytes.push(byte)
        }

        i = i + 1
      }
    }
  }

  result_bytes.into_string
}

fn decode_quoted_printable_impl(raw: String) -> String {
  decode_hex_sequence(
    raw,
    underscore_is_space: false,
    preserve_equals_on_error: true,
  )
}

fn pub decode_quoted_printable(raw: String) -> String {
  decode_quoted_printable_impl(raw)
}

fn pub decode_rfc2047_word(word: String) -> String {
  if word.starts_with?('=?') == false or word.ends_with?('?=') == false {
    return word
  }

  let content = word.substring(2, word.size - 2)

  let parts = content.split('?').map(fn (s) { s.to_string }).to_array

  if parts.size < 3 { return word }

  let charset = match parts.get(0) {
    case Ok(c) -> c
    case Error(_) -> return word
  }

  let encoding = match parts.get(1) {
    case Ok(e) -> e.to_upper
    case Error(_) -> return word
  }

  # RFC 2047 section 4: encoding must be 'B' or 'Q'
  if encoding != 'B' and encoding != 'Q' { return word }

  if charset.empty? { return word }

  let mut encoded_text = ByteArray.new
  let mut i = 2

  while i < parts.size {
    match parts.get(i) {
      case Ok(part) -> {
        if i > 2 { encoded_text.push(ASCII_QUESTION) }

        encoded_text.append(part.to_byte_array)
        i = i + 1
      }
      case Error(_) -> break
    }
  }

  let encoded_text = encoded_text.into_string

  match encoding {
    case 'B' -> {
      let decoder = Decoder.new
      let output = ByteArray.new

      match decoder.decode(encoded_text.to_byte_array, output) {
        case Ok(_) -> output.into_string
        case Error(_) -> word
      }
    }
    case 'Q' -> decode_rfc2047_quoted_printable(encoded_text)
    case _ -> word
  }
}

fn pub decode_rfc2047_quoted_printable(text: String) -> String {
  decode_hex_sequence(
    text,
    underscore_is_space: true,
    preserve_equals_on_error: false,
  )
}

# Trait for content decoder implementations
#
# Allows swapping decoder implementations for testing and extensibility
trait pub ContentDecoder {
  fn decode(
    input: String,
    encoding: String,
    max_size: Int,
  ) -> Result[String, Error]
}

# Default content decoder implementation
type pub DefaultContentDecoder {}

impl ContentDecoder for DefaultContentDecoder {
  fn decode(
    input: String,
    encoding: String,
    max_size: Int,
  ) -> Result[String, Error] {
    decode_body_impl(input, encoding, max_size)
  }
}

impl DefaultContentDecoder {
  fn pub static new -> DefaultContentDecoder {
    DefaultContentDecoder()
  }
}
