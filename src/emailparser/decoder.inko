# ==============================================================================
# Content Transfer Encoding Decoder Module
# ==============================================================================
#
# This module provides decoding functions for email content transfer encodings
# as specified in RFC 2045. It handles the most common encodings used in email:
# - Base64 (RFC 2045 section 6.8)
# - Quoted-Printable (RFC 2045 section 6.7)
# - RFC 2047 encoded-words for non-ASCII headers
#
# ## Purpose
#
# Email messages use various encoding schemes to transport binary data and
# non-ASCII text over protocols that only support 7-bit ASCII. This module
# centralizes all decoding logic:
# - Email body decoding (base64, quoted-printable, 7bit, 8bit, binary)
# - Header value decoding (RFC 2047 encoded-words)
# - Character encoding handling
#
# ## Architecture
#
# The module is organized into three layers:
#
# 1. **Core decoders** (private implementation):
#    - `decode_body_impl`: Main entry point for body decoding
#
# 2. **Public API**:
#    - `decode_quoted_printable`: Decode quoted-printable text
#    - `decode_rfc2047_word`: Decode RFC 2047 encoded-words
#    - `decode_rfc2047_quoted_printable`: Decode RFC 2047 QP encoding
#
# 3. **Error handling**:
#    - Invalid encoding returns empty string or original input
#    - Replacement characters (�) for undecodable bytes
#    - Fails-safe rather than throwing exceptions
#
# ## RFC Compliance
#
# - RFC 2045 section 6: Content-Transfer-Encoding
#   - 6.7: Quoted-Printable Encoding
#   - 6.8: Base64 Encoding
# - RFC 2047 section 6: Encoded-Word Syntax
#
import emailparser.ascii (
  ASCII_CR, ASCII_EQUALS, ASCII_HT, ASCII_LF, ASCII_QUESTION, ASCII_SPACE,
  BASE64_CHUNK_SIZE, BASE64_DECODED_SIZE, UNICODE_REPLACEMENT_CHAR_UTF8,
)
import emailparser.error (Error)
import emailparser.error (Severity)
import emailparser.hex (parse_hex_byte, two_bytes_to_hex_string)
import emailparser.limits (MAX_HEADER_ITERATIONS)
import emailparser.size_tracker (SizeTracker)
import emailparser.streaming_decoder (QuotedPrintableStreamingDecoder)
import std.base64 (Decoder)
import std.bytes (ByteArray)
import std.result (Result)

fn decode_body_impl(
  raw: String,
  encoding: String,
  max_size: Int,
) -> Result[String, Error] {
  match decode_body_bytes_impl(raw, encoding, max_size) {
    case Ok(bytes) -> Result.Ok(bytes.into_string)
    case Error(e) -> Result.Error(e)
  }
}

# Decode a body to raw bytes
#
# Unlike decode_body_impl this preserves the exact decoded bytes, which is
# required for binary attachments (base64/quoted-printable images, PDFs, ...).
fn decode_body_bytes_impl(
  raw: String,
  encoding: String,
  max_size: Int,
) -> Result[ByteArray, Error] {
  let enc_lower = encoding.to_lower

  if enc_lower == 'base64' {
    decode_base64_body(raw, encoding, max_size)
  } else if enc_lower == 'quoted-printable' {
    # Decode incrementally so the output limit is enforced while allocating,
    # instead of decoding the whole body and checking afterwards.
    let mut decoder = QuotedPrintableStreamingDecoder.new(max_size, true, false)
    let decoded = ByteArray.new

    match decoder.feed(raw) {
      case Ok(bytes) -> decoded.append(bytes)
      case Error(e) -> {
        return Result.Error(
          Error.DecodingFailed(
            Severity.Error,
            encoding,
            e,
            Option.None,
            Option.None,
            Option.None,
          ),
        )
      }
    }

    match decoder.finish {
      case Ok(bytes) -> decoded.append(bytes)
      case Error(e) -> {
        return Result.Error(
          Error.DecodingFailed(
            Severity.Error,
            encoding,
            e,
            Option.None,
            Option.None,
            Option.None,
          ),
        )
      }
    }

    Result.Ok(decoded)
  } else {
    match SizeTracker.check_allocation(0, raw.size, max_size) {
      case Ok(_) -> Result.Ok(raw.to_byte_array)
      case Error(e) -> Result.Error(e)
    }
  }
}

# Decode a base64 body, accepting both padded and unpadded input.
#
# Whitespace is ignored. Padding may only appear at the end of the input and
# must be consistent with the number of encoded characters. Unpadded input with
# a three- or two-character tail is decoded normally.
fn decode_base64_body(
  raw: String,
  encoding: String,
  max_size: Int,
) -> Result[ByteArray, Error] {
  let cleaned = ByteArray.new
  let mut i = 0

  while i < raw.size {
    match raw.get(i) {
      case Ok(byte) -> {
        if
          byte != ASCII_LF
            and byte != ASCII_CR
            and byte != ASCII_SPACE
            and byte != ASCII_HT
        {
          cleaned.push(byte)
        }
      }
      case Error(_) -> {}
    }

    i = i + 1
  }

  let mut data_size = cleaned.size
  let mut padding = 0

  while data_size > 0 {
    match cleaned.get(data_size - 1) {
      case Ok(byte) -> {
        if byte == ASCII_EQUALS {
          padding = padding + 1
          data_size = data_size - 1
        } else {
          break
        }
      }
      case Error(_) -> break
    }
  }

  let data = ByteArray.new
  let mut valid = padding <= 2
  let mut j = 0

  while j < data_size {
    match cleaned.get(j) {
      case Ok(byte) -> {
        if is_base64_data_char(byte) { data.push(byte) } else { valid = false }
      }
      case Error(_) -> valid = false
    }

    j = j + 1
  }

  let remainder = data.size % 4

  if remainder == 1 { valid = false }

  if padding == 1 and remainder != 3 { valid = false }

  if padding == 2 and remainder != 2 { valid = false }

  if !valid {
    return Result.Error(
      Error.DecodingFailed(
        Severity.Error,
        encoding,
        'base64 decoding failed',
        Option.None,
        Option.None,
        Option.None,
      ),
    )
  }

  let estimated_size = (data.size * BASE64_DECODED_SIZE) / BASE64_CHUNK_SIZE

  match SizeTracker.check_allocation(0, estimated_size, max_size) {
    case Ok(_) -> {}
    case Error(e) -> return Result.Error(e)
  }

  let mut decoder = Decoder.new

  decoder.padding = false

  let output = ByteArray.new

  match decoder.decode(data, output) {
    case Ok(_) -> Result.Ok(output)
    case Error(_) -> {
      Result.Error(
        Error.DecodingFailed(
          Severity.Error,
          encoding,
          'base64 decoding failed',
          Option.None,
          Option.None,
          Option.None,
        ),
      )
    }
  }
}

fn is_base64_data_char(byte: Int) -> Bool {
  (byte >= 65 and byte <= 90)
    or (byte >= 97 and byte <= 122)
    or (byte >= 48 and byte <= 57)
    or byte == 43
    or byte == 47
}

# Decode quoted-printable / RFC 2047 Q data
#
# This is the single QP state machine shared by the buffered parser and
# `QuotedPrintableStreamingDecoder`. The streaming decoder buffers an
# incomplete trailing escape and decodes complete prefixes through this
# function, so both paths agree on soft line breaks, "==", invalid escapes and
# the `preserve_equals_on_error` behaviour.
fn pub decode_qp_bytes(
  text: String,
  underscore_is_space: Bool,
  preserve_equals_on_error: Bool,
) -> ByteArray {
  let bytes = text.to_byte_array

  decode_qp_bytes_range(
    ref bytes,
    bytes.size,
    underscore_is_space,
    preserve_equals_on_error,
    true,
  )
}

# Decode `input` up to `end` as quoted-printable / RFC 2047 Q data.
#
# The byte-based form preserves non-UTF-8 bytes, which the streaming attachment
# path needs: converting a chunk to String first replaces invalid bytes with
# U+FFFD and corrupts the output.
fn pub decode_qp_bytes_range(
  input: ref ByteArray,
  end: Int,
  underscore_is_space: Bool,
  preserve_equals_on_error: Bool,
  at_eof: Bool,
) -> ByteArray {
  let mut result_bytes = ByteArray.new
  let mut i = 0

  while i < end {
    match input.get(i) {
      case Ok(byte) -> {
        if byte == 95 and underscore_is_space {
          result_bytes.push(ASCII_SPACE)
          i = i + 1
        } else if byte == ASCII_EQUALS {
          # A soft line break is "=" plus a line break and only needs one
          # byte of lookahead, so handle it before the two-byte escape forms.
          if i + 1 < end {
            match input.get(i + 1) {
              case Ok(next1) -> {
                if next1 == ASCII_LF {
                  i = i + 2
                } else if next1 == ASCII_CR {
                  if i + 2 < end {
                    match input.get(i + 2) {
                      case Ok(next2) -> {
                        if next2 == ASCII_LF {
                          i = i + 3
                        } else {
                          push_malformed_qp_equals(
                            mut result_bytes,
                            preserve_equals_on_error,
                          )
                          i = i + 1
                        }
                      }
                      case Error(_) -> {
                        push_malformed_qp_equals(
                          mut result_bytes,
                          preserve_equals_on_error,
                        )
                        i = i + 1
                      }
                    }
                  } else {
                    push_malformed_qp_equals(
                      mut result_bytes,
                      preserve_equals_on_error,
                    )
                    i = i + 1
                  }
                } else if next1 == ASCII_EQUALS {
                  # "==" is not valid QP, but it is common in the wild as an
                  # escaped literal '='. Treat the pair as one '='.
                  result_bytes.push(ASCII_EQUALS)
                  i = i + 2
                } else if i + 2 < end {
                  match input.get(i + 2) {
                    case Ok(hex2) -> {
                      let hex_str = two_bytes_to_hex_string(next1, hex2)

                      match parse_hex_byte(hex_str) {
                        case Some(decoded_byte) -> {
                          result_bytes.push(decoded_byte)
                          i = i + 3
                        }
                        case None -> {
                          push_malformed_qp_equals(
                            mut result_bytes,
                            preserve_equals_on_error,
                          )
                          i = i + 1
                        }
                      }
                    }
                    case Error(_) -> {
                      push_malformed_qp_equals(
                        mut result_bytes,
                        preserve_equals_on_error,
                      )
                      i = i + 1
                    }
                  }
                } else {
                  push_malformed_qp_equals(
                    mut result_bytes,
                    preserve_equals_on_error,
                  )
                  i = i + 1
                }
              }
              case Error(_) -> {
                push_malformed_qp_equals(
                  mut result_bytes,
                  preserve_equals_on_error,
                )
                i = i + 1
              }
            }
          } else {
            push_malformed_qp_equals(mut result_bytes, preserve_equals_on_error)
            i = i + 1
          }
        } else if byte == ASCII_SPACE or byte == ASCII_HT {
          # RFC 2045 section 6.7 rule 3: trailing white space on an encoded
          # line is deleted. Hold the run until we can see whether a line
          # break follows it.
          let mut run_end = i

          while run_end < end {
            match input.get(run_end) {
              case Ok(b) -> {
                if b == ASCII_SPACE or b == ASCII_HT {
                  run_end = run_end + 1
                } else {
                  break
                }
              }
              case Error(_) -> break
            }
          }

          let mut drop_run = false

          if run_end >= end {
            # At a chunk boundary the line break may still arrive, so only
            # treat the end of the range as end of line at EOF.
            drop_run = at_eof
          } else {
            match input.get(run_end) {
              case Ok(after) -> {
                if after == ASCII_LF {
                  drop_run = true
                } else if after == ASCII_CR and run_end + 1 < end {
                  match input.get(run_end + 1) {
                    case Ok(after_cr) -> {
                      if after_cr == ASCII_LF { drop_run = true }
                    }
                    case Error(_) -> {}
                  }
                }
              }
              case Error(_) -> {}
            }
          }

          if !drop_run {
            let mut k = i

            while k < run_end {
              match input.get(k) {
                case Ok(b) -> result_bytes.push(b)
                case Error(_) -> {}
              }

              k = k + 1
            }
          }

          i = run_end
        } else {
          result_bytes.push(byte)
          i = i + 1
        }
      }
      case Error(_) -> {
        # Push Unicode replacement character U+FFFD (UTF-8: 239, 191, 189)
        for byte in UNICODE_REPLACEMENT_CHAR_UTF8.iter {
          result_bytes.push(byte)
        }

        i = i + 1
      }
    }
  }

  result_bytes
}

# Emit the replacement for an invalid '=' escape
fn push_malformed_qp_equals(
  result_bytes: mut ByteArray,
  preserve_equals_on_error: Bool,
) {
  if preserve_equals_on_error {
    result_bytes.push(ASCII_EQUALS)
  } else {
    for byte in UNICODE_REPLACEMENT_CHAR_UTF8.iter { result_bytes.push(byte) }
  }
}

fn decode_quoted_printable_bytes_impl(raw: String) -> ByteArray {
  decode_qp_bytes(
    raw,
    underscore_is_space: false,
    preserve_equals_on_error: true,
  )
}

fn pub decode_quoted_printable(raw: String) -> String {
  decode_quoted_printable_bytes_impl(raw).into_string
}

fn pub decode_rfc2047_word(word: String) -> String {
  if word.starts_with?('=?') == false or word.ends_with?('?=') == false {
    return word
  }

  # "=?=" satisfies both delimiters but has no content; slicing it would panic.
  if word.size < 5 { return word }

  # `size` is byte-based, so slice by bytes here: `substring` counts characters
  # and would overshoot when the payload contains raw non-ASCII bytes.
  let content = word.slice(2, word.size - 2).to_string

  let parts = content.split('?').map(fn (s) { s.to_string }).to_array

  if parts.size < 3 { return word }

  let charset = match parts.get(0) {
    case Ok(c) -> c
    case Error(_) -> return word
  }

  let encoding = match parts.get(1) {
    case Ok(e) -> e.to_upper
    case Error(_) -> return word
  }

  # RFC 2047 section 4: encoding must be 'B' or 'Q'
  if encoding != 'B' and encoding != 'Q' { return word }

  if charset.empty? { return word }

  let mut encoded_text = ByteArray.new
  let mut i = 2

  while i < parts.size {
    match parts.get(i) {
      case Ok(part) -> {
        if i > 2 { encoded_text.push(ASCII_QUESTION) }

        encoded_text.append(part.to_byte_array)
        i = i + 1
      }
      case Error(_) -> break
    }
  }

  let encoded_text = encoded_text.into_string

  match encoding {
    case 'B' -> {
      # Real-world encoded words occasionally contain whitespace (for example
      # when a producer wrapped the payload). Strip it before decoding; the
      # standard base64 decoder rejects such input outright.
      let filtered = ByteArray.new
      let encoded_bytes = encoded_text.to_byte_array
      let mut f = 0

      while f < encoded_bytes.size {
        match encoded_bytes.get(f) {
          case Ok(byte) -> {
            if
              byte != ASCII_SPACE
                and byte != ASCII_HT
                and byte != ASCII_CR
                and byte != ASCII_LF
            {
              filtered.push(byte)
            }

            f = f + 1
          }
          case Error(_) -> f = f + 1
        }
      }

      # Encoded words are frequently unpadded, and padded ones are common too.
      # Strip up to two '=' and decode in unpadded mode, like
      # decode_base64_body does, so both forms work.
      let mut data = filtered.into_string
      let mut stripped = 0

      while stripped < 2 and data.size > 0 {
        match data.get(data.size - 1) {
          case Ok(byte) -> {
            if byte == ASCII_EQUALS {
              data = data.slice(0, data.size - 1).to_string
              stripped = stripped + 1
            } else {
              break
            }
          }
          case Error(_) -> break
        }
      }

      # A one-character tail can't decode to a whole byte
      if data.size % 4 == 1 { return word }

      let mut decoder = Decoder.new

      decoder.padding = false

      let output = ByteArray.new

      match decoder.decode(data.to_byte_array, output) {
        case Ok(_) -> decode_charset(output, charset)
        case Error(_) -> word
      }
    }
    case 'Q' -> {
      decode_charset(
        decode_rfc2047_quoted_printable_bytes(encoded_text),
        charset,
      )
    }
    case _ -> word
  }
}

# Find the exclusive end of an RFC 2047 encoded word
#
# The end is the index just past the terminating "?=". Searching for "?="
# directly is wrong when the encoded text itself starts with '=' (a Q
# encoding hex escape): the '?' before the encoded text plus that '=' looks
# like a terminator. Skip both delimiter '?' characters first.
fn pub find_rfc2047_word_end(raw: String, begin: Int) -> Option[Int] {
  match raw.index_of('?', begin + 2) {
    case Some(charset_end) -> {
      match raw.index_of('?', charset_end + 1) {
        case Some(encoding_end) -> {
          match raw.index_of('?=', encoding_end + 1) {
            case Some(end) -> Option.Some(end + 2)
            case None -> Option.None
          }
        }
        case None -> Option.None
      }
    }
    case None -> Option.None
  }
}

# Decode a header value by processing RFC 2047 encoded words
#
# RFC 2047 section 6: Encoded-Word Syntax
#
# Headers can contain encoded words for non-ASCII text:
# =?charset?encoding?encoded-text?=
#
# Multiple encoded words can appear in a single header value:
# "=?utf-8?B?SGVsbG8=?= =?utf-8?B?V29ybGQ=?="
#
# Algorithm:
# 1. Scan input for "=?" sequence (encoded word start)
# 2. Find matching "?=" sequence (encoded word end)
# 3. Decode the encoded word using decode_rfc2047_word
# 4. Replace encoded word with decoded text
# 5. Continue from after the decoded text
# 6. Repeat until no more encoded words found
#
# Edge cases handled:
# - No encoded words -> return original string
# - Malformed encoded words -> left as-is (not decoded)
# - Multiple encodings in same header -> handled by sequential processing
# - Partial encoded words -> left as-is
# - Maximum iterations limit to prevent infinite loops
#
# Performance considerations:
# - Uses ByteArray for O(n) performance instead of O(n^2) string concatenation
# - Iteration limit prevents DoS from pathological inputs
fn pub decode_header_value_impl(raw: String) -> String {
  # RFC 2047 encoded-word decoding: =?charset?encoding?encoded-text?=
  let mut result = ByteArray.new
  let mut pos = 0
  let mut iterations = 0
  let max_iterations = MAX_HEADER_ITERATIONS
  let mut previous_encoded = false

  # Find all encoded words
  while pos < raw.size {
    iterations = iterations + 1

    if iterations > max_iterations { break }

    match raw.index_of('=?', pos) {
      case Some(begin) -> {
        match find_rfc2047_word_end(raw, begin) {
          case Some(end) -> {
            # Push text before the encoded word
            if begin > pos {
              let before = raw.slice(pos, begin).to_string

              # RFC 2047 section 6.2: whitespace between two adjacent
              # encoded words is ignored.
              if !(previous_encoded and before.trim.empty?) {
                result.append(before.to_byte_array)
              }
            }

            # Decode and push the encoded word
            let encoded_word = raw.slice(begin, end).to_string
            let decoded = decode_rfc2047_word(encoded_word)

            if decoded == encoded_word {
              # Not a valid encoded word. Emit the "=?" literally and keep
              # scanning, so a bogus marker cannot hide later valid words.
              result.append(raw.slice(begin, begin + 2).to_string.to_byte_array)

              pos = begin + 2
              previous_encoded = false
            } else {
              result.append(decoded.to_byte_array)

              # Move position past the encoded word
              pos = end
              previous_encoded = true
            }
          }
          case None -> {
            # A stray "=?" must not stop the scan: emit it literally and
            # resume searching after it for a well-formed encoded word.
            let resume = begin + 2

            if resume > pos {
              result.append(raw.slice(pos, resume).to_string.to_byte_array)
            }

            pos = resume
            previous_encoded = false
          }
        }
      }
      case None -> break
    }
  }

  # Push any remaining text after the last encoded word
  if pos < raw.size {
    let remaining = raw.slice(pos, raw.size).to_string
    let remaining_bytes = remaining.to_byte_array

    result.append(remaining_bytes)
  }

  result.into_string
}

fn pub decode_rfc2047_quoted_printable(text: String) -> String {
  decode_rfc2047_quoted_printable_bytes(text).into_string
}

fn decode_rfc2047_quoted_printable_bytes(text: String) -> ByteArray {
  decode_qp_bytes(
    text,
    underscore_is_space: true,
    preserve_equals_on_error: false,
  )
}

# Decode bytes in the declared charset to a UTF-8 String
#
# Supports US-ASCII/UTF-8 (with BOM stripping and replacement on invalid
# sequences), UTF-16/UTF-16LE/UTF-16BE (BOM aware), ISO-8859-1 (Latin-1) and
# Windows-1252. Unsupported labels are decoded as UTF-8 with replacement
# characters instead of constructing potentially invalid Strings.
fn pub decode_charset(bytes: ByteArray, charset: String) -> String {
  let lower = charset.to_lower
  let is_cp1252 = lower == 'windows-1252' or lower == 'cp1252'
  let is_latin1 = lower == 'iso-8859-1'
    or lower == 'iso8859-1'
    or lower == 'latin1'
    or lower == 'latin-1'
  let is_utf16le = lower == 'utf-16le'
    or lower == 'utf16le'
    or lower == 'utf-16-le'
  let is_utf16be = lower == 'utf-16be'
    or lower == 'utf16be'
    or lower == 'utf-16-be'
  let mut is_utf16 = lower == 'utf-16'
    or lower == 'utf16'
    or is_utf16le
    or is_utf16be
  let mut little_endian = is_utf16le
  let mut start = 0

  # BOMs take precedence over the label
  if
    bytes.size >= 3
      and byte_at(ref bytes, 0) == 0xEF
      and byte_at(ref bytes, 1) == 0xBB
      and byte_at(ref bytes, 2) == 0xBF
  {
    start = 3
  } else if
    bytes.size >= 2
      and byte_at(ref bytes, 0) == 0xFF
      and byte_at(ref bytes, 1) == 0xFE
  {
    start = 2
    is_utf16 = true
    little_endian = true
  } else if
    bytes.size >= 2
      and byte_at(ref bytes, 0) == 0xFE
      and byte_at(ref bytes, 1) == 0xFF
  {
    start = 2
    is_utf16 = true
    little_endian = false
  }

  if is_utf16 { return decode_utf16(ref bytes, start, little_endian) }

  if !is_cp1252 and !is_latin1 { return decode_utf8_lossy(ref bytes, start) }

  let out = ByteArray.new
  let mut i = start

  while i < bytes.size {
    match bytes.get(i) {
      case Ok(byte) -> {
        let cp = if is_cp1252 { cp1252_codepoint(byte) } else { byte }

        append_codepoint(out, cp)

        i = i + 1
      }
      case Error(_) -> i = i + 1
    }
  }

  out.into_string
}

fn byte_at(bytes: ref ByteArray, index: Int) -> Int {
  match bytes.get(index) {
    case Ok(byte) -> byte
    case Error(_) -> -1
  }
}

fn append_codepoint(out: mut ByteArray, cp: Int) {
  if cp < 0x80 {
    out.push(cp)
  } else if cp < 0x800 {
    out.push((cp >> 6) | 0xC0)
    out.push((cp & 0x3F) | 0x80)
  } else if cp < 0x10000 {
    out.push((cp >> 12) | 0xE0)
    out.push(((cp >> 6) & 0x3F) | 0x80)
    out.push((cp & 0x3F) | 0x80)
  } else {
    out.push((cp >> 18) | 0xF0)
    out.push(((cp >> 12) & 0x3F) | 0x80)
    out.push(((cp >> 6) & 0x3F) | 0x80)
    out.push((cp & 0x3F) | 0x80)
  }
}

fn append_replacement(out: mut ByteArray) {
  for byte in UNICODE_REPLACEMENT_CHAR_UTF8.iter { out.push(byte) }
}

# Decode UTF-8, replacing invalid bytes instead of producing invalid Strings
fn decode_utf8_lossy(bytes: ref ByteArray, start: Int) -> String {
  let out = ByteArray.new
  let mut i = start

  while i < bytes.size {
    let b0 = byte_at(ref bytes, i)
    let len = if b0 < 0x80 {
      1
    } else if b0 >= 0xC2 and b0 <= 0xDF {
      2
    } else if b0 >= 0xE0 and b0 <= 0xEF {
      3
    } else if b0 >= 0xF0 and b0 <= 0xF4 {
      4
    } else {
      0
    }

    let mut valid = len > 0 and i + len <= bytes.size

    if valid and len > 1 {
      let mut j = 1

      while j < len {
        let b = byte_at(ref bytes, i + j)

        if b < 0x80 or b > 0xBF { valid = false }

        j = j + 1
      }
    }

    if valid {
      let mut j = 0

      while j < len {
        out.push(byte_at(ref bytes, i + j))
        j = j + 1
      }

      i = i + len
    } else {
      append_replacement(out)
      i = i + 1
    }
  }

  out.into_string
}

# Decode UTF-16 (little or big endian) including surrogate pairs
fn decode_utf16(bytes: ref ByteArray, start: Int, little_endian: Bool) -> String
{
  let out = ByteArray.new
  let mut i = start

  while i + 1 < bytes.size {
    let b0 = byte_at(ref bytes, i)
    let b1 = byte_at(ref bytes, i + 1)
    let unit = if little_endian { b0 | (b1 << 8) } else { (b0 << 8) | b1 }

    i = i + 2

    if unit >= 0xD800 and unit <= 0xDBFF {
      if i + 1 < bytes.size {
        let c0 = byte_at(ref bytes, i)
        let c1 = byte_at(ref bytes, i + 1)
        let low = if little_endian { c0 | (c1 << 8) } else { (c0 << 8) | c1 }

        if low >= 0xDC00 and low <= 0xDFFF {
          let cp = 0x10000 + ((unit - 0xD800) << 10) + (low - 0xDC00)

          append_codepoint(out, cp)
          i = i + 2
        } else {
          append_replacement(out)
        }
      } else {
        append_replacement(out)
      }
    } else if unit >= 0xDC00 and unit <= 0xDFFF {
      append_replacement(out)
    } else {
      append_codepoint(out, unit)
    }
  }

  if i < bytes.size { append_replacement(out) }

  out.into_string
}

# Map a Windows-1252 byte to its Unicode code point
fn cp1252_codepoint(byte: Int) -> Int {
  match byte {
    case 0x80 -> 0x20AC
    case 0x82 -> 0x201A
    case 0x83 -> 0x0192
    case 0x84 -> 0x201E
    case 0x85 -> 0x2026
    case 0x86 -> 0x2020
    case 0x87 -> 0x2021
    case 0x88 -> 0x02C6
    case 0x89 -> 0x2030
    case 0x8A -> 0x0160
    case 0x8B -> 0x2039
    case 0x8C -> 0x0152
    case 0x8E -> 0x017D
    case 0x91 -> 0x2018
    case 0x92 -> 0x2019
    case 0x93 -> 0x201C
    case 0x94 -> 0x201D
    case 0x95 -> 0x2022
    case 0x96 -> 0x2013
    case 0x97 -> 0x2014
    case 0x98 -> 0x02DC
    case 0x99 -> 0x2122
    case 0x9A -> 0x0161
    case 0x9B -> 0x203A
    case 0x9C -> 0x0153
    case 0x9E -> 0x017E
    case 0x9F -> 0x0178
    case 0x81 -> 0xFFFD
    case 0x8D -> 0xFFFD
    case 0x8F -> 0xFFFD
    case 0x90 -> 0xFFFD
    case 0x9D -> 0xFFFD
    case _ -> byte
  }
}
