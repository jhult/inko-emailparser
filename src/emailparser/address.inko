# ==============================================================================
# Email Address Parsing Module
# ==============================================================================
#
# This module provides parsing and manipulation of email addresses as specified
# in RFC 5322 section 3.4. It handles the full complexity of email address
# syntax including display names, comments, quoted strings, and angle brackets.
#
# ## Purpose
#
# Email addresses in headers can appear in various formats:
# - Simple: `user@example.com`
# - With display name: `John Doe <john@example.com>`
# - Quoted: `"John Doe" <john@example.com>`
# - With comments: `john@example.com (Work)`
# - Multiple addresses: `a@example.com, b@example.com`
#
# This module provides:
# - Parsing of single and multiple email addresses
# - Extraction of display names and email addresses
# - Comment removal from address strings
# - String unquoting and validation
#
# ## Architecture
#
# The module provides:
#
# ### Types
# - `EmailAddress`: Represents a parsed email address with name, address, and raw
#
# ### Public Functions
# - `remove_comments`: Remove RFC 5322 comments from address strings
# - `unquote_string`: Remove surrounding double quotes from strings
# - `extract_display_name`: Extract display name from address string
# - `is_valid_email_format`: Validate basic email format
# - `parse_comma_separated_addresses`: Parse multiple addresses
#
# ### Private Functions
# - `parse_address_list_impl`: Core parsing logic (used by main parser)
# - `AddressScanner`: Shared state machine behind comment removal, top-level
#   separator detection and list splitting
#
# ## RFC Compliance
#
# - RFC 5322 section 3.4: Address Specification
#   - 3.4.1: Addr-Spec Specification
#   - 3.4.2: Angle Bracket and Comment Syntax
#
import emailparser.ascii (
  ASCII_AT, ASCII_BACKSLASH, ASCII_COLON, ASCII_COMMA, ASCII_CR, ASCII_DOT,
  ASCII_DQUOTE, ASCII_GREATER_THAN, ASCII_HYPHEN, ASCII_LEFT_BRACKET,
  ASCII_LESS_THAN, ASCII_LF, ASCII_LPAREN, ASCII_RIGHT_BRACKET, ASCII_RPAREN,
  ASCII_SEMICOLON, ASCII_SPACE, UNICODE_REPLACEMENT_CHAR_UTF8, is_alnum,
  is_email_local_special,
)
import emailparser.limits (
  MAX_DOMAIN_SIZE, MAX_EMAIL_ADDRESS_SIZE, MAX_LOCAL_PART_SIZE,
)
import emailparser.validation (is_quoted_string, is_valid_domain)
import std.bytes (ByteArray)
import std.option (Option)

# A byte classified by `AddressScanner`
type inline enum AddressStep {
  # A literal byte: quoted text, angle brackets or plain text
  case Content(Int)

  # A byte escaped by a backslash in a quoted string. The caller skips both
  # the backslash and this byte.
  case Escaped(Int)

  # A comma outside quotes, comments and angle brackets
  case Separator

  # A byte inside a comment, including the parentheses delimiting it
  case Comment

  # A byte that isn't valid UTF-8
  case Invalid
}

# Shared state machine for scanning RFC 5322 address text
#
# Comment removal, top-level separator detection and list splitting all need
# to know whether a byte is quoted, inside a nested comment or inside angle
# brackets. This type tracks that state so all three scanners agree on the
# transitions.
type AddressScanner {
  let mut @in_quote: Bool
  let mut @paren_depth: Int
  let mut @angle_depth: Int
  let mut @bracket_depth: Int
}

impl AddressScanner {
  fn static new -> AddressScanner {
    AddressScanner(
      in_quote: false,
      paren_depth: 0,
      angle_depth: 0,
      bracket_depth: 0,
    )
  }

  # Classify the byte at `pos` and advance the state
  #
  # A backslash inside a quoted string escapes the following byte, which is
  # reported with `Escaped` so the caller can skip both bytes.
  fn mut next(input: String, pos: Int) -> AddressStep {
    match input.get(pos) {
      case Ok(byte) -> {
        if byte == ASCII_BACKSLASH and @in_quote and (pos + 1) < input.size {
          match input.get(pos + 1) {
            case Ok(escaped) -> AddressStep.Escaped(escaped)
            case Error(_) -> AddressStep.Content(byte)
          }
        } else if byte == ASCII_DQUOTE and @paren_depth == 0 {
          @in_quote = !@in_quote
          AddressStep.Content(byte)
        } else if byte == ASCII_LPAREN and @in_quote == false {
          @paren_depth = @paren_depth + 1
          AddressStep.Comment
        } else if byte == ASCII_RPAREN and @in_quote == false {
          if @paren_depth > 0 { @paren_depth = @paren_depth - 1 }

          AddressStep.Comment
        } else if
          byte == ASCII_LESS_THAN and @in_quote == false and @paren_depth == 0
        {
          @angle_depth = @angle_depth + 1
          AddressStep.Content(byte)
        } else if
          byte == ASCII_GREATER_THAN
            and @in_quote == false
            and @paren_depth == 0
        {
          if @angle_depth > 0 { @angle_depth = @angle_depth - 1 }

          AddressStep.Content(byte)
        } else if
          byte == ASCII_LEFT_BRACKET
            and @in_quote == false
            and @paren_depth == 0
        {
          @bracket_depth = @bracket_depth + 1
          AddressStep.Content(byte)
        } else if
          byte == ASCII_RIGHT_BRACKET
            and @in_quote == false
            and @paren_depth == 0
        {
          if @bracket_depth > 0 { @bracket_depth = @bracket_depth - 1 }

          AddressStep.Content(byte)
        } else if @paren_depth > 0 {
          AddressStep.Comment
        } else if
          byte == ASCII_COMMA
            and @in_quote == false
            and @angle_depth == 0
            and @bracket_depth == 0
        {
          AddressStep.Separator
        } else {
          AddressStep.Content(byte)
        }
      }
      case Error(_) -> AddressStep.Invalid
    }
  }

  # Whether the scanner is outside quotes, comments, angle brackets and
  # domain literals (`[192.0.2.1]`, `[IPv6:::1]`)
  fn top_level? -> Bool {
    @in_quote == false
      and @paren_depth == 0
      and @angle_depth == 0
      and @bracket_depth == 0
  }

  # Whether the scanner is outside quotes and comments
  fn unquoted? -> Bool {
    @in_quote == false and @paren_depth == 0
  }
}

type pub EmailAddress {
  let pub @name: Option[String]
  let pub @address: String
  let pub @raw: String
}

fn pub remove_comments(input: String) -> String {
  let result = ByteArray.new
  let mut scanner = AddressScanner.new
  let mut i = 0

  while i < input.size {
    match scanner.next(input, i) {
      case Escaped(escaped) -> {
        result.push(ASCII_BACKSLASH)
        result.push(escaped)
        i = i + 2
      }
      case Content(byte) -> {
        result.push(byte)
        i = i + 1
      }
      case Separator -> {
        result.push(ASCII_COMMA)
        i = i + 1
      }
      case Comment -> i = i + 1
      case Invalid -> {
        # Push Unicode replacement character U+FFFD (UTF-8: 239, 191, 189)
        for byte in UNICODE_REPLACEMENT_CHAR_UTF8.iter { result.push(byte) }

        i = i + 1
      }
    }
  }

  result.into_string
}

fn pub unquote_string(input: String) -> String {
  if !is_quoted_string(input) { return input }

  let inner = input.slice(1, input.size - 1).to_string
  let result = ByteArray.new
  let mut i = 0

  while i < inner.size {
    match inner.get(i) {
      case Ok(byte) -> {
        if byte == 92 and i + 1 < inner.size {
          i = i + 1

          match inner.get(i) {
            case Ok(escaped) -> result.push(escaped)
            case Error(_) -> {
              # Push Unicode replacement character U+FFFD (UTF-8: 239, 191, 189)
              for byte in UNICODE_REPLACEMENT_CHAR_UTF8.iter {
                result.push(byte)
              }
            }
          }
        } else {
          result.push(byte)
        }

        i = i + 1
      }
      case Error(_) -> {
        # Push Unicode replacement character U+FFFD (UTF-8: 239, 191, 189)
        for byte in UNICODE_REPLACEMENT_CHAR_UTF8.iter { result.push(byte) }

        i = i + 1
      }
    }
  }

  result.into_string
}

fn pub extract_display_name(input: String) -> (Option[String], String) {
  let trimmed = input.trim

  # A quoted display name may contain '<' (e.g. `"A <b> C" <a@b.com>`), so the
  # bracket that starts the address is the first *top-level* one.
  match find_top_level_byte(trimmed.clone, ASCII_LESS_THAN, 0) {
    case Some(lt_pos) -> {
      if lt_pos > 0 {
        let name_part = trimmed.slice(0, lt_pos).to_string.trim
        let name = if is_quoted_string(name_part) {
          unquote_string(name_part)
        } else {
          name_part
        }

        (Option.Some(name), trimmed)
      } else {
        (Option.None, trimmed)
      }
    }
    case None -> (Option.None, trimmed)
  }
}

# Find the '@' separating the local part from the domain
#
# A quoted local part may itself contain '@' (`"a@b"@example.com`), so the
# separator is the first '@' outside a quoted string, comment or angle bracket
# pair.
fn find_at_separator(email: String) -> Option[Int] {
  let mut scanner = AddressScanner.new
  let mut i = 0

  while i < email.size {
    if scanner.top_level? {
      match email.get(i) {
        case Ok(byte) -> if byte == ASCII_AT { return Option.Some(i) }
        case Error(_) -> {}
      }
    }

    match scanner.next(email, i) {
      case Escaped(_) -> i = i + 2
      case _ -> i = i + 1
    }
  }

  Option.None
}

# Validate the form of an email address (RFC 5321/5322)
#
# Accepts dot-atom local parts, quoted-string local parts ("a b"@example.com)
# and address literals (a@[192.168.0.1]). Lengths follow RFC 5321: 64 octets
# for the local part, 255 for the domain and 254 for the whole address.
# Domains are validated by `is_valid_domain`, which `message_id` shares.
fn pub is_valid_email_format(email: String) -> Bool {
  if email.empty? or email.size > MAX_EMAIL_ADDRESS_SIZE { return false }

  let at_pos = match find_at_separator(email) {
    case Some(pos) -> pos
    case None -> return false
  }

  let last_pos = email.size - 1

  if (at_pos == 0) or (at_pos == last_pos) { return false }

  if email.index_of('@', at_pos + 1).some? { return false }

  let local_part = email.slice(0, at_pos).to_string

  if local_part.empty? or local_part.size > MAX_LOCAL_PART_SIZE { return false }

  if is_quoted_string(local_part) {
    if !is_valid_quoted_local_part(local_part) { return false }
  } else {
    # dot-atom-text: no leading/trailing/consecutive dots (RFC 5322 3.2.3)
    if
      local_part.starts_with?('.')
        or local_part.ends_with?('.')
        or local_part.contains?('..')
    {
      return false
    }

    let mut local_valid = false
    let mut i = 0

    while i < local_part.size {
      match local_part.get(i) {
        case Ok(byte) -> {
          if !(is_alnum(byte) or is_email_local_special(byte)) { return false }

          local_valid = true
          i = i + 1
        }
        case Error(_) -> return false
      }
    }

    if !local_valid { return false }
  }

  let domain = email.slice(at_pos + 1, email.size).to_string

  if domain.empty? { return false }

  if is_valid_domain(domain) { return true }

  is_valid_address_literal(domain)
}

# Validate the content of a quoted-string local part (without the quotes)
fn is_valid_quoted_local_part(local: String) -> Bool {
  let inner = local.slice(1, local.size - 1).to_string
  let mut i = 0

  while i < inner.size {
    match inner.get(i) {
      case Ok(byte) -> {
        if byte == ASCII_BACKSLASH {
          # An escape must have a character to escape
          if i + 1 >= inner.size { return false }

          i = i + 2
        } else {
          # qtextSMTP: printable ASCII, space and non-ASCII; no bare quote
          if
            byte == ASCII_DQUOTE
              or byte == ASCII_CR
              or byte == ASCII_LF
              or byte < ASCII_SPACE
              or byte == 127
          {
            return false
          }

          i = i + 1
        }
      }
      case Error(_) -> return false
    }
  }

  true
}

# Validate an address literal domain such as "[192.168.0.1]" or "[IPv6:::1]"
fn is_valid_address_literal(domain: String) -> Bool {
  if domain.size < 3 { return false }

  if !domain.starts_with?('[') or !domain.ends_with?(']') { return false }

  let inner = domain.slice(1, domain.size - 1).to_string

  if inner.empty? or inner.size > MAX_DOMAIN_SIZE { return false }

  let mut has_colon = false
  let mut i = 0

  while i < inner.size {
    match inner.get(i) {
      case Ok(byte) -> {
        if
          byte == ASCII_DOT
            or is_alnum(byte)
            or byte == ASCII_COLON
            or byte == ASCII_HYPHEN
        {
          if byte == ASCII_COLON { has_colon = true }
        } else {
          return false
        }

        i = i + 1
      }
      case Error(_) -> return false
    }
  }

  # IPv6 (and IPv6: prefixed) literals carry colons; otherwise require a
  # dotted-quad IPv4 address.
  if has_colon { return true }

  is_valid_dotted_quad(inner)
}

# Validate an IPv4 dotted-quad without leading-zero octets
fn is_valid_dotted_quad(inner: String) -> Bool {
  let mut octets = 0
  let mut value = 0
  let mut digits = 0
  let mut i = 0

  while i < inner.size {
    match inner.get(i) {
      case Ok(byte) -> {
        if byte == ASCII_DOT {
          if digits == 0 { return false }

          octets = octets + 1
          value = 0
          digits = 0

          if octets > 3 { return false }
        } else if byte >= 48 and byte <= 57 {
          if digits == 0 and byte == 48 and i + 1 < inner.size {
            match inner.get(i + 1) {
              case Ok(following) -> if following != ASCII_DOT { return false }
              case Error(_) -> {}
            }
          }

          value = (value * 10) + (byte - 48)
          digits = digits + 1

          if digits > 3 or value > 255 { return false }
        } else {
          return false
        }

        i = i + 1
      }
      case Error(_) -> return false
    }
  }

  octets == 3 and digits > 0
}

fn byte_array_to_string(bytes: Array[Int]) -> String {
  let ba = ByteArray.new

  for b in bytes.iter { ba.push(b) }

  ba.into_string
}

# Find the content of the first top-level angle bracket pair
#
# Display names may legally contain '<' and '>' when quoted, so the brackets
# are located with the scanner instead of a plain `index_of`.
fn find_angle_bracket_content(input: String) -> Option[String] {
  let mut scanner = AddressScanner.new
  let mut start = 0 - 1
  let mut i = 0

  while i < input.size {
    if scanner.unquoted? {
      match input.get(i) {
        case Ok(byte) -> {
          if byte == ASCII_LESS_THAN and scanner.top_level? {
            if start < 0 { start = i + 1 }
          } else if byte == ASCII_GREATER_THAN and !scanner.top_level? {
            if start >= 0 {
              return Option.Some(input.slice(start, i).to_string.trim)
            }
          }
        }
        case Error(_) -> {}
      }
    }

    match scanner.next(input, i) {
      case Escaped(_) -> i = i + 2
      case _ -> i = i + 1
    }
  }

  Option.None
}

fn extract_angle_bracket_content(input: String) -> String {
  match find_angle_bracket_content(input) {
    case Some(content) -> content
    case None -> input.trim
  }
}

fn extract_addr_spec(input: String) -> Option[String] {
  let candidate = extract_angle_bracket_content(input)

  # If empty, try the whole input
  let final_candidate = if candidate.empty? { input.trim } else { candidate }

  # Store the address even if invalid for detection purposes
  # Validation happens separately in strict mode
  if final_candidate.empty? {
    Option.None
  } else {
    Option.Some(final_candidate)
  }
}

# Find the first occurrence of `byte` at or after `from` that is outside
# quotes, comments and angle brackets
fn find_top_level_byte(input: String, byte: Int, from: Int) -> Option[Int] {
  let mut scanner = AddressScanner.new
  let mut i = 0

  while i < input.size {
    if i >= from and scanner.top_level? {
      match input.get(i) {
        case Ok(current) -> if current == byte { return Option.Some(i) }
        case Error(_) -> {}
      }
    }

    match scanner.next(input, i) {
      case Escaped(_) -> i = i + 2
      case _ -> i = i + 1
    }
  }

  Option.None
}

fn parse_single_address(input: String) -> Option[EmailAddress] {
  let cleaned = remove_comments(input)
  let (name_opt, remaining) = extract_display_name(cleaned)

  match extract_addr_spec(remaining) {
    case Some(addr) -> {
      Option.Some(EmailAddress(name: name_opt, address: addr, raw: input))
    }
    case None -> Option.None
  }
}

# Parse and append one list entry, ignoring empty or unparsable entries
fn append_parsed_address(result: mut Array[EmailAddress], bytes: Array[Int]) {
  let addr_str = byte_array_to_string(bytes).trim

  if addr_str.empty? { return }

  match parse_single_address(addr_str) {
    case Some(addr) -> result.push(addr)
    case None -> {}
  }
}

fn pub parse_comma_separated_addresses(input: String) -> Array[EmailAddress] {
  # RFC 5322 group addresses use syntax: group-name: mailbox-list;
  # We don't support parsing groups, so return empty if detected
  # Only treat as group if colon is outside quotes/parens/angle brackets
  match find_top_level_byte(input, ASCII_COLON, 0) {
    case Some(_) -> return []
    case None -> {}
  }

  let mut result = []
  let mut current = [] as Array[Int]
  let mut scanner = AddressScanner.new
  let mut i = 0

  while i < input.size {
    match scanner.next(input, i) {
      case Escaped(escaped) -> {
        current.push(ASCII_BACKSLASH)
        current.push(escaped)
        i = i + 2
      }
      case Content(byte) -> {
        current.push(byte)
        i = i + 1
      }
      case Separator -> {
        append_parsed_address(mut result, current)
        current = [] as Array[Int]
        i = i + 1
      }
      case Comment -> i = i + 1
      case Invalid -> i = i + 1
    }
  }

  append_parsed_address(mut result, current)

  result
}

# Find the last occurrence of `byte` before `before` that is outside quotes,
# comments, angle brackets and domain literals
fn find_last_top_level_byte_before(
  input: String,
  byte: Int,
  before: Int,
) -> Option[Int] {
  let mut scanner = AddressScanner.new
  let limit = if before < input.size { before } else { input.size }
  let mut last = 0 - 1
  let mut i = 0

  while i < limit {
    if scanner.top_level? {
      match input.get(i) {
        case Ok(current) -> if current == byte { last = i }
        case Error(_) -> {}
      }
    }

    match scanner.next(input, i) {
      case Escaped(_) -> i = i + 2
      case _ -> i = i + 1
    }
  }

  if last >= 0 { Option.Some(last) } else { Option.None }
}

# Core parsing logic for address lists
#
# A colon only starts a group when a matching semicolon follows it. Without a
# semicolon the colon is ordinary address text (for example in an unquoted
# display name), so the whole list is parsed as mailboxes. Anything before a
# group is its own comma-separated entry list; its last entry is the group
# display name and is discarded.
fn parse_address_list_impl(
  raw: ref Option[String],
  decoded: String,
) -> Array[EmailAddress] {
  match raw {
    case Some(_) -> {
      let mut result = []
      let mut rest = decoded.trim

      while !rest.empty? {
        match find_top_level_byte(rest, ASCII_COLON, 0) {
          case Some(colon) -> {
            let content_start = colon + 1
            let semi = find_top_level_byte(rest, ASCII_SEMICOLON, content_start)

            match semi {
              case Some(pos) -> {
                # Addresses listed before the group name are separate
                # mailboxes. The group name itself is the final entry.
                match
                  find_last_top_level_byte_before(rest, ASCII_COMMA, colon)
                {
                  case Some(comma) -> {
                    let before = rest.slice(0, comma).to_string

                    for
                      addr
                    in
                      parse_comma_separated_addresses(before).into_iter
                    {
                      result.push(addr)
                    }
                  }
                  case None -> {}
                }

                let content = rest.slice(content_start, pos).to_string

                for addr in parse_comma_separated_addresses(content).into_iter {
                  result.push(addr)
                }

                rest = rest.slice(pos + 1, rest.size).to_string.trim
              }
              case None -> {
                # No closing semicolon: this is a mailbox list, not a group.
                for addr in parse_comma_separated_addresses(rest).into_iter {
                  result.push(addr)
                }

                rest = ''
              }
            }
          }
          case None -> {
            for addr in parse_comma_separated_addresses(rest).into_iter {
              result.push(addr)
            }

            rest = ''
          }
        }
      }

      result
    }
    case None -> []
  }
}
