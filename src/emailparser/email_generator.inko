# Email Generator
#
# Generates synthetic email messages for testing, benchmarking, and examples.
# Supports various email structures and sizes.

import std.base64 (Encoder)
import std.bytes (ByteArray)

# Attachment data structure for test generation
type pub TestAttachment {
  let pub @name: String
  let pub @content_type: String
  let pub @content: String
  let pub @encoding: String
}

# Test Data Generator
#
# Generates synthetic email messages for testing and benchmarking.
# Supports various email structures and sizes.
type pub TestDataGenerator {
  let mut @attachment_counter: Int
}

impl TestDataGenerator {
  fn pub static new -> TestDataGenerator {
    TestDataGenerator(attachment_counter: 0)
  }

  # Generate a simple plain text email
  fn pub mut generate_text_email(subject: String, body: String) -> String {
    let email = 'From: sender@example.com
To: recipient@example.com
Subject: '
      + sanitize_header_value(subject)
      + '
Date: Mon, 15 Jan 2026 10:30:00 +0000
Message-ID: <test-'
      + generate_id.to_string
      + '@example.com>
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8

'
      + body

    email
  }

  # Generate an email with a single attachment
  fn pub mut generate_email_with_attachment(
    name: String,
    content: String,
    encoding: String,
  ) -> String {
    let boundary = generate_boundary
    let encoding = normalize_encoding(encoding)
    let encoded_content = TestDataGenerator.encode_bytes(content, encoding)

    let email = 'From: sender@example.com
To: recipient@example.com
Subject: Email with Attachment
Date: Tue, 16 Jan 2026 14:20:00 +0000
Message-ID: <test-'
      + generate_id.to_string
      + '@example.com>
MIME-Version: 1.0
Content-Type: multipart/mixed; boundary='
      + boundary
      + '

--'
      + boundary
      + '
Content-Type: text/plain; charset=UTF-8

Please find attached file.
--'
      + boundary
      + '
Content-Type: application/octet-stream; name="'
      + escape_quoted_param(name.clone)
      + '"
Content-Disposition: attachment; filename="'
      + escape_quoted_param(name.clone)
      + '"
Content-Transfer-Encoding: '
      + encoding
      + '

'
      + encoded_content
      + '
--'
      + boundary
      + '--'

    email
  }

  # Generate an email with multiple attachments
  fn pub mut generate_email_with_attachments(
    attachments: Array[TestAttachment],
  ) -> String {
    let boundary = generate_boundary

    let mut email = 'From: sender@example.com
To: recipient@example.com
Subject: Email with Multiple Attachments
Date: Wed, 17 Jan 2026 09:15:00 +0000
Message-ID: <test-'
      + generate_id.to_string
      + '@example.com>
MIME-Version: 1.0
Content-Type: multipart/mixed; boundary='
      + boundary
      + '

--'
      + boundary
      + '
Content-Type: text/plain; charset=UTF-8

Please find attached files.

'

    let output = ByteArray.new

    output.append(email)

    for att in attachments.iter {
      let encoding = normalize_encoding(att.encoding)
      let content_type = sanitize_header_value(att.content_type)
      let encoded_content = TestDataGenerator.encode_bytes(
        att.content,
        encoding,
      )

      output.append('--')
      output.append(boundary)
      output.append(
        '
Content-Type: ',
      )
      output.append(content_type)
      output.append('; name="')
      output.append(escape_quoted_param(att.name.clone))
      output.append(
        '"
Content-Disposition: attachment; filename="',
      )
      output.append(escape_quoted_param(att.name.clone))
      output.append(
        '"
Content-Transfer-Encoding: ',
      )
      output.append(encoding)
      output.append(
        '

',
      )
      output.append(encoded_content)
      output.append(
        '
',
      )

      @attachment_counter = @attachment_counter + 1
    }

    output.append('--')
    output.append(boundary)
    output.append('--')
    output.into_string
  }

  # Generate a large attachment with configurable size
  fn pub mut generate_large_attachment(size: Int, pattern: String) -> String {
    let mut result = ByteArray.new
    let mut bytes_written = 0
    let pattern_bytes = pattern.to_byte_array

    # An empty pattern can produce no bytes, so bail out instead of spinning
    # with a chunk_size of zero.
    if pattern_bytes.size == 0 or size <= 0 { return '' }

    while bytes_written < size {
      let remaining = size - bytes_written
      let chunk_size = if remaining > pattern_bytes.size {
        pattern_bytes.size
      } else {
        remaining
      }

      let mut i = 0

      while i < chunk_size {
        match pattern_bytes.get(i) {
          case Ok(byte) -> result.push(byte)
          case Error(_) -> {}
        }

        i = i + 1
      }

      bytes_written = bytes_written + chunk_size
    }

    result.into_string
  }

  # Generate a nested multipart email
  fn pub mut generate_nested_multipart_email(
    depth: Int,
    attachments_per_level: Int,
    attachment_size: Int,
  ) -> String {
    if depth == 0 {
      return generate_text_email(
        'Nested Email',
        'This is the innermost text part.',
      )
    }

    let outer_boundary = generate_boundary
    let mut email = 'From: sender@example.com
To: recipient@example.com
Subject: Nested Multipart Email
Date: Thu, 18 Jan 2026 11:00:00 +0000
Message-ID: <test-'
      + generate_id.to_string
      + '@example.com>
MIME-Version: 1.0
Content-Type: multipart/mixed; boundary='
      + outer_boundary
      + '

'

    # Add text part
    email = email
      + '--'
      + outer_boundary
      + '
Content-Type: text/plain; charset=UTF-8

This email has '
      + depth.to_string
      + ' levels of nesting.

'

    # Add nested multipart if depth > 1
    if depth > 1 {
      let inner_boundary = generate_boundary

      email = email
        + '--'
        + outer_boundary
        + '
Content-Type: multipart/alternative; boundary='
        + inner_boundary
        + '

'

      email = email
        + '--'
        + inner_boundary
        + '
Content-Type: text/plain; charset=UTF-8

Plain text version at level '
        + depth.to_string
        + '

'

      email = email
        + '--'
        + inner_boundary
        + '
Content-Type: text/html; charset=UTF-8

<html><body>HTML version at level '
        + depth.to_string
        + '</body></html>
--'
        + inner_boundary
        + '--

'
    }

    # Add attachments at this level
    let output = ByteArray.new

    output.append(email)

    let mut i = 0

    while i < attachments_per_level {
      let att_name = 'attachment_level'
        + depth.to_string
        + '_'
        + i.to_string
        + '.bin'
      let att_content = generate_large_attachment(attachment_size, 'PATTERN')

      output.append('--')
      output.append(outer_boundary)
      output.append(
        '
Content-Type: application/octet-stream; name="',
      )
      output.append(escape_quoted_param(att_name.clone))
      output.append(
        '"
Content-Disposition: attachment; filename="',
      )
      output.append(escape_quoted_param(att_name.clone))
      output.append(
        '"
Content-Transfer-Encoding: base64

',
      )
      output.append(TestDataGenerator.encode_bytes(att_content, 'base64'))
      output.append(
        '
',
      )

      i = i + 1
      @attachment_counter = @attachment_counter + 1
    }

    output.append('--')
    output.append(outer_boundary)
    output.append('--')
    output.into_string
  }

  # Generate a multipart/alternative email (text + HTML)
  fn pub mut generate_alternative_email(
    subject: String,
    text_body: String,
    html_body: String,
  ) -> String {
    let boundary = generate_boundary

    let email = 'From: sender@example.com
To: recipient@example.com
Subject: '
      + sanitize_header_value(subject)
      + '
Date: Fri, 19 Jan 2026 12:00:00 +0000
Message-ID: <test-'
      + generate_id.to_string
      + '@example.com>
MIME-Version: 1.0
Content-Type: multipart/alternative; boundary='
      + boundary
      + '

--'
      + boundary
      + '
Content-Type: text/plain; charset=UTF-8

'
      + text_body
      + '
--'
      + boundary
      + '
Content-Type: text/html; charset=UTF-8

'
      + html_body
      + '
--'
      + boundary
      + '--'

    email
  }

  # Generate a multipart/related email (HTML + inline images)
  fn pub mut generate_related_email(
    subject: String,
    html_body: String,
    inline_images: Array[(String, String)],
  ) -> String {
    let boundary = generate_boundary

    let mut email = 'From: sender@example.com
To: recipient@example.com
Subject: '
      + sanitize_header_value(subject)
      + '
Date: Sat, 20 Jan 2026 13:00:00 +0000
Message-ID: <test-'
      + generate_id.to_string
      + '@example.com>
MIME-Version: 1.0
Content-Type: multipart/related; boundary='
      + boundary
      + '

--'
      + boundary
      + '
Content-Type: text/html; charset=UTF-8

'
      + html_body
      + '

'

    for (cid, content) in inline_images.iter {
      let encoded_content = TestDataGenerator.encode_bytes(content, 'base64')

      email = email
        + '--'
        + boundary
        + '
Content-Type: image/png
Content-ID: <'
        + sanitize_header_value(cid.clone)
        + '>
Content-Disposition: inline
Content-Transfer-Encoding: base64

'
        + encoded_content
        + '

'
    }

    email = email + '--' + boundary + '--'

    email
  }

  # Generate an email with encoded subject (RFC 2047)
  fn pub mut generate_encoded_subject_email(
    encoded_subject: String,
    body: String,
  ) -> String {
    let email = 'From: sender@example.com
To: recipient@example.com
Subject: '
      + sanitize_header_value(encoded_subject)
      + '
Date: Sun, 21 Jan 2026 14:00:00 +0000
Message-ID: <test-'
      + generate_id.to_string
      + '@example.com>
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8

'
      + body

    email
  }

  # Convert generated text to CRLF line endings
  #
  # Fixtures are generated with LF-only line endings; use this to exercise
  # CRLF and folding code paths.
  fn pub static to_crlf(email: String) -> String {
    email.replace('\r\n', '\n').replace('\n', '\r\n')
  }

  # Encode data using specified encoding
  fn pub static encode_bytes(data: String, encoding: String) -> String {
    let enc_lower = encoding.to_lower

    if enc_lower == 'base64' {
      let encoder = Encoder.new
      let input = data.to_byte_array
      let output = ByteArray.new

      encoder.encode(ref input, output)
      wrap_base64(output.into_string)
    } else if enc_lower == 'quoted-printable' {
      encode_quoted_printable(data)
    } else {
      data
    }
  }

  # Generate a unique boundary string
  fn pub mut generate_boundary -> String {
    @attachment_counter = @attachment_counter + 1
    '----=_Part_'
      + @attachment_counter.to_string
      + '_'
      + @attachment_counter.to_string
      + @attachment_counter.to_string
      + '.'
      + generate_id.to_string
      + @attachment_counter.to_string
  }

  # Generate a unique ID
  fn pub mut generate_id -> Int {
    @attachment_counter = @attachment_counter + 1
    @attachment_counter
  }
}

# Normalise a Content-Transfer-Encoding label
#
# Only the encodings this generator implements are accepted. Anything else is
# treated as 7bit so the declared encoding always matches the encoded body.
fn normalize_encoding(encoding: String) -> String {
  let enc = encoding.trim.to_lower

  if
    enc == 'base64'
      or enc == 'quoted-printable'
      or enc == '7bit'
      or enc == '8bit'
      or enc == 'binary'
  {
    enc
  } else {
    '7bit'
  }
}

# Neutralise characters that would break out of a header field
#
# Bare CR/LF in a header value is a header-injection primitive, so they are
# replaced with a space.
fn sanitize_header_value(value: String) -> String {
  let output = ByteArray.new
  let mut i = 0

  while i < value.size {
    match value.get(i) {
      case Ok(byte) -> {
        if byte == 13 or byte == 10 {
          output.push(32)
        } else {
          output.push(byte)
        }

        i = i + 1
      }
      case Error(_) -> i = i + 1
    }
  }

  output.into_string
}

# Escape a value for use inside a quoted MIME parameter
#
# Backslashes and double quotes are backslash-escaped (RFC 2045 quoted-string)
# and CR/LF are neutralised.
fn escape_quoted_param(value: String) -> String {
  let output = ByteArray.new
  let mut i = 0

  while i < value.size {
    match value.get(i) {
      case Ok(byte) -> {
        if byte == 13 or byte == 10 {
          output.push(32)
        } else if byte == 92 or byte == 34 {
          output.push(92)
          output.push(byte)
        } else {
          output.push(byte)
        }

        i = i + 1
      }
      case Error(_) -> i = i + 1
    }
  }

  output.into_string
}

# Wrap base64 output at 76 columns (RFC 2045 section 6.8)
fn wrap_base64(encoded: String) -> String {
  let output = ByteArray.new
  let mut column = 0
  let mut i = 0

  while i < encoded.size {
    match encoded.get(i) {
      case Ok(byte) -> {
        if byte == 13 or byte == 10 {
          # Existing line breaks are replaced by our own wrapping
        } else {
          output.push(byte)
          column = column + 1

          if column == 76 {
            output.push(10)
            column = 0
          }
        }

        i = i + 1
      }
      case Error(_) -> i = i + 1
    }
  }

  output.into_string
}

# Encode string as quoted-printable
#
# Trailing spaces and tabs are encoded (RFC 2045 section 6.7 rule 3), and soft
# line breaks keep every line within 76 characters including the trailing '='.
# CR/LF are emitted unchanged; fixtures use LF-only line endings, see
# `to_crlf`.
fn encode_quoted_printable(text: String) -> String {
  let result = ByteArray.new
  let mut column = 0
  let mut i = 0

  while i < text.size {
    match text.get(i) {
      case Ok(byte) -> {
        if byte == 13 or byte == 10 {
          result.push(byte)
          column = 0
          i = i + 1
        } else {
          let whitespace = byte == 32 or byte == 9
          let literal = if whitespace {
            !whitespace_before_line_break(text, i)
          } else {
            byte >= 33 and byte <= 126 and byte != 61
          }
          let width = if literal { 1 } else { 3 }
          let projected = column + width

          if projected > 75 {
            result.push(61)
            result.push(10)
            column = 0
          }

          if literal {
            result.push(byte)
          } else {
            result.push(61)
            result.push(hex_digit_to_byte(byte / 16))
            result.push(hex_digit_to_byte(byte % 16))
          }

          column = column + width
          i = i + 1
        }
      }
      case Error(_) -> i = i + 1
    }
  }

  result.into_string
}

# Whether the whitespace run starting at `index` ends the line
#
# RFC 2045 section 6.7 rule 3 requires every space and tab that precedes a
# line break (or the end of the text) to be encoded.
fn whitespace_before_line_break(text: String, index: Int) -> Bool {
  let mut i = index

  while i < text.size {
    match text.get(i) {
      case Ok(byte) -> {
        if byte == 32 or byte == 9 {
          i = i + 1
        } else {
          return byte == 13 or byte == 10
        }
      }
      case Error(_) -> return false
    }
  }

  true
}

# Convert hex digit to ASCII byte
fn hex_digit_to_byte(digit: Int) -> Int {
  if digit >= 0 and digit <= 9 { 48 + digit } else { 65 + digit - 10 }
}
