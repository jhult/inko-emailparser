# Email Generator
#
# Generates synthetic email messages for testing, benchmarking, and examples.
# Supports various email structures and sizes.

import std.base64 (Encoder)
import std.bytes (ByteArray)

# Attachment data structure for test generation
type pub TestAttachment {
  let pub @name: String
  let pub @content_type: String
  let pub @content: String
  let pub @encoding: String
}

# Test Data Generator
#
# Generates synthetic email messages for testing and benchmarking.
# Supports various email structures and sizes.
type pub TestDataGenerator {
  let mut @attachment_counter: Int
}

impl TestDataGenerator {
  fn pub static new -> TestDataGenerator {
    TestDataGenerator(attachment_counter: 0)
  }

  # Generate a simple plain text email
  fn pub mut generate_text_email(subject: String, body: String) -> String {
    let email = 'From: sender@example.com
To: recipient@example.com
Subject: '
      + subject
      + '
Date: Mon, 15 Jan 2026 10:30:00 +0000
Message-ID: <test-'
      + generate_id.to_string
      + '@example.com>
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8

'
      + body

    email
  }

  # Generate an email with a single attachment
  fn pub mut generate_email_with_attachment(
    name: String,
    content: String,
    encoding: String,
  ) -> String {
    let boundary = generate_boundary
    let encoded_content = TestDataGenerator.encode_bytes(content, encoding)

    let email = 'From: sender@example.com
To: recipient@example.com
Subject: Email with Attachment
Date: Tue, 16 Jan 2026 14:20:00 +0000
Message-ID: <test-'
      + generate_id.to_string
      + '@example.com>
MIME-Version: 1.0
Content-Type: multipart/mixed; boundary='
      + boundary
      + '

--'
      + boundary
      + '
Content-Type: text/plain; charset=UTF-8

Please find attached file.
--'
      + boundary
      + '
Content-Type: application/octet-stream; name="'
      + name
      + '"
Content-Disposition: attachment; filename="'
      + name
      + '"
Content-Transfer-Encoding: '
      + encoding
      + '

'
      + encoded_content
      + '
--'
      + boundary
      + '--'

    email
  }

  # Generate an email with multiple attachments
  fn pub mut generate_email_with_attachments(
    attachments: Array[TestAttachment],
  ) -> String {
    let boundary = generate_boundary

    let mut email = 'From: sender@example.com
To: recipient@example.com
Subject: Email with Multiple Attachments
Date: Wed, 17 Jan 2026 09:15:00 +0000
Message-ID: <test-'
      + generate_id.to_string
      + '@example.com>
MIME-Version: 1.0
Content-Type: multipart/mixed; boundary='
      + boundary
      + '

--'
      + boundary
      + '
Content-Type: text/plain; charset=UTF-8

Please find attached files.

'

    for att in attachments.iter {
      let encoded_content = TestDataGenerator.encode_bytes(
        att.content,
        att.encoding,
      )

      email = email
        + '--'
        + boundary
        + '
Content-Type: '
        + att.content_type
        + '; name="'
        + att.name
        + '"
Content-Disposition: attachment; filename="'
        + att.name
        + '"
Content-Transfer-Encoding: '
        + att.encoding
        + '

'
        + encoded_content
        + '
'

      @attachment_counter = @attachment_counter + 1
    }

    email = email + '--' + boundary + '--'

    email
  }

  # Generate a large attachment with configurable size
  fn pub mut generate_large_attachment(size: Int, pattern: String) -> String {
    let mut result = ByteArray.new
    let mut bytes_written = 0
    let pattern_bytes = pattern.to_byte_array

    while bytes_written < size {
      let remaining = size - bytes_written
      let chunk_size = if remaining > pattern_bytes.size {
        pattern_bytes.size
      } else {
        remaining
      }

      let mut i = 0

      while i < chunk_size {
        match pattern_bytes.get(i) {
          case Ok(byte) -> result.push(byte)
          case Error(_) -> {}
        }

        i = i + 1
      }

      bytes_written = bytes_written + chunk_size
    }

    result.into_string
  }

  # Generate a nested multipart email
  fn pub mut generate_nested_multipart_email(
    depth: Int,
    attachments_per_level: Int,
    attachment_size: Int,
  ) -> String {
    if depth == 0 {
      return generate_text_email(
        'Nested Email',
        'This is the innermost text part.',
      )
    }

    let outer_boundary = generate_boundary
    let mut email = 'From: sender@example.com
To: recipient@example.com
Subject: Nested Multipart Email
Date: Thu, 18 Jan 2026 11:00:00 +0000
Message-ID: <test-'
      + generate_id.to_string
      + '@example.com>
MIME-Version: 1.0
Content-Type: multipart/mixed; boundary='
      + outer_boundary
      + '

'

    # Add text part
    email = email
      + '--'
      + outer_boundary
      + '
Content-Type: text/plain; charset=UTF-8

This email has '
      + depth.to_string
      + ' levels of nesting.

'

    # Add nested multipart if depth > 1
    if depth > 1 {
      let inner_boundary = generate_boundary

      email = email
        + '--'
        + outer_boundary
        + '
Content-Type: multipart/alternative; boundary='
        + inner_boundary
        + '

'

      email = email
        + '--'
        + inner_boundary
        + '
Content-Type: text/plain; charset=UTF-8

Plain text version at level '
        + depth.to_string
        + '

'

      email = email
        + '--'
        + inner_boundary
        + '
Content-Type: text/html; charset=UTF-8

<html><body>HTML version at level '
        + depth.to_string
        + '</body></html>
--'
        + inner_boundary
        + '--

'
    }

    # Add attachments at this level
    let mut i = 0

    while i < attachments_per_level {
      let att_name = 'attachment_level'
        + depth.to_string
        + '_'
        + i.to_string
        + '.bin'
      let att_content = generate_large_attachment(attachment_size, 'PATTERN')

      email = email
        + '--'
        + outer_boundary
        + '
Content-Type: application/octet-stream; name="'
        + att_name
        + '"
Content-Disposition: attachment; filename="'
        + att_name
        + '"
Content-Transfer-Encoding: base64

'
        + TestDataGenerator.encode_bytes(att_content, 'base64')
        + '

'

      i = i + 1
      @attachment_counter = @attachment_counter + 1
    }

    email = email + '--' + outer_boundary + '--'

    email
  }

  # Generate a multipart/alternative email (text + HTML)
  fn pub mut generate_alternative_email(
    subject: String,
    text_body: String,
    html_body: String,
  ) -> String {
    let boundary = generate_boundary

    let email = 'From: sender@example.com
To: recipient@example.com
Subject: '
      + subject
      + '
Date: Fri, 19 Jan 2026 12:00:00 +0000
Message-ID: <test-'
      + generate_id.to_string
      + '@example.com>
MIME-Version: 1.0
Content-Type: multipart/alternative; boundary='
      + boundary
      + '

--'
      + boundary
      + '
Content-Type: text/plain; charset=UTF-8

'
      + text_body
      + '
--'
      + boundary
      + '
Content-Type: text/html; charset=UTF-8

'
      + html_body
      + '
--'
      + boundary
      + '--'

    email
  }

  # Generate a multipart/related email (HTML + inline images)
  fn pub mut generate_related_email(
    subject: String,
    html_body: String,
    inline_images: Array[(String, String)],
  ) -> String {
    let boundary = generate_boundary

    let mut email = 'From: sender@example.com
To: recipient@example.com
Subject: '
      + subject
      + '
Date: Sat, 20 Jan 2026 13:00:00 +0000
Message-ID: <test-'
      + generate_id.to_string
      + '@example.com>
MIME-Version: 1.0
Content-Type: multipart/related; boundary='
      + boundary
      + '

--'
      + boundary
      + '
Content-Type: text/html; charset=UTF-8

'
      + html_body
      + '

'

    for (cid, content) in inline_images.iter {
      let encoded_content = TestDataGenerator.encode_bytes(content, 'base64')

      email = email
        + '--'
        + boundary
        + '
Content-Type: image/png
Content-ID: <'
        + cid
        + '>
Content-Disposition: inline
Content-Transfer-Encoding: base64

'
        + encoded_content
        + '

'
    }

    email = email + '--' + boundary + '--'

    email
  }

  # Generate an email with encoded subject (RFC 2047)
  fn pub mut generate_encoded_subject_email(
    encoded_subject: String,
    body: String,
  ) -> String {
    let email = 'From: sender@example.com
To: recipient@example.com
Subject: '
      + encoded_subject
      + '
Date: Sun, 21 Jan 2026 14:00:00 +0000
Message-ID: <test-'
      + generate_id.to_string
      + '@example.com>
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8

'
      + body

    email
  }

  # Encode data using specified encoding
  fn pub static encode_bytes(data: String, encoding: String) -> String {
    let enc_lower = encoding.to_lower

    if enc_lower == 'base64' {
      let encoder = Encoder.new
      let input = data.to_byte_array
      let output = ByteArray.new

      encoder.encode(ref input, output)
      output.into_string
    } else if enc_lower == 'quoted-printable' {
      encode_quoted_printable(data)
    } else {
      data
    }
  }

  # Generate a unique boundary string
  fn pub mut generate_boundary -> String {
    @attachment_counter = @attachment_counter + 1
    '----=_Part_'
      + @attachment_counter.to_string
      + '_'
      + @attachment_counter.to_string
      + @attachment_counter.to_string
      + '.'
      + generate_id.to_string
      + @attachment_counter.to_string
  }

  # Generate a unique ID
  fn pub mut generate_id -> Int {
    @attachment_counter = @attachment_counter + 1
    @attachment_counter
  }
}

# Encode string as quoted-printable
fn encode_quoted_printable(text: String) -> String {
  let result = ByteArray.new
  let mut i = 0

  while i < text.size {
    match text.get(i) {
      case Ok(byte) -> {
        if byte == 61 {
          # Escape equals sign
          result.push(61)
          result.push(50)
          result.push(68)
        } else if byte >= 33 and byte <= 126 and byte != 61 {
          # Printable ASCII (except =)
          result.push(byte)
        } else if byte == 32 or byte == 9 {
          # Space or tab
          result.push(byte)
        } else {
          # Encode as =XX
          result.push(61)

          let high = (byte / 16)
          let low = (byte % 16)

          result.push(hex_digit_to_byte(high))
          result.push(hex_digit_to_byte(low))
        }

        i = i + 1
      }
      case Error(_) -> i = i + 1
    }
  }

  result.into_string
}

# Convert hex digit to ASCII byte
fn hex_digit_to_byte(digit: Int) -> Int {
  if digit >= 0 and digit <= 9 { 48 + digit } else { 65 + digit - 10 }
}
