# ==============================================================================
# Header Extraction Module
# ==============================================================================
#
# This module provides shared functions for extracting specific headers
# from parsed email header arrays. These functions are used by both the
# regular email parser and the streaming parser to avoid code duplication.
#
# ## Purpose
#
# Email parsing involves extracting specific sets of headers for different
# purposes:
# - Threading headers (In-Reply-To, References, Message-ID)
# - Address headers (From, To, Cc, Bcc)
# - MIME headers (Content-Type, Content-Transfer-Encoding)
#
# This module centralizes the extraction logic for common header groups.
#
# ## Architecture
#
# The module provides extraction functions that:
# - Take a ref to an Array[(String, String)] of parsed headers
# - Return structured data containing the extracted header values
# - Use case-insensitive header name matching
#
# ## Public API
#
# - `parse_threading_headers`: Extract threading headers (In-Reply-To, References, thread_id)
# - `parse_address_headers`: Extract From, To, Cc and Bcc
# - `parse_basic_headers`: Extract Subject, Date and Message-ID
# - `parse_mime_metadata`: Extract Content-Type, encoding and charset
# - `validate_multipart_boundary`: Validate the boundary of a multipart message
#
# ## RFC Compliance
#
# - RFC 5322 section 3.6.4: Identification Fields (Message-ID, In-Reply-To, References)
# - RFC 5322 section 3.6.2: Originator Fields (From, Sender, Reply-To)
# - RFC 5322 section 3.6.3: Destination Address Fields (To, Cc, Bcc)
# - RFC 2045 section 5: Content-Type Header Field

import emailparser.address (EmailAddress, parse_address_list_impl)
import emailparser.decoder (decode_header_value_impl)
import emailparser.error (Error)
import emailparser.error (Severity)
import emailparser.header (
  get_header_value_impl, get_header_values_impl, get_param_value_impl,
  parse_content_type_impl,
)
import emailparser.message_id (normalize_message_id, parse_message_ids_impl)
import emailparser.mime (is_multipart)
import emailparser.validation (is_valid_boundary)
import std.option (Option)
import std.string (StringBuffer)

# Parse a single address header (From, To, Cc, Bcc)
fn parse_address_header(
  headers: ref Array[(String, String)],
  name: String,
) -> Array[EmailAddress] {
  # A field may legitimately appear more than once (MTAs and proxies re-emit
  # To:/Cc:/Bcc:), so parse every occurrence instead of dropping the rest.
  let values = get_header_values_impl(headers, name)

  if values.empty? { return [] }

  # Build the joined value with a buffer: repeated string concatenation copies
  # the whole accumulator on every iteration, which is quadratic.
  let mut buffer = StringBuffer.new
  let mut first = true

  for value in values.iter {
    if first { first = false } else { buffer.push(', ') }

    buffer.push(value.clone)
  }

  let combined = buffer.into_string

  let raw = Option.Some(combined.clone)
  let decoded = decode_header_value_impl(combined)

  parse_address_list_impl(ref raw, decoded)
}

# Return the first address of a list, or an empty address when the list is empty
fn first_address(addresses: Array[EmailAddress]) -> EmailAddress {
  if addresses.empty? {
    return EmailAddress(name: Option.None, address: '', raw: '')
  }

  match addresses.into_iter.next {
    case Some(addr) -> addr
    case None -> EmailAddress(name: Option.None, address: '', raw: '')
  }
}

# Extract address headers (From, To, Cc, Bcc)
fn pub parse_address_headers(
  headers: ref Array[(String, String)],
) -> (
  EmailAddress,
  Array[EmailAddress],
  Array[EmailAddress],
  Array[EmailAddress],
) {
  let from = first_address(parse_address_header(headers, 'From'))
  let to = parse_address_header(headers, 'To')
  let cc = parse_address_header(headers, 'Cc')
  let bcc = parse_address_header(headers, 'Bcc')

  (from, to, cc, bcc)
}

# Extract basic message headers (Subject, Date, Message-ID)
fn pub parse_basic_headers(
  headers: ref Array[(String, String)],
) -> (String, String, String) {
  let subject = decode_header_value_impl(
    get_header_value_impl(headers, 'Subject').or(''),
  )
  let date = get_header_value_impl(headers, 'Date').or('')
  let message_id = normalize_message_id(
    get_header_value_impl(headers, 'Message-ID').or(''),
  )

  (subject, date, message_id)
}

# Extract MIME metadata (Content-Type, Content-Transfer-Encoding, charset)
fn pub parse_mime_metadata(
  headers: ref Array[(String, String)],
  strict_mode: Bool,
) -> Result[(String, Array[(String, String)], String, Option[String]), Error] {
  let content_type = get_header_value_impl(headers, 'Content-Type').or(
    'text/plain',
  )

  match parse_content_type_impl(content_type, strict_mode) {
    case Ok((ct_main, ct_params)) -> {
      let content_transfer_encoding = get_header_value_impl(
        headers,
        'Content-Transfer-Encoding',
      )
        .or('7bit')

      let charset = get_param_value_impl(ref ct_params, 'charset')

      Result.Ok((ct_main, ct_params, content_transfer_encoding, charset))
    }
    case Error(e) -> Result.Error(e)
  }
}

# Extract threading headers (In-Reply-To, References, thread_id)
#
# RFC 5322 section 3.6.4: Identification Fields
# - In-Reply-To: Contains the Message-ID of the message this one is a reply to
# - References: Contains a list of Message-IDs forming the conversation thread
# - thread_id: The root Message-ID of the thread (computed from References or Message-ID)
#
# Thread ID computation:
# - If References header is present, thread_id is the first Message-ID in References
# - Otherwise, thread_id is the Message-ID of the current message
#
# Returns: (in_reply_to, references, thread_id)
fn pub parse_threading_headers(
  headers: ref Array[(String, String)],
) -> (Option[String], Array[String], String) {
  # RFC 5322 permits the same field to appear more than once; a header split
  # over multiple occurrences must still contribute every message ID.
  let mut in_reply_to = Option.None
  let in_reply_to_raw = join_header_values(headers, 'In-Reply-To')

  if !in_reply_to_raw.empty? {
    let ids = parse_message_ids_impl(in_reply_to_raw.clone)

    if !ids.empty? {
      match ids.get(0) {
        case Ok(id) -> in_reply_to = Option.Some(id)
        case Error(_) -> {}
      }
    } else {
      let normalized = normalize_message_id(in_reply_to_raw)

      if !normalized.empty? { in_reply_to = Option.Some(normalized) }
    }
  }

  # `parse_message_ids_impl` already returns bracket-free IDs, which is the
  # same representation `normalize_message_id` produces.
  let references = parse_message_ids_impl(
    join_header_values(headers, 'References'),
  )
  let message_id = normalize_message_id(
    get_header_value_impl(headers, 'Message-ID').or(''),
  )

  # Compute thread_id. Both sides are bracket-free, so a reply's thread_id
  # matches the root message's message_id.
  let thread_id = if references.empty? {
    message_id
  } else {
    match references.get(0) {
      case Ok(r) -> r
      case Error(_) -> message_id
    }
  }

  (in_reply_to, references, thread_id)
}

# Join every occurrence of a header with a single space
fn join_header_values(
  headers: ref Array[(String, String)],
  name: String,
) -> String {
  let values = get_header_values_impl(headers, name)
  let mut joined = ''
  let mut idx = 0

  while idx < values.size {
    match values.get(idx) {
      case Ok(value) -> {
        if !joined.empty? { joined = joined + ' ' }

        joined = joined + value
      }
      case Error(_) -> {}
    }

    idx = idx + 1
  }

  joined
}

# Validate the boundary of a multipart message
#
# RFC 2046 requires a boundary of 1-70 characters using only valid characters.
# Non-multipart messages do not require a boundary, so they always pass.
fn pub validate_multipart_boundary(
  content_type: String,
  boundary: ref Option[String],
  strict_mode: Bool,
) -> Result[Bool, Error] {
  if !is_multipart(content_type) { return Result.Ok(true) }

  match boundary.clone {
    case Some(b) -> {
      if !is_valid_boundary(b.clone) {
        # Permissive parsing still processes the message; the body falls back
        # to plain text when the boundary cannot be used.
        if !strict_mode { return Result.Ok(false) }

        return Result.Error(
          Error.InvalidBoundary(
            Severity.Error,
            'boundary string exceeds 70 characters or contains invalid characters',
            Option.None,
            Option.None,
            Option.Some(b),
          ),
        )
      }
    }
    case None -> {
      if !strict_mode { return Result.Ok(false) }

      return Result.Error(
        Error.InvalidBoundary(
          Severity.Error,
          'missing boundary parameter for multipart Content-Type',
          Option.None,
          Option.None,
          Option.Some(content_type),
        ),
      )
    }
  }

  Result.Ok(true)
}
