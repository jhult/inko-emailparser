# Helper type for multipart streaming parser
type MultipartHandlerWrapper[H: mut + StreamHandler] {
  let @handler: mut H
  let mut @attachment_count: Int
  let mut @current_info: Option[AttachmentInfo]
  let mut @base64_decoder: Option[Base64StreamingDecoder]
  let mut @qp_decoder: Option[QuotedPrintableStreamingDecoder]
  let mut @current_encoding: String
  let mut @current_content_type: String
  let @max_size: Int
  let @chunk_size: Int
}

impl MultipartStreamHandler for MultipartHandlerWrapper if H: mut + StreamHandler {
  fn pub mut on_part_begin(
    headers: ref Array[(String, String)],
    content_type: String,
    is_attachment: Bool,
  ) {
    @current_content_type = content_type
    let content_disposition = get_header_value_impl(ref headers, 'Content-Disposition').or('')
    let content_transfer_encoding = get_header_value_impl(ref headers, 'Content-Transfer-Encoding').or('7bit')
    @current_encoding = content_transfer_encoding
    let content_id = get_header_value_impl(ref headers, 'Content-ID')
    
    let is_actual_attachment = content_disposition.starts_with?('attachment') or content_disposition.starts_with?('file')
    
    let filename = if is_actual_attachment {
      extract_filename(content_disposition)
    } else {
      Option.None
    }
    
    if is_actual_attachment {
      let info = AttachmentInfo(
        index: @attachment_count,
        content_type: content_type,
        filename: filename,
        content_disposition: content_disposition,
        content_id: content_id,
        size: 0,
        transfer_encoding: content_transfer_encoding,
      )
      match @handler.on_attachment_begin(info) {
        case Ok(_) -> {}
        case Error(_) -> {}
      }
      @current_info = Option.Some(info)
    }
  }
  
  fn pub mut on_part_data(
    data: ref ByteArray,
    content_transfer_encoding: String,
  ) {
    @current_encoding = content_transfer_encoding
    let data_str = data.clone
    
    match @current_info {
      case Some(info) -> {
        let encoding_lower = content_transfer_encoding.to_lower
        
        if encoding_lower == 'base64' {
          match @base64_decoder {
            case None -> {
              @base64_decoder = Option.Some(Base64StreamingDecoder.new(@max_size, false))
            }
            case Some(_) -> {}
          }
          match @base64_decoder {
            case Some(mut d) -> {
              match d.feed(data_str.into_string) {
                case Ok(decoded) -> {
                  if decoded.size > 0 {
                    match @handler.on_attachment_chunk(decoded, info) {
                      case Ok(_) -> {}
                      case Error(_) -> {}
                    }
                  }
                }
                case Error(_) -> {}
              }
            }
            case None -> {}
          }
        } else if encoding_lower == 'quoted-printable' {
          match @qp_decoder {
            case None -> {
              @qp_decoder = Option.Some(QuotedPrintableStreamingDecoder.new(@max_size, false, false))
            }
            case Some(_) -> {}
          }
          match @qp_decoder {
            case Some(mut d) -> {
              match d.feed(data_str.into_string) {
                case Ok(decoded) -> {
                  if decoded.size > 0 {
                    match @handler.on_attachment_chunk(decoded, info) {
                      case Ok(_) -> {}
                      case Error(_) -> {}
                    }
                  }
                }
                case Error(_) -> {}
              }
            }
            case None -> {}
          }
        } else {
          match @handler.on_attachment_chunk(data_str, info) {
            case Ok(_) -> {}
            case Error(_) -> {}
          }
        }
      }
      case None -> {
        if is_text_plain(@current_content_type) {
          let encoding_lower = content_transfer_encoding.to_lower
          if encoding_lower == 'base64' {
            match @base64_decoder {
              case None -> {
                @base64_decoder = Option.Some(Base64StreamingDecoder.new(@max_size, false))
              }
              case Some(_) -> {}
            }
            match @base64_decoder {
              case Some(mut d) -> {
                match d.feed(data_str.into_string) {
                  case Ok(decoded) -> {
                    if decoded.size > 0 {
                      let decoded_str = decoded.into_string
                      let mut pos = 0
                      while pos < decoded_str.size {
                        let end = if pos + @chunk_size > decoded_str.size {
                          decoded_str.size
                        } else {
                          pos + @chunk_size
                        }
                        let chunk = decoded_str.substring(pos, end)
                        match @handler.on_text_chunk(chunk) {
                          case Ok(_) -> {}
                          case Error(_) -> {}
                        }
                        pos = end
                      }
                    }
                  }
                  case Error(_) -> {}
                }
              }
              case None -> {}
            }
          } else if encoding_lower == 'quoted-printable' {
            match @qp_decoder {
              case None -> {
                @qp_decoder = Option.Some(QuotedPrintableStreamingDecoder.new(@max_size, false, false))
              }
              case Some(_) -> {}
            }
            match @qp_decoder {
              case Some(mut d) -> {
                match d.feed(data_str.into_string) {
                  case Ok(decoded) -> {
                    if decoded.size > 0 {
                      let decoded_str = decoded.into_string
                      let mut pos = 0
                      while pos < decoded_str.size {
                        let end = if pos + @chunk_size > decoded_str.size {
                          decoded_str.size
                        } else {
                          pos + @chunk_size
                        }
                        let chunk = decoded_str.substring(pos, end)
                        match @handler.on_text_chunk(chunk) {
                          case Ok(_) -> {}
                          case Error(_) -> {}
                        }
                        pos = end
                      }
                    }
                  }
                  case Error(_) -> {}
                }
              }
              case None -> {}
            }
          } else {
            match @handler.on_text_chunk(data_str.into_string) {
              case Ok(_) -> {}
              case Error(_) -> {}
            }
          }
        } else if is_text_html(@current_content_type) {
          let encoding_lower = content_transfer_encoding.to_lower
          if encoding_lower == 'base64' {
            match @base64_decoder {
              case None -> {
                @base64_decoder = Option.Some(Base64StreamingDecoder.new(@max_size, false))
              }
              case Some(_) -> {}
            }
            match @base64_decoder {
              case Some(mut d) -> {
                match d.feed(data_str.into_string) {
                  case Ok(decoded) -> {
                    if decoded.size > 0 {
                      let decoded_str = decoded.into_string
                      let mut pos = 0
                      while pos < decoded_str.size {
                        let end = if pos + @chunk_size > decoded_str.size {
                          decoded_str.size
                        } else {
                          pos + @chunk_size
                        }
                        let chunk = decoded_str.substring(pos, end)
                        match @handler.on_html_chunk(chunk) {
                          case Ok(_) -> {}
                          case Error(_) -> {}
                        }
                        pos = end
                      }
                    }
                  }
                  case Error(_) -> {}
                }
              }
              case None -> {}
            }
          } else if encoding_lower == 'quoted-printable' {
            match @qp_decoder {
              case None -> {
                @qp_decoder = Option.Some(QuotedPrintableStreamingDecoder.new(@max_size, false, false))
              }
              case Some(_) -> {}
            }
            match @qp_decoder {
              case Some(mut d) -> {
                match d.feed(data_str.into_string) {
                  case Ok(decoded) -> {
                    if decoded.size > 0 {
                      let decoded_str = decoded.into_string
                      let mut pos = 0
                      while pos < decoded_str.size {
                        let end = if pos + @chunk_size > decoded_str.size {
                          decoded_str.size
                        } else {
                          pos + @chunk_size
                        }
                        let chunk = decoded_str.substring(pos, end)
                        match @handler.on_html_chunk(chunk) {
                          case Ok(_) -> {}
                          case Error(_) -> {}
                        }
                        pos = end
                      }
                    }
                  }
                  case Error(_) -> {}
                }
              }
              case None -> {}
            }
          } else {
            match @handler.on_html_chunk(data_str.into_string) {
              case Ok(_) -> {}
              case Error(_) -> {}
            }
          }
        }
      }
    }
  }
  
  fn pub mut on_part_end {
    # Collect decoded data before calling handler methods
    let mut base64_decoded: Option[ByteArray] = Option.None
    let mut qp_decoded: Option[ByteArray] = Option.None

    # Finish base64 decoder if present
    match @base64_decoder {
      case Some(mut d) -> {
        match d.finish {
          case Ok(decoded) -> {
            if decoded.size > 0 {
              base64_decoded = Option.Some(decoded)
            }
          }
          case Error(_) -> {}
        }
      }
      case None -> {}
    }
    @base64_decoder = Option.None

    # Finish quoted-printable decoder if present
    match @qp_decoder {
      case Some(mut d) -> {
        match d.finish {
          case Ok(decoded) -> {
            if decoded.size > 0 {
              qp_decoded = Option.Some(decoded)
            }
          }
          case Error(_) -> {}
        }
      }
      case None -> {}
    }
    @qp_decoder = Option.None

    # Now pass decoded data to handler
    match @current_info {
      case Some(info) -> {
        match base64_decoded {
          case Some(data) -> {
            match @handler.on_attachment_chunk(data, info) {
              case Ok(_) -> {}
              case Error(_) -> {}
            }
          }
          case None -> {}
        }

        match qp_decoded {
          case Some(data) -> {
            match @handler.on_attachment_chunk(data, info) {
              case Ok(_) -> {}
              case Error(_) -> {}
            }
          }
          case None -> {}
        }

        match @handler.on_attachment_end(info) {
          case Ok(_) -> {}
          case Error(_) -> {}
        }

        @attachment_count = @attachment_count + 1
      }
      case None -> {
        # Handle text/HTML parts without attachment info
        if is_text_plain(@current_content_type) {
          match base64_decoded {
            case Some(data) -> {
              let decoded_str = data.into_string
              let mut pos = 0
              while pos < decoded_str.size {
                let end = if pos + @chunk_size > decoded_str.size {
                  decoded_str.size
                } else {
                  pos + @chunk_size
                }
                let chunk = decoded_str.substring(pos, end)
                match @handler.on_text_chunk(chunk) {
                  case Ok(_) -> {}
                  case Error(_) -> {}
                }
                pos = end
              }
            }
            case None -> {}
          }

          match qp_decoded {
            case Some(data) -> {
              let decoded_str = data.into_string
              let mut pos = 0
              while pos < decoded_str.size {
                let end = if pos + @chunk_size > decoded_str.size {
                  decoded_str.size
                } else {
                  pos + @chunk_size
                }
                let chunk = decoded_str.substring(pos, end)
                match @handler.on_text_chunk(chunk) {
                  case Ok(_) -> {}
                  case Error(_) -> {}
                }
                pos = end
              }
            }
            case None -> {}
          }
        } else if is_text_html(@current_content_type) {
          match base64_decoded {
            case Some(data) -> {
              let decoded_str = data.into_string
              let mut pos = 0
              while pos < decoded_str.size {
                let end = if pos + @chunk_size > decoded_str.size {
                  decoded_str.size
                } else {
                  pos + @chunk_size
                }
                let chunk = decoded_str.substring(pos, end)
                match @handler.on_html_chunk(chunk) {
                  case Ok(_) -> {}
                  case Error(_) -> {}
                }
                pos = end
              }
            }
            case None -> {}
          }

          match qp_decoded {
            case Some(data) -> {
              let decoded_str = data.into_string
              let mut pos = 0
              while pos < decoded_str.size {
                let end = if pos + @chunk_size > decoded_str.size {
                  decoded_str.size
                } else {
                  pos + @chunk_size
                }
                let chunk = decoded_str.substring(pos, end)
                match @handler.on_html_chunk(chunk) {
                  case Ok(_) -> {}
                  case Error(_) -> {}
                }
                pos = end
              }
            }
            case None -> {}
          }
        }
      }
    }

    # Clear current_info last
    @current_info = Option.None
  }
}

# Parse multipart with streaming using MultipartStreamParser
fn parse_multipart_stream[H: mut + StreamHandler](
  raw: String,
  boundary: String,
  default_encoding: String,
  current_depth: Int,
  max_depth: Int,
  max_size: Int,
  max_headers: Int,
  chunk_size: Int,
  handler: mut H,
) -> Result[Int, String] {
  
  if current_depth >= max_depth {
    return Result.Error("Maximum multipart depth exceeded")
  }
  
  let mut attachment_count = 0
  let mut current_info: Option[AttachmentInfo] = Option.None
  let mut base64_decoder: Option[Base64StreamingDecoder] = Option.None
  let mut qp_decoder: Option[QuotedPrintableStreamingDecoder] = Option.None
  let mut current_encoding: String = default_encoding
  let mut current_content_type: String = 'text/plain'
  
  let mut parser = MultipartStreamParser.new(
    boundary,
    max_depth,
    chunk_size,
    false,
    max_headers,
    max_size,
  )
  
  let mut wrapper = MultipartHandlerWrapper(
    handler: handler,
    attachment_count: attachment_count,
    current_info: current_info,
    base64_decoder: base64_decoder,
    qp_decoder: qp_decoder,
    current_encoding: current_encoding,
    current_content_type: current_content_type,
    max_size: max_size,
    chunk_size: chunk_size,
  )

  let data = raw.to_byte_array
  match parser.feed(ref data, wrapper, default_encoding) {
    case Ok(_) -> {}
    case Error(e) -> return Result.Error(e)
  }

  match parser.finish(wrapper) {
    case Ok(_) -> {}
    case Error(e) -> return Result.Error(e)
  }

  Result.Ok(wrapper.attachment_count)
}
  
fn extract_filename(content_disposition: String) -> Option[String] {
  # Simple extraction - looks for filename= parameter
  let filename_key = 'filename='
  match content_disposition.index_of(filename_key, 0) {
    case Some(pos) -> {
      let start = pos + filename_key.size
      if start >= content_disposition.size {
        return Option.None
      }

      # Check for quoted filename
      match content_disposition.get(start) {
        case Ok(byte) -> {
          if byte == 34 {
            let end = match content_disposition.index_of('"', start + 1) {
              case Some(e) -> e
              case None -> content_disposition.size
            }
            if end > (start + 1) {
              return Option.Some(content_disposition.substring(start + 1, end))
            }
          } else {
            # Unquoted filename - read until space or semicolon
            let mut end = start
            while end < content_disposition.size {
              match content_disposition.get(end) {
                case Ok(b) -> {
                  if b == 32 or b == 59 {
                    break
                  }
                  end = end + 1
                }
                case Error(_) -> break
              }
            }
            if end > start {
              return Option.Some(content_disposition.substring(start, end))
            }
          }
        }
        case Error(_) -> return Option.None
      }
    }
    case None -> return Option.None
  }
  return Option.None
}
