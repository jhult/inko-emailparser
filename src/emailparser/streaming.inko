# Streaming API for parsing large emails without loading entire message into memory.
#
# This module provides a callback-based streaming API that enables progressive
# parsing of email components as they become available, dramatically reducing
# memory consumption for large messages.
#
# See docs/streaming-api.md for complete design documentation.

import emailparser.address (EmailAddress)
import std.bytes (ByteArray)
import std.option (Option)
import std.result (Result)

# Attachment metadata (without content)
type pub AttachmentInfo {
  let pub @index: Int                       # Attachment number (0-based)
  let pub @content_type: String
  let pub @filename: Option[String]
  let pub @content_disposition: String
  let pub @content_id: Option[String]
  let pub @size: Int                        # Total size (if known)
  let pub @transfer_encoding: String
}

# Streaming result contains metadata but not content
type pub StreamingResult {
  let pub @from: EmailAddress
  let pub @to: Array[EmailAddress]
  let pub @cc: Array[EmailAddress]
  let pub @bcc: Array[EmailAddress]
  let pub @subject: String
  let pub @date: String
  let pub @message_id: String
  let pub @in_reply_to: Option[String]
  let pub @references: Array[String]
  let pub @thread_id: String
  let pub @content_type: String
  let pub @content_transfer_encoding: String
  let pub @charset: Option[String]
  let pub @extra_headers: Array[(String, String)]
  let pub @attachment_count: Int
  # NOTE: No @text_body, @html_body, @attachments - content is streamed
}

# Streaming configuration
type pub StreamingConfig {
  let pub mut @strict_mode: Bool
  let pub mut @max_email_size: Int
  let pub mut @max_attachment_size: Int
  let pub mut @max_multipart_depth: Int
  let pub mut @max_headers: Int
  let pub mut @stream_chunk_size: Int  # Bytes to process per callback
}

impl StreamingConfig {
  fn pub static new -> StreamingConfig {
    StreamingConfig(
      strict_mode: false,
      max_email_size: 50_000_000,
      max_attachment_size: 25_000_000,
      max_multipart_depth: 10,
      max_headers: 1000,
      stream_chunk_size: 65536,  # 64KB default
    )
  }

  fn pub mut with_strict_mode(strict: Bool) -> mut Self {
    @strict_mode = strict
    self
  }

  fn pub mut with_max_email_size(size: Int) -> mut Self {
    @max_email_size = size
    self
  }

  fn pub mut with_max_attachment_size(size: Int) -> mut Self {
    @max_attachment_size = size
    self
  }

  fn pub mut with_max_multipart_depth(depth: Int) -> mut Self {
    @max_multipart_depth = depth
    self
  }

  fn pub mut with_max_headers(count: Int) -> mut Self {
    @max_headers = count
    self
  }

  fn pub mut with_stream_chunk_size(size: Int) -> mut Self {
    @stream_chunk_size = size
    self
  }
}

# Trait for handling streaming parser events
#
# Implement this trait to process email data incrementally.
# All callbacks receive !! Error for panic propagation.
trait pub StreamHandler {
  # Called when parsing begins
  fn pub on_begin(!! Error) -> Result[Nil, String]

  # Called when headers are parsed
  fn pub on_headers(!! Error, headers: ref Array[(String, String)]) -> Result[Nil, String]

  # Called when text body is available (in chunks)
  fn pub on_text_chunk(!! Error, chunk: String) -> Result[Nil, String]

  # Called when HTML body is available (in chunks)
  fn pub on_html_chunk(!! Error, chunk: String) -> Result[Nil, String]

  # Called when an attachment header is parsed (metadata only)
  fn pub on_attachment_begin(!! Error, info: AttachmentInfo) -> Result[Nil, String]

  # Called when attachment data is available (in chunks)
  fn pub on_attachment_chunk(!! Error, chunk: ByteArray, info: AttachmentInfo) -> Result[Nil, String]

  # Called when attachment is complete
  fn pub on_attachment_end(!! Error, info: AttachmentInfo) -> Result[Nil, String]

  # Called when parsing completes successfully
  fn pub on_end(!! Error) -> Result[Nil, String]

  # Called when an error occurs (optional, errors also propagated to caller)
  fn pub on_error(!! Error, error: String) -> Result[Nil, String]
}

# Streaming parser for large emails
#
# Parses emails incrementally using callbacks to avoid loading entire
# message into memory. Use this for emails larger than 10MB.
type pub StreamingParser {
  let pub @config: StreamingConfig
}

impl StreamingParser {
  fn pub static new -> StreamingParser {
    StreamingParser(config: StreamingConfig.new)
  }

  fn pub static with_config(config: StreamingConfig) -> StreamingParser {
    StreamingParser(config: config)
  }

  # Parse an email using streaming callbacks
  #
  # This method parses the email incrementally, calling the handler's
  # callbacks as data becomes available. Only metadata is returned;
  # content is delivered via callbacks.
  fn pub parse_stream(
    mut self,
    raw: String,
    handler: ref mut StreamHandler,
  ) -> Result[StreamingResult, String] {
    # Notify handler that parsing is beginning
    match handler.on_begin {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error("Handler on_begin failed: ${e}")
    }

    # Normalize line endings
    let normalized = normalize_line_endings_stream(raw)
    let email_size = normalized.size

    # Check email size limit
    if email_size > @config.max_email_size {
      match handler.on_error("Email size exceeds maximum") {
        case Ok(_) -> {}
        case Error(e) -> return Result.Error("Handler on_error failed: ${e}")
      }
      return Result.Error("Email size ${email_size} exceeds maximum ${@config.max_email_size}")
    }

    # Split headers and body
    let split_pos = normalized.index_of('\n\n', 0)

    let (headers_raw, body_raw) = match split_pos {
      case Some(pos) -> {
        (
          normalized.substring(0, pos),
          normalized.substring(pos + 2, normalized.size),
        )
      }
      case None -> {
        # No body section
        (normalized.clone(), '')
      }
    }

    # Import header parsing function
    import emailparser.header (parse_headers_impl)

    # Parse headers
    let headers = match parse_headers_impl(
      headers_raw,
      @config.strict_mode,
      @config.max_email_size,
      @config.max_headers,
    ) {
      case Ok(h) -> h
      case Error(e) -> {
        match handler.on_error(e.to_message) {
          case Ok(_) -> {}
          case Error(err) -> return Result.Error("Handler on_error failed: ${err}")
        }
        return Result.Error(e.to_message)
      }
    }

    # Notify handler of headers
    match handler.on_headers(ref headers) {
      case Ok(_) -> {}
      case Error(e) => return Result.Error("Handler on_headers failed: ${e}")
    }

    # Extract metadata for result
    import emailparser.header (
      get_header_value_impl, parse_content_type_impl,
      get_param_value_impl, eq_ignore_case
    )
    import emailparser.address (parse_address_list_impl)

    # Parse addresses
    let from_raw = get_header_value_impl(ref headers, 'From')
    let from_list = parse_address_list_impl(ref from_raw, from_raw.or(''))
    let from = if from_list.empty? {
      EmailAddress(name: Option.None, address: '', raw: '')
    } else {
      match from_list.into_iter.next {
        case Some(addr) -> addr
        case None -> EmailAddress(name: Option.None, address: '', raw: '')
      }
    }

    let to = parse_address_list_impl(
      ref get_header_value_impl(ref headers, 'To'),
      get_header_value_impl(ref headers, 'To').or(''),
    )
    let cc = parse_address_list_impl(
      ref get_header_value_impl(ref headers, 'Cc'),
      get_header_value_impl(ref headers, 'Cc').or(''),
    )
    let bcc = parse_address_list_impl(
      ref get_header_value_impl(ref headers, 'Bcc'),
      get_header_value_impl(ref headers, 'Bcc').or(''),
    )

    # Extract basic headers
    import emailparser.decoder (decode_rfc2047_word)
    let subject = decode_header_value_stream(
      get_header_value_impl(ref headers, 'Subject').or(''),
    )
    let date = get_header_value_impl(ref headers, 'Date').or('')
    let message_id = get_header_value_impl(ref headers, 'Message-ID').or('')

    # Extract threading headers
    import emailparser.message_id (parse_message_ids_impl)
    let in_reply_to = get_header_value_impl(ref headers, 'In-Reply-To')
    let references = parse_message_ids_impl(
      get_header_value_impl(ref headers, 'References').or(''),
    )
    let thread_id = if references.empty? {
      message_id
    } else {
      match references.get(0) {
        case Ok(r) -> r
        case Error(_) -> message_id
      }
    }

    # Extract MIME headers
    let content_type_raw = get_header_value_impl(ref headers, 'Content-Type').or('text/plain')
    let (ct_main, ct_params) = match parse_content_type_impl(content_type_raw) {
      case Ok(result) -> result
      case Error(e) => return Result.Error(e.to_message)
    }
    let content_transfer_encoding = get_header_value_impl(ref headers, 'Content-Transfer-Encoding').or('7bit')
    let charset = get_param_value_impl(ref ct_params, 'charset')

    # Parse body based on content type
    import emailparser.validation (is_valid_boundary)
    let boundary = extract_boundary_from_params(ref ct_params)

    # Validate boundary if multipart
    if is_multipart(ct_main) {
      match boundary.clone {
        case Some(b) -> {
          if !is_valid_boundary(b.clone) {
            return Result.Error("Invalid boundary string")
          }
        }
        case None => return Result.Error("Multipart content type requires boundary parameter")
      }
    }

    # Parse body with streaming
    let attachment_count = match parse_body_stream(
      body_raw,
      ct_main,
      boundary,
      content_transfer_encoding,
      handler,
      @config,
    ) {
      case Ok(count) => count
      case Error(e) => {
        match handler.on_error(e) {
          case Ok(_) -> {}
          case Error(err) => return Result.Error("Handler on_error failed: ${err}")
        }
        return Result.Error(e)
      }
    }

    # Extract extra headers
    import emailparser.header (extract_extra_headers)
    let extra_headers = extract_extra_headers(headers)

    # Notify handler that parsing is complete
    match handler.on_end {
      case Ok(_) -> {}
      case Error(e) => return Result.Error("Handler on_end failed: ${e}")
    }

    # Return streaming result with metadata
    Result.Ok(StreamingResult(
      from: from,
      to: to,
      cc: cc,
      bcc: bcc,
      subject: subject,
      date: date,
      message_id: message_id,
      in_reply_to: in_reply_to,
      references: references,
      thread_id: thread_id,
      content_type: ct_main,
      content_transfer_encoding: content_transfer_encoding,
      charset: charset,
      extra_headers: extra_headers,
      attachment_count: attachment_count,
    ))
  }
}

# Helper functions for streaming parser

# Normalize line endings for streaming
fn normalize_line_endings_stream(text: String) -> String {
  text.replace('\r\n', '\n')
}

# Decode header value for streaming (simplified version)
fn decode_header_value_stream(raw: String) -> String {
  import emailparser.decoder (decode_rfc2047_word)
  
  let mut result = ByteArray.new
  let mut pos = 0
  
  while pos < raw.size {
    match raw.index_of('=?', pos) {
      case Some(begin) -> {
        match raw.index_of('?=', begin + 2) {
          case Some(end) -> {
            # Push text before the encoded word
            if begin > pos {
              let before = raw.substring(pos, begin)
              result.append(before.to_byte_array)
            }
            
            # Decode and push the encoded word
            let encoded_word = raw.substring(begin, end + 2)
            let decoded = decode_rfc2047_word(encoded_word)
            result.append(decoded.to_byte_array)
            
            # Move position past the encoded word
            pos = end + 2
          }
          case None -> break
        }
      }
      case None -> break
    }
  }
  
  # Push any remaining text
  if pos < raw.size {
    let remaining = raw.substring(pos, raw.size)
    result.append(remaining.to_byte_array)
  }
  
  result.into_string
}

# Extract boundary from content type params
fn extract_boundary_from_params(
  params: ref Array[(String, String)],
) -> Option[String] {
  for (key, value) in params.iter {
    if eq_ignore_case(key.clone, 'boundary') {
      return Option.Some(value.clone)
    }
  }
  Option.None
}

# Check if content type is multipart
fn is_multipart(content_type: String) -> Bool {
  content_type.starts_with?('multipart/')
}

# Check if content type is text/plain
fn is_text_plain(content_type: String) -> Bool {
  content_type == 'text/plain'
}

# Check if content type is text/html
fn is_text_html(content_type: String) -> Bool {
  content_type == 'text/html'
}

# Parse body with streaming callbacks
fn parse_body_stream(
  body_raw: String,
  ct_main: String,
  boundary: Option[String],
  content_transfer_encoding: String,
  handler: ref mut StreamHandler,
  config: StreamingConfig,
) -> Result[Int, String] {
  if is_multipart(ct_main) {
    match boundary {
      case Some(b) -> {
        parse_multipart_stream(
          body_raw,
          b,
          content_transfer_encoding,
          0,
          config.max_multipart_depth,
          config.max_attachment_size,
          config.max_headers,
          config.stream_chunk_size,
          handler,
        )
      }
      case None -> Result.Ok(0)
    }
  } else if is_text_plain(ct_main) {
    # Stream text body
    stream_text_body(body_raw, content_transfer_encoding, config.stream_chunk_size, handler)
    Result.Ok(0)
  } else if is_text_html(ct_main) {
    # Stream HTML body
    stream_html_body(body_raw, content_transfer_encoding, config.stream_chunk_size, handler)
    Result.Ok(0)
  } else {
    Result.Ok(0)
  }
}

# Stream text body in chunks
fn stream_text_body(
  body_raw: String,
  encoding: String,
  chunk_size: Int,
  handler: ref mut StreamHandler,
) {
  import emailparser.decoder (decode_body_impl)
  
  # For simplicity, decode the entire body and stream in chunks
  # A full implementation would decode incrementally
  match decode_body_impl(body_raw, encoding, 50_000_000) {
    case Ok(decoded) -> {
      let mut pos = 0
      while pos < decoded.size {
        let end = if pos + chunk_size > decoded.size {
          decoded.size
        } else {
          pos + chunk_size
        }
        let chunk = decoded.substring(pos, end)
        match handler.on_text_chunk(chunk) {
          case Ok(_) -> {}
          case Error(e) -> return
        }
        pos = end
      }
    }
    case Error(_) -> {}
  }
}

# Stream HTML body in chunks
fn stream_html_body(
  body_raw: String,
  encoding: String,
  chunk_size: Int,
  handler: ref mut StreamHandler,
) {
  import emailparser.decoder (decode_body_impl)
  
  # For simplicity, decode the entire body and stream in chunks
  # A full implementation would decode incrementally
  match decode_body_impl(body_raw, encoding, 50_000_000) {
    case Ok(decoded) -> {
      let mut pos = 0
      while pos < decoded.size {
        let end = if pos + chunk_size > decoded.size {
          decoded.size
        } else {
          pos + chunk_size
        }
        let chunk = decoded.substring(pos, end)
        match handler.on_html_chunk(chunk) {
          case Ok(_) -> {}
          case Error(e) -> return
        }
        pos = end
      }
    }
    case Error(_) -> {}
  }
}

# Parse multipart with streaming (simplified implementation)
fn parse_multipart_stream(
  raw: String,
  boundary: String,
  default_encoding: String,
  current_depth: Int,
  max_depth: Int,
  max_size: Int,
  max_headers: Int,
  chunk_size: Int,
  handler: ref mut StreamHandler,
) -> Result[Int, String] {
  import emailparser.header (parse_headers_impl, get_header_value_impl, parse_content_type_impl, get_param_value_impl, eq_ignore_case)
  import emailparser.decoder (decode_body_impl)
  
  if current_depth >= max_depth {
    return Result.Error("Maximum multipart depth exceeded")
  }
  
  let boundary_marker = '--' + boundary
  let end_marker = '--' + boundary + '--'
  
  let mut attachment_count = 0
  let mut pos = 0
  
  # Find first boundary
  match raw.index_of(boundary_marker, 0) {
    case Some(first_pos) -> pos = first_pos + boundary_marker.size
    case None -> return Result.Ok(0)
  }
  
  # Process each part
  while pos < raw.size {
    # Skip whitespace after boundary
    while pos < raw.size && (raw.byte_at(pos) == 10 /* \n */ || raw.byte_at(pos) == 13 /* \r */) {
      pos = pos + 1
    }
    
    # Check for end marker
    if pos + end_marker.size <= raw.size {
      let substring = raw.substring(pos, pos + end_marker.size)
      if substring == end_marker {
        break
      }
    }
    
    # Find next boundary
    let next_boundary = match raw.index_of(boundary_marker, pos) {
      case Some(p) -> p
      case None => raw.size
    }
    
    # Extract part content
    let part_content = raw.substring(pos, next_boundary)
    
    # Split part headers and body
    let part_split = part_content.index_of('\n\n', 0)
    match part_split {
      case Some(split_pos) => {
        let part_headers_raw = part_content.substring(0, split_pos)
        let part_body_raw = part_content.substring(split_pos + 2, part_content.size)
        
        # Parse part headers
        match parse_headers_impl(part_headers_raw, false, max_size, max_headers) {
          case Ok(part_headers) => {
            # Get content disposition to determine if attachment
            let content_disposition = get_header_value_impl(ref part_headers, 'Content-Disposition').or('')
            let content_type = get_header_value_impl(ref part_headers, 'Content-Type').or('application/octet-stream')
            let content_transfer_encoding = get_header_value_impl(ref part_headers, 'Content-Transfer-Encoding').or(default_encoding)
            
            # Check if this is an attachment
            if content_disposition.starts_with?('attachment') || content_disposition.starts_with?('file') {
              # Extract attachment info
              let filename = extract_filename(content_disposition)
              
              let info = AttachmentInfo(
                index: attachment_count,
                content_type: content_type,
                filename: filename,
                content_disposition: content_disposition,
                content_id: get_header_value_impl(ref part_headers, 'Content-ID'),
                size: part_body_raw.size,
                transfer_encoding: content_transfer_encoding,
              )
              
              # Notify handler of attachment begin
              match handler.on_attachment_begin(info) {
                case Ok(_) -> {}
                case Error(e) => return Result.Error("Handler on_attachment_begin failed: ${e}")
              }
              
              # Decode and stream attachment
              match decode_body_impl(part_body_raw, content_transfer_encoding, max_size) {
                case Ok(decoded) -> {
                  # Stream in chunks
                  let mut chunk_pos = 0
                  while chunk_pos < decoded.size {
                    let chunk_end = if chunk_pos + chunk_size > decoded.size {
                      decoded.size
                    } else {
                      chunk_pos + chunk_size
                    }
                    let chunk = decoded.substring(chunk_pos, chunk_end).to_byte_array
                    match handler.on_attachment_chunk(chunk, info) {
                      case Ok(_) -> {}
                      case Error(e) => return Result.Error("Handler on_attachment_chunk failed: ${e}")
                    }
                    chunk_pos = chunk_end
                  }
                }
                case Error(_) -> {}
              }
              
              # Notify handler of attachment end
              match handler.on_attachment_end(info) {
                case Ok(_) -> {}
                case Error(e) => return Result.Error("Handler on_attachment_end failed: ${e}")
              }
              
              attachment_count = attachment_count + 1
            } else {
              # Check if text/plain or text/html body
              if is_text_plain(content_type) {
                stream_text_body(part_body_raw, content_transfer_encoding, chunk_size, handler)
              } else if is_text_html(content_type) {
                stream_html_body(part_body_raw, content_transfer_encoding, chunk_size, handler)
              }
            }
          }
          case Error(e) => {}
        }
      }
      case None => {}
    }
    
    # Move to next part
    pos = next_boundary
    if pos + boundary_marker.size <= raw.size {
      pos = pos + boundary_marker.size
    } else {
      break
    }
  }
  
  Result.Ok(attachment_count)
}

# Extract filename from content disposition
fn extract_filename(content_disposition: String) -> Option[String] {
  # Simple extraction - looks for filename= parameter
  let filename_key = 'filename='
  match content_disposition.index_of(filename_key, 0) {
    case Some(pos) -> {
      let start = pos + filename_key.size
      if start >= content_disposition.size {
        return Option.None
      }
      
      # Check for quoted filename
      if content_disposition.byte_at(start) == 34 { # '"'
        let end = match content_disposition.index_of('"', start + 1) {
          case Some(e) => e
          case None => content_disposition.size
        }
        if end > start + 1 {
          return Option.Some(content_disposition.substring(start + 1, end))
        }
      } else {
        # Unquoted filename - read until space or semicolon
        let mut end = start
        while end < content_disposition.size {
          let byte = content_disposition.byte_at(end)
          if byte == 32 /* space */ || byte == 59 /* ; */ {
            break
          }
          end = end + 1
        }
        if end > start {
          return Option.Some(content_disposition.substring(start, end))
        }
      }
    }
    case None -> {}
  }
  Option.None
}
