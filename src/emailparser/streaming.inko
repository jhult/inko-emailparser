# Streaming API for parsing large emails without loading entire message into memory.
#
# This module provides a callback-based streaming API that enables progressive
# parsing of email components as they become available, dramatically reducing
# memory consumption for large messages.
#
# See docs/streaming-api.md for complete design documentation.

import emailparser (validate_addresses, validate_required_headers)
import emailparser.address (EmailAddress)
import emailparser.decoder (decode_body_bytes_impl, decode_body_impl)
import emailparser.error (Error, Severity, is_recoverable_part_error)
import emailparser.header (
  extract_extra_headers, extract_filename_param, get_header_value_impl,
  get_param_value_impl, parse_content_disposition_impl, parse_content_type_impl,
  parse_headers_impl, split_header_body,
)
import emailparser.header_extraction (
  parse_address_headers, parse_basic_headers, parse_mime_metadata,
  parse_threading_headers, validate_multipart_boundary,
)
import emailparser.limits (
  MAX_ATTACHMENTS, MAX_ATTACHMENT_SIZE, MAX_EMAIL_SIZE, MAX_HEADERS,
  MAX_HEADERS_SECTION_SIZE, MAX_MULTIPART_DEPTH,
)
import emailparser.mime (
  extract_boundary, is_multipart, is_text_html, is_text_plain,
)
import emailparser.streaming_decoder (
  Base64StreamingDecoder, QuotedPrintableStreamingDecoder,
)
import emailparser.streaming_multipart (
  MultipartStreamHandler, MultipartStreamParser,
)
import emailparser.streaming_reader (AsyncReader)
import std.bytes (ByteArray)
import std.option (Option)
import std.result (Result)

# Attachment metadata (without content)
type pub AttachmentInfo {
  let pub @index: Int # Attachment number (0-based)
  let pub @content_type: String
  let pub @filename: Option[String]
  let pub @content_disposition: String
  let pub @content_id: Option[String]
  let pub @size: Int # Total size (if known)
  let pub @transfer_encoding: String
}

# Streaming result contains metadata but not content
type pub StreamingResult {
  let pub @from: EmailAddress
  let pub @to: Array[EmailAddress]
  let pub @cc: Array[EmailAddress]
  let pub @bcc: Array[EmailAddress]
  let pub @subject: String
  let pub @date: String
  let pub @message_id: String
  let pub @in_reply_to: Option[String]
  let pub @references: Array[String]
  let pub @thread_id: String
  let pub @content_type: String
  let pub @content_transfer_encoding: String
  let pub @charset: Option[String]
  let pub @extra_headers: Array[(String, String)]
  let pub @attachment_count: Int

  # NOTE: No @text_body, @html_body, @attachments - content is streamed
}

# Streaming configuration
type pub StreamingConfig {
  let pub mut @strict_mode: Bool
  let pub mut @max_email_size: Int
  let pub mut @max_attachment_size: Int
  let pub mut @max_multipart_depth: Int
  let pub mut @max_headers: Int
  let pub mut @max_attachments: Int
  let pub mut @stream_chunk_size: Int # Bytes to process per callback
}

impl StreamingConfig {
  fn pub static new -> StreamingConfig {
    StreamingConfig(
      strict_mode: false,
      max_email_size: MAX_EMAIL_SIZE,
      max_attachment_size: MAX_ATTACHMENT_SIZE,
      max_multipart_depth: MAX_MULTIPART_DEPTH,
      max_headers: MAX_HEADERS,
      max_attachments: MAX_ATTACHMENTS,
      stream_chunk_size: 65536,
    )
  }
}

# Trait for handling streaming parser events
#
# Implement this trait to process email data incrementally.
trait pub StreamHandler {
  # Called when parsing begins
  fn pub mut on_begin -> Result[Int, String]

  # Called when headers are parsed
  fn pub mut on_headers(
    headers: ref Array[(String, String)],
  ) -> Result[Int, String]

  # Called when text body is available (in chunks)
  fn pub mut on_text_chunk(chunk: String) -> Result[Int, String]

  # Called when HTML body is available (in chunks)
  fn pub mut on_html_chunk(chunk: String) -> Result[Int, String]

  # Called when an attachment header is parsed (metadata only)
  fn pub mut on_attachment_begin(
    info: ref AttachmentInfo,
  ) -> Result[Int, String]

  # Called when attachment data is available (in chunks)
  fn pub mut on_attachment_chunk(
    chunk: ByteArray,
    info: ref AttachmentInfo,
  ) -> Result[Int, String]

  # Called when attachment is complete
  fn pub mut on_attachment_end(info: ref AttachmentInfo) -> Result[Int, String]

  # Called when parsing completes successfully
  fn pub mut on_end -> Result[Int, String]

  # Called when an error occurs (optional, errors also propagated to caller)
  #
  # The error is passed by reference so the parser can still return it to the
  # caller afterwards. Use `to_message` to render it for display.
  fn pub mut on_error(error: ref Error) -> Result[Int, String]
}

# Streaming parser for large emails
#
# Parses emails incrementally using callbacks to avoid loading entire
# message into memory. Use this for emails larger than 10MB.
type pub StreamingParser {
  let pub @config: StreamingConfig
}

impl StreamingParser {
  fn pub static new -> StreamingParser {
    StreamingParser(config: StreamingConfig.new)
  }

  fn pub static with_config(config: StreamingConfig) -> StreamingParser {
    StreamingParser(config: config)
  }

  # Parse an email using streaming callbacks
  #
  # This method parses the email incrementally, calling the handler's
  # callbacks as data becomes available. Only metadata is returned;
  # content is delivered via callbacks.
  fn pub mut parse_stream[H: mut + StreamHandler](
    raw: String,
    handler: mut H,
  ) -> Result[StreamingResult, Error] {
    match validate_stream_chunk_size(@config.stream_chunk_size) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    # Notify handler that parsing is beginning
    match handler.on_begin {
      case Ok(_) -> {}
      case Error(e) -> {
        return Result.Error(Error.from_string('Handler on_begin failed: ${e}'))
      }
    }

    # Normalize line endings
    let normalized = normalize_line_endings_stream(raw)
    let email_size = normalized.size

    # Check email size limit
    if email_size > @config.max_email_size {
      let failure = Error.EmailSizeExceeded(
        Severity.Error,
        @config.max_email_size,
        email_size,
        Option.None,
        Option.None,
      )

      match handler.on_error(failure) {
        case Ok(_) -> {}
        case Error(e) -> {
          return Result.Error(
            Error.from_string('Handler on_error failed: ${e}'),
          )
        }
      }

      return Result.Error(failure)
    }

    # Split headers and body (byte-offset safe for non-ASCII headers)
    let (headers_raw, body_raw) = split_header_body(normalized)

    # Parse headers
    let headers = match
      parse_headers_impl(
        headers_raw,
        @config.strict_mode,
        MAX_HEADERS_SECTION_SIZE,
        @config.max_headers,
      )
    {
      case Ok(h) -> h
      case Error(e) -> {
        match handler.on_error(e) {
          case Ok(_) -> {}
          case Error(err) -> {
            return Result.Error(
              Error.from_string('Handler on_error failed: ${err}'),
            )
          }
        }

        return Result.Error(e)
      }
    }

    # Notify handler of headers
    match handler.on_headers(ref headers) {
      case Ok(_) -> {}
      case Error(e) -> {
        return Result.Error(
          Error.from_string('Handler on_headers failed: ${e}'),
        )
      }
    }

    # Extract metadata for result
    let (from, to, cc, bcc) = parse_address_headers(ref headers)
    let (subject, date, message_id) = parse_basic_headers(ref headers)
    let (in_reply_to, references, thread_id) = parse_threading_headers(
      ref headers,
    )

    # Run the same validators as the buffered parser
    match validate_required_headers(ref headers, @config.strict_mode) {
      case Ok(_) -> {}
      case Error(e) -> {
        match handler.on_error(e) {
          case Ok(_) -> {}
          case Error(err) -> {
            return Result.Error(
              Error.from_string('Handler on_error failed: ${err}'),
            )
          }
        }

        return Result.Error(e)
      }
    }

    match
      validate_addresses(ref from, ref to, ref cc, ref bcc, @config.strict_mode)
    {
      case Ok(_) -> {}
      case Error(e) -> {
        match handler.on_error(e) {
          case Ok(_) -> {}
          case Error(err) -> {
            return Result.Error(
              Error.from_string('Handler on_error failed: ${err}'),
            )
          }
        }

        return Result.Error(e)
      }
    }

    let (ct_main, ct_params, content_transfer_encoding, charset) = match
      parse_mime_metadata(ref headers, @config.strict_mode)
    {
      case Ok(result) -> result
      case Error(e) -> return Result.Error(e)
    }

    # Parse body based on content type
    let boundary = extract_boundary(ref ct_params)

    # Validate boundary if multipart
    match validate_multipart_boundary(ct_main.clone, ref boundary) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    # Metadata used when the whole message is a single non-text part
    let single_attachment_info = single_part_attachment_info(
      ref headers,
      ct_main,
      content_transfer_encoding,
      @config.strict_mode,
    )

    # Parse body with streaming
    let attachment_count = match
      parse_body_stream(
        body_raw,
        ct_main,
        boundary,
        content_transfer_encoding,
        single_attachment_info,
        handler,
        @config,
      )
    {
      case Ok(count) -> count
      case Error(e) -> {
        let failure = e

        match handler.on_error(failure) {
          case Ok(_) -> {}
          case Error(err) -> {
            return Result.Error(
              Error.from_string('Handler on_error failed: ${err}'),
            )
          }
        }

        return Result.Error(failure)
      }
    }

    # Extract extra headers
    let extra_headers = extract_extra_headers(headers)

    # Notify handler that parsing is complete
    match handler.on_end {
      case Ok(_) -> {}
      case Error(e) -> {
        return Result.Error(Error.from_string('Handler on_end failed: ${e}'))
      }
    }

    # Return streaming result with metadata
    Result.Ok(
      StreamingResult(
        from: from,
        to: to,
        cc: cc,
        bcc: bcc,
        subject: subject,
        date: date,
        message_id: message_id,
        in_reply_to: in_reply_to,
        references: references,
        thread_id: thread_id,
        content_type: ct_main,
        content_transfer_encoding: content_transfer_encoding,
        charset: charset,
        extra_headers: extra_headers,
        attachment_count: attachment_count,
      ),
    )
  }

  # Parse an email using streaming callbacks from async source
  #
  # This async version of parse_stream allows for async processing of callbacks.
  # Returns the same result as parse_stream but handlers can perform async operations.
  fn pub mut parse_async_raw[H: mut + StreamHandler](
    raw: String,
    handler: mut H,
  ) -> Result[StreamingResult, Error] {
    # Delegate to parse_stream since the logic is identical
    # The difference is in the trait constraint which allows async handlers
    self.parse_stream(raw, handler)
  }

  # Report a failure to the handler and return the error to propagate
  #
  # Every failure in the async reader path funnels through here so `on_error`
  # is called exactly once per failure, including failures that used to skip it
  # (metadata parsing, boundary validation, header-section limits).
  fn notify_error[H: mut + StreamHandler](
    handler: mut H,
    failure: Error,
  ) -> Error {
    match handler.on_error(ref failure) {
      case Ok(_) -> failure
      case Error(e) -> Error.from_string('Handler on_error failed: ${e}')
    }
  }

  # Parse an email from an async reader using streaming callbacks
  #
  # Reads email data incrementally from an async reader and processes it using
  # callbacks. Body data is processed incrementally without buffering the entire
  # body in memory.
  fn pub mut parse_async_reader[H: mut + StreamHandler, R: mut + AsyncReader](
    reader: mut R,
    handler: mut H,
  ) -> Result[StreamingResult, Error] {
    match validate_stream_chunk_size(@config.stream_chunk_size) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    match handler.on_begin {
      case Ok(_) -> {}
      case Error(e) -> {
        return Result.Error(Error.from_string('Handler on_begin failed: ${e}'))
      }
    }

    let mut buffer = ByteArray.new
    let mut headers: Array[(String, String)] = []
    let mut initial_body = ByteArray.new
    let mut headers_parsed = false

    let chunk_size = @config.stream_chunk_size
    let mut total_bytes = 0

    # Phase 1: Read chunks until headers are parsed
    loop {
      match reader.read(chunk_size) {
        case Ok(chunk) -> {
          if chunk.size == 0 { break }

          total_bytes = total_bytes + chunk.size

          if total_bytes > @config.max_email_size {
            let failure = Error.EmailSizeExceeded(
              Severity.Error,
              @config.max_email_size,
              total_bytes,
              Option.None,
              Option.None,
            )

            return Result.Error(notify_error(handler, failure))
          }

          let mut i = 0

          while i < chunk.size {
            match chunk.get(i) {
              case Ok(byte) -> buffer.push(byte)
              case Error(_) -> {}
            }

            i = i + 1
          }

          let buffer_str = buffer.clone.into_string
          let separator = find_header_separator(buffer_str)

          match separator {
            case Some((pos, separator_size)) -> {
              let headers_raw = buffer_str.slice(0, pos).to_string

              headers = match
                parse_headers_impl(
                  headers_raw,
                  @config.strict_mode,
                  MAX_HEADERS_SECTION_SIZE,
                  @config.max_headers,
                )
              {
                case Ok(h) -> h
                case Error(e) -> return Result.Error(notify_error(handler, e))
              }

              match handler.on_headers(ref headers) {
                case Ok(_) -> {}
                case Error(e) -> {
                  return Result.Error(
                    Error.from_string('Handler on_headers failed: ${e}'),
                  )
                }
              }

              headers_parsed = true

              # Extract body bytes remaining in buffer after headers
              let mut j = pos + separator_size

              while j < buffer.size {
                match buffer.get(j) {
                  case Ok(byte) -> initial_body.push(byte)
                  case Error(_) -> {}
                }

                j = j + 1
              }

              break
            }
            case None -> {
              if buffer.size > MAX_HEADERS_SECTION_SIZE {
                let failure = Error.HeaderSectionTooLarge(
                  Severity.Error,
                  buffer.size,
                  MAX_HEADERS_SECTION_SIZE,
                  Option.None,
                  Option.None,
                  Option.None,
                )

                return Result.Error(notify_error(handler, failure))
              }
            }
          }
        }
        case Error(e) -> {
          let failure = Error.from_string(e)

          return Result.Error(notify_error(handler, failure))
        }
      }
    }

    # EOF before a header/body separator: treat the accumulated bytes as the
    # header section with an empty body, matching `parse_stream`. Without this
    # a truncated stream silently lost the subject, sender and thread info.
    if !headers_parsed {
      let headers_raw = buffer.clone.into_string

      headers = match
        parse_headers_impl(
          headers_raw,
          @config.strict_mode,
          MAX_HEADERS_SECTION_SIZE,
          @config.max_headers,
        )
      {
        case Ok(h) -> h
        case Error(e) -> return Result.Error(notify_error(handler, e))
      }

      match handler.on_headers(ref headers) {
        case Ok(_) -> {}
        case Error(e) -> {
          return Result.Error(
            Error.from_string('Handler on_headers failed: ${e}'),
          )
        }
      }
    }

    # Extract metadata from headers
    let (from, to, cc, bcc) = parse_address_headers(ref headers)
    let (subject, date, message_id) = parse_basic_headers(ref headers)
    let (in_reply_to, references, thread_id) = parse_threading_headers(
      ref headers,
    )

    # Run the same validators as the buffered parser
    match validate_required_headers(ref headers, @config.strict_mode) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(notify_error(handler, e))
    }

    match
      validate_addresses(ref from, ref to, ref cc, ref bcc, @config.strict_mode)
    {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(notify_error(handler, e))
    }

    let (ct_main, ct_params, content_transfer_encoding, charset) = match
      parse_mime_metadata(ref headers, @config.strict_mode)
    {
      case Ok(result) -> result
      case Error(e) -> return Result.Error(notify_error(handler, e))
    }
    let boundary = extract_boundary(ref ct_params)

    match validate_multipart_boundary(ct_main.clone, ref boundary) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(notify_error(handler, e))
    }

    # Phase 2: Process body incrementally
    let single_attachment_info = single_part_attachment_info(
      ref headers,
      ct_main,
      content_transfer_encoding,
      @config.strict_mode,
    )

    let attachment_count = if is_multipart(ct_main) {
      match boundary.clone {
        case Some(b) -> {
          match
            process_body_reader_multipart(
              reader,
              initial_body,
              b,
              content_transfer_encoding,
              @config.max_multipart_depth,
              @config.max_attachment_size,
              @config.max_headers,
              @config.strict_mode,
              @config.max_attachments,
              chunk_size,
              @config.max_email_size,
              total_bytes,
              handler,
            )
          {
            case Ok(count) -> count
            case Error(e) -> return Result.Error(notify_error(handler, e))
          }
        }
        case None -> 0
      }
    } else if is_text_plain(ct_main) or is_text_html(ct_main) {
      match
        process_body_reader_text(
          reader,
          initial_body,
          content_transfer_encoding,
          is_text_html(ct_main),
          chunk_size,
          @config.max_attachment_size,
          @config.strict_mode,
          @config.max_email_size,
          total_bytes,
          handler,
        )
      {
        case Ok(_) -> 0
        case Error(e) -> {
          let failure = e

          match handler.on_error(failure) {
            case Ok(_) -> {}
            case Error(err) -> {
              return Result.Error(
                Error.from_string('Handler on_error failed: ${err}'),
              )
            }
          }

          return Result.Error(failure)
        }
      }
    } else {
      match
        process_attachment_reader(
          reader,
          initial_body,
          single_attachment_info,
          content_transfer_encoding,
          chunk_size,
          @config.max_attachment_size,
          @config.strict_mode,
          @config.max_email_size,
          total_bytes,
          handler,
        )
      {
        case Ok(_) -> 1
        case Error(e) -> {
          let failure = e

          match handler.on_error(failure) {
            case Ok(_) -> {}
            case Error(err) -> {
              return Result.Error(
                Error.from_string('Handler on_error failed: ${err}'),
              )
            }
          }

          return Result.Error(failure)
        }
      }
    }

    let extra_headers = extract_extra_headers(headers)

    match handler.on_end {
      case Ok(_) -> {}
      case Error(e) -> {
        return Result.Error(Error.from_string('Handler on_end failed: ${e}'))
      }
    }

    Result.Ok(
      StreamingResult(
        from: from,
        to: to,
        cc: cc,
        bcc: bcc,
        subject: subject,
        date: date,
        message_id: message_id,
        in_reply_to: in_reply_to,
        references: references,
        thread_id: thread_id,
        content_type: ct_main,
        content_transfer_encoding: content_transfer_encoding,
        charset: charset,
        extra_headers: extra_headers,
        attachment_count: attachment_count,
      ),
    )
  }
}

# Helper functions for streaming parser

# Normalize line endings for streaming
fn normalize_line_endings_stream(text: String) -> String {
  text.replace('\r\n', '\n')
}

# Find the end of the header section
#
# Returns the position of the separator and its length (2 for "\n\n", 4 for
# "\r\n\r\n"), or None when the headers are not complete yet.
fn find_header_separator(text: String) -> Option[(Int, Int)] {
  let lf = text.index_of('\n\n', 0)
  let crlf = text.index_of('\r\n\r\n', 0)

  match lf {
    case Some(lf_pos) -> {
      match crlf {
        case Some(crlf_pos) -> {
          if crlf_pos < lf_pos {
            Option.Some((crlf_pos, 4))
          } else {
            Option.Some((lf_pos, 2))
          }
        }
        case None -> Option.Some((lf_pos, 2))
      }
    }
    case None -> {
      match crlf {
        case Some(crlf_pos) -> Option.Some((crlf_pos, 4))
        case None -> Option.None
      }
    }
  }
}

# Parse body with streaming callbacks
fn parse_body_stream[H: mut + StreamHandler](
  body_raw: String,
  ct_main: String,
  boundary: Option[String],
  content_transfer_encoding: String,
  attachment_info: AttachmentInfo,
  handler: mut H,
  config: mut StreamingConfig,
) -> Result[Int, Error] {
  if is_multipart(ct_main) {
    match boundary {
      case Some(b) -> {
        parse_multipart_stream(
          body_raw,
          b,
          content_transfer_encoding,
          0,
          config.max_multipart_depth,
          config.max_attachment_size,
          config.max_headers,
          config.strict_mode,
          config.max_attachments,
          config.stream_chunk_size,
          handler,
        )
      }
      case None -> Result.Ok(0)
    }
  } else if is_text_plain(ct_main) {
    stream_text_body(
      body_raw,
      content_transfer_encoding,
      config.stream_chunk_size,
      config.max_attachment_size,
      config.strict_mode,
      handler,
    )
  } else if is_text_html(ct_main) {
    stream_html_body(
      body_raw,
      content_transfer_encoding,
      config.stream_chunk_size,
      config.max_attachment_size,
      config.strict_mode,
      handler,
    )
  } else {
    stream_single_attachment(
      body_raw,
      attachment_info,
      content_transfer_encoding,
      config.stream_chunk_size,
      config.max_attachment_size,
      handler,
    )
  }
}

# Stream body in chunks (shared helper)
fn stream_body_impl[H: mut + StreamHandler](
  body_raw: String,
  encoding: String,
  chunk_size: Int,
  max_size: Int,
  is_html: Bool,
  strict_mode: Bool,
  handler: mut H,
) -> Result[Int, Error] {
  let encoding_lower = encoding.to_lower

  if encoding_lower == 'base64' {
    let mut d = Base64StreamingDecoder.new(max_size, strict_mode)

    match d.feed(body_raw) {
      case Ok(decoded) -> {
        if decoded.size > 0 {
          match
            send_text_chunks(decoded.into_string, chunk_size, is_html, handler)
          {
            case Ok(_) -> {}
            case Error(e) -> return Result.Error(e)
          }
        }

        match d.finish {
          case Ok(decoded) -> {
            if decoded.size > 0 {
              match
                send_text_chunks(
                  decoded.into_string,
                  chunk_size,
                  is_html,
                  handler,
                )
              {
                case Ok(_) -> {}
                case Error(e) -> return Result.Error(e)
              }
            }
          }
          case Error(e) -> return Result.Error(Error.from_string(e))
        }
      }
      case Error(e) -> return Result.Error(Error.from_string(e))
    }
  } else if encoding_lower == 'quoted-printable' {
    let mut d = QuotedPrintableStreamingDecoder.new(max_size, true, false)

    match d.feed(body_raw) {
      case Ok(decoded) -> {
        if decoded.size > 0 {
          match
            send_text_chunks(decoded.into_string, chunk_size, is_html, handler)
          {
            case Ok(_) -> {}
            case Error(e) -> return Result.Error(e)
          }
        }

        match d.finish {
          case Ok(decoded) -> {
            if decoded.size > 0 {
              match
                send_text_chunks(
                  decoded.into_string,
                  chunk_size,
                  is_html,
                  handler,
                )
              {
                case Ok(_) -> {}
                case Error(e) -> return Result.Error(e)
              }
            }
          }
          case Error(e) -> return Result.Error(Error.from_string(e))
        }
      }
      case Error(e) -> return Result.Error(Error.from_string(e))
    }
  } else {
    match decode_body_impl(body_raw, encoding, max_size) {
      case Ok(decoded) -> {
        match send_text_chunks(decoded, chunk_size, is_html, handler) {
          case Ok(_) -> {}
          case Error(e) -> return Result.Error(e)
        }
      }
      case Error(_) -> {}
    }
  }

  Result.Ok(0)
}

# Stream text body in chunks
fn stream_text_body[H: mut + StreamHandler](
  body_raw: String,
  encoding: String,
  chunk_size: Int,
  max_size: Int,
  strict_mode: Bool,
  handler: mut H,
) -> Result[Int, Error] {
  stream_body_impl(
    body_raw,
    encoding,
    chunk_size,
    max_size,
    false,
    strict_mode,
    handler,
  )
}

# Stream HTML body in chunks
fn stream_html_body[H: mut + StreamHandler](
  body_raw: String,
  encoding: String,
  chunk_size: Int,
  max_size: Int,
  strict_mode: Bool,
  handler: mut H,
) -> Result[Int, Error] {
  stream_body_impl(
    body_raw,
    encoding,
    chunk_size,
    max_size,
    true,
    strict_mode,
    handler,
  )
}

# Process text/html body incrementally from an async reader
#
# Creates the appropriate decoder and feeds initial body data plus subsequent
# chunks from the reader through it, streaming decoded text/html to the handler.
fn process_body_reader_text[H: mut + StreamHandler, R: mut + AsyncReader](
  reader: mut R,
  initial_body: ByteArray,
  encoding: String,
  is_html: Bool,
  chunk_size: Int,
  max_size: Int,
  strict_mode: Bool,
  max_email_size: Int,
  start_total_bytes: Int,
  handler: mut H,
) -> Result[Int, Error] {
  let mut total_bytes = start_total_bytes
  let encoding_lower = encoding.to_lower

  if encoding_lower == 'base64' {
    let mut decoder = Base64StreamingDecoder.new(max_size, strict_mode)

    # Feed initial body data
    if initial_body.size > 0 {
      match decoder.feed(initial_body.into_string) {
        case Ok(decoded) -> {
          if decoded.size > 0 {
            match
              send_text_chunks(
                decoded.into_string,
                chunk_size,
                is_html,
                handler,
              )
            {
              case Ok(_) -> {}
              case Error(e) -> return Result.Error(e)
            }
          }
        }
        case Error(e) -> return Result.Error(Error.from_string(e))
      }
    }

    # Read and feed remaining chunks from reader
    loop {
      match reader.read(chunk_size) {
        case Ok(chunk) -> {
          if chunk.size == 0 { break }

          total_bytes = total_bytes + chunk.size

          if total_bytes > max_email_size {
            return Result.Error(
              Error.EmailSizeExceeded(
                Severity.Error,
                max_email_size,
                total_bytes,
                Option.None,
                Option.None,
              ),
            )
          }

          match decoder.feed(chunk.into_string) {
            case Ok(decoded) -> {
              if decoded.size > 0 {
                match
                  send_text_chunks(
                    decoded.into_string,
                    chunk_size,
                    is_html,
                    handler,
                  )
                {
                  case Ok(_) -> {}
                  case Error(e) -> return Result.Error(e)
                }
              }
            }
            case Error(e) -> return Result.Error(Error.from_string(e))
          }
        }
        case Error(e) -> return Result.Error(Error.from_string(e))
      }
    }

    # Finish decoder
    match decoder.finish {
      case Ok(decoded) -> {
        if decoded.size > 0 {
          match
            send_text_chunks(decoded.into_string, chunk_size, is_html, handler)
          {
            case Ok(_) -> {}
            case Error(e) -> return Result.Error(e)
          }
        }
      }
      case Error(e) -> return Result.Error(Error.from_string(e))
    }
  } else if encoding_lower == 'quoted-printable' {
    let mut decoder = QuotedPrintableStreamingDecoder.new(max_size, true, false)

    # Feed initial body data
    if initial_body.size > 0 {
      match decoder.feed(initial_body.into_string) {
        case Ok(decoded) -> {
          if decoded.size > 0 {
            match
              send_text_chunks(
                decoded.into_string,
                chunk_size,
                is_html,
                handler,
              )
            {
              case Ok(_) -> {}
              case Error(e) -> return Result.Error(e)
            }
          }
        }
        case Error(e) -> return Result.Error(Error.from_string(e))
      }
    }

    # Read and feed remaining chunks from reader
    loop {
      match reader.read(chunk_size) {
        case Ok(chunk) -> {
          if chunk.size == 0 { break }

          total_bytes = total_bytes + chunk.size

          if total_bytes > max_email_size {
            return Result.Error(
              Error.EmailSizeExceeded(
                Severity.Error,
                max_email_size,
                total_bytes,
                Option.None,
                Option.None,
              ),
            )
          }

          match decoder.feed(chunk.into_string) {
            case Ok(decoded) -> {
              if decoded.size > 0 {
                match
                  send_text_chunks(
                    decoded.into_string,
                    chunk_size,
                    is_html,
                    handler,
                  )
                {
                  case Ok(_) -> {}
                  case Error(e) -> return Result.Error(e)
                }
              }
            }
            case Error(e) -> return Result.Error(Error.from_string(e))
          }
        }
        case Error(e) -> return Result.Error(Error.from_string(e))
      }
    }

    # Finish decoder
    match decoder.finish {
      case Ok(decoded) -> {
        if decoded.size > 0 {
          match
            send_text_chunks(decoded.into_string, chunk_size, is_html, handler)
          {
            case Ok(_) -> {}
            case Error(e) -> return Result.Error(e)
          }
        }
      }
      case Error(e) -> return Result.Error(Error.from_string(e))
    }
  } else {
    # Passthrough encoding (7bit, 8bit, binary)
    if initial_body.size > 0 {
      match decode_body_impl(initial_body.into_string, encoding, max_size) {
        case Ok(decoded) -> {
          match send_text_chunks(decoded, chunk_size, is_html, handler) {
            case Ok(_) -> {}
            case Error(e) -> return Result.Error(e)
          }
        }
        case Error(_) -> {}
      }
    }

    loop {
      match reader.read(chunk_size) {
        case Ok(chunk) -> {
          if chunk.size == 0 { break }

          total_bytes = total_bytes + chunk.size

          if total_bytes > max_email_size {
            return Result.Error(
              Error.EmailSizeExceeded(
                Severity.Error,
                max_email_size,
                total_bytes,
                Option.None,
                Option.None,
              ),
            )
          }

          match decode_body_impl(chunk.into_string, encoding, max_size) {
            case Ok(decoded) -> {
              match send_text_chunks(decoded, chunk_size, is_html, handler) {
                case Ok(_) -> {}
                case Error(e) -> return Result.Error(e)
              }
            }
            case Error(e) -> return Result.Error(e)
          }
        }
        case Error(e) -> return Result.Error(Error.from_string(e))
      }
    }
  }

  Result.Ok(0)
}

# Reject a zero or negative chunk size before it can cause an infinite loop
fn validate_stream_chunk_size(chunk_size: Int) -> Result[Nil, Error] {
  if chunk_size <= 0 {
    return Result.Error(
      Error.from_string('stream_chunk_size must be greater than 0'),
    )
  }

  Result.Ok(nil)
}

# Send decoded text/html in sized chunks to the handler
fn send_text_chunks[H: mut + StreamHandler](
  decoded_str: String,
  chunk_size: Int,
  is_html: Bool,
  handler: mut H,
) -> Result[Int, Error] {
  if chunk_size <= 0 {
    return Result.Error(Error.from_string('chunk size must be greater than 0'))
  }

  let mut pos = 0

  while pos < decoded_str.size {
    let end = if pos + chunk_size > decoded_str.size {
      decoded_str.size
    } else {
      pos + chunk_size
    }
    # `slice` takes byte offsets, matching `size`; `substring` is char based.
    let chunk = decoded_str.slice(pos, end).to_string

    let result = if is_html {
      handler.on_html_chunk(chunk)
    } else {
      handler.on_text_chunk(chunk)
    }

    match result {
      case Ok(_) -> {}
      case Error(e) -> {
        return Result.Error(
          Error.from_string('Handler text callback failed: ${e}'),
        )
      }
    }

    pos = end
  }

  Result.Ok(0)
}

# Build the attachment metadata for a message whose whole body is one part
fn single_part_attachment_info(
  headers: ref Array[(String, String)],
  content_type: String,
  encoding: String,
  strict_mode: Bool,
) -> AttachmentInfo {
  let mut disposition = 'attachment'
  let mut filename = Option.None

  match get_header_value_impl(headers, 'Content-Disposition') {
    case Some(raw) -> {
      match parse_content_disposition_impl(raw, strict_mode) {
        case Ok((disp, params)) -> {
          if !disp.empty? { disposition = disp }

          match get_param_value_impl(ref params, 'filename') {
            case Some(f) -> filename = Option.Some(f)
            case None -> {}
          }
        }
        case Error(_) -> {}
      }
    }
    case None -> {}
  }

  let mut content_id = Option.None

  match get_header_value_impl(headers, 'Content-ID') {
    case Some(id) -> content_id = Option.Some(id.trim)
    case None -> {}
  }

  AttachmentInfo(
    index: 0,
    content_type: content_type,
    filename: filename,
    content_disposition: disposition,
    content_id: content_id,
    size: 0,
    transfer_encoding: encoding,
  )
}

# Deliver an attachment body in chunks of at most `chunk_size` bytes
fn send_attachment_chunks[H: mut + StreamHandler](
  decoded: ref ByteArray,
  chunk_size: Int,
  info: ref AttachmentInfo,
  handler: mut H,
) -> Result[Int, Error] {
  if chunk_size <= 0 {
    return Result.Error(Error.from_string('chunk size must be greater than 0'))
  }

  let mut pos = 0

  while pos < decoded.size {
    let end = if pos + chunk_size > decoded.size {
      decoded.size
    } else {
      pos + chunk_size
    }

    let chunk = ByteArray.new
    let mut i = pos

    while i < end {
      match decoded.get(i) {
        case Ok(byte) -> chunk.push(byte)
        case Error(_) -> {}
      }

      i = i + 1
    }

    match handler.on_attachment_chunk(chunk, info) {
      case Ok(_) -> {}
      case Error(e) -> {
        return Result.Error(
          Error.from_string('Handler on_attachment_chunk failed: ${e}'),
        )
      }
    }

    pos = end
  }

  Result.Ok(0)
}

# Stream a non-multipart, non-text body as a single attachment
fn stream_single_attachment[H: mut + StreamHandler](
  body_raw: String,
  info: AttachmentInfo,
  encoding: String,
  chunk_size: Int,
  max_size: Int,
  handler: mut H,
) -> Result[Int, Error] {
  match handler.on_attachment_begin(info) {
    case Ok(_) -> {}
    case Error(e) -> {
      return Result.Error(
        Error.from_string('Handler on_attachment_begin failed: ${e}'),
      )
    }
  }

  let decoded = match decode_body_bytes_impl(body_raw, encoding, max_size) {
    case Ok(d) -> d
    case Error(e) -> return Result.Error(e)
  }

  match send_attachment_chunks(ref decoded, chunk_size, info, handler) {
    case Ok(_) -> {}
    case Error(e) -> return Result.Error(e)
  }

  match handler.on_attachment_end(info) {
    case Ok(_) -> {}
    case Error(e) -> {
      return Result.Error(
        Error.from_string('Handler on_attachment_end failed: ${e}'),
      )
    }
  }

  Result.Ok(1)
}

# Accumulate decoded bytes and emit full chunks to the attachment handler
fn push_attachment_bytes[H: mut + StreamHandler](
  pending: mut ByteArray,
  data: ref ByteArray,
  chunk_size: Int,
  info: ref AttachmentInfo,
  handler: mut H,
) -> Result[Int, Error] {
  if chunk_size <= 0 {
    return Result.Error(Error.from_string('chunk size must be greater than 0'))
  }

  let mut offset = 0

  # Top up a partial chunk buffered by a previous call
  if pending.size > 0 {
    while pending.size < chunk_size and offset < data.size {
      match data.get(offset) {
        case Ok(byte) -> pending.push(byte)
        case Error(_) -> {}
      }

      offset = offset + 1
    }

    if pending.size == chunk_size {
      let chunk = ByteArray.new
      let mut i = 0

      while i < pending.size {
        match pending.get(i) {
          case Ok(byte) -> chunk.push(byte)
          case Error(_) -> {}
        }

        i = i + 1
      }

      pending.clear

      match handler.on_attachment_chunk(chunk, info) {
        case Ok(_) -> {}
        case Error(e) -> {
          return Result.Error(
            Error.from_string('Handler on_attachment_chunk failed: ${e}'),
          )
        }
      }
    }
  }

  # Emit complete chunks straight from the incoming data
  while (offset + chunk_size) <= data.size {
    let chunk = ByteArray.new
    let mut i = offset

    while i < (offset + chunk_size) {
      match data.get(i) {
        case Ok(byte) -> chunk.push(byte)
        case Error(_) -> {}
      }

      i = i + 1
    }

    match handler.on_attachment_chunk(chunk, info) {
      case Ok(_) -> {}
      case Error(e) -> {
        return Result.Error(
          Error.from_string('Handler on_attachment_chunk failed: ${e}'),
        )
      }
    }

    offset = offset + chunk_size
  }

  # Buffer what's left for the next call or the final flush
  while offset < data.size {
    match data.get(offset) {
      case Ok(byte) -> pending.push(byte)
      case Error(_) -> {}
    }

    offset = offset + 1
  }

  Result.Ok(0)
}

# Stream a single non-text body from an async reader as an attachment
fn process_attachment_reader[H: mut + StreamHandler, R: mut + AsyncReader](
  reader: mut R,
  initial_body: ByteArray,
  info: AttachmentInfo,
  encoding: String,
  chunk_size: Int,
  max_size: Int,
  strict_mode: Bool,
  max_email_size: Int,
  start_total_bytes: Int,
  handler: mut H,
) -> Result[Int, Error] {
  match handler.on_attachment_begin(info) {
    case Ok(_) -> {}
    case Error(e) -> {
      return Result.Error(
        Error.from_string('Handler on_attachment_begin failed: ${e}'),
      )
    }
  }

  let mut total_bytes = start_total_bytes
  let mut pending = ByteArray.new
  let encoding_lower = encoding.to_lower

  if encoding_lower == 'base64' {
    let mut decoder = Base64StreamingDecoder.new(max_size, strict_mode)

    if initial_body.size > 0 {
      match decoder.feed(initial_body.into_string) {
        case Ok(decoded) -> {
          match
            push_attachment_bytes(
              pending,
              ref decoded,
              chunk_size,
              info,
              handler,
            )
          {
            case Ok(_) -> {}
            case Error(e) -> return Result.Error(e)
          }
        }
        case Error(e) -> return Result.Error(Error.from_string(e))
      }
    }

    loop {
      match reader.read(chunk_size) {
        case Ok(chunk) -> {
          if chunk.size == 0 { break }

          total_bytes = total_bytes + chunk.size

          if total_bytes > max_email_size {
            return Result.Error(
              Error.EmailSizeExceeded(
                Severity.Error,
                max_email_size,
                total_bytes,
                Option.None,
                Option.None,
              ),
            )
          }

          match decoder.feed(chunk.into_string) {
            case Ok(decoded) -> {
              match
                push_attachment_bytes(
                  pending,
                  ref decoded,
                  chunk_size,
                  info,
                  handler,
                )
              {
                case Ok(_) -> {}
                case Error(e) -> return Result.Error(e)
              }
            }
            case Error(e) -> return Result.Error(Error.from_string(e))
          }
        }
        case Error(e) -> return Result.Error(Error.from_string(e))
      }
    }

    match decoder.finish {
      case Ok(decoded) -> {
        match
          push_attachment_bytes(pending, ref decoded, chunk_size, info, handler)
        {
          case Ok(_) -> {}
          case Error(e) -> return Result.Error(e)
        }
      }
      case Error(e) -> return Result.Error(Error.from_string(e))
    }
  } else if encoding_lower == 'quoted-printable' {
    let mut decoder = QuotedPrintableStreamingDecoder.new(max_size, true, false)

    if initial_body.size > 0 {
      match decoder.feed(initial_body.into_string) {
        case Ok(decoded) -> {
          match
            push_attachment_bytes(
              pending,
              ref decoded,
              chunk_size,
              info,
              handler,
            )
          {
            case Ok(_) -> {}
            case Error(e) -> return Result.Error(e)
          }
        }
        case Error(e) -> return Result.Error(Error.from_string(e))
      }
    }

    loop {
      match reader.read(chunk_size) {
        case Ok(chunk) -> {
          if chunk.size == 0 { break }

          total_bytes = total_bytes + chunk.size

          if total_bytes > max_email_size {
            return Result.Error(
              Error.EmailSizeExceeded(
                Severity.Error,
                max_email_size,
                total_bytes,
                Option.None,
                Option.None,
              ),
            )
          }

          match decoder.feed(chunk.into_string) {
            case Ok(decoded) -> {
              match
                push_attachment_bytes(
                  pending,
                  ref decoded,
                  chunk_size,
                  info,
                  handler,
                )
              {
                case Ok(_) -> {}
                case Error(e) -> return Result.Error(e)
              }
            }
            case Error(e) -> return Result.Error(Error.from_string(e))
          }
        }
        case Error(e) -> return Result.Error(Error.from_string(e))
      }
    }

    match decoder.finish {
      case Ok(decoded) -> {
        match
          push_attachment_bytes(pending, ref decoded, chunk_size, info, handler)
        {
          case Ok(_) -> {}
          case Error(e) -> return Result.Error(e)
        }
      }
      case Error(e) -> return Result.Error(Error.from_string(e))
    }
  } else {
    # 7bit/8bit/binary: deliver the raw bytes
    match
      push_attachment_bytes(
        pending,
        ref initial_body,
        chunk_size,
        info,
        handler,
      )
    {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    loop {
      match reader.read(chunk_size) {
        case Ok(chunk) -> {
          if chunk.size == 0 { break }

          total_bytes = total_bytes + chunk.size

          if total_bytes > max_email_size {
            return Result.Error(
              Error.EmailSizeExceeded(
                Severity.Error,
                max_email_size,
                total_bytes,
                Option.None,
                Option.None,
              ),
            )
          }

          match
            push_attachment_bytes(pending, ref chunk, chunk_size, info, handler)
          {
            case Ok(_) -> {}
            case Error(e) -> return Result.Error(e)
          }
        }
        case Error(e) -> return Result.Error(Error.from_string(e))
      }
    }
  }

  if pending.size > 0 {
    match handler.on_attachment_chunk(pending, info) {
      case Ok(_) -> {}
      case Error(e) -> {
        return Result.Error(
          Error.from_string('Handler on_attachment_chunk failed: ${e}'),
        )
      }
    }
  }

  match handler.on_attachment_end(info) {
    case Ok(_) -> {}
    case Error(e) -> {
      return Result.Error(
        Error.from_string('Handler on_attachment_end failed: ${e}'),
      )
    }
  }

  Result.Ok(1)
}

# Process multipart body incrementally from an async reader
#
# Creates a MultipartStreamParser and feeds initial body data plus subsequent
# chunks from the reader, processing parts incrementally.
fn process_body_reader_multipart[H: mut + StreamHandler, R: mut + AsyncReader](
  reader: mut R,
  initial_body: ByteArray,
  boundary: String,
  default_encoding: String,
  max_depth: Int,
  max_size: Int,
  max_headers: Int,
  strict_mode: Bool,
  max_attachments: Int,
  chunk_size: Int,
  max_email_size: Int,
  start_total_bytes: Int,
  handler: mut H,
) -> Result[Int, Error] {
  let mut total_bytes = start_total_bytes
  let mut parser = match
    MultipartStreamParser.new(
      boundary,
      max_depth,
      chunk_size,
      strict_mode,
      max_headers,
      max_size,
    )
  {
    case Ok(p) -> p
    case Error(e) -> return Result.Error(e)
  }

  let mut wrapper = MultipartHandlerWrapper(
    handler: handler,
    attachment_count: 0,
    current_info: Option.None,
    base64_decoder: Option.None,
    qp_decoder: Option.None,
    current_encoding: default_encoding,
    current_content_type: 'text/plain',
    max_size: max_size,
    chunk_size: chunk_size,
    max_headers: max_headers,
    strict_mode: strict_mode,
    max_attachments: max_attachments,
    current_attachment_size: 0,
    depth: 0,
    max_depth: max_depth,
    nested_buffer: Option.None,
    nested_boundary: Option.None,
  )

  # Feed initial body data
  if initial_body.size > 0 {
    match parser.feed(ref initial_body, wrapper, default_encoding) {
      case Ok(_) -> {}
      case Error(e) -> {
        if strict_mode or !is_recoverable_part_error(ref e) {
          return Result.Error(e)
        }
      }
    }
  }

  # Read and feed remaining chunks from reader
  loop {
    match reader.read(chunk_size) {
      case Ok(chunk) -> {
        if chunk.size == 0 { break }

        total_bytes = total_bytes + chunk.size

        if total_bytes > max_email_size {
          return Result.Error(
            Error.EmailSizeExceeded(
              Severity.Error,
              max_email_size,
              total_bytes,
              Option.None,
              Option.None,
            ),
          )
        }

        match parser.feed(ref chunk, wrapper, default_encoding) {
          case Ok(_) -> {}
          case Error(e) -> {
            if strict_mode or !is_recoverable_part_error(ref e) {
              return Result.Error(e)
            }

            break
          }
        }
      }
      case Error(e) -> return Result.Error(Error.from_string(e))
    }
  }

  match parser.finish(wrapper) {
    case Ok(_) -> {}
    case Error(e) -> {
      if strict_mode or !is_recoverable_part_error(ref e) {
        return Result.Error(e)
      }
    }
  }

  Result.Ok(wrapper.attachment_count)
}

# Helper type for multipart streaming parser
type MultipartHandlerWrapper[H: mut + StreamHandler] {
  let @handler: mut H
  let mut @attachment_count: Int
  let mut @current_info: Option[AttachmentInfo]
  let mut @base64_decoder: Option[Base64StreamingDecoder]
  let mut @qp_decoder: Option[QuotedPrintableStreamingDecoder]
  let mut @current_encoding: String
  let mut @current_content_type: String
  let @max_size: Int
  let @chunk_size: Int
  let @max_headers: Int
  let @strict_mode: Bool
  let @max_attachments: Int
  let mut @current_attachment_size: Int
  let @depth: Int
  let @max_depth: Int
  let mut @nested_buffer: Option[ByteArray]
  let mut @nested_boundary: Option[String]
}

impl MultipartStreamHandler for MultipartHandlerWrapper
if
  H: mut + StreamHandler,
{
  fn pub mut on_part_begin(
    headers: ref Array[(String, String)],
    content_type: String,
    is_attachment: Bool,
  ) -> Result[Int, Error] {
    let (main_type, ct_params) = match
      parse_content_type_impl(content_type, @strict_mode)
    {
      case Ok((mt, params)) -> (mt, params)
      case Error(_) -> (content_type, [])
    }

    @current_content_type = main_type

    # Nested multipart: buffer the part body and parse it as a new multipart
    # document when the part ends. Reject excessive nesting before buffering
    # anything so a depth bomb cannot allocate the whole nested payload first.
    if main_type.starts_with?('multipart/') {
      match get_param_value_impl(ref ct_params, 'boundary') {
        case Some(nested_boundary) -> {
          if @depth + 1 > @max_depth {
            return Result.Error(
              Error.MultipartDepthExceeded(
                Severity.Error,
                @depth + 1,
                @max_depth,
                Option.None,
                Option.None,
                Option.None,
              ),
            )
          }

          @nested_buffer = Option.Some(ByteArray.new)
          @nested_boundary = Option.Some(nested_boundary)
          return Result.Ok(0)
        }
        case None -> {}
      }
    }

    let content_disposition = get_header_value_impl(
      ref headers,
      'Content-Disposition',
    )
      .or('')

    # Normalise the disposition type the same way the buffered parser does
    let mut disposition = if is_attachment { 'attachment' } else { 'inline' }

    match
      parse_content_disposition_impl(content_disposition.clone, @strict_mode)
    {
      case Ok((disp, _)) -> if !disp.empty? { disposition = disp }
      case Error(_) -> {}
    }

    let content_transfer_encoding = get_header_value_impl(
      ref headers,
      'Content-Transfer-Encoding',
    )
      .or('7bit')

    @current_encoding = content_transfer_encoding

    let content_id = get_header_value_impl(ref headers, 'Content-ID')

    # MultipartStreamParser already applies the shared classification.
    let is_actual_attachment = is_attachment

    let filename = if is_actual_attachment {
      extract_filename(content_disposition)
    } else {
      Option.None
    }

    if is_actual_attachment {
      if @attachment_count >= @max_attachments {
        return Result.Error(
          Error.TooManyAttachments(
            Severity.Error,
            @attachment_count + 1,
            @max_attachments,
            Option.None,
            Option.None,
            Option.None,
          ),
        )
      }

      @current_attachment_size = 0

      let info = AttachmentInfo(
        index: @attachment_count,
        content_type: main_type,
        filename: filename,
        content_disposition: disposition,
        content_id: content_id,
        size: 0,
        transfer_encoding: content_transfer_encoding,
      )

      match @handler.on_attachment_begin(info) {
        case Ok(_) -> {}
        case Error(e) -> {
          return Result.Error(
            Error.from_string('Handler on_attachment_begin failed: ${e}'),
          )
        }
      }

      @current_info = Option.Some(info)
    }

    Result.Ok(0)
  }

  fn pub mut on_part_data(
    data: ref ByteArray,
    content_transfer_encoding: String,
  ) -> Result[Int, Error] {
    match @nested_buffer {
      case Some(mut buffer) -> {
        # `append` takes its argument by reference, so no copy is needed here
        buffer.append(data)
        return Result.Ok(0)
      }
      case None -> {}
    }

    @current_encoding = content_transfer_encoding

    let data_str = data.clone

    match @current_info {
      case Some(info) -> {
        let encoding_lower = content_transfer_encoding.to_lower

        if encoding_lower == 'base64' {
          match @base64_decoder {
            case None -> {
              @base64_decoder = Option.Some(
                Base64StreamingDecoder.new(@max_size, false),
              )
            }
            case Some(_) -> {}
          }

          match @base64_decoder {
            case Some(mut d) -> {
              match d.feed(data_str.into_string) {
                case Ok(decoded) -> {
                  if decoded.size > 0 {
                    @current_attachment_size = @current_attachment_size
                      + decoded.size

                    if @current_attachment_size > @max_size {
                      return Result.Error(
                        Error.AttachmentSizeTooLarge(
                          Severity.Error,
                          @current_attachment_size,
                          @max_size,
                          Option.None,
                          Option.None,
                          Option.None,
                        ),
                      )
                    }

                    match @handler.on_attachment_chunk(decoded, info) {
                      case Ok(_) -> {}
                      case Error(e) -> {
                        return Result.Error(
                          Error.from_string(
                            'Handler on_attachment_chunk failed: ${e}',
                          ),
                        )
                      }
                    }
                  }
                }
                case Error(e) -> return Result.Error(Error.from_string(e))
              }
            }
            case None -> {}
          }
        } else if encoding_lower == 'quoted-printable' {
          match @qp_decoder {
            case None -> {
              @qp_decoder = Option.Some(
                QuotedPrintableStreamingDecoder.new(@max_size, true, false),
              )
            }
            case Some(_) -> {}
          }

          match @qp_decoder {
            case Some(mut d) -> {
              match d.feed(data_str.into_string) {
                case Ok(decoded) -> {
                  if decoded.size > 0 {
                    @current_attachment_size = @current_attachment_size
                      + decoded.size

                    if @current_attachment_size > @max_size {
                      return Result.Error(
                        Error.AttachmentSizeTooLarge(
                          Severity.Error,
                          @current_attachment_size,
                          @max_size,
                          Option.None,
                          Option.None,
                          Option.None,
                        ),
                      )
                    }

                    match @handler.on_attachment_chunk(decoded, info) {
                      case Ok(_) -> {}
                      case Error(e) -> {
                        return Result.Error(
                          Error.from_string(
                            'Handler on_attachment_chunk failed: ${e}',
                          ),
                        )
                      }
                    }
                  }
                }
                case Error(e) -> return Result.Error(Error.from_string(e))
              }
            }
            case None -> {}
          }
        } else {
          @current_attachment_size = @current_attachment_size + data_str.size

          if @current_attachment_size > @max_size {
            return Result.Error(
              Error.AttachmentSizeTooLarge(
                Severity.Error,
                @current_attachment_size,
                @max_size,
                Option.None,
                Option.None,
                Option.None,
              ),
            )
          }

          match @handler.on_attachment_chunk(data_str, info) {
            case Ok(_) -> {}
            case Error(e) -> {
              return Result.Error(
                Error.from_string('Handler on_attachment_chunk failed: ${e}'),
              )
            }
          }
        }
      }
      case None -> {
        let is_html = is_text_html(@current_content_type)

        if is_text_plain(@current_content_type) or is_html {
          let encoding_lower = content_transfer_encoding.to_lower

          if encoding_lower == 'base64' {
            match @base64_decoder {
              case None -> {
                @base64_decoder = Option.Some(
                  Base64StreamingDecoder.new(@max_size, false),
                )
              }
              case Some(_) -> {}
            }

            match @base64_decoder {
              case Some(mut d) -> {
                match d.feed(data_str.into_string) {
                  case Ok(decoded) -> {
                    if decoded.size > 0 {
                      match
                        send_text_chunks(
                          decoded.into_string,
                          @chunk_size,
                          is_html,
                          @handler,
                        )
                      {
                        case Ok(_) -> {}
                        case Error(e) -> return Result.Error(e)
                      }
                    }
                  }
                  case Error(e) -> return Result.Error(Error.from_string(e))
                }
              }
              case None -> {}
            }
          } else if encoding_lower == 'quoted-printable' {
            match @qp_decoder {
              case None -> {
                @qp_decoder = Option.Some(
                  QuotedPrintableStreamingDecoder.new(@max_size, true, false),
                )
              }
              case Some(_) -> {}
            }

            match @qp_decoder {
              case Some(mut d) -> {
                match d.feed(data_str.into_string) {
                  case Ok(decoded) -> {
                    if decoded.size > 0 {
                      match
                        send_text_chunks(
                          decoded.into_string,
                          @chunk_size,
                          is_html,
                          @handler,
                        )
                      {
                        case Ok(_) -> {}
                        case Error(e) -> return Result.Error(e)
                      }
                    }
                  }
                  case Error(e) -> return Result.Error(Error.from_string(e))
                }
              }
              case None -> {}
            }
          } else {
            match
              send_text_chunks(
                data_str.into_string,
                @chunk_size,
                is_html,
                @handler,
              )
            {
              case Ok(_) -> {}
              case Error(e) -> return Result.Error(e)
            }
          }
        }
      }
    }

    Result.Ok(0)
  }

  fn pub mut on_part_end -> Result[Int, Error] {
    # Nested multipart: hand the buffered body to a child parser. The buffer is
    # borrowed, not cloned, so the payload exists only once.
    let mut nested_boundary = ''

    match @nested_boundary {
      case Some(nb) -> nested_boundary = nb
      case None -> {}
    }

    if !@nested_buffer.none? {
      match @nested_buffer {
        case Some(b) -> {
          if !nested_boundary.empty? {
            match
              finish_nested(
                @handler,
                ref b,
                nested_boundary,
                @attachment_count,
                @max_size,
                @chunk_size,
                @max_headers,
                @strict_mode,
                @max_attachments,
                @depth,
                @max_depth,
              )
            {
              case Ok(count) -> @attachment_count = count
              case Error(e) -> return Result.Error(e)
            }
          }
        }
        case None -> {}
      }

      @nested_buffer = Option.None
      @nested_boundary = Option.None

      return Result.Ok(0)
    }

    # Collect decoded data before calling handler methods
    let mut base64_decoded: Option[ByteArray] = Option.None
    let mut qp_decoded: Option[ByteArray] = Option.None

    # Finish base64 decoder if present
    match @base64_decoder {
      case Some(mut d) -> {
        match d.finish {
          case Ok(decoded) -> {
            if decoded.size > 0 { base64_decoded = Option.Some(decoded) }
          }
          case Error(e) -> return Result.Error(Error.from_string(e))
        }
      }
      case None -> {}
    }

    @base64_decoder = Option.None

    # Finish quoted-printable decoder if present
    match @qp_decoder {
      case Some(mut d) -> {
        match d.finish {
          case Ok(decoded) -> {
            if decoded.size > 0 { qp_decoded = Option.Some(decoded) }
          }
          case Error(e) -> return Result.Error(Error.from_string(e))
        }
      }
      case None -> {}
    }

    @qp_decoder = Option.None

    # Now pass decoded data to handler
    match @current_info {
      case Some(info) -> {
        # Report the accumulated decoded size and normalised type; the info
        # passed to on_attachment_begin still has size 0.
        let final_info = AttachmentInfo(
          index: info.index,
          content_type: info.content_type,
          filename: info.filename.clone,
          content_disposition: info.content_disposition,
          content_id: info.content_id.clone,
          size: @current_attachment_size,
          transfer_encoding: info.transfer_encoding,
        )

        match base64_decoded {
          case Some(data) -> {
            @current_attachment_size = @current_attachment_size + data.size

            if @current_attachment_size > @max_size {
              return Result.Error(
                Error.AttachmentSizeTooLarge(
                  Severity.Error,
                  @current_attachment_size,
                  @max_size,
                  Option.None,
                  Option.None,
                  Option.None,
                ),
              )
            }

            match @handler.on_attachment_chunk(data, info) {
              case Ok(_) -> {}
              case Error(e) -> {
                return Result.Error(
                  Error.from_string('Handler on_attachment_chunk failed: ${e}'),
                )
              }
            }
          }
          case None -> {}
        }

        match qp_decoded {
          case Some(data) -> {
            @current_attachment_size = @current_attachment_size + data.size

            if @current_attachment_size > @max_size {
              return Result.Error(
                Error.AttachmentSizeTooLarge(
                  Severity.Error,
                  @current_attachment_size,
                  @max_size,
                  Option.None,
                  Option.None,
                  Option.None,
                ),
              )
            }

            match @handler.on_attachment_chunk(data, info) {
              case Ok(_) -> {}
              case Error(e) -> {
                return Result.Error(
                  Error.from_string('Handler on_attachment_chunk failed: ${e}'),
                )
              }
            }
          }
          case None -> {}
        }

        match @handler.on_attachment_end(final_info) {
          case Ok(_) -> {}
          case Error(e) -> {
            return Result.Error(
              Error.from_string('Handler on_attachment_end failed: ${e}'),
            )
          }
        }

        @attachment_count = @attachment_count + 1
      }
      case None -> {
        # Handle text/HTML parts without attachment info
        let is_html = is_text_html(@current_content_type)

        if is_text_plain(@current_content_type) or is_html {
          match base64_decoded {
            case Some(data) -> {
              match
                send_text_chunks(
                  data.into_string,
                  @chunk_size,
                  is_html,
                  @handler,
                )
              {
                case Ok(_) -> {}
                case Error(e) -> return Result.Error(e)
              }
            }
            case None -> {}
          }

          match qp_decoded {
            case Some(data) -> {
              match
                send_text_chunks(
                  data.into_string,
                  @chunk_size,
                  is_html,
                  @handler,
                )
              {
                case Ok(_) -> {}
                case Error(e) -> return Result.Error(e)
              }
            }
            case None -> {}
          }
        }
      }
    }

    # Clear current_info last
    @current_info = Option.None

    Result.Ok(0)
  }
}

# Parse a buffered nested multipart part with a child parser.
#
# The buffer is borrowed, not copied: the caller moves the part body out of the
# wrapper before calling this, so the payload exists only once.
fn finish_nested[H: mut + StreamHandler](
  handler: mut H,
  nested_buffer: ref ByteArray,
  nested_boundary: String,
  attachment_count: Int,
  max_size: Int,
  chunk_size: Int,
  max_headers: Int,
  strict_mode: Bool,
  max_attachments: Int,
  depth: Int,
  max_depth: Int,
) -> Result[Int, Error] {
  if depth + 1 > max_depth {
    return Result.Error(
      Error.MultipartDepthExceeded(
        Severity.Error,
        depth + 1,
        max_depth,
        Option.None,
        Option.None,
        Option.None,
      ),
    )
  }

  let mut nested_parser = match
    MultipartStreamParser.new(
      nested_boundary,
      max_depth,
      chunk_size,
      false,
      max_headers,
      max_size,
    )
  {
    case Ok(p) -> p
    case Error(e) -> return Result.Error(e)
  }

  let mut nested_wrapper = MultipartHandlerWrapper(
    handler: handler,
    attachment_count: attachment_count,
    current_info: Option.None,
    base64_decoder: Option.None,
    qp_decoder: Option.None,
    current_encoding: '7bit',
    current_content_type: 'text/plain',
    max_size: max_size,
    chunk_size: chunk_size,
    max_headers: max_headers,
    strict_mode: strict_mode,
    max_attachments: max_attachments,
    current_attachment_size: 0,
    depth: depth + 1,
    max_depth: max_depth,
    nested_buffer: Option.None,
    nested_boundary: Option.None,
  )

  match nested_parser.feed(ref nested_buffer, nested_wrapper, '7bit') {
    case Ok(_) -> {}
    case Error(e) -> {
      if strict_mode or !is_recoverable_part_error(ref e) {
        return Result.Error(e)
      }
    }
  }

  match nested_parser.finish(nested_wrapper) {
    case Ok(_) -> {}
    case Error(e) -> {
      if strict_mode or !is_recoverable_part_error(ref e) {
        return Result.Error(e)
      }
    }
  }

  Result.Ok(nested_wrapper.attachment_count)
}

# Parse multipart with streaming using MultipartStreamParser
fn parse_multipart_stream[H: mut + StreamHandler](
  raw: String,
  boundary: String,
  default_encoding: String,
  current_depth: Int,
  max_depth: Int,
  max_size: Int,
  max_headers: Int,
  strict_mode: Bool,
  max_attachments: Int,
  chunk_size: Int,
  handler: mut H,
) -> Result[Int, Error] {
  if current_depth >= max_depth {
    return Result.Error(
      Error.MultipartDepthExceeded(
        Severity.Error,
        current_depth,
        max_depth,
        Option.None,
        Option.None,
        Option.None,
      ),
    )
  }

  let mut attachment_count = 0
  let mut current_info: Option[AttachmentInfo] = Option.None
  let mut base64_decoder: Option[Base64StreamingDecoder] = Option.None
  let mut qp_decoder: Option[QuotedPrintableStreamingDecoder] = Option.None
  let mut current_encoding: String = default_encoding
  let mut current_content_type: String = 'text/plain'

  let mut parser = match
    MultipartStreamParser.new(
      boundary,
      max_depth,
      chunk_size,
      strict_mode,
      max_headers,
      max_size,
    )
  {
    case Ok(p) -> p
    case Error(e) -> return Result.Error(e)
  }

  let mut wrapper = MultipartHandlerWrapper(
    handler: handler,
    attachment_count: attachment_count,
    current_info: current_info,
    base64_decoder: base64_decoder,
    qp_decoder: qp_decoder,
    current_encoding: current_encoding,
    current_content_type: current_content_type,
    max_size: max_size,
    chunk_size: chunk_size,
    max_headers: max_headers,
    strict_mode: strict_mode,
    max_attachments: max_attachments,
    current_attachment_size: 0,
    depth: 0,
    max_depth: max_depth,
    nested_buffer: Option.None,
    nested_boundary: Option.None,
  )

  let data = raw.to_byte_array

  match parser.feed(ref data, wrapper, default_encoding) {
    case Ok(_) -> {}
    case Error(e) -> {
      if strict_mode or !is_recoverable_part_error(ref e) {
        return Result.Error(e)
      }
    }
  }

  match parser.finish(wrapper) {
    case Ok(_) -> {}
    case Error(e) -> {
      if strict_mode or !is_recoverable_part_error(ref e) {
        return Result.Error(e)
      }
    }
  }

  Result.Ok(wrapper.attachment_count)
}

# Extract and sanitize the filename from a Content-Disposition value
fn extract_filename(content_disposition: String) -> Option[String] {
  extract_filename_param(content_disposition)
}
