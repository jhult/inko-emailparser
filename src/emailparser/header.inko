# Header Parsing Module
#
# RFC 5322 section 2.2: Header Fields
#
# Provides functions for parsing email headers, including:
# - Header field validation
# - Case-insensitive comparison
# - Content-Type parameter parsing
# - Standard header identification

import emailparser.ascii (
  ASCII_BACKSLASH, ASCII_COLON, ASCII_DQUOTE, ASCII_EXCLAMATION,
  ASCII_SEMICOLON, ASCII_TILDE, is_uppercase,
)
import emailparser.decoder (decode_charset)
import emailparser.error (Error)
import emailparser.error (Severity)
import emailparser.hex (hex_char_to_value)
import emailparser.limits (
  MAX_FILENAME_SIZE, MAX_HEADER_VALUE_LENGTH, MAX_RFC2231_SEGMENTS,
)
import emailparser.size_tracker (SizeTracker)
import emailparser.validation (is_quoted_string, is_valid_mime_type)
import std.bytes (ByteArray)
import std.option (Option)
import std.result (Result)

let STANDARD = [
  'from',
  'to',
  'cc',
  'bcc',
  'subject',
  'date',
  'message-id',
  'in-reply-to',
  'references',
  'sender',
  'content-type',
  'content-transfer-encoding',
  'content-disposition',
  'mime-version',
  'content-id',
  'description',
  'priority',
  'disposition-notification-to',
]

# Whether a header field may legally appear more than once
#
# RFC 5322 section 3.6 allows these fields to repeat. `x-*` fields are
# non-standard but commonly repeatable too.
fn is_repeatable_header(lower_name: String) -> Bool {
  lower_name == 'received'
    or lower_name == 'comments'
    or lower_name == 'keywords'
    or lower_name.starts_with?('resent-')
    or lower_name.starts_with?('x-')
}

# Validate RFC 5322 field name
# RFC 5322 section 3.6.8: field names are 1+ printable chars (except colon)
fn pub is_valid_field_name(name: String) -> Bool {
  if name.empty? { return false }

  let mut i = 0

  while i < name.size {
    match name.get(i) {
      case Ok(byte) -> {
        # Field name must be printable ASCII (33-126) except colon (58)
        # RFC 5322: field-name = 1*ftext
        # ftext = %d33-57 / %d59-126 (any printable ASCII except colon)
        if
          byte < ASCII_EXCLAMATION or byte == ASCII_COLON or byte > ASCII_TILDE
        {
          return false
        }

        i = i + 1
      }
      case Error(_) -> return false
    }
  }

  true
}

# Parse email headers from raw string
#
# RFC 5322 section 2.2: Header Fields
#
# Header format:
# - Each header: "field-name: field-value"
# - Headers separated by blank line from body
# - Long headers can be folded (continued) using CRLF + whitespace
# - Field names are case-insensitive
#
# Algorithm:
# 1. Check email size limit before parsing
# 2. Split input into lines
# 3. Process lines sequentially:
#    a. If line starts with space/tab, append to current header value (folded)
#    b. Otherwise, if in header, save it and start new header
#    c. Parse new header: split at first colon
# 4. In strict mode, validate header format and detect duplicates
# 5. Stop at blank line (end of headers)
# 6. Save last header if present
#
# Edge cases handled:
# - Folded headers (continuation lines starting with whitespace)
# - Missing colon -> strict mode: error, permissive: skip line
# - Empty headers (field-name is empty) -> strict mode: error
# - Duplicate headers -> strict mode: error, permissive: first value wins
#   (all occurrences are retained in the parsed array; get_header_value_impl
#   returns the first match consistently)
# - Malformed headers (multiple colons) -> strict mode: detect possible missing newline
# - Size limits enforced at each step
#
# Security considerations:
# - Size limit checked before parsing to prevent DoS
# - Header count limit enforced to prevent memory exhaustion
# - Strict mode detects malformed headers that could be attacks
#
# Split a message into its header section and body
#
# The header section ends at the first blank line ("\n\n"). When no blank line
# is present the entire input is treated as headers, matching RFC 5322's
# allowance for header-only messages.
#
# `String.index_of` and `String.slice` both use byte offsets, while
# `String.substring` uses character offsets. Slicing here keeps messages with
# non-ASCII headers intact.
fn pub split_header_body(input: String) -> (String, String) {
  match input.index_of('\n\n', 0) {
    case Some(pos) -> {
      (
        input.slice(0, pos).to_string,
        input.slice(pos + 2, input.size).to_string,
      )
    }
    case None -> (input.clone, '')
  }
}

# Find the first header/body separator in a byte buffer
#
# Recognizes both LF LF and CR LF CR LF and reports the separator's size, so
# callers can locate the body without converting the buffer to a String first.
# `start` lets incremental readers resume scanning after the bytes they have
# already checked; overlap it by three bytes so a separator split across reads
# is still found.
fn pub find_header_separator_bytes(
  buffer: ref ByteArray,
  start: Int,
) -> Option[(Int, Int)] {
  let size = buffer.size
  let mut i = start

  while i < size {
    match buffer.get(i) {
      case Ok(byte) -> {
        if byte == 10 {
          if i + 1 < size {
            match buffer.get(i + 1) {
              case Ok(following) -> {
                if following == 10 { return Option.Some((i, 2)) }
              }
              case Error(_) -> {}
            }
          }
        } else if byte == 13 {
          if i + 3 < size {
            match buffer.get(i + 1) {
              case Ok(b1) -> {
                match buffer.get(i + 2) {
                  case Ok(b2) -> {
                    match buffer.get(i + 3) {
                      case Ok(b3) -> {
                        if b1 == 10 and b2 == 13 and b3 == 10 {
                          return Option.Some((i, 4))
                        }
                      }
                      case Error(_) -> {}
                    }
                  }
                  case Error(_) -> {}
                }
              }
              case Error(_) -> {}
            }
          }
        }
      }
      case Error(_) -> {}
    }

    i = i + 1
  }

  Option.None
}

# Performance optimizations:
# - Lowercase header names cached to avoid O(n²) conversions
# - Case-insensitive comparison without repeated string copies
fn parse_headers_impl(
  raw: String,
  strict_mode: Bool,
  max_size: Int,
  max_headers: Int,
) -> Result[Array[(String, String)], Error] {
  # Check the header-section size limit before parsing
  if raw.size > max_size {
    return Result.Error(
      Error.HeaderSectionTooLarge(
        Severity.Error,
        raw.size,
        max_size,
        Option.None,
        Option.None,
        Option.None,
      ),
    )
  }

  let mut headers = []
  # Optimization: cache lowercase header names to avoid O(n²) conversions
  let mut lower_keys = []

  # Split into lines
  let lines = raw.split('\n').into_iter.to_array

  let mut current_key = ''
  let mut current_value = ''
  let mut in_header = false
  let mut line_number = 0

  for line in lines {
    line_number = line_number + 1

    if line.empty? {
      if in_header {
        headers.push((current_key, current_value))
        in_header = false
      }

      break # End of headers
    }

    # Convert Slice to String for processing
    let mut line_str = line.to_string

    # Strip trailing carriage return (for CRLF line endings). Slice by byte:
    # `substring` counts characters and would miss the CR in a line containing
    # multi-byte text.
    if line_str.ends_with?('\r') {
      line_str = line_str.slice(0, line_str.size - 1).to_string
    }

    # A CR that is not part of a CRLF line ending is a header-injection
    # primitive: reject it in strict mode and neutralise it otherwise.
    if line_str.contains?('\r') {
      if strict_mode {
        return Result.Error(
          Error.MalformedHeader(
            Severity.Error,
            'bare carriage return in header',
            Option.Some(line_number),
            Option.None,
            Option.Some(line_str.clone),
          ),
        )
      }

      line_str = line_str.replace('\r', ' ')
    }

    # Skip empty lines (after stripping CR)
    if line_str.empty? {
      if in_header {
        headers.push((current_key, current_value))
        in_header = false
      }

      break # End of headers
    }

    # Check for folded header (continuation line starting with whitespace)
    if line_str.starts_with?(' ') or line_str.starts_with?('\t') {
      if in_header {
        let new_size = current_value.size + line_str.size
        let mut append = true

        match
          SizeTracker.check_allocation(0, new_size, MAX_HEADER_VALUE_LENGTH)
        {
          case Ok(_) -> {}
          case Error(_) -> {
            if strict_mode {
              return Result.Error(
                Error.HeaderValueTooLarge(
                  Severity.Error,
                  new_size,
                  MAX_HEADER_VALUE_LENGTH,
                  Option.Some(line_number),
                  Option.None,
                  Option.Some(line_str.clone),
                ),
              )
            } else {
              # Permissive mode: drop only this continuation and keep parsing.
              # Breaking here would discard every following header.
              append = false
            }
          }
        }

        # RFC 5322 unfolding removes only the line break; the continuation's
        # leading white space (and any significant inner/trailing whitespace)
        # is part of the value, e.g. for folded MIME parameters.
        if append { current_value = current_value + line_str }
      }
    } else {
      # New header
      if in_header {
        # Check max_headers limit before adding
        if headers.size >= max_headers {
          return Result.Error(
            Error.TooManyHeaders(
              Severity.Error,
              headers.size,
              max_headers,
              Option.Some(line_number),
              Option.None,
              Option.None,
            ),
          )
        }

        headers.push((current_key, current_value))

        if strict_mode { lower_keys.push(current_key.to_lower) }
      }

      let colon_pos = line_str.index_of(':', 0)

      match colon_pos {
        case Some(pos) -> {
          current_key = line_str.slice(0, pos).to_string.trim
          current_value = line_str.slice(pos + 1, line_str.size).to_string.trim

          # RFC 5322 requires non-empty header names - reject even in non-strict mode
          if current_key.empty? {
            return Result.Error(
              Error.InvalidHeaderFieldName(
                Severity.Error,
                current_key,
                Option.Some(line_number),
                Option.None,
                Option.Some(line_str.clone),
              ),
            )
          }

          # Check header value size limit
          match
            SizeTracker.check_allocation(
              0,
              current_value.size,
              MAX_HEADER_VALUE_LENGTH,
            )
          {
            case Ok(_) -> {}
            case Error(_) -> {
              if strict_mode {
                return Result.Error(
                  Error.HeaderValueTooLarge(
                    Severity.Error,
                    current_value.size,
                    MAX_HEADER_VALUE_LENGTH,
                    Option.Some(line_number),
                    Option.None,
                    Option.Some(current_value.clone),
                  ),
                )
              } else {
                current_value = current_value
                  .slice(0, MAX_HEADER_VALUE_LENGTH)
                  .to_string
              }
            }
          }

          # Strict mode validation
          if strict_mode {
            # Validate field name format
            if is_valid_field_name(current_key) == false {
              return Result.Error(
                Error.InvalidHeaderFieldName(
                  Severity.Error,
                  current_key,
                  Option.Some(line_number),
                  Option.None,
                  Option.Some(current_key.clone),
                ),
              )
            }

            # Check for duplicate headers (case-insensitive)
            # Use cached lowercase keys to avoid repeated conversions.
            # Fields that RFC 5322 allows to repeat are exempt.
            let lower_key = current_key.to_lower

            if !is_repeatable_header(lower_key) {
              for k in lower_keys.iter {
                if k == lower_key {
                  return Result.Error(
                    Error.DuplicateHeader(
                      Severity.Error,
                      current_key,
                      Option.Some(line_number),
                      Option.None,
                      Option.Some(current_key.clone),
                    ),
                  )
                }
              }
            }
          }

          in_header = true
        }
        case None -> {
          # RFC 5322 requires colon separator - reject even in non-strict mode
          return Result.Error(
            Error.HeaderWithoutColon(
              Severity.Error,
              Option.Some(line_number),
              Option.None,
              Option.Some(line_str.clone),
            ),
          )
        }
      }
    }
  }

  # Push the last header if we were in the middle of parsing one
  if in_header {
    # Check max_headers limit before adding
    if headers.size >= max_headers {
      return Result.Error(
        Error.TooManyHeaders(
          Severity.Error,
          headers.size,
          max_headers,
          Option.Some(line_number),
          Option.None,
          Option.None,
        ),
      )
    }

    headers.push((current_key, current_value))

    if strict_mode { lower_keys.push(current_key.to_lower) }
  }

  Result.Ok(headers)
}

# Get header value by name (case-insensitive)
fn get_header_value_impl(
  headers: ref Array[(String, String)],
  name: String,
) -> Option[String] {
  for (key, value) in headers.iter {
    # Use case-insensitive comparison to avoid creating lowercase strings
    if eq_ignore_case(key, name) { return Option.Some(value.clone) }
  }

  Option.None
}

# Get every value for a header name, in order (case-insensitive)
#
# RFC 5322 allows a field to appear more than once (To, Cc, Bcc, Received, ...).
# Use get_header_value_impl when only the first occurrence matters.
fn get_header_values_impl(
  headers: ref Array[(String, String)],
  name: String,
) -> Array[String] {
  let values = []

  for (key, value) in headers.iter {
    if eq_ignore_case(key, name) { values.push(value.clone) }
  }

  values
}

# Case-insensitive string comparison helper
# Compares two strings ignoring ASCII case differences
# Convert byte to lowercase if it's uppercase
fn to_lowercase(byte: Int) -> Int {
  if is_uppercase(byte) { byte + 32 } else { byte }
}

# Compare two bytes ignoring case
fn bytes_equal_ignore_case(byte_a: Int, byte_b: Int) -> Bool {
  to_lowercase(byte_a) == to_lowercase(byte_b)
}

fn eq_ignore_case(a: String, b: String) -> Bool {
  if a.size != b.size { return false }

  let mut i = 0

  while i < a.size {
    match a.get(i) {
      case Ok(byte_a) -> {
        match b.get(i) {
          case Ok(byte_b) -> {
            if bytes_equal_ignore_case(byte_a, byte_b) == false { return false }

            i = i + 1
          }
          case Error(_) -> return false
        }
      }
      case Error(_) -> return false
    }
  }

  true
}

fn parse_content_type_impl(
  raw: String,
  strict_mode: Bool,
) -> Result[(String, Array[(String, String)]), Error] {
  # Validate Content-Type format per RFC 2045
  # Must be "type/subtype" optionally followed by parameters
  let trimmed = raw.trim
  let trimmed_size = trimmed.size

  # Find the first semicolon to separate main type from parameters
  let semi_pos = trimmed.index_of(';', 0)

  # Extract the main type (before any parameters)
  let main_type_end = match semi_pos.clone {
    case Some(pos) -> pos
    case None -> trimmed_size
  }

  let main_type = trimmed.slice(0, main_type_end).to_string.trim

  # Validate that main type is in valid "type/subtype" format
  if !is_valid_mime_type(main_type.clone) {
    # Permissive mode treats an unusable Content-Type as text/plain instead of
    # failing the whole message.
    if !strict_mode { return Result.Ok(('text/plain', [])) }

    return Result.Error(
      Error.InvalidContentType(
        Severity.Error,
        'invalid MIME type format, expected "type/subtype"',
        Option.None,
        Option.None,
        Option.Some(main_type.clone),
      ),
    )
  }

  # Now parse parameters if present
  let mut params = []

  match semi_pos {
    case Some(pos) -> {
      let params_raw = trimmed.slice(pos + 1, trimmed_size).to_string

      # Parse parameters with quote awareness
      match parse_parameters_impl(params_raw, strict_mode) {
        case Ok(parsed_params) -> params = parsed_params
        case Error(e) -> return Result.Error(e)
      }
    }
    case None -> {}
  }

  # MIME types are case-insensitive (RFC 2045 section 5.1); normalize once so
  # all downstream comparisons can be exact.
  Result.Ok((main_type.to_lower, params))
}

# Parse parameters with quote-aware semicolon splitting
# Handles quoted values that may contain semicolons
#
# All indexes below are byte offsets: `String.get`, `String.index_of` and
# `String.slice` operate on bytes, so non-ASCII values (e.g. filenames) are
# preserved. Quoted values are unquoted with a byte slice for the same reason.
fn parse_parameters_impl(
  params_raw: String,
  strict_mode: Bool,
) -> Result[Array[(String, String)], Error] {
  let mut params = []
  let mut i = 0
  let mut in_quotes = false
  let mut param_start = 0

  while i < params_raw.size {
    match params_raw.get(i) {
      case Ok(byte) -> {
        if byte == ASCII_BACKSLASH and in_quotes {
          # RFC 2045 quoted-pair: the escaped byte is literal, so an escaped
          # quote must not toggle the quote state and an escaped semicolon must
          # not end the parameter. Skip it.
          i = i + 1
        } else if byte == ASCII_DQUOTE {
          # Toggle quote state
          in_quotes = !in_quotes
        } else if byte == ASCII_SEMICOLON and !in_quotes {
          # Found semicolon outside quotes - end of parameter
          let param = params_raw.slice(param_start, i).to_string.trim

          match parse_single_parameter(param) {
            case Ok(entry) -> {
              match entry {
                case Some(pair) -> params.push(pair)
                case None -> {}
              }
            }
            case Error(e) -> if strict_mode { return Result.Error(e) }
          }

          param_start = i + 1
        }
      }
      case Error(_) -> {}
    }

    i = i + 1
  }

  # Handle last parameter (after final semicolon)
  if param_start < params_raw.size {
    let param = params_raw.slice(param_start, params_raw.size).to_string.trim

    match parse_single_parameter(param) {
      case Ok(entry) -> {
        match entry {
          case Some(pair) -> params.push(pair)
          case None -> {}
        }
      }
      case Error(e) -> if strict_mode { return Result.Error(e) }
    }
  }

  Result.Ok(params)
}

# Parse a single "key=value" parameter
#
# Returns None for an empty parameter, which is what a trailing semicolon
# produces.
fn parse_single_parameter(
  param: String,
) -> Result[Option[(String, String)], Error] {
  if param.empty? { return Result.Ok(Option.None) }

  match param.index_of('=', 0) {
    case Some(eq) -> {
      let key = param.slice(0, eq).to_string.trim
      let raw_value = param.slice(eq + 1, param.size).to_string
      let value = raw_value.trim

      # Check for newlines in parameter values (security issue)
      if raw_value.contains?('\n') or raw_value.contains?('\r') {
        return Result.Error(
          Error.InvalidContentType(
            Severity.Error,
            'parameter value contains newline characters',
            Option.None,
            Option.None,
            Option.Some(param.clone),
          ),
        )
      }

      # Remove quotes if present, resolving the quoted-pairs used to embed a
      # quote or backslash in the value.
      let clean_value = if is_quoted_string(value) {
        unescape_quoted_pairs(value.slice(1, value.size - 1).to_string)
      } else {
        value.to_string
      }

      Result.Ok(Option.Some((key.to_string, clean_value)))
    }
    case None -> {
      # Parameter without = is malformed
      Result.Error(
        Error.InvalidContentType(
          Severity.Error,
          'invalid parameter format: "' + param + '"',
          Option.None,
          Option.None,
          Option.Some(param.clone),
        ),
      )
    }
  }
}

# Resolve the quoted-pairs of a quoted-string body
#
# Only `\"` and `\\` are unescaped: RFC 2045 allows any quoted-pair, but
# resolving e.g. the backslash in an unescaped Windows path would silently
# mangle the value.
fn unescape_quoted_pairs(value: String) -> String {
  let result = ByteArray.new
  let mut i = 0

  while i < value.size {
    match value.get(i) {
      case Ok(byte) -> {
        if byte == ASCII_BACKSLASH and i + 1 < value.size {
          match value.get(i + 1) {
            case Ok(following) -> {
              if following == ASCII_DQUOTE or following == ASCII_BACKSLASH {
                result.push(following)
                i = i + 1
              } else {
                result.push(byte)
              }
            }
            case Error(_) -> result.push(byte)
          }
        } else {
          result.push(byte)
        }
      }
      case Error(_) -> {}
    }

    i = i + 1
  }

  result.into_string
}

# Parse Content-Disposition header value
# RFC 2183: Content-Disposition header format is "disposition-type; param=value; ..."
# disposition-type is typically "inline" or "attachment" (not a MIME type)
fn parse_content_disposition_impl(
  raw: String,
  strict_mode: Bool,
) -> Result[(String, Array[(String, String)]), Error] {
  let trimmed = raw.trim
  let trimmed_size = trimmed.size

  # Find the first semicolon to separate disposition type from parameters
  let semi_pos = trimmed.index_of(';', 0)

  # Extract the disposition type (before any parameters)
  let disp_type_end = match semi_pos.clone {
    case Some(pos) -> pos
    case None -> trimmed_size
  }

  let disp_type = trimmed.slice(0, disp_type_end).to_string.trim

  # Validate disposition type (should be "inline", "attachment", or form-data)
  # Unlike Content-Type, this is NOT a MIME type format
  if disp_type.empty? {
    return Result.Error(
      Error.InvalidContentType(
        Severity.Error,
        'empty disposition type',
        Option.None,
        Option.None,
        Option.Some(trimmed.clone),
      ),
    )
  }

  # Now parse parameters if present
  let mut params = []

  match semi_pos {
    case Some(pos) -> {
      let params_raw = trimmed.slice(pos + 1, trimmed_size).to_string

      # Parse parameters with quote awareness
      match parse_parameters_impl(params_raw, strict_mode) {
        case Ok(parsed_params) -> params = parsed_params
        case Error(e) -> return Result.Error(e)
      }
    }
    case None -> {}
  }

  # Disposition types are case-insensitive (RFC 2183).
  Result.Ok((disp_type.to_lower, params))
}

# Get parameter value from params list
fn get_param_value_impl(
  params: ref Array[(String, String)],
  key: String,
) -> Option[String] {
  # Parameter names are case-insensitive. Compare without lower-casing either
  # side: `assemble_rfc2231_continuation` calls this once per segment, so
  # allocating a copy of every key turns hostile headers quadratic.
  for (k, v) in params.iter {
    if eq_ignore_case(k, key) { return Option.Some(v.clone) }
  }

  Option.None
}

# Sanitize a filename to a safe basename
#
# Path components are stripped, control characters removed, and characters
# that are invalid on Windows are replaced with '_'. This neutralizes path
# traversal while still producing a usable name for inputs such as
# "C:\docs\file.pdf" or "report?.pdf".
fn pub sanitize_filename(filename: String) -> Option[String] {
  if filename.empty? { return Option.None }

  # Take the last path component (handles both / and \ separators).
  let mut start = 0
  let mut i = 0

  while i < filename.size {
    match filename.get(i) {
      case Ok(byte) -> {
        if byte == 47 or byte == 92 { start = i + 1 }

        i = i + 1
      }
      case Error(_) -> i = i + 1
    }
  }

  let mut base_bytes = ByteArray.new
  let mut k = start

  while k < filename.size {
    match filename.get(k) {
      case Ok(byte) -> base_bytes.push(byte)
      case Error(_) -> {}
    }

    k = k + 1
  }

  let base = base_bytes.into_string.trim

  # The checks on the cleaned name below are strictly stronger: cleaning only
  # removes bytes or replaces them with '_', so it cannot turn an unacceptable
  # name into an acceptable one.

  let mut clean = ByteArray.new
  let mut j = 0

  while j < base.size {
    match base.get(j) {
      case Ok(byte) -> {
        if byte < 32 or byte == 127 {
          # Drop C0 controls and DEL.
        } else if byte == 194 and is_c1_continuation(base, j + 1) {
          # Drop the two-byte UTF-8 encoding of a C1 control.
          j = j + 1
        } else if bidi_control_length(base, j) > 0 {
          # Drop bidi/format controls used for extension spoofing.
          j = j + bidi_control_length(base, j) - 1
        } else if is_reserved_filename_char(byte) {
          clean.push(95) # '_'
        } else {
          clean.push(byte)
        }

        j = j + 1
      }
      case Error(_) -> j = j + 1
    }
  }

  let name = clean.into_string.trim

  if name.empty? { return Option.None }

  if name == '.' or name == '..' { return Option.None }

  if name.starts_with?('.') or name.ends_with?('.') { return Option.None }

  if name.size > MAX_FILENAME_SIZE { return Option.None }

  # Windows reserved device names are not safe to create.
  let reserved_names = [
    'CON',
    'PRN',
    'AUX',
    'NUL',
    'COM1',
    'COM2',
    'COM3',
    'COM4',
    'COM5',
    'COM6',
    'COM7',
    'COM8',
    'COM9',
    'LPT1',
    'LPT2',
    'LPT3',
    'LPT4',
    'LPT5',
    'LPT6',
    'LPT7',
    'LPT8',
    'LPT9',
  ]

  let base_name = match name.index_of('.', 0) {
    case Some(dot_pos) -> name.slice(0, dot_pos).to_string
    case None -> name.clone
  }

  for reserved_name in reserved_names.iter {
    if eq_ignore_case(base_name.clone, reserved_name.clone) {
      return Option.None
    }
  }

  Option.Some(name)
}

# Characters that are invalid in Windows filenames
fn is_reserved_filename_char(byte: Int) -> Bool {
  byte == 60
    or byte == 62
    or byte == 58
    or byte == 34
    or byte == 124
    or byte == 63
    or byte == 42
}

# Whether `index` is the continuation byte of a UTF-8 C1 control (U+0080-U+009F)
fn is_c1_continuation(text: String, index: Int) -> Bool {
  if index >= text.size { return false }

  match text.get(index) {
    case Ok(byte) -> byte >= 128 and byte <= 159
    case Error(_) -> false
  }
}

# Length of a bidi/format control sequence at `index`, or 0 if none
#
# These characters can reorder how a filename is displayed, which enables
# extension spoofing (for example "résumé<U+202E>fdp.exe" rendering as
# "résuméexe.pdf"). U+2028 LINE SEPARATOR and U+2029 PARAGRAPH SEPARATOR are
# included as well: they pass through logs and UIs as line breaks.
fn bidi_control_length(text: String, index: Int) -> Int {
  if index + 2 >= text.size { return 0 }

  let b0 = match text.get(index) {
    case Ok(v) -> v
    case Error(_) -> return 0
  }
  let b1 = match text.get(index + 1) {
    case Ok(v) -> v
    case Error(_) -> return 0
  }
  let b2 = match text.get(index + 2) {
    case Ok(v) -> v
    case Error(_) -> return 0
  }

  if b0 == 0xE2 and b1 == 0x80 {
    # U+200E/U+200F and U+200B/U+200C/U+200D
    # U+2028/U+2029 line and paragraph separators
    if
      (b2 >= 0x8B and b2 <= 0x8F)
        or (b2 >= 0xA8 and b2 <= 0xA9)
        or (b2 >= 0xAA and b2 <= 0xAE)
    {
      return 3
    }
  }

  # U+2066..U+2069 (isolate controls)
  if b0 == 0xE2 and b1 == 0x81 and b2 >= 0xA6 and b2 <= 0xA9 { return 3 }

  # U+FEFF (BOM / zero-width no-break space)
  if b0 == 0xEF and b1 == 0xBB and b2 == 0xBF { return 3 }

  0
}

# Extract a filename from a Content-Disposition value
#
# Supports RFC 2183 filename parameters and RFC 2231 extended parameters
# (filename*=UTF-8''... and the filename*0*/filename*1* continuation form).
fn pub extract_filename_param(disposition: String) -> Option[String] {
  match parse_content_disposition_impl(disposition, false) {
    case Error(_) -> Option.None
    case Ok((_, params)) -> {
      # An unusable extended value (unknown charset, invalid octets) must not
      # mask a valid plain filename, so fall through when it fails to decode or
      # sanitizes to nothing.
      match get_param_value_impl(ref params, 'filename*') {
        case Some(value) -> {
          let decoded = decode_rfc2231_value(value, true)

          if !decoded.contains?('\u{FFFD}') {
            match sanitize_filename(decoded) {
              case Some(name) -> return Option.Some(name)
              case None -> {}
            }
          }
        }
        case None -> {}
      }

      # RFC 2231 continuation segments must be assembled before decoding:
      # percent-decoding each segment separately destroys multi-byte
      # sequences (and escaped octets) split across segments.
      match assemble_rfc2231_continuation(ref params, 'filename') {
        case Some(value) -> {
          match sanitize_filename(value) {
            case Some(name) -> return Option.Some(name)
            case None -> {}
          }
        }
        case None -> {}
      }

      match get_param_value_impl(ref params, 'filename') {
        case Some(value) -> sanitize_filename(value)
        case None -> Option.None
      }
    }
  }
}

# Assemble an RFC 2231 parameter continuation ("prefix*0*", "prefix*1*", ...)
#
# Segments are concatenated as raw bytes in index order and decoded once at the
# end, so a UTF-8 sequence or a percent escape split across segments survives.
# The charset is taken from the first segment (if it declares one). Returns
# None when no continuation segment exists or the segment count exceeds
# MAX_RFC2231_SEGMENTS.
fn assemble_rfc2231_continuation(
  params: ref Array[(String, String)],
  prefix: String,
) -> Option[String] {
  let mut bytes = ByteArray.new
  let mut charset = 'utf-8'
  let mut index = 0
  let mut found = false

  while index < MAX_RFC2231_SEGMENTS {
    let star_key = '${prefix}*${index}*'
    let plain_key = '${prefix}*${index}'
    let mut segment = Option.None
    let mut encoded = false

    match get_param_value_impl(ref params, star_key) {
      case Some(value) -> {
        segment = Option.Some(value)
        encoded = true
      }
      case None -> {
        match get_param_value_impl(ref params, plain_key) {
          case Some(value) -> segment = Option.Some(value)
          case None -> {}
        }
      }
    }

    match segment {
      case Some(value) -> {
        found = true

        if index == 0 and encoded {
          match split_rfc2231_charset(value) {
            case Some((declared, rest)) -> {
              charset = declared
              bytes.append(percent_decode(rest))
            }
            case None -> bytes.append(percent_decode(value))
          }
        } else if encoded {
          bytes.append(percent_decode(value))
        } else {
          bytes.append(value.to_byte_array)
        }

        index = index + 1
      }
      case None -> {
        # A gap ends the continuation
        index = MAX_RFC2231_SEGMENTS
      }
    }
  }

  # Reject rather than silently truncate an over-long continuation
  if index >= MAX_RFC2231_SEGMENTS and found {
    match
      get_param_value_impl(ref params, '${prefix}*${MAX_RFC2231_SEGMENTS}*')
    {
      case Some(_) -> return Option.None
      case None -> {}
    }
  }

  if found { Option.Some(decode_charset(bytes, charset)) } else { Option.None }
}

# Split "charset'language'value" into its charset and encoded value
fn split_rfc2231_charset(value: String) -> Option[(String, String)] {
  match value.index_of("'", 0) {
    case Some(first) -> {
      match value.index_of("'", first + 1) {
        case Some(second) -> {
          Option.Some(
            (
              value.slice(0, first).to_string,
              value.slice(second + 1, value.size).to_string,
            ),
          )
        }
        case None -> Option.None
      }
    }
    case None -> Option.None
  }
}

# Decode an RFC 2231 value ("charset'language'percent-encoded" when
# `has_charset` is true).
fn decode_rfc2231_value(value: String, has_charset: Bool) -> String {
  let mut charset = 'utf-8'
  let mut encoded = value

  if has_charset {
    match value.index_of("'", 0) {
      case Some(first) -> {
        match value.index_of("'", first + 1) {
          case Some(second) -> {
            charset = value.slice(0, first).to_string
            encoded = value.slice(second + 1, value.size).to_string
          }
          case None -> {}
        }
      }
      case None -> {}
    }
  }

  decode_charset(percent_decode(encoded), charset)
}

# Decode RFC 2231 percent escapes to raw bytes
fn percent_decode(value: String) -> ByteArray {
  let mut out = ByteArray.new
  let mut i = 0

  while i < value.size {
    match value.get(i) {
      case Ok(byte) -> {
        if byte == 37 and i + 2 < value.size {
          match value.get(i + 1) {
            case Ok(b1) -> {
              match value.get(i + 2) {
                case Ok(b2) -> {
                  match hex_char_to_value(b1) {
                    case Some(high) -> {
                      match hex_char_to_value(b2) {
                        case Some(low) -> {
                          out.push((high * 16) + low)
                          i = i + 3
                        }
                        case None -> {
                          out.push(byte)
                          i = i + 1
                        }
                      }
                    }
                    case None -> {
                      out.push(byte)
                      i = i + 1
                    }
                  }
                }
                case Error(_) -> {
                  out.push(byte)
                  i = i + 1
                }
              }
            }
            case Error(_) -> {
              out.push(byte)
              i = i + 1
            }
          }
        } else {
          out.push(byte)
          i = i + 1
        }
      }
      case Error(_) -> i = i + 1
    }
  }

  out
}

# Check if header is standard RFC 5322 header
fn is_standard_header_impl(name: String) -> Bool {
  let lower = name.to_lower

  for std in STANDARD.iter {
    if std == lower { return true }
  }

  false
}

# Extract non-standard headers
fn pub extract_extra_headers(
  headers: ref Array[(String, String)],
) -> Array[(String, String)] {
  let mut extra_headers = []

  for (key, value) in headers.iter {
    if is_standard_header_impl(key) == false {
      extra_headers.push((key.clone, value.clone))
    }
  }

  extra_headers
}
