import emailparser.ascii (
  ASCII_CR, ASCII_EQUALS, ASCII_HT, ASCII_LF, ASCII_SPACE,
)
import emailparser.decoder (decode_qp_bytes_range, is_base64_char)
import emailparser.hex (hex_char_to_value)
import emailparser.size_tracker (SizeTracker)
import std.base64 (Decoder)
import std.bytes (ByteArray)

type pub Base64StreamingDecoder {
  let mut @buffer: ByteArray
  let mut @size_tracker: SizeTracker
  let @strict_mode: Bool
  let mut @padding_seen: Bool
}

impl Base64StreamingDecoder {
  fn pub static new(max_size: Int, strict_mode: Bool) -> Base64StreamingDecoder
  {
    Base64StreamingDecoder(
      buffer: recover ByteArray.new,
      size_tracker: SizeTracker.new(max_size),
      strict_mode: strict_mode,
      padding_seen: false,
    )
  }

  fn pub mut feed(chunk: String) -> Result[ByteArray, String] {
    let bytes = chunk.to_byte_array

    feed_bytes(ref bytes)
  }

  # Feed raw bytes. The byte path preserves non-UTF-8 attachment content.
  fn pub mut feed_bytes(chunk: ref ByteArray) -> Result[ByteArray, String] {
    # Add chunk to buffer, filtering out whitespace and invalid characters.
    # Incomplete groups are kept in the buffer until they can be decoded.
    let mut i = 0

    while i < chunk.size {
      match chunk.get(i) {
        case Ok(byte) -> {
          # Skip whitespace
          if
            byte == ASCII_LF
              or byte == ASCII_CR
              or byte == ASCII_SPACE
              or byte == ASCII_HT
          {
            i = i + 1
          } else if is_base64_char(byte, true) {
            if @padding_seen and byte != ASCII_EQUALS {
              # Non-padding character after padding is invalid
              if @strict_mode {
                return Result.Error('Padding appears before end of data')
              } else {
                # In lax mode, skip this character
                i = i + 1
              }
            } else {
              if byte == ASCII_EQUALS { @padding_seen = true }

              @buffer.push(byte)

              i = i + 1
            }
          } else {
            # Invalid character
            if @strict_mode {
              return Result.Error('Invalid base64 character')
            } else {
              # In lax mode, skip invalid characters
              i = i + 1
            }
          }
        }
        case Error(_) -> i = i + 1
      }
    }

    # Only decode complete 4-character groups. A padded group is complete once
    # its size is a multiple of four.
    let decode_len = if @padding_seen {
      if @buffer.size % 4 == 0 { @buffer.size } else { 0 }
    } else {
      (@buffer.size / 4) * 4
    }

    if decode_len == 0 { return Result.Ok(ByteArray.new) }

    let to_decode = @buffer.slice(0, decode_len).to_byte_array

    @buffer = @buffer.slice(decode_len, @buffer.size).to_byte_array

    # Padding only ends one encoded block. Reset the state so a caller can
    # feed another block through the same decoder.
    if @padding_seen { @padding_seen = false }

    let output = ByteArray.new

    match decode_base64_bytes(ref to_decode, @strict_mode, output) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    # Check size limit and truncate if necessary
    if output.size > @size_tracker.remaining_space {
      return Result.Error('Decoded size exceeds maximum')
    }

    let _ = @size_tracker.add(output.size)

    Result.Ok(output)
  }

  fn pub mut finish -> Result[ByteArray, String] {
    let output = ByteArray.new

    if @buffer.size == 0 { return Result.Ok(output) }

    let to_decode = @buffer.clone

    @buffer = ByteArray.new

    match decode_base64_bytes(ref to_decode, @strict_mode, output) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    if output.size > @size_tracker.remaining_space {
      return Result.Error('Decoded size exceeds maximum')
    }

    let _ = @size_tracker.add(output.size)

    Result.Ok(output)
  }

  fn pub decoded_size -> Int {
    @size_tracker.current_size
  }
}

# Decode a (possibly unpadded) group of base64 characters.
#
# Trailing padding is stripped before decoding so that both "QQ==" and "QQ"
# decode to the same byte. A remainder of one character can never be decoded
# and is rejected.
fn decode_base64_bytes(
  input: ref ByteArray,
  strict_mode: Bool,
  into: mut ByteArray,
) -> Result[Nil, String] {
  if input.empty? { return Result.Ok(nil) }

  let mut data_size = input.size
  let mut padding = 0

  while data_size > 0 {
    match input.get(data_size - 1) {
      case Ok(byte) -> {
        if byte == ASCII_EQUALS {
          padding = padding + 1
          data_size = data_size - 1
        } else {
          break
        }
      }
      case Error(_) -> break
    }
  }

  let data = ByteArray.new
  let mut i = 0

  while i < data_size {
    match input.get(i) {
      case Ok(byte) -> {
        if byte == ASCII_EQUALS {
          if strict_mode {
            return Result.Error('Padding appears before end of data')
          }
        } else {
          data.push(byte)
        }
      }
      case Error(_) -> {}
    }

    i = i + 1
  }

  let remainder = data.size % 4

  if remainder == 1 { return Result.Error('Invalid base64 length') }

  if strict_mode {
    if padding > 2 { return Result.Error('Invalid base64 padding') }

    if padding == 1 and remainder != 3 {
      return Result.Error('Invalid base64 padding')
    }

    if padding == 2 and remainder != 2 {
      return Result.Error('Invalid base64 padding')
    }
  }

  let mut decoder = Decoder.new

  decoder.padding = false

  match decoder.decode(data, into) {
    case Ok(_) -> Result.Ok(nil)
    case Error(_) -> Result.Error('Base64 decoding failed')
  }
}

type pub QuotedPrintableStreamingDecoder {
  let mut @pending: ByteArray
  let mut @size_tracker: SizeTracker
  let @preserve_equals_on_error: Bool
  let @underscore_is_space: Bool
}

impl QuotedPrintableStreamingDecoder {
  fn pub static new(
    max_size: Int,
    preserve_equals_on_error: Bool,
    underscore_is_space: Bool,
  ) -> QuotedPrintableStreamingDecoder {
    QuotedPrintableStreamingDecoder(
      pending: recover ByteArray.new,
      size_tracker: SizeTracker.new(max_size),
      preserve_equals_on_error: preserve_equals_on_error,
      underscore_is_space: underscore_is_space,
    )
  }

  fn pub mut feed(chunk: String) -> Result[ByteArray, String] {
    let bytes = chunk.to_byte_array

    feed_bytes(ref bytes)
  }

  # Feed raw bytes. The byte path preserves non-UTF-8 attachment content.
  fn pub mut feed_bytes(chunk: ref ByteArray) -> Result[ByteArray, String] {
    # Combine pending data with new chunk
    let mut combined = @pending.clone

    combined.append(chunk.clone)

    # Only the trailing bytes of a potentially incomplete sequence are
    # buffered: '=', '=X' (X a hex digit) or '=\r'. Everything before it is
    # decoded now, so a malformed tail can never swallow the whole chunk.
    let tail = qp_incomplete_tail(combined)
    let process_end = combined.size - tail

    @pending = combined.slice(process_end, combined.size).to_byte_array

    # Decode the complete prefix with the shared QP state machine. The byte
    # range API keeps raw 8-bit content intact.
    let output = decode_qp_bytes_range(
      ref combined,
      process_end,
      @underscore_is_space,
      @preserve_equals_on_error,
      false,
    )

    # Check size limit
    match @size_tracker.check_add(output.size) {
      case Ok(_) -> {}
      case Error(_) -> return Result.Error('Decoded size exceeds maximum')
    }

    let _ = @size_tracker.add(output.size)

    Result.Ok(output)
  }

  fn pub mut finish -> Result[ByteArray, String] {
    # Process any remaining pending data
    let output = ByteArray.new

    if @pending.size > 0 {
      # The pending bytes are an incomplete escape sequence or trailing white
      # space at EOF. Drop trailing blanks (RFC 2045 section 6.7 rule 3) and
      # decode the remaining malformed escape instead of emitting it verbatim.
      let pending = @pending.clone
      let mut content_end = pending.size
      let mut last_is_cr = false

      match pending.get(content_end - 1) {
        case Ok(last) -> {
          if last == ASCII_CR {
            last_is_cr = true
            content_end = content_end - 1
          }
        }
        case Error(_) -> {}
      }

      let mut ws_start = content_end

      while ws_start > 0 {
        match pending.get(ws_start - 1) {
          case Ok(byte) -> {
            if byte == ASCII_SPACE or byte == ASCII_HT {
              ws_start = ws_start - 1
            } else {
              break
            }
          }
          case Error(_) -> break
        }
      }

      if ws_start < content_end {
        content_end = ws_start
      } else if last_is_cr {
        content_end = pending.size
      }

      let mut i = 0

      while i < content_end {
        match pending.get(i) {
          case Ok(byte) -> {
            if byte == ASCII_EQUALS {
              # No usable escape sequence left: keep the '=' only when the
              # caller asked us to preserve malformed escapes.
              if @preserve_equals_on_error { output.push(ASCII_EQUALS) }
            } else {
              output.push(byte)
            }

            i = i + 1
          }
          case Error(_) -> i = i + 1
        }
      }

      @pending = ByteArray.new

      # Check size limit
      match @size_tracker.check_add(output.size) {
        case Ok(_) -> {}
        case Error(_) -> return Result.Error('Decoded size exceeds maximum')
      }

      @size_tracker.add(output.size)
    }

    Result.Ok(output)
  }

  fn pub decoded_size -> Int {
    @size_tracker.current_size
  }
}

# Number of trailing bytes that may be part of an incomplete escape sequence
#
# A trailing run of '=' is consumed in pairs (this decoder treats "==" as a
# literal '='), so only an odd run leaves a lone '=' behind. Otherwise an
# escape starts only when the run of '=' before the final byte is odd.
fn qp_incomplete_tail(data: ref ByteArray) -> Int {
  let size = data.size

  if size == 0 { return 0 }

  let trailing_equals = qp_count_equals_ending_at(data, size)

  if trailing_equals > 0 {
    if (trailing_equals % 2) == 1 { return 1 } else { return 0 }
  }

  # The last byte is not '='; an escape may start right before it.
  let equals_before = qp_count_equals_ending_at(data, size - 1)

  if (equals_before % 2) == 0 {
    # Retain trailing white space (and a CR right after it) so a CRLF in the
    # next chunk can still strip it as end-of-line white space.
    let last_is_cr = match data.get(size - 1) {
      case Ok(last) -> last == ASCII_CR
      case Error(_) -> false
    }
    let mut ws_end = if last_is_cr { size - 1 } else { size }
    let mut ws_start = ws_end

    while ws_start > 0 {
      match data.get(ws_start - 1) {
        case Ok(byte) -> {
          if byte == ASCII_SPACE or byte == ASCII_HT {
            ws_start = ws_start - 1
          } else {
            break
          }
        }
        case Error(_) -> break
      }
    }

    if ws_start < ws_end {
      return (ws_end - ws_start) + (if last_is_cr { 1 } else { 0 })
    }

    return 0
  }

  match data.get(size - 1) {
    case Ok(last) -> {
      if last == ASCII_CR { return 2 }

      match hex_char_to_value(last) {
        case Some(_) -> 2
        case None -> 0
      }
    }
    case Error(_) -> 0
  }
}

# Count the run of '=' bytes ending at (but excluding) `end`
fn qp_count_equals_ending_at(data: ref ByteArray, end: Int) -> Int {
  let mut count = 0
  let mut i = end

  while i > 0 {
    match data.get(i - 1) {
      case Ok(byte) -> {
        if byte == ASCII_EQUALS {
          count = count + 1
          i = i - 1
        } else {
          i = 0
        }
      }
      case Error(_) -> i = 0
    }
  }

  count
}
