import std.base64 (Decoder)
import std.bytes (ByteArray)

# ASCII constants for base64 decoding
let ASCII_CR = 13
let ASCII_LF = 10
let ASCII_SPACE = 32
let ASCII_HT = 9
let ASCII_EQUALS = 61

type pub Base64StreamingDecoder {
  let mut @buffer: ByteArray
  let mut @decoded_size: Int
  let @max_size: Int
  let @strict_mode: Bool
}

impl Base64StreamingDecoder {
  fn pub static new(max_size: Int, strict_mode: Bool) -> Base64StreamingDecoder {
    Base64StreamingDecoder(
      buffer: recover ByteArray.new,
      decoded_size: 0,
      max_size: max_size,
      strict_mode: strict_mode,
    )
  }

  fn pub mut feed(chunk: String) -> Result[ByteArray, String] {
    let mut has_padding = false

    # Add chunk to buffer, filtering out whitespace and invalid characters
    let mut i = 0
    while i < chunk.size {
      match chunk.get(i) {
        case Ok(byte) -> {
          # Skip whitespace
          if byte == ASCII_LF or byte == ASCII_CR or byte == ASCII_SPACE or byte == ASCII_HT {
            i = i + 1
          } else if is_valid_base64_char(byte) {
            # Check for padding in wrong position
            if has_padding and byte != ASCII_EQUALS {
              # Non-padding character after padding is invalid
              if @strict_mode {
                return Result.Error('Padding appears before end of data')
              } else {
                # In lax mode, skip this character
                i = i + 1
              }
            } else {
              @buffer.push(byte)
              if byte == ASCII_EQUALS {
                has_padding = true
              }
              i = i + 1
            }
          } else {
            # Invalid character
            if @strict_mode {
              return Result.Error('Invalid base64 character')
            } else {
              # In lax mode, skip invalid characters
              i = i + 1
            }
          }
        }
        case Error(_) -> i = i + 1
      }
    }

    let output = ByteArray.new

    # Only decode if we see padding (indicating end of data in this stream)
    if has_padding {
      let decoder = Decoder.new
      match decoder.decode(@buffer, output) {
        case Ok(_) -> {
          # Check size limit and truncate if necessary
          let available_space = @max_size - @decoded_size
          if output.size > available_space {
            # Truncate output to fit within limit
            let truncated = ByteArray.new
            let mut idx = 0
            while idx < available_space {
              match output.get(idx) {
                case Ok(b) -> truncated.push(b)
                case Error(_) -> {}
              }
              idx = idx + 1
            }
            @decoded_size = @max_size
            @buffer = ByteArray.new
            return Result.Ok(truncated)
          } else {
            @decoded_size = @decoded_size + output.size
            @buffer = ByteArray.new
          }
        }
        case Error(_) -> {
          return Result.Error('Base64 decoding failed')
        }
      }
    }

    Result.Ok(output)
  }

  fn pub mut finish -> Result[ByteArray, String] {
    # Decode any remaining data in buffer
    let output = ByteArray.new

    if @buffer.size > 0 {
      let decoder = Decoder.new
      match decoder.decode(@buffer, output) {
        case Ok(_) -> {
          # Check size limit and truncate if necessary
          let available_space = @max_size - @decoded_size
          if output.size > available_space {
            # Truncate output to fit within limit
            let truncated = ByteArray.new
            let mut idx = 0
            while idx < available_space {
              match output.get(idx) {
                case Ok(b) -> truncated.push(b)
                case Error(_) -> {}
              }
              idx = idx + 1
            }
            @decoded_size = @max_size
            @buffer = ByteArray.new
            return Result.Ok(truncated)
          } else {
            @decoded_size = @decoded_size + output.size
            @buffer = ByteArray.new
          }
        }
        case Error(_) -> {
          return Result.Error('Base64 decoding failed')
        }
      }
    }

    Result.Ok(output)
  }

  fn pub decoded_size -> Int {
    @decoded_size
  }
}

fn is_valid_base64_char(byte: Int) -> Bool {
  # A-Z: 65-90, a-z: 97-122, 0-9: 48-57, +: 43, /: 47, =: 61
  (byte >= 65 and byte <= 90)
    or (byte >= 97 and byte <= 122)
    or (byte >= 48 and byte <= 57)
    or byte == 43
    or byte == 47
    or byte == 61
}

type pub QuotedPrintableStreamingDecoder {
  let mut @pending: ByteArray
  let mut @decoded_size: Int
  let @max_size: Int
  let @preserve_equals_on_error: Bool
  let @underscore_is_space: Bool
}

impl QuotedPrintableStreamingDecoder {
  fn pub static new(max_size: Int, preserve_equals_on_error: Bool, underscore_is_space: Bool) -> QuotedPrintableStreamingDecoder {
    QuotedPrintableStreamingDecoder(
      pending: recover ByteArray.new,
      decoded_size: 0,
      max_size: max_size,
      preserve_equals_on_error: preserve_equals_on_error,
      underscore_is_space: underscore_is_space,
    )
  }

  fn pub mut feed(chunk: String) -> Result[ByteArray, String] {
    # Combine pending data with new chunk
    let combined = ByteArray.new
    let mut p = 0
    while p < @pending.size {
      match @pending.get(p) {
        case Ok(b) -> combined.push(b)
        case Error(_) -> {}
      }
      p = p + 1
    }

    let mut c = 0
    while c < chunk.size {
      match chunk.get(c) {
        case Ok(b) -> combined.push(b)
        case Error(_) -> {}
      }
      c = c + 1
    }

    # Check if combined ends with incomplete sequence
    # If it does, buffer EVERYTHING for next chunk
    let combined_size = combined.size
    let mut has_incomplete = false

    # Check if ends with '=' (might be start of =XX or =\r\n)
    if combined_size >= 1 {
      match combined.get(combined_size - 1) {
        case Ok(last) -> {
          if last == ASCII_EQUALS {
            has_incomplete = true
          }
        }
        case Error(_) -> {}
      }
    }

    # Check if ends with '=X' where X is a hex digit and not '=' (might be =XY split)
    # But only if there's no '=' before this one (to avoid buffering '==X' patterns)
    if combined_size >= 2 and has_incomplete == false {
      match combined.get(combined_size - 2) {
        case Ok(second_last) -> {
          if second_last == ASCII_EQUALS {
            match combined.get(combined_size - 1) {
              case Ok(last) -> {
                # Check if last is a hex digit (not CR, LF, or another =)
                let is_hex_not_eq = last != ASCII_EQUALS and ((last >= 48 and last <= 57) or (last >= 65 and last <= 70) or (last >= 97 and last <= 102))
                if is_hex_not_eq {
                  # Check if there's another '=' before this one (e.g., '==X' pattern)
                  # If size >= 3, check position -3
                  let has_eq_before = if combined_size >= 3 {
                    match combined.get(combined_size - 3) {
                      case Ok(third_last) -> third_last == ASCII_EQUALS
                      case Error(_) -> false
                    }
                  } else {
                    false
                  }

                  if has_eq_before == false {
                    has_incomplete = true
                  }
                }
              }
              case Error(_) -> {}
            }
          }
        }
        case Error(_) -> {}
      }
    }

    # Check if ends with '=\r' (might be waiting for \n)
    if combined_size >= 2 and has_incomplete == false {
      match combined.get(combined_size - 2) {
        case Ok(second_last) -> {
          match combined.get(combined_size - 1) {
            case Ok(last) -> {
              if second_last == ASCII_EQUALS and last == ASCII_CR {
                has_incomplete = true
              }
            }
            case Error(_) -> {}
          }
        }
        case Error(_) -> {}
      }
    }

    # If incomplete, buffer everything
    if has_incomplete {
      @pending = combined
      return Result.Ok(ByteArray.new)
    }

    # Process the text
    let text = combined.into_string
    let output = ByteArray.new
    let mut i = 0

    while i < text.size {
      match text.get(i) {
        case Ok(byte) -> {
          if byte == 95 and @underscore_is_space {
            # Underscore as space
            output.push(ASCII_SPACE)
            i = i + 1
          } else if byte == ASCII_EQUALS {
            # Check if we have enough bytes for a complete sequence
            if i + 2 < text.size {
              match text.get(i + 1) {
                case Ok(next1) -> {
                  # Check for soft line break (=\r\n or =\n)
                  if next1 == ASCII_CR {
                    match text.get(i + 2) {
                      case Ok(next2) -> {
                        if next2 == ASCII_LF {
                          # Soft line break =\r\n - skip all three bytes
                          i = i + 3
                        } else {
                          # =\r followed by something else
                          if @preserve_equals_on_error {
                            output.push(ASCII_EQUALS)
                          }
                          i = i + 1
                        }
                      }
                      case Error(_) -> {
                        if @preserve_equals_on_error {
                          output.push(ASCII_EQUALS)
                        }
                        i = i + 1
                      }
                    }
                  } else if next1 == ASCII_LF {
                    # Soft line break =\n - skip both bytes
                    i = i + 2
                  } else if next1 == ASCII_EQUALS {
                    # == special case: treat as literal =
                    output.push(ASCII_EQUALS)
                    i = i + 2
                  } else {
                    # Try to parse as hex sequence =XX
                    match text.get(i + 2) {
                      case Ok(next2) -> {
                        match parse_hex_pair(next1, next2) {
                          case Some(decoded) -> {
                            output.push(decoded)
                            i = i + 3
                          }
                          case None -> {
                            # Invalid hex sequence
                            if @preserve_equals_on_error {
                              output.push(ASCII_EQUALS)
                            }
                            i = i + 1
                          }
                        }
                      }
                      case Error(_) -> {
                        if @preserve_equals_on_error {
                          output.push(ASCII_EQUALS)
                        }
                        i = i + 1
                      }
                    }
                  }
                }
                case Error(_) -> {
                  if @preserve_equals_on_error {
                    output.push(ASCII_EQUALS)
                  }
                  i = i + 1
                }
              }
            } else if i + 1 < text.size {
              # Only one byte after =, might be =\n
              match text.get(i + 1) {
                case Ok(next1) -> {
                  if next1 == ASCII_LF {
                    # Soft line break =\n
                    i = i + 2
                  } else {
                    # This case should not happen as we buffer incomplete sequences
                    if @preserve_equals_on_error {
                      output.push(ASCII_EQUALS)
                    }
                    i = i + 1
                  }
                }
                case Error(_) -> {
                  if @preserve_equals_on_error {
                    output.push(ASCII_EQUALS)
                  }
                  i = i + 1
                }
              }
            } else {
              # = at end - should not happen as we buffer these
              if @preserve_equals_on_error {
                output.push(ASCII_EQUALS)
              }
              i = i + 1
            }
          } else {
            # Literal byte
            output.push(byte)
            i = i + 1
          }
        }
        case Error(_) -> i = i + 1
      }
    }

    # Check size limit
    let new_size = @decoded_size + output.size
    if new_size > @max_size {
      return Result.Error('Decoded size exceeds maximum')
    }
    @decoded_size = new_size

    Result.Ok(output)
  }

  fn pub mut finish -> Result[ByteArray, String] {
    # Process any remaining pending data
    let output = ByteArray.new

    if @pending.size > 0 {
      # If we have pending data, it's incomplete - handle it
      let mut i = 0
      while i < @pending.size {
        match @pending.get(i) {
          case Ok(byte) -> {
            if @preserve_equals_on_error {
              output.push(byte)
            }
            i = i + 1
          }
          case Error(_) -> i = i + 1
        }
      }

      @pending = ByteArray.new

      # Check size limit
      let new_size = @decoded_size + output.size
      if new_size > @max_size {
        return Result.Error('Decoded size exceeds maximum')
      }
      @decoded_size = new_size
    }

    Result.Ok(output)
  }

  fn pub decoded_size -> Int {
    @decoded_size
  }
}

fn parse_hex_pair(high: Int, low: Int) -> Option[Int] {
  match hex_digit_value(high) {
    case Some(h) -> {
      match hex_digit_value(low) {
        case Some(l) -> Option.Some(h * 16 + l)
        case None -> Option.None
      }
    }
    case None -> Option.None
  }
}

fn hex_digit_value(byte: Int) -> Option[Int] {
  if byte >= 48 and byte <= 57 {
    # 0-9
    Option.Some(byte - 48)
  } else if byte >= 65 and byte <= 70 {
    # A-F
    Option.Some(byte - 65 + 10)
  } else if byte >= 97 and byte <= 102 {
    # a-f
    Option.Some(byte - 97 + 10)
  } else {
    Option.None
  }
}
