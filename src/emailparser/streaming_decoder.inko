import emailparser.ascii (
  ASCII_CR, ASCII_EQUALS, ASCII_HT, ASCII_LF, ASCII_SPACE,
)
import emailparser.hex (hex_char_to_value)
import emailparser.size_tracker (SizeTracker)
import std.base64 (Decoder)
import std.bytes (ByteArray)

type pub Base64StreamingDecoder {
  let mut @buffer: ByteArray
  let mut @size_tracker: SizeTracker
  let @strict_mode: Bool
  let mut @padding_seen: Bool
}

impl Base64StreamingDecoder {
  fn pub static new(max_size: Int, strict_mode: Bool) -> Base64StreamingDecoder
  {
    Base64StreamingDecoder(
      buffer: recover ByteArray.new,
      size_tracker: SizeTracker.new(max_size, strict_mode),
      strict_mode: strict_mode,
      padding_seen: false,
    )
  }

  fn pub mut feed(chunk: String) -> Result[ByteArray, String] {
    # Add chunk to buffer, filtering out whitespace and invalid characters.
    # Incomplete groups are kept in the buffer until they can be decoded.
    let mut i = 0

    while i < chunk.size {
      match chunk.get(i) {
        case Ok(byte) -> {
          # Skip whitespace
          if
            byte == ASCII_LF
              or byte == ASCII_CR
              or byte == ASCII_SPACE
              or byte == ASCII_HT
          {
            i = i + 1
          } else if is_valid_base64_char(byte) {
            if @padding_seen and byte != ASCII_EQUALS {
              # Non-padding character after padding is invalid
              if @strict_mode {
                return Result.Error('Padding appears before end of data')
              } else {
                # In lax mode, skip this character
                i = i + 1
              }
            } else {
              if byte == ASCII_EQUALS { @padding_seen = true }

              @buffer.push(byte)

              i = i + 1
            }
          } else {
            # Invalid character
            if @strict_mode {
              return Result.Error('Invalid base64 character')
            } else {
              # In lax mode, skip invalid characters
              i = i + 1
            }
          }
        }
        case Error(_) -> i = i + 1
      }
    }

    # Only decode complete 4-character groups. A padded group is complete once
    # its size is a multiple of four.
    let decode_len = if @padding_seen {
      if @buffer.size % 4 == 0 { @buffer.size } else { 0 }
    } else {
      (@buffer.size / 4) * 4
    }

    if decode_len == 0 { return Result.Ok(ByteArray.new) }

    let to_decode = ByteArray.new
    let rest = ByteArray.new
    let mut idx = 0

    while idx < @buffer.size {
      match @buffer.get(idx) {
        case Ok(byte) -> {
          if idx < decode_len { to_decode.push(byte) } else { rest.push(byte) }
        }
        case Error(_) -> {}
      }

      idx = idx + 1
    }

    @buffer = rest

    let output = ByteArray.new

    match decode_base64_bytes(ref to_decode, @strict_mode, output) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    # Check size limit and truncate if necessary
    let available_space = @size_tracker.remaining_space

    if output.size > available_space {
      let truncated = ByteArray.new
      let mut idx = 0

      while idx < available_space {
        match output.get(idx) {
          case Ok(b) -> truncated.push(b)
          case Error(_) -> {}
        }

        idx = idx + 1
      }

      let _ = @size_tracker.add(available_space)

      @buffer = ByteArray.new
      return Result.Ok(truncated)
    }

    let _ = @size_tracker.add(output.size)

    Result.Ok(output)
  }

  fn pub mut finish -> Result[ByteArray, String] {
    let output = ByteArray.new

    if @buffer.size == 0 { return Result.Ok(output) }

    let to_decode = ByteArray.new
    let mut idx = 0

    while idx < @buffer.size {
      match @buffer.get(idx) {
        case Ok(byte) -> to_decode.push(byte)
        case Error(_) -> {}
      }

      idx = idx + 1
    }

    @buffer = ByteArray.new

    match decode_base64_bytes(ref to_decode, @strict_mode, output) {
      case Ok(_) -> {}
      case Error(e) -> return Result.Error(e)
    }

    # Check size limit and truncate if necessary
    let available_space = @size_tracker.remaining_space

    if output.size > available_space {
      let truncated = ByteArray.new
      let mut idx = 0

      while idx < available_space {
        match output.get(idx) {
          case Ok(b) -> truncated.push(b)
          case Error(_) -> {}
        }

        idx = idx + 1
      }

      let _ = @size_tracker.add(available_space)

      return Result.Ok(truncated)
    }

    let _ = @size_tracker.add(output.size)

    Result.Ok(output)
  }

  fn pub decoded_size -> Int {
    @size_tracker.current_size
  }
}

fn is_valid_base64_char(byte: Int) -> Bool {
  # A-Z: 65-90, a-z: 97-122, 0-9: 48-57, +: 43, /: 47, =: 61
  (byte >= 65 and byte <= 90)
    or (byte >= 97 and byte <= 122)
    or (byte >= 48 and byte <= 57)
    or byte == 43
    or byte == 47
    or byte == 61
}

# Decode a (possibly unpadded) group of base64 characters.
#
# Trailing padding is stripped before decoding so that both "QQ==" and "QQ"
# decode to the same byte. A remainder of one character can never be decoded
# and is rejected.
fn decode_base64_bytes(
  input: ref ByteArray,
  strict_mode: Bool,
  into: mut ByteArray,
) -> Result[Nil, String] {
  if input.empty? { return Result.Ok(nil) }

  let mut data_size = input.size
  let mut padding = 0

  while data_size > 0 {
    match input.get(data_size - 1) {
      case Ok(byte) -> {
        if byte == ASCII_EQUALS {
          padding = padding + 1
          data_size = data_size - 1
        } else {
          break
        }
      }
      case Error(_) -> break
    }
  }

  let data = ByteArray.new
  let mut i = 0

  while i < data_size {
    match input.get(i) {
      case Ok(byte) -> {
        if byte == ASCII_EQUALS {
          if strict_mode {
            return Result.Error('Padding appears before end of data')
          }
        } else {
          data.push(byte)
        }
      }
      case Error(_) -> {}
    }

    i = i + 1
  }

  let remainder = data.size % 4

  if remainder == 1 { return Result.Error('Invalid base64 length') }

  if strict_mode {
    if padding > 2 { return Result.Error('Invalid base64 padding') }

    if padding == 1 and remainder != 3 {
      return Result.Error('Invalid base64 padding')
    }

    if padding == 2 and remainder != 2 {
      return Result.Error('Invalid base64 padding')
    }
  }

  let mut decoder = Decoder.new

  decoder.padding = false

  match decoder.decode(data, into) {
    case Ok(_) -> Result.Ok(nil)
    case Error(_) -> Result.Error('Base64 decoding failed')
  }
}

type pub QuotedPrintableStreamingDecoder {
  let mut @pending: ByteArray
  let mut @size_tracker: SizeTracker
  let @preserve_equals_on_error: Bool
  let @underscore_is_space: Bool
}

impl QuotedPrintableStreamingDecoder {
  fn pub static new(
    max_size: Int,
    preserve_equals_on_error: Bool,
    underscore_is_space: Bool,
  ) -> QuotedPrintableStreamingDecoder {
    QuotedPrintableStreamingDecoder(
      pending: recover ByteArray.new,
      size_tracker: SizeTracker.new(max_size, true),
      preserve_equals_on_error: preserve_equals_on_error,
      underscore_is_space: underscore_is_space,
    )
  }

  fn pub mut feed(chunk: String) -> Result[ByteArray, String] {
    # Combine pending data with new chunk
    let combined = ByteArray.new
    let mut p = 0

    while p < @pending.size {
      match @pending.get(p) {
        case Ok(b) -> combined.push(b)
        case Error(_) -> {}
      }

      p = p + 1
    }

    let mut c = 0

    while c < chunk.size {
      match chunk.get(c) {
        case Ok(b) -> combined.push(b)
        case Error(_) -> {}
      }

      c = c + 1
    }

    # Check if combined ends with incomplete sequence
    # If it does, buffer EVERYTHING for next chunk
    let combined_size = combined.size
    let mut has_incomplete = false

    # Check if ends with '=' (might be start of =XX or =\r\n)
    if combined_size >= 1 {
      match combined.get(combined_size - 1) {
        case Ok(last) -> if last == ASCII_EQUALS { has_incomplete = true }
        case Error(_) -> {}
      }
    }

    # Check if ends with '=X' where X is a hex digit and not '=' (might be =XY split)
    # But only if there's no '=' before this one (to avoid buffering '==X' patterns)
    if combined_size >= 2 and has_incomplete == false {
      match combined.get(combined_size - 2) {
        case Ok(second_last) -> {
          if second_last == ASCII_EQUALS {
            match combined.get(combined_size - 1) {
              case Ok(last) -> {
                # Check if last is a hex digit (not CR, LF, or another =)
                let is_hex_not_eq = last != ASCII_EQUALS
                  and (
                    (last >= 48 and last <= 57)
                      or (last >= 65 and last <= 70)
                      or (last >= 97 and last <= 102)
                  )

                if is_hex_not_eq {
                  # Check if there's another '=' before this one (e.g., '==X' pattern)
                  # If size >= 3, check position -3
                  let has_eq_before = if combined_size >= 3 {
                    match combined.get(combined_size - 3) {
                      case Ok(third_last) -> third_last == ASCII_EQUALS
                      case Error(_) -> false
                    }
                  } else {
                    false
                  }

                  if has_eq_before == false { has_incomplete = true }
                }
              }
              case Error(_) -> {}
            }
          }
        }
        case Error(_) -> {}
      }
    }

    # Check if ends with '=\r' (might be waiting for \n)
    if combined_size >= 2 and has_incomplete == false {
      match combined.get(combined_size - 2) {
        case Ok(second_last) -> {
          match combined.get(combined_size - 1) {
            case Ok(last) -> {
              if second_last == ASCII_EQUALS and last == ASCII_CR {
                has_incomplete = true
              }
            }
            case Error(_) -> {}
          }
        }
        case Error(_) -> {}
      }
    }

    # If incomplete, buffer everything
    if has_incomplete {
      @pending = combined
      return Result.Ok(ByteArray.new)
    }

    # Process the text
    let text = combined.into_string
    let output = ByteArray.new
    let mut i = 0

    while i < text.size {
      match text.get(i) {
        case Ok(byte) -> {
          if byte == 95 and @underscore_is_space {
            # Underscore as space
            output.push(ASCII_SPACE)
            i = i + 1
          } else if byte == ASCII_EQUALS {
            # Check if we have enough bytes for a complete sequence
            if i + 2 < text.size {
              match text.get(i + 1) {
                case Ok(next1) -> {
                  # Check for soft line break (=\r\n or =\n)
                  if next1 == ASCII_CR {
                    match text.get(i + 2) {
                      case Ok(next2) -> {
                        if next2 == ASCII_LF {
                          # Soft line break =\r\n - skip all three bytes
                          i = i + 3
                        } else {
                          # =\r followed by something else
                          if @preserve_equals_on_error {
                            output.push(ASCII_EQUALS)
                          }

                          i = i + 1
                        }
                      }
                      case Error(_) -> {
                        if @preserve_equals_on_error {
                          output.push(ASCII_EQUALS)
                        }

                        i = i + 1
                      }
                    }
                  } else if next1 == ASCII_LF {
                    # Soft line break =\n - skip both bytes
                    i = i + 2
                  } else if next1 == ASCII_EQUALS {
                    # == special case: treat as literal =
                    # This is a common encoding for literal = in the wild
                    output.push(ASCII_EQUALS)
                    i = i + 2
                  } else {
                    # Try to parse as hex sequence =XX
                    match text.get(i + 2) {
                      case Ok(next2) -> {
                        match parse_hex_pair(next1, next2) {
                          case Some(decoded) -> {
                            output.push(decoded)
                            i = i + 3
                          }
                          case None -> {
                            # Invalid hex sequence
                            if @preserve_equals_on_error {
                              output.push(ASCII_EQUALS)
                            }

                            i = i + 1
                          }
                        }
                      }
                      case Error(_) -> {
                        if @preserve_equals_on_error {
                          output.push(ASCII_EQUALS)
                        }

                        i = i + 1
                      }
                    }
                  }
                }
                case Error(_) -> {
                  if @preserve_equals_on_error { output.push(ASCII_EQUALS) }

                  i = i + 1
                }
              }
            } else if i + 1 < text.size {
              # Only one byte after =, might be =\n
              match text.get(i + 1) {
                case Ok(next1) -> {
                  if next1 == ASCII_LF {
                    # Soft line break =\n
                    i = i + 2
                  } else {
                    # This case should not happen as we buffer incomplete sequences
                    if @preserve_equals_on_error { output.push(ASCII_EQUALS) }

                    i = i + 1
                  }
                }
                case Error(_) -> {
                  if @preserve_equals_on_error { output.push(ASCII_EQUALS) }

                  i = i + 1
                }
              }
            } else {
              # = at end - should not happen as we buffer these
              if @preserve_equals_on_error { output.push(ASCII_EQUALS) }

              i = i + 1
            }
          } else {
            # Literal byte
            output.push(byte)
            i = i + 1
          }
        }
        case Error(_) -> i = i + 1
      }
    }

    # Check size limit
    match @size_tracker.check_add(output.size) {
      case Ok(_) -> {}
      case Error(_) -> return Result.Error('Decoded size exceeds maximum')
    }

    let _ = @size_tracker.add(output.size)

    Result.Ok(output)
  }

  fn pub mut finish -> Result[ByteArray, String] {
    # Process any remaining pending data
    let output = ByteArray.new

    if @pending.size > 0 {
      # If we have pending data, it's incomplete - handle it
      let mut i = 0

      while i < @pending.size {
        match @pending.get(i) {
          case Ok(byte) -> {
            if @preserve_equals_on_error { output.push(byte) }

            i = i + 1
          }
          case Error(_) -> i = i + 1
        }
      }

      @pending = ByteArray.new

      # Check size limit
      match @size_tracker.check_add(output.size) {
        case Ok(_) -> {}
        case Error(_) -> return Result.Error('Decoded size exceeds maximum')
      }

      @size_tracker.add(output.size)
    }

    Result.Ok(output)
  }

  fn pub decoded_size -> Int {
    @size_tracker.current_size
  }
}

fn parse_hex_pair(high: Int, low: Int) -> Option[Int] {
  match hex_char_to_value(high) {
    case Some(h) -> {
      match hex_char_to_value(low) {
        case Some(l) -> Option.Some(h * 16 + l)
        case None -> Option.None
      }
    }
    case None -> Option.None
  }
}
