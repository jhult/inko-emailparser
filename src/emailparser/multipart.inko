# ==============================================================================
# Multipart MIME Message Parsing Module
# ==============================================================================
#
# This module handles parsing of multipart MIME messages as specified in
# RFC 2046 section 5. It processes emails with multiple parts, including
# alternative text/HTML versions, inline images, and file attachments.
#
# ## Purpose
#
# Multipart messages allow emails to contain multiple content types:
# - **multipart/alternative**: Same content in different formats (e.g., text + HTML)
# - **multipart/related**: HTML with inline images (Content-ID references)
# - **multipart/mixed**: Combination of text, HTML, and attachments
# - **Nested multipart**: Complex structures with multiple levels
#
# This module:
# - Splits multipart bodies by boundary strings
# - Parses individual multipart parts (headers + body)
# - Handles nested multipart messages recursively
# - Merges text, HTML, and attachment parts into structured output
#
# ## Architecture
#
# The module provides one main public function:
#
# - `parse_multipart_impl`: Parse a multipart message body
#   - Input: Raw body string, boundary string, recursion depth, max depth
#   - Output: Tuple of (text_body, html_body, attachments_array)
#   - Handles: Nested multipart, text extraction, attachment parsing
#
# And one helper function:
#
# - `merge_multipart_part`: Merge a single part into existing results
#   - Updates: text_body, html_body based on content type
#   - Creates: EmailAttachment for disposition="attachment" parts
#   - Returns: Updated tuple of (text, html, attachment)
#
# ## RFC Compliance
#
# - RFC 2046 section 5: Multipart Media Type
#   - 5.1: Multipart Media Type
#   - 5.1.1: Multipart: The common syntax
#   - 5.1.3: Nested Multipart
#
# ## Design Decisions
#
# ### Recursive Parsing
# Nested multipart messages are parsed recursively with depth tracking to prevent
# stack overflow attacks. The max depth limit (default: 10) is enforced.
#
# ### Content Type Handling
# - text/plain -> Stored in text_body
# - text/html -> Stored in html_body
# - Other types -> Treated as attachments
# - multipart/* -> Parsed recursively
#
# ### Attachment Detection
# Parts with Content-Disposition="attachment" are always treated as attachments,
# regardless of content type. Parts without disposition are inferred from type.

import emailparser.attachment (EmailAttachment)
import emailparser.decoder (decode_body_bytes_impl)
import emailparser.error (Error, Severity, is_recoverable_part_error)
import emailparser.header (
  extract_filename_param, get_header_value_impl, get_param_value_impl,
  parse_content_disposition_impl, parse_content_type_impl, parse_headers_impl,
  sanitize_filename,
)
import std.bytes (ByteArray)
import std.option (Option)
import std.result (Result)

# Process a single multipart part and merge results
fn pub merge_multipart_part(
  text_body: ref Option[String],
  html_body: ref Option[String],
  ct_main: String,
  disp_main: String,
  filename: Option[String],
  content_id: Option[String],
  decoded_bytes: ByteArray,
) -> (Option[String], Option[String], Option[EmailAttachment]) {
  # Track if we need to clone (lazy initialization)
  let mut text_modified = false
  let mut html_modified = false
  let mut new_text_body = Option.None
  let mut new_html_body = Option.None
  let mut new_attachment = Option.None

  if disp_main == 'attachment' or (disp_main == 'inline' and filename.some?) {
    new_attachment = Option.Some(
      EmailAttachment.from_decoded_part(
        content_type: ct_main,
        filename: filename,
        content_disposition: disp_main,
        content_id: content_id,
        decoded_bytes: decoded_bytes,
      ),
    )
  } else if ct_main == 'text/plain' {
    let segment = decoded_bytes.into_string

    if text_body.some? {
      let existing: String = text_body.clone.get

      new_text_body = Option.Some(existing + segment)
    } else {
      new_text_body = Option.Some(segment)
    }

    text_modified = true
  } else if ct_main == 'text/html' {
    let segment = decoded_bytes.into_string

    if html_body.some? {
      let existing: String = html_body.clone.get

      new_html_body = Option.Some(existing + segment)
    } else {
      new_html_body = Option.Some(segment)
    }

    html_modified = true
  } else if ct_main.starts_with?('image/') and disp_main == 'inline' {
    new_attachment = Option.Some(
      EmailAttachment.from_decoded_part(
        content_type: ct_main,
        filename: filename,
        content_disposition: disp_main,
        content_id: content_id,
        decoded_bytes: decoded_bytes,
      ),
    )
  } else {
    # Any other non-text part with no real disposition is still an
    # attachment (e.g. application/pdf sent without Content-Disposition).
    # A missing disposition is represented as "inline" with no filename.
    let disposition = if
      disp_main.empty? or (disp_main == 'inline' and filename.none?)
    {
      'attachment'
    } else {
      disp_main
    }

    new_attachment = Option.Some(
      EmailAttachment.from_decoded_part(
        content_type: ct_main,
        filename: filename,
        content_disposition: disposition,
        content_id: content_id,
        decoded_bytes: decoded_bytes,
      ),
    )
  }

  # Clone original values only if we didn't modify them
  let final_text = if text_modified {
    new_text_body
  } else {
    match text_body.clone {
      case Some(v) -> Option.Some(v)
      case None -> Option.None
    }
  }

  let final_html = if html_modified {
    new_html_body
  } else {
    match html_body.clone {
      case Some(v) -> Option.Some(v)
      case None -> Option.None
    }
  }

  (final_text, final_html, new_attachment)
}

import emailparser.validation (is_valid_boundary)

# Handle nested multipart messages
fn pub handle_nested_multipart(
  decoded_bytes: ByteArray,
  ct_params: Array[(String, String)],
  transfer_encoding: String,
  depth: Int,
  max_depth: Int,
  max_attachment_size: Int,
  max_attachments: Int,
  max_headers: Int,
  ct_main: String,
  disp_main: String,
  filename: Option[String],
  content_id: Option[String],
  strict_mode: Bool,
) -> Result[(Option[String], Option[String], Array[EmailAttachment]), Error] {
  match get_header_value_impl(ct_params, 'boundary') {
    case Some(nested_boundary) -> {
      match
        parse_multipart_impl(
          decoded_bytes.into_string,
          nested_boundary,
          transfer_encoding,
          depth + 1,
          max_depth,
          max_attachment_size,
          max_attachments,
          max_headers,
          strict_mode,
        )
      {
        case Ok(result) -> Result.Ok(result)
        case Error(e) -> Result.Error(e)
      }
    }
    case None -> {
      Result.Ok(
        (
          Option.None,
          Option.None,
          [
            EmailAttachment.from_decoded_part(
              content_type: ct_main,
              filename: filename,
              content_disposition: disp_main,
              content_id: content_id,
              decoded_bytes: decoded_bytes,
            ),
          ],
        ),
      )
    }
  }
}

# Parse multipart MIME message
fn parse_multipart_impl(
  raw: String,
  boundary: String,
  default_encoding: String,
  depth: Int,
  max_depth: Int,
  max_attachment_size: Int,
  max_attachments: Int,
  max_headers: Int,
  strict_mode: Bool,
) -> Result[(Option[String], Option[String], Array[EmailAttachment]), Error] {
  if depth > max_depth {
    return Result.Error(
      Error.MultipartDepthExceeded(
        Severity.Error,
        depth,
        max_depth,
        Option.None,
        Option.None,
        Option.None,
      ),
    )
  }

  if !is_valid_boundary(boundary) {
    return Result.Error(
      Error.InvalidBoundary(
        Severity.Error,
        'contains disallowed characters',
        Option.None,
        Option.None,
        Option.Some(boundary.clone),
      ),
    )
  }

  let mut text_body = Option.None
  let mut html_body = Option.None
  let mut attachments = []

  let parts = match split_multipart_body(raw, boundary) {
    case Ok(p) -> p
    case Error(e) -> return Result.Error(e)
  }

  # Validate that multipart has at least one part
  # RFC 2046: multipart bodies must contain at least one body part
  let mut has_valid_part = false

  if parts.size > 1 {
    let mut i = 1

    while i < parts.size {
      let part = match parts.get(i) {
        case Ok(p) -> p
        case Error(_) -> break
      }

      let trimmed = part.trim

      # Check if this is a valid part (not just the closing marker)
      if !trimmed.starts_with?('--') and !trimmed.empty? {
        has_valid_part = true
        break
      }

      i = i + 1
    }
  }

  if !has_valid_part {
    return Result.Error(
      Error.MultipartWithoutParts(
        Severity.Error,
        Option.None,
        Option.None,
        Option.Some(raw.clone),
      ),
    )
  }

  if parts.size > 1 {
    let mut i = 1

    while i < parts.size {
      let part = match parts.get(i) {
        case Ok(p) -> p
        case Error(_) -> break
      }

      let trimmed = part.trim

      # Empty parts are OK (just skip them), but -- marks the end
      if trimmed.starts_with?('--') { break }

      if !trimmed.empty? {
        match
          parse_single_multipart_part(
            trimmed,
            max_attachment_size,
            max_headers,
            default_encoding,
            strict_mode,
          )
        {
          case
            Ok(
              (
                ct_main,
                ct_params,
                disp_main,
                filename,
                content_id,
                decoded_bytes,
              ),
            ) -> {
            if ct_main.starts_with?('multipart/') {
              match
                handle_nested_multipart(
                  decoded_bytes,
                  ct_params,
                  default_encoding,
                  depth,
                  max_depth,
                  max_attachment_size,
                  max_attachments,
                  max_headers,
                  ct_main,
                  disp_main,
                  filename,
                  content_id,
                  strict_mode,
                )
              {
                case Ok((nested_text, nested_html, nested_atts)) -> {
                  match nested_text {
                    case Some(txt) -> {
                      if text_body.some? {
                        let existing: String = text_body.clone.get

                        text_body = Option.Some(existing + txt)
                      } else {
                        text_body = Option.Some(txt)
                      }
                    }
                    case None -> {}
                  }

                  match nested_html {
                    case Some(html) -> {
                      if html_body.some? {
                        let existing: String = html_body.clone.get

                        html_body = Option.Some(existing + html)
                      } else {
                        html_body = Option.Some(html)
                      }
                    }
                    case None -> {}
                  }

                  for att in nested_atts.into_iter {
                    if attachments.size >= max_attachments {
                      return Result.Error(
                        Error.TooManyAttachments(
                          Severity.Error,
                          attachments.size + 1,
                          max_attachments,
                          Option.None,
                          Option.None,
                          Option.None,
                        ),
                      )
                    }

                    attachments.push(att)
                  }
                }
                case Error(e) -> if strict_mode { return Result.Error(e) }
              }
            } else {
              let (new_text, new_html, new_att) = merge_multipart_part(
                text_body,
                html_body,
                ct_main,
                disp_main,
                filename,
                content_id,
                decoded_bytes,
              )

              text_body = new_text
              html_body = new_html

              match new_att {
                case Some(att) -> {
                  if attachments.size >= max_attachments {
                    return Result.Error(
                      Error.TooManyAttachments(
                        Severity.Error,
                        attachments.size + 1,
                        max_attachments,
                        Option.None,
                        Option.None,
                        Option.None,
                      ),
                    )
                  }

                  attachments.push(att)
                }
                case None -> {}
              }
            }
          }
          case Error(e) -> {
            # Strict mode fails on any part error; permissive mode skips
            # malformed parts but still surfaces size and structural limits.
            if strict_mode or !is_recoverable_part_error(ref e) {
              return Result.Error(e)
            }
          }
        }
      }

      i = i + 1
    }
  }

  Result.Ok((text_body, html_body, attachments))
}

# Split and validate multipart body by boundary
fn pub split_multipart_body(
  raw: String,
  boundary: String,
) -> Result[Array[String], Error] {
  let boundary_delim = '--' + boundary.trim

  if raw.contains?(boundary_delim) == false {
    let fragment = if raw.size > 50 { raw.substring(0, 50) } else { raw.clone }

    return Result.Error(
      Error.BoundaryNotFound(
        Severity.Error,
        Option.None,
        Option.None,
        Option.Some(fragment),
      ),
    )
  }

  # Split only on delimiters that start a line. A plain substring split lets
  # body text such as "before --boundary after" truncate or hide content.
  let parts = split_on_boundary(raw, boundary_delim)

  Result.Ok(parts)
}

# Split `raw` on `marker`, but only where `marker` starts a line
fn split_on_boundary(raw: String, marker: String) -> Array[String] {
  let bytes = raw.to_byte_array
  let marker_bytes = marker.to_byte_array
  let mut parts: Array[String] = []

  if marker_bytes.size == 0 { return [raw.clone] }

  if bytes.size < marker_bytes.size { return [raw.clone] }

  let mut start = 0
  let mut i = 0
  let max_i = bytes.size - marker_bytes.size

  while i <= max_i {
    if boundary_at(ref bytes, ref marker_bytes, i) {
      parts.push(bytes_range_to_string(ref bytes, start, i))
      start = i + marker_bytes.size
      i = start
    } else {
      i = i + 1
    }
  }

  parts.push(bytes_range_to_string(ref bytes, start, bytes.size))
  parts
}

# Whether a valid boundary delimiter appears at `pos`
fn boundary_at(bytes: ref ByteArray, marker: ref ByteArray, pos: Int) -> Bool {
  if pos > 0 {
    match bytes.get(pos - 1) {
      case Ok(b) -> if b != 10 { return false }
      case Error(_) -> return false
    }
  }

  let mut j = 0

  while j < marker.size {
    match bytes.get(pos + j) {
      case Ok(a) -> {
        match marker.get(j) {
          case Ok(b) -> if a != b { return false }
          case Error(_) -> return false
        }
      }
      case Error(_) -> return false
    }

    j = j + 1
  }

  # Validate what follows the marker: CRLF, bare LF, transport padding, close
  # delimiter ("--"), or end of input.
  let tail = pos + marker.size

  if tail >= bytes.size { return true }

  match bytes.get(tail) {
    case Ok(b) -> {
      if b == 13 or b == 10 {
        true
      } else if b == 45 {
        if tail + 1 >= bytes.size { return true }

        match bytes.get(tail + 1) {
          case Ok(b2) -> b2 == 45
          case Error(_) -> false
        }
      } else if b == 32 or b == 9 {
        padding_ends_line(ref bytes, tail)
      } else {
        false
      }
    }
    case Error(_) -> false
  }
}

# Whether transport padding at `pos` is terminated by CRLF/LF or end of input
fn padding_ends_line(bytes: ref ByteArray, pos: Int) -> Bool {
  let mut i = pos

  while i < bytes.size {
    match bytes.get(i) {
      case Ok(b) -> {
        if b == 32 or b == 9 {
          i = i + 1
        } else if b == 13 or b == 10 {
          return true
        } else {
          return false
        }
      }
      case Error(_) -> return false
    }
  }

  true
}

# Convert the byte range [start, end) of `bytes` to a String
fn bytes_range_to_string(bytes: ref ByteArray, start: Int, end: Int) -> String {
  let mut result = ByteArray.new
  let mut i = start

  while i < end {
    match bytes.get(i) {
      case Ok(b) -> result.push(b)
      case Error(_) -> {}
    }

    i = i + 1
  }

  result.into_string
}

# Parse headers from a single multipart part
fn pub parse_multipart_part_headers(
  part_headers_raw: String,
  max_attachment_size: Int,
  max_headers: Int,
) -> Result[Array[(String, String)], Error] {
  parse_headers_impl(part_headers_raw, false, max_attachment_size, max_headers)
}

# Extract metadata from a multipart part's headers
fn pub extract_part_metadata(
  part_headers: ref Array[(String, String)],
  default_encoding: String,
  strict_mode: Bool,
) -> Result[
  (String, Array[(String, String)], String, Array[(String, String)], String),
  Error,
] {
  let content_type = get_header_value_impl(part_headers, 'Content-Type').or(
    'text/plain',
  )

  match parse_content_type_impl(content_type, strict_mode) {
    case Ok((ct_main, ct_params)) -> {
      let content_disposition = get_header_value_impl(
        part_headers,
        'Content-Disposition',
      )
        .or('')

      # Handle empty Content-Disposition - treat as inline with no params
      if content_disposition.empty? {
        let transfer_encoding = get_header_value_impl(
          part_headers,
          'Content-Transfer-Encoding',
        )
          .or(default_encoding)

        Result.Ok((ct_main, ct_params, 'inline', [], transfer_encoding))
      } else {
        match parse_content_disposition_impl(content_disposition, strict_mode) {
          case Ok((disp_main, disp_params)) -> {
            let transfer_encoding = get_header_value_impl(
              part_headers,
              'Content-Transfer-Encoding',
            )
              .or(default_encoding)

            Result.Ok(
              (ct_main, ct_params, disp_main, disp_params, transfer_encoding),
            )
          }
          case Error(e) -> Result.Error(e)
        }
      }
    }
    case Error(e) -> Result.Error(e)
  }
}

# Process a single multipart part's body
fn pub process_multipart_part_body(
  part_body_raw: String,
  transfer_encoding: String,
  max_attachment_size: Int,
) -> Result[ByteArray, Error] {
  match
    decode_body_bytes_impl(
      part_body_raw,
      transfer_encoding,
      max_attachment_size,
    )
  {
    case Ok(decoded_bytes) -> Result.Ok(decoded_bytes)
    case Error(e) -> Result.Error(e)
  }
}

# Extract content ID from part headers
fn pub extract_content_id(
  part_headers: Array[(String, String)],
) -> Option[String] {
  get_header_value_impl(part_headers, 'Content-ID').map(fn (id) {
    let trimmed = id.trim

    if
      trimmed.size >= 2
        and trimmed.starts_with?('<')
        and trimmed.ends_with?('>')
    {
      trimmed.substring(1, trimmed.size - 1)
    } else {
      trimmed
    }
  })
}

# Parse a single multipart part from its raw content
fn pub parse_single_multipart_part(
  trimmed: String,
  max_attachment_size: Int,
  max_headers: Int,
  default_encoding: String,
  strict_mode: Bool,
) -> Result[
  (
    String,
    Array[(String, String)],
    String,
    Option[String],
    Option[String],
    ByteArray,
  ),
  Error,
] {
  let newline_pos = trimmed.index_of('\n\n', 0)

  match newline_pos {
    case Some(pos) -> {
      let part_headers_raw = trimmed.slice(0, pos).to_string
      let part_body_raw = trimmed.slice(pos + 2, trimmed.size).to_string

      let part_headers = match
        parse_multipart_part_headers(
          part_headers_raw,
          max_attachment_size,
          max_headers,
        )
      {
        case Ok(h) -> h
        case Error(e) -> return Result.Error(e)
      }

      let (ct_main, ct_params, disp_main, _, transfer_encoding) = match
        extract_part_metadata(part_headers, default_encoding, strict_mode)
      {
        case Ok(metadata) -> metadata
        case Error(e) -> return Result.Error(e)
      }

      let decoded_body = match
        process_multipart_part_body(
          part_body_raw,
          transfer_encoding,
          max_attachment_size,
        )
      {
        case Ok(b) -> b
        case Error(e) -> return Result.Error(e)
      }

      let mut filename = match
        get_header_value_impl(part_headers, 'Content-Disposition')
      {
        case Some(raw) -> extract_filename_param(raw)
        case None -> Option.None
      }

      # Fall back to the Content-Type name parameter
      if filename.none? {
        match get_param_value_impl(ref ct_params, 'name') {
          case Some(n) -> filename = sanitize_filename(n)
          case None -> {}
        }
      }

      let content_id = extract_content_id(part_headers)

      Result.Ok(
        (ct_main, ct_params, disp_main, filename, content_id, decoded_body),
      )
    }
    case None -> {
      let fragment = if trimmed.size > 50 {
        trimmed.substring(0, 50)
      } else {
        trimmed.clone
      }

      Result.Error(
        Error.NoBodyInPart(
          Severity.Error,
          Option.None,
          Option.None,
          Option.Some(fragment),
        ),
      )
    }
  }
}
