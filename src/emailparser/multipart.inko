# ==============================================================================
# Multipart MIME Message Parsing Module
# ==============================================================================
#
# This module handles parsing of multipart MIME messages as specified in
# RFC 2046 section 5. It processes emails with multiple parts, including
# alternative text/HTML versions, inline images, and file attachments.
#
# ## Purpose
#
# Multipart messages allow emails to contain multiple content types:
# - **multipart/alternative**: Same content in different formats (e.g., text + HTML)
# - **multipart/related**: HTML with inline images (Content-ID references)
# - **multipart/mixed**: Combination of text, HTML, and attachments
# - **Nested multipart**: Complex structures with multiple levels
#
# This module:
# - Splits multipart bodies by boundary strings
# - Parses individual multipart parts (headers + body)
# - Handles nested multipart messages recursively
# - Merges text, HTML, and attachment parts into structured output
#
# ## Architecture
#
# The module provides one main public function:
#
# - `parse_multipart_impl`: Parse a multipart message body
#   - Input: Raw body string, boundary string, recursion depth, max depth
#   - Output: Tuple of (text_body, html_body, attachments_array)
#   - Handles: Nested multipart, text extraction, attachment parsing
#
# Every other function in this module is an internal helper. The helpers
# assume the input has already been normalized to LF-only line endings by the
# caller (`EmailParser.parse` / `parse_multipart`).
#
# ## RFC Compliance
#
# - RFC 2046 section 5: Multipart Media Type
#   - 5.1: Multipart Media Type
#   - 5.1.1: Multipart: The common syntax
#   - 5.1.3: Nested Multipart
#
# ## Design Decisions
#
# ### Recursive Parsing
# Nested multipart messages are parsed recursively with depth tracking to prevent
# stack overflow attacks. The max depth limit (default: 10) is enforced.
#
# ### Content Type Handling
# - text/plain -> Stored in text_body
# - text/html -> Stored in html_body
# - Other types -> Treated as attachments
# - multipart/* -> Parsed recursively
#
# ### Attachment Detection
# Parts with Content-Disposition="attachment" are always treated as attachments,
# regardless of content type. Parts without disposition are inferred from type.

import emailparser.attachment (EmailAttachment)
import emailparser.boundary (boundary_at)
import emailparser.decoder (decode_body_bytes_impl)
import emailparser.error (Error, Severity, is_recoverable_part_error)
import emailparser.header (
  extract_filename_param, get_header_value_impl, get_param_value_impl,
  is_valid_field_name, parse_content_disposition_impl, parse_content_type_impl,
  parse_headers_impl, sanitize_filename,
)
import emailparser.limits (MAX_HEADERS_SECTION_SIZE)
import emailparser.message_id (normalize_content_id)
import emailparser.mime (classify_part, is_attachment_disposition)
import emailparser.validation (is_valid_boundary)
import std.bytes (ByteArray)
import std.option (Option)
import std.result (Result)
import std.string (StringBuffer)

# Process a single multipart part and merge results
#
# Body segments are appended to the arrays rather than concatenated into an
# accumulator: cloning the accumulator per part is quadratic in the number of
# parts, which a sender controls. `join_body_segments` builds the final body
# once, after every part has been seen.
fn merge_multipart_part(
  text_parts: mut Array[String],
  html_parts: mut Array[String],
  ct_main: String,
  disp_main: String,
  filename: Option[String],
  content_id: Option[String],
  decoded_bytes: ByteArray,
) -> Option[EmailAttachment] {
  match classify_part(ct_main.clone, disp_main.clone, ref filename) {
    case TextBody -> {
      text_parts.push(decoded_bytes.into_string)
      Option.None
    }
    case HtmlBody -> {
      html_parts.push(decoded_bytes.into_string)
      Option.None
    }
    case _ -> {
      # Attachments and unhandled kinds. An un-attached multipart/* part is
      # parsed recursively before this function is called, so the remaining
      # kinds (Attachment, or Multipart when nested parsing is skipped) become
      # attachments. A missing disposition means the part was inferred to be
      # an attachment; report it as such instead of the empty value. An
      # explicit "inline" is preserved (e.g. images in multipart/related).
      let disposition = if disp_main.empty? { 'attachment' } else { disp_main }

      Option.Some(
        EmailAttachment.from_decoded_part(
          content_type: ct_main,
          filename: filename,
          content_disposition: disposition,
          content_id: content_id,
          decoded_bytes: decoded_bytes,
        ),
      )
    }
  }
}

# Join the body segments of one kind with the separator used between parts
fn join_body_segments(segments: ref Array[String]) -> Option[String] {
  if segments.empty? { return Option.None }

  let mut buffer = StringBuffer.new
  let mut first = true

  for segment in segments.iter {
    if first { first = false } else { buffer.push('\n') }

    buffer.push(segment.clone)
  }

  Option.Some(buffer.into_string)
}

# Handle nested multipart messages
fn handle_nested_multipart(
  decoded_bytes: ByteArray,
  ct_params: Array[(String, String)],
  depth: Int,
  max_depth: Int,
  max_attachment_size: Int,
  max_attachments: Int,
  max_headers: Int,
  ct_main: String,
  disp_main: String,
  filename: Option[String],
  content_id: Option[String],
  strict_mode: Bool,
) -> Result[(Option[String], Option[String], Array[EmailAttachment]), Error] {
  match get_header_value_impl(ct_params, 'boundary') {
    case Some(nested_boundary) -> {
      match
        parse_multipart_impl(
          decoded_bytes.into_string,
          nested_boundary,
          depth + 1,
          max_depth,
          max_attachment_size,
          max_attachments,
          max_headers,
          strict_mode,
        )
      {
        case Ok(result) -> Result.Ok(result)
        case Error(e) -> Result.Error(e)
      }
    }
    case None -> {
      Result.Ok(
        (
          Option.None,
          Option.None,
          [
            EmailAttachment.from_decoded_part(
              content_type: ct_main,
              filename: filename,
              content_disposition: disp_main,
              content_id: content_id,
              decoded_bytes: decoded_bytes,
            ),
          ],
        ),
      )
    }
  }
}

# Parse multipart MIME message
fn parse_multipart_impl(
  raw: String,
  boundary: String,
  depth: Int,
  max_depth: Int,
  max_attachment_size: Int,
  max_attachments: Int,
  max_headers: Int,
  strict_mode: Bool,
) -> Result[(Option[String], Option[String], Array[EmailAttachment]), Error] {
  # `depth` is the nesting level of this multipart (0 for the root), so the
  # limit is inclusive of the root: reject before parsing level `max_depth`.
  if depth >= max_depth {
    return Result.Error(
      Error.MultipartDepthExceeded(
        Severity.Error,
        depth,
        max_depth,
        Option.None,
        Option.None,
        Option.None,
      ),
    )
  }

  if !is_valid_boundary(boundary) {
    return Result.Error(
      Error.InvalidBoundary(
        Severity.Error,
        'contains disallowed characters',
        Option.None,
        Option.None,
        Option.Some(boundary.clone),
      ),
    )
  }

  let mut text_parts: Array[String] = []
  let mut html_parts: Array[String] = []
  let mut attachments = []

  let parts = match split_multipart_body(raw, boundary) {
    case Ok(p) -> p
    case Error(e) -> return Result.Error(e)
  }

  # Validate that multipart has at least one part
  # RFC 2046: multipart bodies must contain at least one body part
  let mut has_valid_part = false

  if parts.size > 1 {
    let mut i = 1

    while i < parts.size {
      let part = match parts.get(i) {
        case Ok(p) -> p
        case Error(_) -> break
      }

      let trimmed = part.trim

      # Check if this is a valid part (not just the closing marker)
      if !trimmed.starts_with?('--') and !trimmed.empty? {
        has_valid_part = true
        break
      }

      i = i + 1
    }
  }

  if !has_valid_part {
    return Result.Error(
      Error.MultipartWithoutParts(
        Severity.Error,
        Option.None,
        Option.None,
        Option.Some(raw.clone),
      ),
    )
  }

  if parts.size > 1 {
    let mut i = 1

    while i < parts.size {
      let part = match parts.get(i) {
        case Ok(p) -> p
        case Error(_) -> break
      }

      let trimmed = part.trim

      # Empty parts are OK (just skip them), but -- marks the end
      if trimmed.starts_with?('--') { break }

      if !trimmed.empty? {
        match
          parse_single_multipart_part(
            trimmed,
            max_attachment_size,
            max_headers,
            strict_mode,
          )
        {
          case
            Ok(
              (
                ct_main,
                ct_params,
                disp_main,
                filename,
                content_id,
                decoded_bytes,
              ),
            ) -> {
            # An attached multipart/* part (a forwarded message, say) is an
            # attachment, not a nested body.
            if
              ct_main.starts_with?('multipart/')
                and !is_attachment_disposition(disp_main.clone, ref filename)
            {
              match
                handle_nested_multipart(
                  decoded_bytes,
                  ct_params,
                  depth,
                  max_depth,
                  max_attachment_size,
                  max_attachments,
                  max_headers,
                  ct_main,
                  disp_main,
                  filename,
                  content_id,
                  strict_mode,
                )
              {
                case Ok((nested_text, nested_html, nested_atts)) -> {
                  match nested_text {
                    case Some(txt) -> text_parts.push(txt)
                    case None -> {}
                  }

                  match nested_html {
                    case Some(html) -> html_parts.push(html)
                    case None -> {}
                  }

                  for att in nested_atts.into_iter {
                    if attachments.size >= max_attachments {
                      return Result.Error(
                        Error.TooManyAttachments(
                          Severity.Error,
                          attachments.size + 1,
                          max_attachments,
                          Option.None,
                          Option.None,
                          Option.None,
                        ),
                      )
                    }

                    attachments.push(att)
                  }
                }
                case Error(e) -> {
                  # Structural limits (depth, size) must surface even in
                  # permissive mode; only malformed parts are skipped.
                  if strict_mode or !is_recoverable_part_error(ref e) {
                    return Result.Error(e)
                  }
                }
              }
            } else {
              let new_att = merge_multipart_part(
                mut text_parts,
                mut html_parts,
                ct_main,
                disp_main,
                filename,
                content_id,
                decoded_bytes,
              )

              match new_att {
                case Some(att) -> {
                  if attachments.size >= max_attachments {
                    return Result.Error(
                      Error.TooManyAttachments(
                        Severity.Error,
                        attachments.size + 1,
                        max_attachments,
                        Option.None,
                        Option.None,
                        Option.None,
                      ),
                    )
                  }

                  attachments.push(att)
                }
                case None -> {}
              }
            }
          }
          case Error(e) -> {
            # Strict mode fails on any part error; permissive mode skips
            # malformed parts but still surfaces size and structural limits.
            if strict_mode or !is_recoverable_part_error(ref e) {
              return Result.Error(e)
            }
          }
        }
      }

      i = i + 1
    }
  }

  Result.Ok(
    (
      join_body_segments(ref text_parts),
      join_body_segments(ref html_parts),
      attachments,
    ),
  )
}

# Split and validate multipart body by boundary
fn split_multipart_body(
  raw: String,
  boundary: String,
) -> Result[Array[String], Error] {
  let boundary_delim = '--' + boundary.trim

  if raw.contains?(boundary_delim) == false {
    let fragment = if raw.size > 50 {
      raw.slice(0, 50).to_string
    } else {
      raw.clone
    }

    return Result.Error(
      Error.BoundaryNotFound(
        Severity.Error,
        Option.None,
        Option.None,
        Option.Some(fragment),
      ),
    )
  }

  # Split only on delimiters that start a line. A plain substring split lets
  # body text such as "before --boundary after" truncate or hide content.
  let parts = split_on_boundary(raw, boundary_delim)

  Result.Ok(parts)
}

# Split `raw` on `marker`, but only where `marker` starts a line
fn split_on_boundary(raw: String, marker: String) -> Array[String] {
  let bytes = raw.to_byte_array
  let marker_bytes = marker.to_byte_array
  let mut parts: Array[String] = []

  if marker_bytes.size == 0 { return [raw.clone] }

  if bytes.size < marker_bytes.size { return [raw.clone] }

  let mut start = 0
  let mut i = 0
  let max_i = bytes.size - marker_bytes.size

  while i <= max_i {
    if boundary_at(ref bytes, ref marker_bytes, i, true, true) {
      parts.push(bytes_range_to_string(ref bytes, start, i))
      start = i + marker_bytes.size
      i = start
    } else {
      i = i + 1
    }
  }

  parts.push(bytes_range_to_string(ref bytes, start, bytes.size))
  parts
}

# Convert the byte range [start, end) of `bytes` to a String
fn bytes_range_to_string(bytes: ref ByteArray, start: Int, end: Int) -> String {
  if start >= end { return '' }

  bytes.slice(start, end).to_string
}

# Parse headers from a single multipart part
fn parse_multipart_part_headers(
  part_headers_raw: String,
  max_headers: Int,
  strict_mode: Bool,
) -> Result[Array[(String, String)], Error] {
  parse_headers_impl(
    part_headers_raw,
    strict_mode,
    MAX_HEADERS_SECTION_SIZE,
    max_headers,
  )
}

# Extract metadata from a multipart part's headers
fn extract_part_metadata(
  part_headers: ref Array[(String, String)],
  strict_mode: Bool,
) -> Result[
  (String, Array[(String, String)], String, Array[(String, String)], String),
  Error,
] {
  let content_type = get_header_value_impl(part_headers, 'Content-Type').or(
    'text/plain',
  )

  match parse_content_type_impl(content_type, strict_mode) {
    case Ok((ct_main, ct_params)) -> {
      let content_disposition = get_header_value_impl(
        part_headers,
        'Content-Disposition',
      )
        .or('')

      # A missing Content-Disposition stays empty so the classifier can tell
      # it apart from an explicit "inline".
      # RFC 2045 section 6: a part without Content-Transfer-Encoding is 7bit;
      # the message-level encoding applies to the message body only.
      if content_disposition.empty? {
        let transfer_encoding = get_header_value_impl(
          part_headers,
          'Content-Transfer-Encoding',
        )
          .or('7bit')

        Result.Ok((ct_main, ct_params, '', [], transfer_encoding))
      } else {
        match parse_content_disposition_impl(content_disposition, strict_mode) {
          case Ok((disp_main, disp_params)) -> {
            let transfer_encoding = get_header_value_impl(
              part_headers,
              'Content-Transfer-Encoding',
            )
              .or('7bit')

            Result.Ok(
              (ct_main, ct_params, disp_main, disp_params, transfer_encoding),
            )
          }
          case Error(e) -> Result.Error(e)
        }
      }
    }
    case Error(e) -> Result.Error(e)
  }
}

# Process a single multipart part's body
fn process_multipart_part_body(
  part_body_raw: String,
  transfer_encoding: String,
  max_attachment_size: Int,
) -> Result[ByteArray, Error] {
  match
    decode_body_bytes_impl(
      part_body_raw,
      transfer_encoding,
      max_attachment_size,
    )
  {
    case Ok(decoded_bytes) -> Result.Ok(decoded_bytes)
    case Error(e) -> Result.Error(e)
  }
}

# Extract content ID from part headers
fn extract_content_id(part_headers: Array[(String, String)]) -> Option[String] {
  get_header_value_impl(part_headers, 'Content-ID').map(fn (id) {
    normalize_content_id(id)
  })
}

# Parse a single multipart part from its raw content
fn parse_single_multipart_part(
  trimmed: String,
  max_attachment_size: Int,
  max_headers: Int,
  strict_mode: Bool,
) -> Result[
  (
    String,
    Array[(String, String)],
    String,
    Option[String],
    Option[String],
    ByteArray,
  ),
  Error,
] {
  # A part is either headers + empty line + body, or (RFC 2046) has an empty
  # header section and is all body. A part with headers but no body has no
  # "\n\n" after trimming, so detect that case instead of treating the
  # headers as body text.
  let (part_headers_raw, part_body_raw) = match trimmed.index_of('\n\n', 0) {
    case Some(pos) -> {
      (
        trimmed.slice(0, pos).to_string,
        trimmed.slice(pos + 2, trimmed.size).to_string,
      )
    }
    case None -> {
      if headers_only_part(trimmed) { (trimmed, '') } else { ('', trimmed) }
    }
  }

  let part_headers = match
    parse_multipart_part_headers(part_headers_raw, max_headers, strict_mode)
  {
    case Ok(h) -> h
    case Error(e) -> return Result.Error(e)
  }

  let (ct_main, ct_params, disp_main, _, transfer_encoding) = match
    extract_part_metadata(part_headers, strict_mode)
  {
    case Ok(metadata) -> metadata
    case Error(e) -> return Result.Error(e)
  }

  let decoded_body = match
    process_multipart_part_body(
      part_body_raw,
      transfer_encoding,
      max_attachment_size,
    )
  {
    case Ok(b) -> b
    case Error(e) -> return Result.Error(e)
  }

  let mut filename = match
    get_header_value_impl(part_headers, 'Content-Disposition')
  {
    case Some(raw) -> extract_filename_param(raw)
    case None -> Option.None
  }

  # Fall back to the Content-Type name parameter
  if filename.none? {
    match get_param_value_impl(ref ct_params, 'name') {
      case Some(n) -> filename = sanitize_filename(n)
      case None -> {}
    }
  }

  let content_id = extract_content_id(part_headers)

  Result.Ok((ct_main, ct_params, disp_main, filename, content_id, decoded_body))
}

# Whether a trimmed part consists only of headers
#
# Used for a part whose header block is followed by neither a body nor the
# empty line that separates headers from body.
fn headers_only_part(text: String) -> Bool {
  let first_line_end = text.index_of('\n', 0).or(text.size)

  if first_line_end <= 0 { return false }

  let first_line = text.slice(0, first_line_end).to_string

  match first_line.index_of(':', 0) {
    case Some(colon) -> {
      if colon == 0 { return false }

      is_valid_field_name(first_line.slice(0, colon).to_string)
    }
    case None -> false
  }
}
