# Centralized error types for email parser
#
# Provides a type-safe error handling system with specific error variants
# for common failure cases when parsing RFC 5322 email messages.

# Error severity levels for categorizing issues
# Severity of a parse error
#
# The parser itself only produces `Error`: a parse either succeeds or returns
# the error that stopped it. `Warning` and `Fatal` are available to callers
# that wrap or reclassify errors (for example a handler that wants to report a
# recovered issue as a warning); they are never emitted by this library.
type pub enum Severity {
  case Warning
  case Error
  case Fatal
}

# Unified error type for all email parsing operations
#
# Using Inko's enum type for compile-time exhaustiveness checking and
# type-safe pattern matching. Each error variant includes a severity level
# for categorizing issues.
type pub enum Error {
  # Size and limit errors
  case EmailSizeTooLarge(
    Severity,
    Int,
    Int,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case AttachmentSizeTooLarge(
    Severity,
    Int,
    Int,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case TooManyAttachments(
    Severity,
    Int,
    Int,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case TooManyHeaders(
    Severity,
    Int,
    Int,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case MultipartDepthExceeded(
    Severity,
    Int,
    Int,
    Option[Int],
    Option[Int],
    Option[String],
  )

  # Header validation errors
  case InvalidHeaderFieldName(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case MalformedHeader(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case DuplicateHeader(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case HeaderWithoutColon(Severity, Option[Int], Option[Int], Option[String])
  case InvalidEmailFormat(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case HeaderValueTooLarge(
    Severity,
    Int,
    Int,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case HeaderSectionTooLarge(
    Severity,
    Int,
    Int,
    Option[Int],
    Option[Int],
    Option[String],
  )

  # Boundary and multipart errors
  case BoundaryNotFound(Severity, Option[Int], Option[Int], Option[String])
  case InvalidBoundary(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case MultipartWithoutParts(Severity, Option[Int], Option[Int], Option[String])

  # Generic parsing errors
  case ParseError(Severity, String, Option[Int], Option[Int], Option[String])

  # Decoding errors
  case DecodingFailed(
    Severity,
    String,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case DecodedSizeTooLarge(
    Severity,
    Int,
    Int,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )

  # Required header validation errors (strict mode)
  case MissingRequiredHeader(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case EmptyRequiredHeader(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )

  # Content-Type validation errors
  case InvalidContentType(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
}

# Structured description of an error, independent of a variant's payload
#
# Every variant carries a severity, a human-readable message and an optional
# source location. Collecting them in one record means displaying errors and
# classifying them only needs a single match over `Error`: adding a variant
# requires updating `Error.context` (what it means) and `Error.variant` (its
# name), instead of four exhaustive matches.
type pub ErrorContext {
  let pub @severity: Severity
  let pub @message: String
  let pub @line: Option[Int]
  let pub @position: Option[Int]
  let pub @fragment: Option[String]
}

impl Error {
  # Format error message with optional context (line, position, fragment)
  fn pub format_with_context(
    message: String,
    line: ref Option[Int],
    pos: ref Option[Int],
    frag: ref Option[String],
  ) -> String {
    let mut result = message

    match line {
      case Some(l) -> result = 'Line ' + l.to_string + ': ' + result
      case None -> {}
    }

    match pos {
      case Some(p) -> result = result + ' (position ' + p.to_string + ')'
      case None -> {}
    }

    match frag {
      case Some(f) -> result = result + ' ["' + f + '"]'
      case None -> {}
    }

    result
  }

  # Structured description of this error
  #
  # This is the single place that turns a variant's payload into the message
  # shown to users, its severity and its source location.
  fn pub context -> ErrorContext {
    match self {
      case EmailSizeTooLarge(sev, size, max_size, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Email size exceeds maximum allowed size: '
            + size.to_string
            + ' bytes (max: '
            + max_size.to_string
            + ' bytes)',
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case AttachmentSizeTooLarge(sev, size, max_size, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Attachment size exceeds maximum allowed size: '
            + size.to_string
            + ' bytes (max: '
            + max_size.to_string
            + ' bytes)',
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case TooManyAttachments(sev, count, max_count, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Maximum number of attachments exceeded: '
            + count.to_string
            + ' (max: '
            + max_count.to_string
            + ')',
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case TooManyHeaders(sev, count, max_count, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Maximum number of headers exceeded: '
            + count.to_string
            + ' (max: '
            + max_count.to_string
            + ')',
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case MultipartDepthExceeded(sev, depth, max_depth, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Maximum multipart nesting depth exceeded: '
            + depth.to_string
            + ' (max: '
            + max_depth.to_string
            + ')',
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case InvalidHeaderFieldName(sev, name, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Invalid header field name: ' + name,
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case MalformedHeader(sev, reason, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Malformed header: ' + reason,
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case DuplicateHeader(sev, name, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Duplicate header detected: ' + name,
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case HeaderWithoutColon(sev, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Invalid header format: no colon found',
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case InvalidEmailFormat(sev, reason, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Invalid email format: ' + reason,
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case HeaderValueTooLarge(sev, size, max_size, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Header value exceeds maximum allowed size: '
            + size.to_string
            + ' bytes (max: '
            + max_size.to_string
            + ' bytes)',
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case HeaderSectionTooLarge(sev, size, max_size, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Header section exceeds maximum allowed size: '
            + size.to_string
            + ' bytes (max: '
            + max_size.to_string
            + ' bytes)',
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case BoundaryNotFound(sev, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Boundary marker not found in message body',
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case InvalidBoundary(sev, reason, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Invalid boundary string: ' + reason,
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case MultipartWithoutParts(sev, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Multipart message has no body parts',
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case ParseError(sev, message, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: message.clone,
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case DecodingFailed(sev, encoding, reason, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Failed to decode ' + encoding + ' content: ' + reason,
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case DecodedSizeTooLarge(sev, size, max_size, encoding, line, pos, frag)
      -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Decoded '
            + encoding
            + ' content exceeds maximum size: '
            + size.to_string
            + ' bytes (max: '
            + max_size.to_string
            + ' bytes)',
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case MissingRequiredHeader(sev, header_name, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Missing required header: ' + header_name,
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case EmptyRequiredHeader(sev, header_name, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Required header is empty: ' + header_name,
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
      case InvalidContentType(sev, reason, line, pos, frag) -> {
        ErrorContext(
          severity: sev.copy,
          message: 'Invalid Content-Type: ' + reason,
          line: line.clone,
          position: pos.clone,
          fragment: frag.clone,
        )
      }
    }
  }

  # Convert error to human-readable message with context
  fn pub to_message -> String {
    let ctx = context

    '['
      + ctx.severity.to_string
      + '] '
      + format_with_context(ctx.message, ctx.line, ctx.position, ctx.fragment)
  }

  # Get the error variant name (for backward compatibility)
  fn pub variant -> String {
    match self {
      case EmailSizeTooLarge(_, _, _, _, _, _) -> 'EmailSizeTooLarge'
      case AttachmentSizeTooLarge(_, _, _, _, _, _) -> 'AttachmentSizeTooLarge'
      case TooManyAttachments(_, _, _, _, _, _) -> 'TooManyAttachments'
      case TooManyHeaders(_, _, _, _, _, _) -> 'TooManyHeaders'
      case MultipartDepthExceeded(_, _, _, _, _, _) -> 'MultipartDepthExceeded'
      case InvalidHeaderFieldName(_, _, _, _, _) -> 'InvalidHeaderFieldName'
      case MalformedHeader(_, _, _, _, _) -> 'MalformedHeader'
      case DuplicateHeader(_, _, _, _, _) -> 'DuplicateHeader'
      case HeaderWithoutColon(_, _, _, _) -> 'HeaderWithoutColon'
      case InvalidEmailFormat(_, _, _, _, _) -> 'InvalidEmailFormat'
      case HeaderValueTooLarge(_, _, _, _, _, _) -> 'HeaderValueTooLarge'
      case HeaderSectionTooLarge(_, _, _, _, _, _) -> 'HeaderSectionTooLarge'
      case BoundaryNotFound(_, _, _, _) -> 'BoundaryNotFound'
      case InvalidBoundary(_, _, _, _, _) -> 'InvalidBoundary'
      case MultipartWithoutParts(_, _, _, _) -> 'MultipartWithoutParts'
      case ParseError(_, _, _, _, _) -> 'ParseError'
      case DecodingFailed(_, _, _, _, _, _) -> 'DecodingFailed'
      case DecodedSizeTooLarge(_, _, _, _, _, _, _) -> 'DecodedSizeTooLarge'
      case MissingRequiredHeader(_, _, _, _, _) -> 'MissingRequiredHeader'
      case EmptyRequiredHeader(_, _, _, _, _) -> 'EmptyRequiredHeader'
      case InvalidContentType(_, _, _, _, _) -> 'InvalidContentType'
    }
  }

  # Get the severity level of this error
  fn pub severity -> Severity {
    context.severity.copy
  }

  # Create a ParseError from a string message
  #
  # Used where a lower-level component only reports a plain message.
  fn pub static from_string(message: String) -> Error {
    Error.ParseError(
      Severity.Error,
      message,
      Option.None,
      Option.None,
      Option.None,
    )
  }
}

impl Severity {
  # Return an owned copy of this severity
  #
  # Pattern matches on an error's fields yield references, so this is used to
  # store a severity in a value that requires ownership (`ErrorContext`).
  fn pub copy -> Severity {
    match self {
      case Warning -> Severity.Warning
      case Error -> Severity.Error
      case Fatal -> Severity.Fatal
    }
  }

  # Convert severity to string representation
  fn pub to_string -> String {
    match self {
      case Warning -> 'WARNING'
      case Error -> 'ERROR'
      case Fatal -> 'FATAL'
    }
  }
}

# Whether a part-level parse error may be skipped in permissive mode
#
# The buffered and streaming multipart parsers share this classification so a
# malformed part is skipped consistently while size and structural limits still
# abort the parse. Keep this match exhaustive: adding a variant then forces a
# deliberate decision instead of silently defaulting to recoverable.
fn pub is_recoverable_part_error(error: ref Error) -> Bool {
  match error {
    case MalformedHeader(_, _, _, _, _) -> true
    case HeaderWithoutColon(_, _, _, _) -> true
    case InvalidHeaderFieldName(_, _, _, _, _) -> true
    case DuplicateHeader(_, _, _, _, _) -> true
    case DecodingFailed(_, _, _, _, _, _) -> true
    case InvalidContentType(_, _, _, _, _) -> true
    case MultipartWithoutParts(_, _, _, _) -> true
    # Size and structural limits abort the parse.
    case EmailSizeTooLarge(_, _, _, _, _, _) -> false
    case AttachmentSizeTooLarge(_, _, _, _, _, _) -> false
    case TooManyAttachments(_, _, _, _, _, _) -> false
    case TooManyHeaders(_, _, _, _, _, _) -> false
    case MultipartDepthExceeded(_, _, _, _, _, _) -> false
    case InvalidEmailFormat(_, _, _, _, _) -> false
    case HeaderValueTooLarge(_, _, _, _, _, _) -> false
    case HeaderSectionTooLarge(_, _, _, _, _, _) -> false
    case BoundaryNotFound(_, _, _, _) -> false
    case InvalidBoundary(_, _, _, _, _) -> false
    case ParseError(_, _, _, _, _) -> false
    case DecodedSizeTooLarge(_, _, _, _, _, _, _) -> false
    case MissingRequiredHeader(_, _, _, _, _) -> false
    case EmptyRequiredHeader(_, _, _, _, _) -> false
  }
}
