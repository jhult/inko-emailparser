# Centralized error types for email parser
#
# Provides a type-safe error handling system with specific error variants
# for common failure cases when parsing RFC 5322 email messages.

# Error severity levels for categorizing issues
type pub enum Severity {
  case Warning
  case Error
  case Fatal
}

# Unified error type for all email parsing operations
#
# Using Inko's enum type for compile-time exhaustiveness checking and
# type-safe pattern matching. Each error variant includes a severity level
# for categorizing issues.
type pub enum Error {
  # Size and limit errors
  case EmailSizeTooLarge(
    Severity,
    Int,
    Int,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case AttachmentSizeTooLarge(
    Severity,
    Int,
    Int,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case TooManyHeaders(
    Severity,
    Int,
    Int,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case MultipartDepthExceeded(
    Severity,
    Int,
    Int,
    Option[Int],
    Option[Int],
    Option[String],
  )

  # Header validation errors
  case InvalidHeaderFieldName(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case MalformedHeader(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case DuplicateHeader(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case HeaderWithoutColon(Severity, Option[Int], Option[Int], Option[String])
  case InvalidEmailFormat(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case HeaderValueTooLarge(
    Severity,
    Int,
    Int,
    Option[Int],
    Option[Int],
    Option[String],
  )

  # Boundary and multipart errors
  case BoundaryNotFound(Severity, Option[Int], Option[Int], Option[String])
  case InvalidBoundary(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case MultipartWithoutParts(Severity, Option[Int], Option[Int], Option[String])
  case NoBodyInPart(Severity, Option[Int], Option[Int], Option[String])

  # Generic parsing errors
  case ParseError(Severity, String, Option[Int], Option[Int], Option[String])

  # Decoding errors
  case DecodingFailed(
    Severity,
    String,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case DecodedSizeTooLarge(
    Severity,
    Int,
    Int,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )

  # Required header validation errors (strict mode)
  case MissingRequiredHeader(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
  case EmptyRequiredHeader(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )

  # Size limit errors
  case EmailSizeExceeded(Severity, Int, Int, Option[Int], Option[Int])

  # Content-Type validation errors
  case InvalidContentType(
    Severity,
    String,
    Option[Int],
    Option[Int],
    Option[String],
  )
}

impl Error {
  # Format error message with optional context (line, position, fragment)
  fn pub format_with_context(
    message: String,
    line: ref Option[Int],
    pos: ref Option[Int],
    frag: ref Option[String],
  ) -> String {
    let mut result = message

    match line {
      case Some(l) -> result = 'Line ' + l.to_string + ': ' + result
      case None -> {}
    }

    match pos {
      case Some(p) -> result = result + ' (position ' + p.to_string + ')'
      case None -> {}
    }

    match frag {
      case Some(f) -> result = result + ' ["' + f + '"]'
      case None -> {}
    }

    result
  }

  # Convert error to human-readable message with context
  fn pub to_message -> String {
    let severity_prefix = match self {
      case EmailSizeTooLarge(sev, _, _, _, _, _) -> sev.to_string
      case AttachmentSizeTooLarge(sev, _, _, _, _, _) -> sev.to_string
      case TooManyHeaders(sev, _, _, _, _, _) -> sev.to_string
      case MultipartDepthExceeded(sev, _, _, _, _, _) -> sev.to_string
      case InvalidHeaderFieldName(sev, _, _, _, _) -> sev.to_string
      case MalformedHeader(sev, _, _, _, _) -> sev.to_string
      case DuplicateHeader(sev, _, _, _, _) -> sev.to_string
      case HeaderWithoutColon(sev, _, _, _) -> sev.to_string
      case InvalidEmailFormat(sev, _, _, _, _) -> sev.to_string
      case HeaderValueTooLarge(sev, _, _, _, _, _) -> sev.to_string
      case BoundaryNotFound(sev, _, _, _) -> sev.to_string
      case InvalidBoundary(sev, _, _, _, _) -> sev.to_string
      case MultipartWithoutParts(sev, _, _, _) -> sev.to_string
      case NoBodyInPart(sev, _, _, _) -> sev.to_string
      case ParseError(sev, _, _, _, _) -> sev.to_string
      case DecodingFailed(sev, _, _, _, _, _) -> sev.to_string
      case DecodedSizeTooLarge(sev, _, _, _, _, _, _) -> sev.to_string
      case MissingRequiredHeader(sev, _, _, _, _) -> sev.to_string
      case EmptyRequiredHeader(sev, _, _, _, _) -> sev.to_string
      case EmailSizeExceeded(sev, _, _, _, _) -> sev.to_string
      case InvalidContentType(sev, _, _, _, _) -> sev.to_string
    }

    match self {
      case EmailSizeTooLarge(_, size, max_size, line, pos, frag) -> {
        let msg = 'Email size exceeds maximum allowed size: '
          + size.to_string
          + ' bytes (max: '
          + max_size.to_string
          + ' bytes)'

        '[' + severity_prefix + '] ' + format_with_context(msg, line, pos, frag)
      }
      case AttachmentSizeTooLarge(_, size, max_size, line, pos, frag) -> {
        let msg = 'Attachment size exceeds maximum allowed size: '
          + size.to_string
          + ' bytes (max: '
          + max_size.to_string
          + ' bytes)'

        '[' + severity_prefix + '] ' + format_with_context(msg, line, pos, frag)
      }
      case TooManyHeaders(_, count, max_count, line, pos, frag) -> {
        let msg = 'Maximum number of headers exceeded: '
          + count.to_string
          + ' (max: '
          + max_count.to_string
          + ')'

        '[' + severity_prefix + '] ' + format_with_context(msg, line, pos, frag)
      }
      case MultipartDepthExceeded(_, depth, max_depth, line, pos, frag) -> {
        let msg = 'Maximum multipart nesting depth exceeded: '
          + depth.to_string
          + ' (max: '
          + max_depth.to_string
          + ')'

        '[' + severity_prefix + '] ' + format_with_context(msg, line, pos, frag)
      }
      case InvalidHeaderFieldName(_, name, line, pos, frag) -> {
        '['
          + severity_prefix
          + '] '
          + format_with_context(
            'Invalid header field name: ' + name,
            line,
            pos,
            frag,
          )
      }
      case MalformedHeader(_, reason, line, pos, frag) -> {
        '['
          + severity_prefix
          + '] '
          + format_with_context('Malformed header: ' + reason, line, pos, frag)
      }
      case DuplicateHeader(_, name, line, pos, frag) -> {
        '['
          + severity_prefix
          + '] '
          + format_with_context(
            'Duplicate header detected: ' + name,
            line,
            pos,
            frag,
          )
      }
      case HeaderWithoutColon(_, line, pos, frag) -> {
        '['
          + severity_prefix
          + '] '
          + format_with_context(
            'Invalid header format: no colon found',
            line,
            pos,
            frag,
          )
      }
      case InvalidEmailFormat(_, reason, line, pos, frag) -> {
        '['
          + severity_prefix
          + '] '
          + format_with_context(
            'Invalid email format: ' + reason,
            line,
            pos,
            frag,
          )
      }
      case HeaderValueTooLarge(_, size, max_size, line, pos, frag) -> {
        let msg = 'Header value exceeds maximum allowed size: '
          + size.to_string
          + ' bytes (max: '
          + max_size.to_string
          + ' bytes)'

        '[' + severity_prefix + '] ' + format_with_context(msg, line, pos, frag)
      }
      case BoundaryNotFound(_, line, pos, frag) -> {
        '['
          + severity_prefix
          + '] '
          + format_with_context(
            'Boundary marker not found in message body',
            line,
            pos,
            frag,
          )
      }
      case InvalidBoundary(_, reason, line, pos, frag) -> {
        '['
          + severity_prefix
          + '] '
          + format_with_context(
            'Invalid boundary string: ' + reason,
            line,
            pos,
            frag,
          )
      }
      case MultipartWithoutParts(_, line, pos, frag) -> {
        '['
          + severity_prefix
          + '] '
          + format_with_context(
            'Multipart message has no body parts',
            line,
            pos,
            frag,
          )
      }
      case NoBodyInPart(_, line, pos, frag) -> {
        '['
          + severity_prefix
          + '] '
          + format_with_context(
            'No body found in multipart part',
            line,
            pos,
            frag,
          )
      }
      case ParseError(_, message, line, pos, frag) -> {
        '['
          + severity_prefix
          + '] '
          + format_with_context(message, line, pos, frag)
      }
      case DecodingFailed(_, encoding, reason, line, pos, frag) -> {
        let msg = 'Failed to decode ' + encoding + ' content: ' + reason

        '[' + severity_prefix + '] ' + format_with_context(msg, line, pos, frag)
      }
      case DecodedSizeTooLarge(_, size, max_size, encoding, line, pos, frag)
      -> {
        let msg = 'Decoded '
          + encoding
          + ' content exceeds maximum size: '
          + size.to_string
          + ' bytes (max: '
          + max_size.to_string
          + ' bytes)'

        '[' + severity_prefix + '] ' + format_with_context(msg, line, pos, frag)
      }
      case MissingRequiredHeader(_, header_name, line, pos, frag) -> {
        '['
          + severity_prefix
          + '] '
          + format_with_context(
            'Missing required header: ' + header_name,
            line,
            pos,
            frag,
          )
      }
      case EmptyRequiredHeader(_, header_name, line, pos, frag) -> {
        '['
          + severity_prefix
          + '] '
          + format_with_context(
            'Required header is empty: ' + header_name,
            line,
            pos,
            frag,
          )
      }
      case EmailSizeExceeded(_, max_size, actual_size, line, pos) -> {
        let msg = 'Email size '
          + actual_size.to_string
          + ' exceeds maximum '
          + max_size.to_string

        '['
          + severity_prefix
          + '] '
          + format_with_context(msg, line, pos, Option.None)
      }
      case InvalidContentType(_, reason, line, pos, frag) -> {
        '['
          + severity_prefix
          + '] '
          + format_with_context(
            'Invalid Content-Type: ' + reason,
            line,
            pos,
            frag,
          )
      }
    }
  }

  # Get the error variant name (for backward compatibility)
  fn pub variant -> String {
    match self {
      case EmailSizeTooLarge(_, _, _, _, _, _) -> 'EmailSizeTooLarge'
      case AttachmentSizeTooLarge(_, _, _, _, _, _) -> 'AttachmentSizeTooLarge'
      case TooManyHeaders(_, _, _, _, _, _) -> 'TooManyHeaders'
      case MultipartDepthExceeded(_, _, _, _, _, _) -> 'MultipartDepthExceeded'
      case InvalidHeaderFieldName(_, _, _, _, _) -> 'InvalidHeaderFieldName'
      case MalformedHeader(_, _, _, _, _) -> 'MalformedHeader'
      case DuplicateHeader(_, _, _, _, _) -> 'DuplicateHeader'
      case HeaderWithoutColon(_, _, _, _) -> 'HeaderWithoutColon'
      case InvalidEmailFormat(_, _, _, _, _) -> 'InvalidEmailFormat'
      case HeaderValueTooLarge(_, _, _, _, _, _) -> 'HeaderValueTooLarge'
      case BoundaryNotFound(_, _, _, _) -> 'BoundaryNotFound'
      case InvalidBoundary(_, _, _, _, _) -> 'InvalidBoundary'
      case MultipartWithoutParts(_, _, _, _) -> 'MultipartWithoutParts'
      case NoBodyInPart(_, _, _, _) -> 'NoBodyInPart'
      case ParseError(_, _, _, _, _) -> 'ParseError'
      case DecodingFailed(_, _, _, _, _, _) -> 'DecodingFailed'
      case DecodedSizeTooLarge(_, _, _, _, _, _, _) -> 'DecodedSizeTooLarge'
      case MissingRequiredHeader(_, _, _, _, _) -> 'MissingRequiredHeader'
      case EmptyRequiredHeader(_, _, _, _, _) -> 'EmptyRequiredHeader'
      case EmailSizeExceeded(_, _, _, _, _) -> 'EmailSizeExceeded'
      case InvalidContentType(_, _, _, _, _) -> 'InvalidContentType'
    }
  }

  # Get the severity level of this error
  fn pub severity -> Severity {
    let sev = match self {
      case EmailSizeTooLarge(_, _, _, _, _, _) -> Severity.Error
      case AttachmentSizeTooLarge(_, _, _, _, _, _) -> Severity.Error
      case TooManyHeaders(_, _, _, _, _, _) -> Severity.Error
      case MultipartDepthExceeded(_, _, _, _, _, _) -> Severity.Error
      case InvalidHeaderFieldName(_, _, _, _, _) -> Severity.Error
      case MalformedHeader(_, _, _, _, _) -> Severity.Error
      case DuplicateHeader(_, _, _, _, _) -> Severity.Warning
      case HeaderWithoutColon(_, _, _, _) -> Severity.Error
      case InvalidEmailFormat(_, _, _, _, _) -> Severity.Error
      case HeaderValueTooLarge(_, _, _, _, _, _) -> Severity.Error
      case BoundaryNotFound(_, _, _, _) -> Severity.Error
      case InvalidBoundary(_, _, _, _, _) -> Severity.Error
      case MultipartWithoutParts(_, _, _, _) -> Severity.Error
      case NoBodyInPart(_, _, _, _) -> Severity.Error
      case ParseError(_, _, _, _, _) -> Severity.Error
      case DecodingFailed(_, _, _, _, _, _) -> Severity.Error
      case DecodedSizeTooLarge(_, _, _, _, _, _, _) -> Severity.Error
      case MissingRequiredHeader(_, _, _, _, _) -> Severity.Error
      case EmptyRequiredHeader(_, _, _, _, _) -> Severity.Error
      case EmailSizeExceeded(_, _, _, _, _) -> Severity.Error
      case InvalidContentType(_, _, _, _, _) -> Severity.Error
    }

    sev
  }

  # Create a ParseError from a string message (for backward compatibility)
  fn pub static from_string(message: String) -> Error {
    Error.ParseError(
      Severity.Error,
      message,
      Option.None,
      Option.None,
      Option.None,
    )
  }

  # Create a ParseError from a string message with severity
  fn pub static from_string_with_severity(
    message: String,
    sev: Severity,
  ) -> Error {
    Error.ParseError(sev, message, Option.None, Option.None, Option.None)
  }
}

impl Severity {
  # Convert severity to string representation
  fn pub to_string -> String {
    match self {
      case Warning -> 'WARNING'
      case Error -> 'ERROR'
      case Fatal -> 'FATAL'
    }
  }
}
