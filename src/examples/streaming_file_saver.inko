# Example: Streaming File Attachment Saver
#
# This example demonstrates how to use the streaming API to save email
# attachments to disk incrementally, without loading the entire email
# or attachments into memory.
#
# Key features demonstrated:
# - Incremental file writing (write chunks as they arrive)
# - Filename sanitization (via `emailparser.header.sanitize_filename`, which
#   strips path components, control characters and platform-reserved names)
# - Verbose progress output
# - I/O error handling
#
# The output directory is created on start. Attachments without a usable
# filename (or with one that cannot be sanitized) are skipped.

import emailparser.email_generator (TestAttachment, TestDataGenerator)
import emailparser.error (Error)
import emailparser.header (sanitize_filename)
import emailparser.streaming (AttachmentInfo, StreamHandler, StreamingParser)
import std.fs.file (WriteOnlyFile)
import std.stdio (Stderr, Stdout)

# FileAttachmentSaver saves attachments to disk incrementally
#
# This handler demonstrates the streaming API by saving each attachment
# to a separate file as chunks arrive. Files are written incrementally
# to avoid loading large attachments into memory.
type pub FileAttachmentSaver {
  let mut @output_dir: String
  let mut @current_file: Option[OutputFile]
  let mut @attachment_count: Int
  let mut @verbose: Bool
}

# Helper type for output file tracking
type OutputFile {
  let mut @path: String
  let mut @filename: String
  let mut @chunk_count: Int
  let mut @total_bytes: Int
  let mut @file: WriteOnlyFile
}

impl OutputFile {
  fn pub static new(
    path: String,
    filename: String,
    file: WriteOnlyFile,
  ) -> OutputFile {
    OutputFile(
      path: path,
      filename: filename,
      chunk_count: 0,
      total_bytes: 0,
      file: file,
    )
  }
}

impl FileAttachmentSaver {
  # Create a new FileAttachmentSaver
  #
  # Parameters:
  # - output_dir: Directory where attachments will be saved
  # - verbose: Enable verbose progress output
  fn pub static new(output_dir: String, verbose: Bool) -> FileAttachmentSaver {
    FileAttachmentSaver(
      output_dir: output_dir,
      current_file: Option.None,
      attachment_count: 0,
      verbose: verbose,
    )
  }

  # Get the number of attachments saved
  fn pub mut get_attachment_count -> Int {
    @attachment_count
  }

  # Create a safe output path for an attachment
  #
  # Uses the library's `sanitize_filename`, which strips path components,
  # control characters, bidi overrides and Windows-reserved names.
  fn mut create_output_path(filename: String) -> Option[String] {
    match sanitize_filename(filename) {
      case Some(safe_name) -> {
        Option.Some(
          @output_dir + '/' + @attachment_count.to_string + '_' + safe_name,
        )
      }
      case None -> Option.None
    }
  }
}

impl StreamHandler for FileAttachmentSaver {
  # Called when parsing begins
  fn pub mut on_begin -> Result[Int, String] {
    @attachment_count = 0

    # Create the output directory (and any parents) before writing files
    match @output_dir.to_path.create_directory_all {
      case Ok(_) -> {}
      case Error(e) -> {
        return Result.Error('cannot create output directory: ${e}')
      }
    }

    if @verbose {
      let _ = Stdout.new.print('Starting email parsing...')
    }

    Result.Ok(0)
  }

  # Called when headers are parsed
  fn pub mut on_headers(
    headers: ref Array[(String, String)],
  ) -> Result[Int, String] {
    if @verbose {
      let _ = Stdout.new.print('Headers parsed successfully')
    }

    Result.Ok(0)
  }

  # Called when text body chunk arrives
  fn pub mut on_text_chunk(chunk: String) -> Result[Int, String] {
    if @verbose and chunk.size > 0 {
      let _ = Stdout.new.print(
        'Text body chunk: ' + chunk.size.to_string + ' bytes',
      )
    }

    Result.Ok(0)
  }

  # Called when HTML body chunk arrives
  fn pub mut on_html_chunk(chunk: String) -> Result[Int, String] {
    if @verbose and chunk.size > 0 {
      let _ = Stdout.new.print(
        'HTML body chunk: ' + chunk.size.to_string + ' bytes',
      )
    }

    Result.Ok(0)
  }

  # Called when attachment metadata is available
  #
  # Creates a new file for the attachment and tracks state.
  fn pub mut on_attachment_begin(
    info: ref AttachmentInfo,
  ) -> Result[Int, String] {
    let filename = match info.filename {
      case Some(name) -> name
      case None -> {
        if @verbose {
          let _ = Stdout.new.print(
            'Attachment #' + info.index.to_string + ': unnamed (skipping)',
          )
        }

        @current_file = Option.None
        return Result.Ok(0)
      }
    }

    let output_path = match create_output_path(filename.clone) {
      case Some(path) -> path
      case None -> {
        if @verbose {
          let _ = Stdout.new.print(
            'Attachment #'
              + info.index.to_string
              + ': unusable filename (skipping)',
          )
        }

        @current_file = Option.None
        return Result.Ok(0)
      }
    }

    match WriteOnlyFile.new(output_path.to_path) {
      case Ok(file) -> {
        if @verbose {
          let _ = Stdout.new.print(
            'Attachment #' + info.index.to_string + ': ' + filename,
          )
          let _ = Stdout.new.print('  Content-Type: ' + info.content_type)
          let _ = Stdout.new.print('  Encoding: ' + info.transfer_encoding)
          let _ = Stdout.new.print('  Saving to: ' + output_path)
        }

        @current_file = Option.Some(OutputFile.new(output_path, filename, file))
        @attachment_count = @attachment_count + 1
      }
      case Error(e) -> {
        if @verbose {
          let _ = Stderr.new.print(
            'Failed to create ' + output_path + ': ' + e.to_string,
          )
        }

        @current_file = Option.None
      }
    }

    Result.Ok(0)
  }

  # Called when attachment data chunk arrives
  #
  # Writes the chunk to the current file incrementally.
  fn pub mut on_attachment_chunk(
    chunk: ByteArray,
    info: ref AttachmentInfo,
  ) -> Result[Int, String] {
    match @current_file {
      case Some(mut file) -> {
        match file.file.write(ref chunk) {
          case Ok(_) -> {}
          case Error(e) -> {
            return Result.Error('failed to write ' + file.path + ': ${e}')
          }
        }

        file.total_bytes = file.total_bytes + chunk.size
        file.chunk_count = file.chunk_count + 1

        if @verbose {
          if file.chunk_count == 1 or file.chunk_count % 100 == 0 {
            let _ = Stdout.new.print(
              '  Chunk #'
                + file.chunk_count.to_string
                + ': '
                + chunk.size.to_string
                + ' bytes (total: '
                + file.total_bytes.to_string
                + ')',
            )
          }
        }

        Result.Ok(0)
      }
      case None -> Result.Ok(0)
    }
  }

  # Called when attachment is complete
  #
  # Flushes and closes the file, logs final statistics.
  fn pub mut on_attachment_end(info: ref AttachmentInfo) -> Result[Int, String]
  {
    match @current_file {
      case Some(mut file) -> {
        match file.file.flush {
          case Ok(_) -> {}
          case Error(e) -> {
            return Result.Error('failed to flush ' + file.path + ': ${e}')
          }
        }

        if @verbose {
          let _ = Stdout.new.print(
            '  Completed: '
              + file.chunk_count.to_string
              + ' chunks, '
              + file.total_bytes.to_string
              + ' bytes total',
          )
        }
      }
      case None -> {}
    }

    Result.Ok(0)
  }

  # Called when parsing completes successfully
  fn pub mut on_end -> Result[Int, String] {
    if @verbose {
      let _ = Stdout.new.print('Parsing complete!')
      let _ = Stdout.new.print(
        'Total attachments saved: ' + @attachment_count.to_string,
      )
    }

    Result.Ok(0)
  }

  # Called when an error occurs
  fn pub mut on_error(error: ref Error) -> Result[Int, String] {
    let _ = Stderr.new.print('Error: ' + error.to_message)

    Result.Ok(0)
  }
}

# Main function demonstrating FileAttachmentSaver usage
type async Main {
  fn async main {
    let out = Stdout.new
    let err = Stderr.new

    let _ = out.print('=== FileAttachmentSaver Example ===')
    let _ = out.print(
      'Attachments are written to ./attachments as their chunks arrive',
    )
    let _ = out.print('')

    # Generate a test email with attachments
    let mut generator = TestDataGenerator.new

    let _ = out.print('Generating test email with 3 attachments...')

    let attachments = [
      TestAttachment(
        name: 'document.pdf',
        content_type: 'application/pdf',
        content: '%PDF-1.4...simulated PDF content...',
        encoding: 'base64',
      ),
      TestAttachment(
        name: 'image.png',
        content_type: 'image/png',
        content: 'PNG...simulated image content...',
        encoding: 'base64',
      ),
      TestAttachment(
        name: 'data.txt',
        content_type: 'text/plain',
        content: 'This is plain text data for the attachment.',
        encoding: 'base64',
      ),
    ]

    let email = generator.generate_email_with_attachments(attachments)

    let _ = out.print(
      'Test email generated (' + email.size.to_string + ' bytes)',
    )
    let _ = out.print('')

    # Create the handler with verbose output
    let mut saver = FileAttachmentSaver.new('./attachments', true)

    # Parse the email using streaming API
    let _ = out.print('Parsing email with streaming API...')

    let parser = StreamingParser.new

    match parser.parse_stream(email, saver) {
      case Ok(result) -> {
        let _ = out.print('')
        let _ = out.print('=== Parsing Results ===')
        let _ = out.print('Subject: ' + result.subject)
        let _ = out.print('From: ' + result.from.address)

        let first_to = match result.to.iter.next {
          case Some(addr) -> addr.address
          case None -> 'n/a'
        }

        let _ = out.print('To: ' + first_to)
        let _ = out.print('Content-Type: ' + result.content_type)
        let _ = out.print(
          'Attachment count: ' + result.attachment_count.to_string,
        )
        let _ = out.print('')
        let _ = out.print('All attachments processed successfully!')
      }
      case Error(e) -> {
        let _ = err.print('Failed to parse email: ' + e.to_message)

        return
      }
    }
  }
}
