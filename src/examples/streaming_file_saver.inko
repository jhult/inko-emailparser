# Example: Streaming File Attachment Saver
#
# This example demonstrates how to use the streaming API to save email
# attachments to disk incrementally, without loading the entire email
# or attachments into memory.
#
# Key features demonstrated:
# - Incremental file writing (write chunks as they arrive)
# - Filename sanitization (prevent path traversal attacks)
# - Verbose progress output
# - I/O error handling

import emailparser.streaming (
  AttachmentInfo, StreamHandler, StreamingParser, StreamingResult,
)
import emailparser.test_data_generator (TestAttachment, TestDataGenerator)
import std.stdio (Stderr, Stdout)

# FileAttachmentSaver saves attachments to disk incrementally
#
# This handler demonstrates the streaming API by saving each attachment
# to a separate file as chunks arrive. Files are written incrementally
# to avoid loading large attachments into memory.
type pub FileAttachmentSaver {
  let mut @output_dir: String
  let mut @current_file: Option[OutputFile]
  let mut @attachment_count: Int
  let mut @verbose: Bool
}

# Helper type for output file tracking
type OutputFile {
  let mut @path: String
  let mut @filename: String
  let mut @chunk_count: Int
  let mut @total_bytes: Int
}

impl OutputFile {
  fn pub static new(path: String, filename: String) -> OutputFile {
    OutputFile(path: path, filename: filename, chunk_count: 0, total_bytes: 0)
  }
}

impl FileAttachmentSaver {
  # Create a new FileAttachmentSaver
  #
  # Parameters:
  # - output_dir: Directory where attachments will be saved
  # - verbose: Enable verbose progress output
  fn pub static new(output_dir: String, verbose: Bool) -> FileAttachmentSaver {
    FileAttachmentSaver(
      output_dir: output_dir,
      current_file: Option.None,
      attachment_count: 0,
      verbose: verbose,
    )
  }

  # Get the number of attachments saved
  fn pub mut get_attachment_count -> Int {
    @attachment_count
  }

  # Sanitize a filename to prevent path traversal attacks
  #
  # Removes or replaces dangerous characters like path separators.
  fn mut sanitize_filename(name: String) -> String {
    let mut result = recover ByteArray.new
    let mut i = 0

    while i < name.size {
      match name.get(i) {
        case Ok(byte) -> {
          # Replace path separators with underscores
          if byte == 47 or byte == 92 {
            result.push(95)
          } else if byte == 0 {
            # Remove null bytes
          } else {
            result.push(byte)
          }
        }
        case Error(_) -> {}
      }

      i = i + 1
    }

    result.into_string
  }

  # Create a safe output path for an attachment
  #
  # Combines output directory with sanitized filename.
  fn mut create_output_path(filename: String) -> String {
    let safe_name = sanitize_filename(filename)

    # Prefix with attachment index to avoid collisions
    let prefix = @attachment_count.to_string + '_'

    @output_dir + '/' + prefix + safe_name
  }
}

impl StreamHandler for FileAttachmentSaver {
  # Called when parsing begins
  fn pub mut on_begin -> Result[Int, String] {
    @attachment_count = 0

    if @verbose { Stdout.new.print('Starting email parsing...') }

    Result.Ok(0)
  }

  # Called when headers are parsed
  fn pub mut on_headers(
    headers: ref Array[(String, String)],
  ) -> Result[Int, String] {
    if @verbose { Stdout.new.print('Headers parsed successfully') }

    Result.Ok(0)
  }

  # Called when text body chunk arrives
  fn pub mut on_text_chunk(chunk: String) -> Result[Int, String] {
    if @verbose and chunk.size > 0 {
      Stdout.new.print('Text body chunk: ' + chunk.size.to_string + ' bytes')
    }

    Result.Ok(0)
  }

  # Called when HTML body chunk arrives
  fn pub mut on_html_chunk(chunk: String) -> Result[Int, String] {
    if @verbose and chunk.size > 0 {
      Stdout.new.print('HTML body chunk: ' + chunk.size.to_string + ' bytes')
    }

    Result.Ok(0)
  }

  # Called when attachment metadata is available
  #
  # Creates a new file for the attachment and tracks state.
  fn pub mut on_attachment_begin(
    info: ref AttachmentInfo,
  ) -> Result[Int, String] {
    match info.filename {
      case Some(filename) -> {
        let output_path = create_output_path(filename)

        if @verbose {
          Stdout.new.print(
            'Attachment #' + info.index.to_string + ': ' + filename,
          )
          Stdout.new.print('  Content-Type: ' + info.content_type)
          Stdout.new.print('  Encoding: ' + info.transfer_encoding)
          Stdout.new.print('  Saving to: ' + output_path)
        }

        # Create output file tracker (simulating file creation)
        @current_file = Option.Some(OutputFile.new(output_path, filename))
        @attachment_count = @attachment_count + 1
      }
      case None -> {
        if @verbose {
          Stdout.new.print(
            'Attachment #' + info.index.to_string + ': unnamed (skipping)',
          )
        }

        @current_file = Option.None
      }
    }

    Result.Ok(0)
  }

  # Called when attachment data chunk arrives
  #
  # Writes the chunk to the current file incrementally.
  fn pub mut on_attachment_chunk(
    chunk: ByteArray,
    info: ref AttachmentInfo,
  ) -> Result[Int, String] {
    match @current_file {
      case Some(mut file) -> {
        # In a real implementation, this would write to disk
        # For this example, we simulate writing by tracking stats
        file.total_bytes = file.total_bytes + chunk.size
        file.chunk_count = file.chunk_count + 1

        if @verbose {
          if file.chunk_count == 1 or file.chunk_count % 100 == 0 {
            Stdout.new.print(
              '  Chunk #'
                + file.chunk_count.to_string
                + ': '
                + chunk.size.to_string
                + ' bytes (total: '
                + file.total_bytes.to_string
                + ')',
            )
          }
        }

        Result.Ok(0)
      }
      case None -> Result.Ok(0)
    }
  }

  # Called when attachment is complete
  #
  # Flushes and closes the file, logs final statistics.
  fn pub mut on_attachment_end(
    info: ref AttachmentInfo,
  ) -> Result[Int, String] {
    match @current_file {
      case Some(file) -> {
        if @verbose {
          Stdout.new.print(
            '  Completed: '
              + file.chunk_count.to_string
              + ' chunks, '
              + file.total_bytes.to_string
              + ' bytes total',
          )
        }

        @current_file = Option.None
      }
      case None -> {}
    }

    Result.Ok(0)
  }

  # Called when parsing completes successfully
  fn pub mut on_end -> Result[Int, String] {
    if @verbose {
      Stdout.new.print('Parsing complete!')
      Stdout.new.print(
        'Total attachments saved: ' + @attachment_count.to_string,
      )
    }

    Result.Ok(0)
  }

  # Called when an error occurs
  fn pub mut on_error(error: String) -> Result[Int, String] {
    Stderr.new.print('Error: ' + error)
    Result.Ok(0)
  }
}

# Main function demonstrating FileAttachmentSaver usage
type async Main {
  fn async main {
    let out = Stdout.new
    let err = Stderr.new

    out.print('=== FileAttachmentSaver Example ===')
    out.print('This example demonstrates saving email attachments to disk')
    out.print('')

    # Generate a test email with attachments
    let mut generator = TestDataGenerator.new

    out.print('Generating test email with 3 attachments...')

    let attachments = [
      TestAttachment(
        name: 'document.pdf',
        content_type: 'application/pdf',
        content: '%PDF-1.4...simulated PDF content...',
        encoding: 'base64',
      ),
      TestAttachment(
        name: 'image.png',
        content_type: 'image/png',
        content: 'PNG...simulated image content...',
        encoding: 'base64',
      ),
      TestAttachment(
        name: 'data.txt',
        content_type: 'text/plain',
        content: 'This is plain text data for the attachment.',
        encoding: 'base64',
      ),
    ]

    let email = generator.generate_email_with_attachments(attachments)

    out.print('Test email generated (' + email.size.to_string + ' bytes)')
    out.print('')

    # Create the handler with verbose output
    let mut saver = FileAttachmentSaver.new('./attachments', true)

    # Parse the email using streaming API
    out.print('Parsing email with streaming API...')

    let parser = StreamingParser.new

    match parser.parse_stream(email, saver) {
      case Ok(result) -> {
        out.print('')
        out.print('=== Parsing Results ===')
        out.print('Subject: ' + result.subject)
        out.print('From: ' + result.from.address)

        let first_to = match result.to.iter.next {
          case Some(addr) -> addr.address
          case None -> 'n/a'
        }

        out.print('To: ' + first_to)
        out.print('Content-Type: ' + result.content_type)
        out.print('Attachment count: ' + result.attachment_count.to_string)
        out.print('')
        out.print('All attachments processed successfully!')
      }
      case Error(e) -> {
        err.print('Failed to parse email: ' + e)
        return
      }
    }
  }
}
