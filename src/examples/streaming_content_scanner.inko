# Example: Streaming Content Scanner
#
# This example demonstrates how to use the streaming API to scan email
# content for malicious patterns. The scanner examines text body, HTML body,
# and attachments, and fails immediately when suspicious content is detected
# (fail-fast mode).
#
# Key features demonstrated:
# - Pattern matching in text and HTML content
# - Binary pattern scanning in attachments
# - Fail-fast error handling (abort on detection)
# - Configurable malicious pattern detection

import emailparser.email_generator (TestAttachment, TestDataGenerator)
import emailparser.streaming (AttachmentInfo, StreamHandler, StreamingParser)
import std.bytes (ByteArray)
import std.option (Option)
import std.stdio (Stderr, Stdout)

# ContentScanner scans email content for malicious patterns
type pub ContentScanner {
  let mut @malicious_patterns: Array[String]
  let mut @binary_patterns: Array[ByteArray]
  let mut @patterns_found: Array[String]
  let mut @fail_fast: Bool
  let mut @verbose: Bool
}

impl ContentScanner {
  fn pub static new(
    patterns: Array[String],
    binary_patterns: Array[ByteArray],
    fail_fast: Bool,
    verbose: Bool,
  ) -> ContentScanner {
    ContentScanner(
      malicious_patterns: patterns,
      binary_patterns: binary_patterns,
      patterns_found: [],
      fail_fast: fail_fast,
      verbose: verbose,
    )
  }

  fn pub static with_defaults(verbose: Bool) -> ContentScanner {
    let patterns = [
      'malware',
      'virus',
      'trojan',
      'spyware',
      'keylogger',
      'ransomware',
      'phishing',
      '<script',
      'javascript:',
      'eval(',
      'document.write',
      'exec(',
      'system(',
      'shell_exec',
    ]

    let binary_pattern = recover ByteArray.new
    let binary_patterns = [binary_pattern]

    ContentScanner.new(patterns, binary_patterns, true, verbose)
  }

  fn mut scan_text(content: String) -> Option[String] {
    for pattern in @malicious_patterns.iter {
      if content.contains?(pattern.to_lower) or content.contains?(pattern) {
        return Option.Some(pattern.clone)
      }
    }

    Option.None
  }

  fn mut scan_binary(data: ref ByteArray) -> Option[String] {
    for pattern in @binary_patterns.iter {
      if contains_binary_pattern(data, pattern.clone) {
        return Option.Some('binary_pattern_' + pattern.size.to_string)
      }
    }

    Option.None
  }

  fn pub mut get_patterns_found -> Array[String] {
    @patterns_found.clone
  }

  fn pub mut has_detections -> Bool {
    !@patterns_found.empty?
  }
}

fn contains_binary_pattern(data: ref ByteArray, pattern: ByteArray) -> Bool {
  if pattern.size == 0 or data.size < pattern.size { return false }

  let mut i = 0
  let max_i = data.size - pattern.size

  while i <= max_i {
    let mut match_found = true
    let mut j = 0

    while j < pattern.size {
      match data.get(i + j) {
        case Ok(data_byte) -> {
          match pattern.get(j) {
            case Ok(pattern_byte) -> {
              if data_byte != pattern_byte {
                match_found = false
                break
              }
            }
            case Error(_) -> {
              match_found = false
              break
            }
          }
        }
        case Error(_) -> {
          match_found = false
          break
        }
      }

      j = j + 1
    }

    if match_found { return true }

    i = i + 1
  }

  false
}

impl StreamHandler for ContentScanner {
  fn pub mut on_begin -> Result[Int, String] {
    if @verbose {
      let _ = Stdout.new.print('Starting content scan...')
      let _ = Stdout.new.print(
        'Monitoring ' + @malicious_patterns.size.to_string + ' text patterns',
      )
      let _ = Stdout.new.print(
        'Monitoring ' + @binary_patterns.size.to_string + ' binary patterns',
      )
    }

    Result.Ok(0)
  }

  fn pub mut on_headers(
    headers: ref Array[(String, String)],
  ) -> Result[Int, String] {
    if @verbose { let _ = Stdout.new.print('Headers parsed successfully') }

    for (name, value) in headers.iter {
      match scan_text(value.clone) {
        case Some(pattern) -> {
          @patterns_found.push(pattern.clone)

          let _ = Stderr.new.print(
            "WARNING: Malicious pattern '"
              + pattern
              + "' found in header '"
              + name
              + "'",
          )

          if @fail_fast {
            return Result.Error(
              "Malicious content detected in header '" + name + "': " + pattern,
            )
          }
        }
        case None -> {}
      }
    }

    Result.Ok(0)
  }

  fn pub mut on_text_chunk(chunk: String) -> Result[Int, String] {
    if @verbose and chunk.size > 0 {
      let _ = Stdout.new.print(
        'Scanning text chunk: ' + chunk.size.to_string + ' bytes',
      )
    }

    match scan_text(chunk) {
      case Some(pattern) -> {
        @patterns_found.push(pattern.clone)

        let _ = Stderr.new.print(
          "WARNING: Malicious pattern '" + pattern + "' found in text body",
        )

        if @fail_fast {
          return Result.Error(
            'Malicious content detected in text body: ' + pattern,
          )
        }
      }
      case None -> {}
    }

    Result.Ok(0)
  }

  fn pub mut on_html_chunk(chunk: String) -> Result[Int, String] {
    if @verbose and chunk.size > 0 {
      let _ = Stdout.new.print(
        'Scanning HTML chunk: ' + chunk.size.to_string + ' bytes',
      )
    }

    match scan_text(chunk) {
      case Some(pattern) -> {
        @patterns_found.push(pattern.clone)

        let _ = Stderr.new.print(
          "WARNING: Malicious pattern '" + pattern + "' found in HTML body",
        )

        if @fail_fast {
          return Result.Error(
            'Malicious content detected in HTML body: ' + pattern,
          )
        }
      }
      case None -> {}
    }

    Result.Ok(0)
  }

  fn pub mut on_attachment_begin(
    info: ref AttachmentInfo,
  ) -> Result[Int, String] {
    if @verbose {
      let filename = match info.filename {
        case Some(f) -> f
        case None -> 'unnamed'
      }

      let _ = Stdout.new.print(
        'Scanning attachment #' + info.index.to_string + ': ' + filename,
      )
      let _ = Stdout.new.print('  Content-Type: ' + info.content_type)
      let _ = Stdout.new.print('  Encoding: ' + info.transfer_encoding)
    }

    Result.Ok(0)
  }

  fn pub mut on_attachment_chunk(
    chunk: ByteArray,
    info: ref AttachmentInfo,
  ) -> Result[Int, String] {
    if @verbose and chunk.size > 0 {
      let _ = Stdout.new.print(
        '  Scanning attachment chunk: ' + chunk.size.to_string + ' bytes',
      )
    }

    match scan_binary(chunk) {
      case Some(pattern) -> {
        @patterns_found.push(pattern.clone)

        let _ = Stderr.new.print(
          "WARNING: Malicious binary pattern '"
            + pattern
            + "' found in attachment",
        )

        if @fail_fast {
          return Result.Error(
            'Malicious content detected in attachment: ' + pattern,
          )
        }
      }
      case None -> {}
    }

    Result.Ok(0)
  }

  fn pub mut on_attachment_end(
    info: ref AttachmentInfo,
  ) -> Result[Int, String] {
    if @verbose {
      let _ = Stdout.new.print(
        '  Attachment #' + info.index.to_string + ' scan complete',
      )
    }

    Result.Ok(0)
  }

  fn pub mut on_end -> Result[Int, String] {
    if @verbose {
      let _ = Stdout.new.print('Scanning complete!')

      if @patterns_found.empty? {
        let _ = Stdout.new.print('No malicious patterns detected')
      } else {
        let _ = Stdout.new.print(
          'Malicious patterns found: ' + @patterns_found.size.to_string,
        )

        for pattern in @patterns_found.iter {
          let _ = Stdout.new.print('  - ' + pattern)
        }
      }
    }

    Result.Ok(0)
  }

  fn pub mut on_error(error: String) -> Result[Int, String] {
    let _ = Stderr.new.print('Scan error: ' + error)

    Result.Ok(0)
  }
}

type async Main {
  fn async main {
    let out = Stdout.new
    let err = Stderr.new

    let _ = out.print('=== ContentScanner Example ===')
    let _ = out.print(
      'This example demonstrates scanning email content for malicious patterns',
    )
    let _ = out.print('')

    let _ = out.print('--- Test 1: Clean email (no malicious content) ---')

    let mut generator = TestDataGenerator.new
    let clean_email = generator.generate_text_email(
      'Hello from friend',
      'This is a friendly email with legitimate content.',
    )

    let mut scanner = ContentScanner.with_defaults(true)
    let parser = StreamingParser.new

    match parser.parse_stream(clean_email, scanner) {
      case Ok(result) -> {
        let _ = out.print('Result: CLEAN - No malicious patterns detected')
        let _ = out.print('Subject: ' + result.subject)
      }
      case Error(e) -> let _ = err.print('Result: ERROR - ' + e)
    }

    let _ = out.print('')

    let _ = out.print(
      '--- Test 2: Email with malicious content in text body ---',
    )

    let malicious_text_email = generator.generate_text_email(
      'Suspicious offer',
      'This email contains malware and virus content for testing.',
    )

    let mut scanner2 = ContentScanner.with_defaults(true)
    let parser2 = StreamingParser.new

    match parser2.parse_stream(malicious_text_email, scanner2) {
      case Ok(result) -> {
        let _ = out.print('Result: CLEAN - No malicious patterns detected')
        let _ = out.print('Subject: ' + result.subject)
      }
      case Error(e) -> {
        let _ = out.print('Result: BLOCKED - ' + e)
        let _ = out.print(
          'Patterns found: ' + scanner2.get_patterns_found.size.to_string,
        )
      }
    }

    let _ = out.print('')

    let _ = out.print('--- Test 3: Email with malicious HTML content ---')

    let html_email = generator.generate_alternative_email(
      'HTML Test',
      'Plain text here',
      '<html><body><p>Safe content</p><script>alert("XSS")</script></body></html>',
    )

    let mut scanner3 = ContentScanner.with_defaults(true)
    let parser3 = StreamingParser.new

    match parser3.parse_stream(html_email, scanner3) {
      case Ok(result) -> {
        let _ = out.print('Result: CLEAN - No malicious patterns detected')
        let _ = out.print('Subject: ' + result.subject)
      }
      case Error(e) -> {
        let _ = out.print('Result: BLOCKED - ' + e)
        let _ = out.print(
          'Patterns found: ' + scanner3.get_patterns_found.size.to_string,
        )
      }
    }

    let _ = out.print('')

    let _ = out.print('--- Test 4: Email with attachments ---')

    let attachments = [
      TestAttachment(
        name: 'safe.txt',
        content_type: 'text/plain',
        content: 'This is safe attachment content.',
        encoding: 'base64',
      ),
      TestAttachment(
        name: 'data.bin',
        content_type: 'application/octet-stream',
        content: 'Binary data with some patterns here...',
        encoding: 'base64',
      ),
    ]

    let email_with_attachments = generator.generate_email_with_attachments(
      attachments,
    )

    let mut scanner4 = ContentScanner.with_defaults(true)
    let parser4 = StreamingParser.new

    match parser4.parse_stream(email_with_attachments, scanner4) {
      case Ok(result) -> {
        let _ = out.print('Result: CLEAN - No malicious patterns detected')
        let _ = out.print('Subject: ' + result.subject)
        let _ = out.print(
          'Attachments scanned: ' + result.attachment_count.to_string,
        )
      }
      case Error(e) -> {
        let _ = out.print('Result: BLOCKED - ' + e)
        let _ = out.print(
          'Patterns found: ' + scanner4.get_patterns_found.size.to_string,
        )
      }
    }

    let _ = out.print('')

    let _ = out.print(
      '--- Test 5: Non-fail-fast mode (detect all violations) ---',
    )

    let multi_malicious_email = generator.generate_text_email(
      'Multiple violations',
      'This has virus and malware and trojan content.',
    )

    let custom_patterns = ['virus', 'malware', 'trojan']
    let mut scanner5 = ContentScanner.new(custom_patterns, [], false, true)
    let parser5 = StreamingParser.new

    match parser5.parse_stream(multi_malicious_email, scanner5) {
      case Ok(_) -> {
        let _ = out.print('Result: SCAN COMPLETE (non-fail-fast mode)')
        let _ = out.print(
          'Violations detected: ' + scanner5.get_patterns_found.size.to_string,
        )

        for pattern in scanner5.get_patterns_found.iter {
          let _ = out.print('  - ' + pattern)
        }
      }
      case Error(e) -> let _ = err.print('Unexpected error: ' + e)
    }

    let _ = out.print('')
    let _ = out.print('=== All tests completed ===')
  }
}
