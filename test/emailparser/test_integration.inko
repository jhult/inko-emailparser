# Integration Tests with Real-World Email Samples
#
# These tests parse actual emails from major providers:
# - Gmail (simple and complex)
# - Outlook/O365
# - Apple Mail
# - Mobile clients
# - Internationalized emails

import emailparser (EmailParser)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  # ============================================================
  # GMAIL EMAILS
  # ============================================================

  t.test('gmail_simple_plain_text', fn (t) {
    let parser = EmailParser.new
    let raw_email = 'Delivered-To: user@gmail.com
Received: by 2002:a05:6914:2411:b0:238:6474:b5e with SMTP id q17csp1234567pgr;
        Wed, 15 Jan 2026 10:30:00 -0800 (PST)
X-Received: by 2002:a05:6914:2411:b0:238:6474:b5e with SMTP id q17csp1234567pgr;
        Wed, 15 Jan 2026 10:30:00 -0800 (PST)
ARC-Seal: i=1; a=rsa-sha256; t=1736964600; cv=none;
        d=google.com; s=arc-20160816;
        b=fake_signature_value
ARC-Message-Signature: i=1; a=rsa-sha256; c=relaxed/relaxed;
        d=google.com; s=arc-20160816;
        h=mime-version:references:in-reply-to:date:message-id:subject:from:to
         :cc:content-transfer-encoding;
        bh=fake_hash_value;
        b=fake_signature_value
ARC-Authentication-Results: i=1; mx.google.com;
       spf=pass (google.com: domain of sender@example.com designates 192.0.2.1 as permitted sender) smtp.mailfrom=sender@example.com
Return-Path: <sender@example.com>
Received: from mail.example.com (mail.example.com. [192.0.2.1])
        by mx.google.com with ESMTPS id q1234.2026.01.15.10.30.00
        for <user@gmail.com>
        (version=TLS1_3 cipher=TLS_AES_256_GCM_SHA384 bits=256/256);
        Wed, 15 Jan 2026 10:30:00 -0800 (PST)
Received-SPF: pass (google.com: domain of sender@example.com designates 192.0.2.1 as permitted sender)
Authentication-Results: mx.google.com;
       spf=pass (google.com: domain of sender@example.com designates 192.0.2.1 as permitted sender);
       dkim=pass header.i=@example.com header.s=s1 header.b=fake_value;
       dmarc=pass (p=NONE sp=NONE dis=NONE) header.from=example.com
Received: by mail.example.com (Postfix, from userid 1000)
	id ABCDEF; Wed, 15 Jan 2026 10:30:00 -0800 (PST)
Date: Wed, 15 Jan 2026 10:30:00 -0800
To: user@gmail.com
From: Sender Name <sender@example.com>
Subject: Simple Gmail Test Email
Message-ID: <abc123@mail.example.com>
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 7bit

This is a simple plain text email sent to Gmail.

It has multiple lines of text and tests basic parsing.

Best regards,
Sender'

    let result = parser.parse(raw_email)

    match result {
      case Ok(msg) -> {
        t.equal(msg.addresses.from.address, 'sender@example.com')
        t.equal(msg.addresses.to.size, 1)
        t.equal(msg.addresses.to.get(0).or_panic.address, 'user@gmail.com')
        t.equal(msg.subject, 'Simple Gmail Test Email')
        t.equal(msg.message_id, '<abc123@mail.example.com>')
        t.equal(msg.mime.content_type, 'text/plain')

        match msg.mime.charset {
          case Some(cs) -> t.equal(cs, 'UTF-8')
          case None -> t.equal('should have charset', 'got none')
        }

        match msg.text_body {
          case Some(body) -> {
            t.true(body.contains?('simple plain text email'))
            t.true(body.contains?('multiple lines'))
          }
          case None -> t.equal('should have text body', 'got none')
        }
      }
      case Error(e) -> t.equal('should parse', 'got error: ' + e)
    }
  })

  t.test('gmail_complex_with_attachments', fn (t) {
    let parser = EmailParser.new
    let raw_email = 'Delivered-To: user@gmail.com
Received: by 2002:a05:6914:2411:b0:238:6474:b5e with SMTP id q17csp1234567pgr;
        Thu, 16 Jan 2026 14:20:00 -0800 (PST)
X-Received: by 2002:a05:6914:2411:b0:238:6474:b5e with SMTP id q17csp1234567pgr;
        Thu, 16 Jan 2026 14:20:00 -0800 (PST)
ARC-Seal: i=1; a=rsa-sha256; t=1737052800; cv=none;
        d=google.com; s=arc-20160816;
        b=fake_signature_value
ARC-Message-Signature: i=1; a=rsa-sha256; c=relaxed/relaxed;
        d=google.com; s=arc-20160816;
        h=mime-version:references:in-reply-to:date:message-id:subject:from:to
         :cc:content-transfer-encoding;
        bh=fake_hash_value;
        b=fake_signature_value
ARC-Authentication-Results: i=1; mx.google.com;
       spf=pass (google.com: domain of marketing@company.com designates 192.0.2.2 as permitted sender) smtp.mailfrom=marketing@company.com
Return-Path: <marketing@company.com>
Received: from mail.company.com (mail.company.com. [192.0.2.2])
        by mx.google.com with ESMTPS id q5678.2026.01.16.14.20.00
        for <user@gmail.com>
        (version=TLS1_3 cipher=TLS_AES_256_GCM_SHA384 bits=256/256);
        Thu, 16 Jan 2026 14:20:00 -0800 (PST)
Received-SPF: pass (google.com: domain of marketing@company.com designates 192.0.2.2 as permitted sender)
Authentication-Results: mx.google.com;
       spf=pass (google.com: domain of marketing@company.com designates 192.0.2.2 as permitted sender);
       dkim=pass header.i=@company.com header.s=s1 header.b=fake_value;
       dmarc=pass (p=NONE sp=NONE dis=NONE) header.from=company.com
Received: by mail.company.com (Postfix, from userid 1001)
	id GHIJKL; Thu, 16 Jan 2026 14:20:00 -0800 (PST)
Date: Thu, 16 Jan 2026 14:20:00 -0800
To: user@gmail.com
From: Marketing Team <marketing@company.com>
Subject: Newsletter with Attachments
Message-ID: <news123@company.com>
MIME-Version: 1.0
Content-Type: multipart/mixed; boundary=----=_Part_123_4567890.1234567890

------=_Part_123_4567890.1234567890
Content-Type: multipart/alternative; boundary=----=_Alt_123_4567890.1234567890

------=_Alt_123_4567890.1234567890
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 7bit

Hello,

This is our monthly newsletter with text content.

Best regards,
The Marketing Team
------=_Alt_123_4567890.1234567890
Content-Type: text/html; charset=UTF-8
Content-Transfer-Encoding: 7bit

<html>
<body>
<h1>Monthly Newsletter</h1>
<p>Hello,</p>
<p>This is our monthly newsletter with <strong>HTML content</strong>.</p>
<p>Best regards,<br>The Marketing Team</p>
</body>
</html>
------=_Alt_123_4567890.1234567890--

------=_Part_123_4567890.1234567890
Content-Type: application/pdf; name="report.pdf"
Content-Transfer-Encoding: base64
Content-Disposition: attachment; filename="report.pdf"

JVBERi0xLjUKJcOkw7zDtsOfCjIgMCBvYmoKPDwvTGVuZ3RoIDMgMCBSL0ZpbHRlci9GbGF0ZURl
Y29kZT4+CnN0cmVhbQp4nDPz5XATAAAEQ2Z2AAAQaWF1dGhvcml6ZWQKZW5kc3RyZWFtCmVuZG9i
ago=
------=_Part_123_4567890.1234567890
Content-Type: image/jpeg; name="image.jpg"
Content-Transfer-Encoding: base64
Content-Disposition: attachment; filename="image.jpg"

/9j/4AAQSkZJRgABAQEAYABgAAD/2wBDAAgGBgcGBQgHBwcJCQgKDBQNDAsLDBkSEw8UHRofHh0a
HBwgJC4nICIsIxwcKDcpLDAxNDQ0Hyc5PTgyPC4zNDL/wAALCAACAgBAREA/8QAFAABAAAAAAAAAA
AAACv/EABQQAQAAAAAAAAAAAAAAAAAAAAD/2gAIAQEAAD8AT//Z
------=_Part_123_4567890.1234567890--
'

    let result = parser.parse(raw_email)

    match result {
      case Ok(msg) -> {
        t.equal(msg.mime.content_type, 'multipart/mixed')
        t.equal(msg.addresses.from.address, 'marketing@company.com')
        t.equal(msg.subject, 'Newsletter with Attachments')

        match msg.text_body {
          case Some(body) -> t.true(body.contains?('monthly newsletter'))
          case None -> t.equal('should have text body', 'got none')
        }

        match msg.html_body {
          case Some(body) -> t.true(body.contains?('Monthly Newsletter'))
          case None -> t.equal('should have html body', 'got none')
        }

        if msg.attachments.size >= 2 {
          match msg.attachments.get(0) {
            case Ok(att) -> {
              t.equal(att.content_type, 'application/pdf')
              t.equal(att.filename, Option.Some('report.pdf'))
              t.equal(att.content_disposition, 'attachment')
            }
            case Error(_) -> {}
          }

          match msg.attachments.get(1) {
            case Ok(att) -> {
              t.equal(att.content_type, 'image/jpeg')
              t.equal(att.filename, Option.Some('image.jpg'))
            }
            case Error(_) -> {}
          }
        }
      }
      case Error(e) -> t.equal('should parse', 'got error: ' + e)
    }
  })

  # ============================================================
  # OUTLOOK EMAILS
  # ============================================================

  t.test('outlook_threading_headers', fn (t) {
    let parser = EmailParser.new
    let raw_email = 'Received: from DB5EUR06FT063.mail.protection.outlook.com (2a01:111:f403:fd04::1) by
