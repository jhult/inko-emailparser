  # ============================================================
  # ADDRESS FIELDS
  # ============================================================

  t.test('equivalence_multiple_recipients', fn (t) {
    let raw_email = 'From: sender@example.com
To: recipient1@example.com, recipient2@example.com
Cc: cc1@example.com, cc2@example.com
Bcc: bcc@example.com
Subject: Multiple Recipients
Message-ID: <test@example.com>
MIME-Version: 1.0
Content-Type: text/plain

Body for multiple recipients.

'

    let streaming_parser = StreamingParser.new
    let mut streaming_handler = EquivalenceTestHandler.new
    let streaming_result = match
      streaming_parser.parse_stream(raw_email, streaming_handler)
    {
      case Ok(r) -> r
      case Error(e) -> {
        t.equal('should parse streaming', 'got error: ' + e)
        return
      }
    }

    let regular_parser = EmailParser.new
    let regular_result = match regular_parser.parse(raw_email) {
      case Ok(r) -> r
      case Error(e) -> {
        t.equal('should parse regular', 'got error: ' + e)
        return
      }
    }

    t.equal(streaming_result.to.size, regular_result.addresses.to.size)
    t.equal(streaming_result.cc.size, regular_result.addresses.cc.size)
    t.equal(streaming_result.subject, regular_result.subject)
  })

  # ============================================================
  # THREADING HEADERS
  # ============================================================

  t.test('equivalence_with_threading_headers', fn (t) {
    let raw_email = 'From: sender@example.com
To: recipient@example.com
Subject: Re: Thread Test
Message-ID: <msg3@example.com>
References: <msg1@example.com> <msg2@example.com>
In-Reply-To: <msg2@example.com>
MIME-Version: 1.0
Content-Type: text/plain

Threaded body.

'

    let streaming_parser = StreamingParser.new
    let mut streaming_handler = EquivalenceTestHandler.new
    let streaming_result = match
      streaming_parser.parse_stream(raw_email, streaming_handler)
    {
      case Ok(r) -> r
      case Error(e) -> {
        t.equal('should parse streaming', 'got error: ' + e)
        return
      }
    }

    let regular_parser = EmailParser.new
    let regular_result = match regular_parser.parse(raw_email) {
      case Ok(r) -> r
      case Error(e) -> {
        t.equal('should parse regular', 'got error: ' + e)
        return
      }
    }

    t.equal(streaming_result.thread_id, regular_result.threading.thread_id)
    t.equal(streaming_result.in_reply_to, regular_result.threading.in_reply_to)
  })

  # ============================================================
  # ENCODED SUBJECTS
  # ============================================================

  t.test('equivalence_rfc2047_encoded_subject', fn (t) {
    let mut generator = TestDataGenerator.new
    let email = generator.generate_encoded_subject_email(
      '=?UTF-8?B?SGVsbG8gV29ybGQ=?=',
      'Body content here.',
    )

    let streaming_parser = StreamingParser.new
    let mut streaming_handler = EquivalenceTestHandler.new
    let streaming_result = match
      streaming_parser.parse_stream(email, streaming_handler)
    {
      case Ok(r) -> r
      case Error(e) -> {
        t.equal('should parse streaming', 'got error: ' + e)
        return
      }
    }

    let regular_parser = EmailParser.new
    let regular_result = match regular_parser.parse(email) {
      case Ok(r) -> r
      case Error(e) -> {
        t.equal('should parse regular', 'got error: ' + e)
        return
      }
    }

    t.equal(streaming_result.subject, regular_result.subject)
  })

  # ============================================================
  # BOUNDARY HANDLING
  # ============================================================

  t.test('equivalence_complex_boundary', fn (t) {
    let raw_email = 'From: sender@example.com
To: recipient@example.com
Subject: Complex Boundary
Message-ID: <test@example.com>
MIME-Version: 1.0
Content-Type: multipart/mixed; boundary="----=_NextPart_000_0000_01DA4F9A.ABC12345"

------=_NextPart_000_0000_01DA4F9A.ABC12345
Content-Type: text/plain

Text part
------=_NextPart_000_0000_01DA4F9A.ABC12345
Content-Type: application/octet-stream
Content-Transfer-Encoding: base64

SGVsbG8=
------=_NextPart_000_0000_01DA4F9A.ABC12345--
'

    let streaming_parser = StreamingParser.new
    let mut streaming_handler = EquivalenceTestHandler.new
    let streaming_result = match
      streaming_parser.parse_stream(raw_email, streaming_handler)
    {
      case Ok(r) -> r
      case Error(e) -> {
        t.equal('should parse streaming', 'got error: ' + e)
        return
      }
    }

    let regular_parser = EmailParser.new
    let regular_result = match regular_parser.parse(raw_email) {
      case Ok(r) -> r
      case Error(e) -> {
        t.equal('should parse regular', 'got error: ' + e)
        return
      }
    }

    t.equal(streaming_result.attachment_count, regular_result.attachments.size)
    t.equal(streaming_result.subject, regular_result.subject)
  })

  # ============================================================
  # EXTRA HEADERS
  # ============================================================

  t.test('equivalence_with_custom_headers', fn (t) {
    let raw_email = 'From: sender@example.com
To: recipient@example.com
Subject: Custom Headers
Message-ID: <test@example.com>
MIME-Version: 1.0
Content-Type: text/plain
X-Custom-Header-1: value1
X-Custom-Header-2: value2
X-Priority: High

Body with custom headers.

'

    let streaming_parser = StreamingParser.new
    let mut streaming_handler = EquivalenceTestHandler.new
    let streaming_result = match
      streaming_parser.parse_stream(raw_email, streaming_handler)
    {
      case Ok(r) -> r
      case Error(e) -> {
        t.equal('should parse streaming', 'got error: ' + e)
        return
      }
    }

    let regular_parser = EmailParser.new
    let regular_result = match regular_parser.parse(raw_email) {
      case Ok(r) -> r
      case Error(e) -> {
        t.equal('should parse regular', 'got error: ' + e)
        return
      }
    }

    t.equal(streaming_result.subject, regular_result.subject)
    t.equal(
      streaming_result.extra_headers.size,
      regular_result.extra_headers.size,
    )
  })
}
