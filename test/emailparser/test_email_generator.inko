# Unit tests for the email_generator module

import emailparser (EmailParser)
import emailparser.decoder (decode_qp_bytes)
import emailparser.email_generator (TestAttachment, TestDataGenerator)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('generate_simple_text_email', fn (t) {
    let mut generator = TestDataGenerator.new
    let email = generator.generate_text_email('Test Subject', 'Test Body')

    let parser = EmailParser.new

    match parser.parse(email) {
      case Ok(msg) -> {
        t.equal(msg.subject, 'Test Subject')

        match msg.text_body {
          case Some(body) -> t.equal(body.trim, 'Test Body')
          case None -> t.equal('should have text body', 'got none')
        }
      }
      case Error(e) -> t.equal('should parse', 'got error: ' + e.to_message)
    }
  })

  t.test('generate_email_with_attachment', fn (t) {
    let mut generator = TestDataGenerator.new
    let email = generator.generate_email_with_attachment(
      'test.txt',
      'Hello World',
      'base64',
    )

    let parser = EmailParser.new

    match parser.parse(email) {
      case Ok(msg) -> {
        t.equal(msg.attachments.size, 1)

        match msg.attachments.get(0) {
          case Ok(att) -> {
            t.equal(att.filename, Option.Some('test.txt'))
            t.equal(att.content_type, 'application/octet-stream')
          }
          case Error(_) -> t.equal('should have attachment', 'got error')
        }
      }
      case Error(e) -> t.equal('should parse', 'got error: ' + e.to_message)
    }
  })

  t.test('generate_email_with_multiple_attachments', fn (t) {
    let mut generator = TestDataGenerator.new
    let attachments = [
      TestAttachment(
        name: 'file1.txt',
        content_type: 'text/plain',
        content: 'Content 1',
        encoding: 'base64',
      ),
      TestAttachment(
        name: 'file2.txt',
        content_type: 'text/plain',
        content: 'Content 2',
        encoding: 'quoted-printable',
      ),
    ]
    let email = generator.generate_email_with_attachments(attachments)

    let parser = EmailParser.new

    match parser.parse(email) {
      case Ok(msg) -> t.equal(msg.attachments.size, 2)
      case Error(e) -> t.equal('should parse', 'got error: ' + e.to_message)
    }
  })

  t.test('generate_large_attachment', fn (t) {
    let mut generator = TestDataGenerator.new
    let attachment = generator.generate_large_attachment(1000, 'PATTERN')

    t.equal(attachment.size, 1000)
  })

  t.test('generate_large_attachment_empty_pattern', fn (t) {
    let mut generator = TestDataGenerator.new

    t.equal(generator.generate_large_attachment(1000, '').size, 0)
    t.equal(generator.generate_large_attachment(0, 'PATTERN').size, 0)
  })

  t.test('generate_nested_multipart_email', fn (t) {
    let mut generator = TestDataGenerator.new
    let email = generator.generate_nested_multipart_email(2, 1, 100)

    let parser = EmailParser.new

    match parser.parse(email) {
      case Ok(msg) -> {
        t.equal(msg.mime.content_type, 'multipart/mixed')
        t.true(msg.attachments.size >= 1)
      }
      case Error(e) -> t.equal('should parse', 'got error: ' + e.to_message)
    }
  })

  t.test('encode_bytes_base64', fn (t) {
    let encoded = TestDataGenerator.encode_bytes('Hello World', 'base64')

    t.true(encoded.contains?('SGVsbG8gV29ybGQ'))
  })

  t.test('encode_bytes_quoted_printable', fn (t) {
    let encoded = TestDataGenerator.encode_bytes(
      'Hello World',
      'quoted-printable',
    )

    t.equal(encoded, 'Hello World')
  })

  t.test('generate_boundary_unique', fn (t) {
    let mut generator = TestDataGenerator.new

    let boundary1 = generator.generate_boundary
    let boundary2 = generator.generate_boundary
    let boundary3 = generator.generate_boundary

    t.true(boundary1 != boundary2)
    t.true(boundary2 != boundary3)
    t.true(boundary1 != boundary3)
  })

  t.test('generate_id_increments', fn (t) {
    let mut generator = TestDataGenerator.new

    let id1 = generator.generate_id
    let id2 = generator.generate_id
    let id3 = generator.generate_id

    t.true(id1 < id2)
    t.true(id2 < id3)
  })

  t.test('generated_subject_cannot_inject_headers', fn (t) {
    let mut generator = TestDataGenerator.new
    let email = generator.generate_text_email('hi\nX-Injected: yes', 'body')

    # The newline is neutralised, so no extra header is created
    t.false(email.contains?('\nX-Injected'))

    let parser = EmailParser.new
    let result = match parser.parse(email) {
      case Ok(m) -> m
      case Error(e) -> {
        t.equal('should parse', e.to_message)
        return
      }
    }

    t.equal(result.subject, 'hi X-Injected: yes')

    for (key, _) in result.extra_headers.iter {
      t.false(key.to_lower == 'x-injected')
    }
  })

  t.test('generated_encoding_cannot_inject_headers', fn (t) {
    let mut generator = TestDataGenerator.new
    let email = generator.generate_email_with_attachment(
      'f.txt',
      'data',
      '7bit\r\nX-Injected: yes',
    )

    t.false(email.contains?('X-Injected'))
    t.true(email.contains?('Content-Transfer-Encoding: 7bit'))
  })

  t.test('generated_content_type_cannot_inject_headers', fn (t) {
    let mut generator = TestDataGenerator.new
    let attachments = [
      TestAttachment(
        name: 'f.txt',
        content_type: 'text/plain\r\nX-Injected: yes',
        content: 'data',
        encoding: 'base64',
      ),
    ]
    let email = generator.generate_email_with_attachments(attachments)

    t.false(email.contains?('\nX-Injected'))
  })

  t.test('generated_attachment_name_is_escaped', fn (t) {
    let mut generator = TestDataGenerator.new
    let email = generator.generate_email_with_attachment(
      'a"b.pdf',
      'content',
      'base64',
    )

    # The quote is backslash-escaped inside the quoted parameter
    t.true(email.contains?('filename="a\\"b.pdf"'))
    t.false(email.contains?('filename="a"b.pdf"'))
  })

  t.test('generated_quoted_printable_encodes_trailing_whitespace', fn (t) {
    let encoded = TestDataGenerator.encode_bytes(
      'abc   \nx',
      'quoted-printable',
    )

    t.true(encoded.contains?('abc=20=20=20\nx'))
  })

  t.test('generated_quoted_printable_keeps_lines_short', fn (t) {
    let mut content = ''

    while content.size < 300 { content = content + 'abcdefghij' }

    let encoded = TestDataGenerator.encode_bytes(content, 'quoted-printable')

    t.true(encoded.contains?('=\n'))

    for line in encoded.split('\n').into_iter { t.true(line.size <= 76) }
  })

  t.test('generated_quoted_printable_round_trips', fn (t) {
    let content = 'trailing   \n=equals\ndata \t\n'
    let encoded = TestDataGenerator.encode_bytes(content, 'quoted-printable')
    let decoded = decode_qp_bytes(encoded, false, true).into_string

    t.equal(decoded, content)
  })

  t.test('generated_base64_is_wrapped_at_76_columns', fn (t) {
    let mut generator = TestDataGenerator.new
    let mut content = ''

    while content.size < 400 { content = content + 'abcdefghij' }

    let email = generator.generate_email_with_attachment(
      'big.bin',
      content,
      'base64',
    )

    let lines = email.split('\n').into_iter.to_array

    for line in lines.iter { t.true(line.size <= 76) }
  })

  t.test('generated_fixture_can_use_crlf', fn (t) {
    let mut generator = TestDataGenerator.new
    let email = TestDataGenerator.to_crlf(
      generator.generate_text_email('CRLF', 'body'),
    )

    t.true(email.contains?('\r\n'))
    t.false(email.contains?('\n\n'))

    let parser = EmailParser.new

    match parser.parse(email) {
      case Ok(m) -> t.equal(m.subject, 'CRLF')
      case Error(e) -> t.equal('should parse', e.to_message)
    }
  })
}
