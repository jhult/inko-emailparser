# Tests for header parsing module
#
# Tests is_valid_field_name, sanitize_filename, extract_extra_headers,
# and header parsing behavior through the EmailParser API.

import emailparser (EmailParser)
import emailparser.header (
  extract_extra_headers, extract_filename_param, find_header_separator_bytes,
  get_header_value_impl, is_valid_field_name, parse_content_type_impl,
  sanitize_filename,
)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('parse_headers_strict_accepts_non_ascii_crlf', fn (t) {
    let parser = EmailParser.new.with_strict_mode(true)
    let result = parser.parse_headers('Subject: Héllo\r\nFrom: a@b.com\r\n')

    match result {
      case Ok(headers) -> {
        t.equal(headers.size, 2)

        match headers.get(0) {
          case Ok((_, value)) -> t.equal(value, 'Héllo')
          case Error(_) -> t.equal('should have header', 'got none')
        }
      }
      case Error(e) -> t.equal('should parse', 'got error: ' + e.to_message)
    }
  })

  # ============================================================
  # is_valid_field_name tests
  # ============================================================

  t.test('valid_field_name_simple', fn (t) {
    t.true(is_valid_field_name('From'))
    t.true(is_valid_field_name('To'))
    t.true(is_valid_field_name('Subject'))
    t.true(is_valid_field_name('X-Custom-Header'))
  })

  t.test('valid_field_name_all_printable_ascii', fn (t) {
    # RFC 5322: ftext = %d33-57 / %d59-126 (printable ASCII except colon)
    t.true(is_valid_field_name('!'))
    t.true(is_valid_field_name('~'))
    t.true(is_valid_field_name('A-Z'))
    t.true(is_valid_field_name('Content-Type'))
  })

  t.test('invalid_field_name_empty', fn (t) { t.false(is_valid_field_name('')) })

  t.test('invalid_field_name_contains_colon', fn (t) {
    t.false(is_valid_field_name('Field:Name'))
    t.false(is_valid_field_name(':'))
  })

  t.test('invalid_field_name_contains_space', fn (t) {
    t.false(is_valid_field_name('Field Name'))
    t.false(is_valid_field_name(' Leading'))
    t.false(is_valid_field_name('Trailing '))
  })

  t.test('invalid_field_name_control_chars', fn (t) {
    # Control characters (< 33) are invalid
    t.false(is_valid_field_name('\t'))
    t.false(is_valid_field_name('\n'))
    t.false(is_valid_field_name('\r'))
  })

  # ============================================================
  # sanitize_filename tests
  # ============================================================

  t.test('sanitize_filename_valid', fn (t) {
    t.equal(sanitize_filename('document.pdf'), Option.Some('document.pdf'))
    t.equal(sanitize_filename('file'), Option.Some('file'))
    t.equal(sanitize_filename('my-file_v2'), Option.Some('my-file_v2'))
  })

  t.test('sanitize_filename_strips_bidi_controls', fn (t) {
    t.equal(
      sanitize_filename('r\u{E9}sum\u{E9}\u{202E}fdp.exe'),
      Option.Some('r\u{E9}sum\u{E9}fdp.exe'),
    )
    t.equal(
      sanitize_filename('a\u{200F}b\u{FEFF}c.txt'),
      Option.Some('abc.txt'),
    )
  })

  t.test('sanitize_filename_empty', fn (t) {
    t.equal(sanitize_filename(''), Option.None)
  })

  t.test('sanitize_filename_path_traversal', fn (t) {
    t.equal(sanitize_filename('../etc/passwd'), Option.Some('passwd'))
    t.equal(sanitize_filename('..'), Option.None)
    t.equal(sanitize_filename('foo/../bar'), Option.Some('bar'))
    t.equal(
      sanitize_filename('../../.ssh/authorized_keys'),
      Option.Some('authorized_keys'),
    )
  })

  t.test('sanitize_filename_path_separators', fn (t) {
    t.equal(sanitize_filename('/etc/passwd'), Option.Some('passwd'))
    t.equal(sanitize_filename('C:\\Windows\\system32'), Option.Some('system32'))
    t.equal(sanitize_filename('dir/file'), Option.Some('file'))
  })

  t.test('sanitize_filename_dots_inside_name', fn (t) {
    t.equal(sanitize_filename('report..pdf'), Option.Some('report..pdf'))
  })

  t.test('extract_filename_param_plain', fn (t) {
    t.equal(
      extract_filename_param('attachment; filename="report.pdf"'),
      Option.Some('report.pdf'),
    )
  })

  t.test('extract_filename_param_quoted_non_ascii', fn (t) {
    # Byte offsets and character offsets must not be mixed when unquoting
    t.equal(
      extract_filename_param('attachment; filename="résumé.pdf"'),
      Option.Some('résumé.pdf'),
    )
  })

  t.test(
    'extract_filename_param_quoted_non_ascii_with_trailing_param',
    fn (t) {
      t.equal(
        extract_filename_param('attachment; filename="résumé.pdf"; size=1'),
        Option.Some('résumé.pdf'),
      )
    },
  )

  t.test('content_type_quoted_non_ascii_boundary', fn (t) {
    match
      parse_content_type_impl('multipart/mixed; boundary="ersönlich"', true)
    {
      case Ok((main_type, params)) -> {
        t.equal(main_type, 'multipart/mixed')
        t.equal(params.size, 1)

        match params.get(0) {
          case Ok((key, value)) -> {
            t.equal(key, 'boundary')
            t.equal(value, 'ersönlich')
          }
          case Error(_) -> t.true(false)
        }
      }
      case Error(e) -> t.equal('should parse', e.to_message)
    }
  })

  t.test('extract_filename_param_rfc2231_utf8', fn (t) {
    t.equal(
      extract_filename_param(
        "attachment; filename*=UTF-8''%E2%82%AC%20rates.pdf",
      ),
      Option.Some('€ rates.pdf'),
    )
  })

  t.test('extract_filename_param_rfc2231_latin1', fn (t) {
    t.equal(
      extract_filename_param("attachment; filename*=ISO-8859-1''Caf%E9.txt"),
      Option.Some('Café.txt'),
    )
  })

  t.test('extract_filename_param_invalid_extended_falls_back', fn (t) {
    t.equal(
      extract_filename_param(
        "attachment; filename*=bogus-charset''%ff; filename=\"real.txt\"",
      ),
      Option.Some('real.txt'),
    )
  })

  t.test('extract_filename_param_rfc2231_continuation', fn (t) {
    t.equal(
      extract_filename_param(
        "attachment; filename*0*=UTF-8''Hello%20; filename*1*=World.txt",
      ),
      Option.Some('Hello World.txt'),
    )
  })

  t.test('extract_filename_param_rfc2231_split_utf8', fn (t) {
    # The UTF-8 sequence for "€" is split across two segments and must be
    # decoded after the segments are concatenated.
    t.equal(
      extract_filename_param(
        "attachment; filename*0*=utf-8''%E2%82; filename*1*=%AC.txt",
      ),
      Option.Some('€.txt'),
    )
  })

  t.test('extract_filename_param_rfc2231_more_than_twenty_segments', fn (t) {
    let mut disposition = 'attachment'
    let mut expected = ''
    let mut i = 0

    while i < 25 {
      disposition = disposition + '; filename*${i}*=x'
      expected = expected + 'x'
      i = i + 1
    }

    t.equal(extract_filename_param(disposition), Option.Some(expected))
  })

  t.test('sanitize_filename_windows_reserved', fn (t) {
    t.equal(sanitize_filename('CON'), Option.None)
    t.equal(sanitize_filename('PRN'), Option.None)
    t.equal(sanitize_filename('AUX'), Option.None)
    t.equal(sanitize_filename('NUL'), Option.None)
    t.equal(sanitize_filename('COM1'), Option.None)
    t.equal(sanitize_filename('LPT1'), Option.None)
    # Case-insensitive
    t.equal(sanitize_filename('con'), Option.None)
    t.equal(sanitize_filename('Con'), Option.None)
    # Reserved name with extension
    t.equal(sanitize_filename('CON.txt'), Option.None)
  })

  t.test('sanitize_filename_windows_special_chars', fn (t) {
    t.equal(sanitize_filename('file<name'), Option.Some('file_name'))
    t.equal(sanitize_filename('file>name'), Option.Some('file_name'))
    t.equal(sanitize_filename('file:name'), Option.Some('file_name'))
    t.equal(sanitize_filename('file"name'), Option.Some('file_name'))
    t.equal(sanitize_filename('file|name'), Option.Some('file_name'))
    t.equal(sanitize_filename('file?name'), Option.Some('file_name'))
    t.equal(sanitize_filename('file*name'), Option.Some('file_name'))
  })

  t.test('sanitize_filename_control_chars', fn (t) {
    t.equal(sanitize_filename('file\u{1}name'), Option.Some('filename'))
    t.equal(sanitize_filename('file\u{7F}name'), Option.Some('filename'))
  })

  t.test('sanitize_filename_leading_trailing_dots', fn (t) {
    t.equal(sanitize_filename('.hidden'), Option.None)
    t.equal(sanitize_filename('file.'), Option.None)
    t.equal(sanitize_filename('.'), Option.None)
  })

  t.test('sanitize_filename_too_long', fn (t) {
    let mut long_name = ''
    let mut i = 0

    while i < 256 {
      long_name = long_name + 'a'
      i = i + 1
    }

    t.equal(sanitize_filename(long_name), Option.None)
  })

  t.test('sanitize_filename_max_length_ok', fn (t) {
    let mut name = ''
    let mut i = 0

    while i < 255 {
      name = name + 'a'
      i = i + 1
    }

    t.true(sanitize_filename(name).some?)
  })

  # ============================================================
  # extract_extra_headers tests
  # ============================================================

  t.test('extract_extra_headers_with_custom', fn (t) {
    let headers = [
      ('From', 'test@example.com'),
      ('To', 'user@example.com'),
      ('X-Custom', 'value1'),
      ('Subject', 'Test'),
      ('X-Mailer', 'TestMailer'),
    ]

    let extra = extract_extra_headers(headers)

    t.equal(extra.size, 2)

    match extra.get(0) {
      case Ok(pair) -> {
        t.equal(pair.0, 'X-Custom')
        t.equal(pair.1, 'value1')
      }
      case Error(_) -> t.true(false)
    }

    match extra.get(1) {
      case Ok(pair) -> {
        t.equal(pair.0, 'X-Mailer')
        t.equal(pair.1, 'TestMailer')
      }
      case Error(_) -> t.true(false)
    }
  })

  t.test('extract_extra_headers_none_custom', fn (t) {
    let headers = [
      ('From', 'test@example.com'),
      ('To', 'user@example.com'),
      ('Subject', 'Test'),
    ]

    let extra = extract_extra_headers(headers)

    t.equal(extra.size, 0)
  })

  t.test('extract_extra_headers_empty', fn (t) {
    let headers: Array[(String, String)] = []
    let extra = extract_extra_headers(headers)

    t.equal(extra.size, 0)
  })

  # ============================================================
  # Header parsing via EmailParser API
  # ============================================================

  t.test('parse_headers_basic', fn (t) {
    let parser = EmailParser.new
    let raw = 'From: test@example.com\nTo: user@example.com\nSubject: Test\n\n'
    let result = parser.parse_headers(raw)

    match result {
      case Ok(headers) -> t.equal(headers.size, 3)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_headers_folded_between_params', fn (t) {
    # Folding BETWEEN parameters (after semicolon) should be OK
    let parser = EmailParser.new
    let raw = 'Content-Type: multipart/mixed; charset=utf-8;\n boundary=abc123\n\n'
    let result = parser.parse_headers(raw)

    match result {
      case Ok(headers) -> t.equal(headers.size, 1)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_headers_folding_inside_single_param', fn (t) {
    # RFC 5322 FWS is valid inside a parameter value; unfolding keeps a space
    let parser = EmailParser.new
    let raw = 'Content-Type: multipart/mixed; boundary=abc\n 123\n\n'
    let result = parser.parse_headers(raw)

    match result {
      case Ok(headers) -> t.equal(headers.size, 1)
      case Error(e) -> panic('parse_headers failed: ${e.to_message}')
    }
  })

  t.test('parse_headers_unfolding_preserves_continuation_whitespace', fn (t) {
    # RFC 5322 unfolding removes only the line break; significant whitespace in
    # a folded parameter value must survive.
    let parser = EmailParser.new
    let raw = 'Content-Type: multipart/mixed; boundary=abc\n   123\n\n'
    let result = parser.parse_headers(raw)

    match result {
      case Ok(headers) -> {
        match get_header_value_impl(ref headers, 'Content-Type') {
          case Some(value) -> {
            t.equal(value, 'multipart/mixed; boundary=abc   123')
          }
          case None -> t.equal('expected a Content-Type header', 'got none')
        }
      }
      case Error(e) -> panic('parse_headers failed: ${e.to_message}')
    }
  })

  t.test('parse_headers_folding_inside_last_param', fn (t) {
    # Folding in the last parameter value is valid too
    let parser = EmailParser.new
    let raw = 'Content-Type: multipart/mixed; charset=utf-8; boundary=abc\n 123\n\n'
    let result = parser.parse_headers(raw)

    match result {
      case Ok(headers) -> t.equal(headers.size, 1)
      case Error(e) -> panic('parse_headers failed: ${e.to_message}')
    }
  })

  t.test('parse_headers_max_count_strict', fn (t) {
    let parser = EmailParser.new.with_strict_mode(true).with_max_headers(2)

    # 4 headers exceeds limit of 2 (error triggers when 3rd header
    # sees size 2 already in array)
    let raw = 'From: a@b.com\nTo: c@d.com\nSubject: X\nDate: Mon, 01 Jan 2026 00:00:00 +0000\n\n'

    match parser.parse_headers(raw) {
      case Ok(_) -> t.true(false)
      case Error(e) -> {
        t.true(e.to_message.contains?('Maximum number of headers exceeded'))
      }
    }
  })

  t.test('parse_headers_empty_field_name_rejected', fn (t) {
    let parser = EmailParser.new
    # Header line starting with colon has empty field name
    let raw = ': value\n\n'

    match parser.parse_headers(raw) {
      case Ok(_) -> t.true(false)
      case Error(e) -> {
        t.true(e.to_message.contains?('Invalid header field name'))
      }
    }
  })

  t.test('parse_headers_no_colon_rejected', fn (t) {
    let parser = EmailParser.new
    let raw = 'This line has no colon\n\n'

    match parser.parse_headers(raw) {
      case Ok(_) -> t.true(false)
      case Error(e) -> t.true(e.to_message.contains?('no colon found'))
    }
  })

  t.test('parse_headers_crlf_handling', fn (t) {
    let parser = EmailParser.new
    let raw = 'From: test@example.com\r\nTo: user@example.com\r\n\r\n'
    let result = parser.parse_headers(raw)

    match result {
      case Ok(headers) -> t.equal(headers.size, 2)
      case Error(_) -> t.true(false)
    }
  })

  t.test('parse_headers_value_at_max_length_lax', fn (t) {
    let parser = EmailParser.new

    # Create a header value close to 8192 bytes
    let mut long_value = ''
    let mut i = 0

    while i < 8190 {
      long_value = long_value + 'x'
      i = i + 1
    }

    let raw = 'Subject: ' + long_value + '\n\n'
    let result = parser.parse_headers(raw)

    match result {
      case Ok(headers) -> t.equal(headers.size, 1)
      case Error(_) -> t.true(false)
    }
  })

  t.test('duplicate_header_permissive_first_wins', fn (t) {
    let parser = EmailParser.new
    let raw = 'Subject: First\nSubject: Second\n\nBody'

    match parser.parse_headers(raw) {
      case Ok(headers) -> {
        t.equal(headers.size, 2)
        t.equal(get_header_value_impl(ref headers, 'Subject').or(''), 'First')
      }
      case Error(e) -> panic('parse_headers failed: ${e.to_message}')
    }
  })

  t.test('duplicate_header_strict_errors', fn (t) {
    let parser = EmailParser.new.with_strict_mode(true)
    let raw = 'Subject: First\nSubject: Second\n\nBody'

    match parser.parse_headers(raw) {
      case Ok(_) -> t.true(false)
      case Error(e) -> t.true(e.to_message.contains?('Duplicate'))
    }
  })

  t.test('strict_mode_accepts_colons_in_values', fn (t) {
    let parser = EmailParser.new.with_strict_mode(true)
    let raw = 'Subject: Re: meeting\nDate: 2024-01-01T10:00:00Z\nX-Url: https://example.com/offer\n\nBody'

    match parser.parse_headers(raw) {
      case Ok(headers) -> t.equal(headers.size, 3)
      case Error(_) -> t.true(false)
    }
  })

  t.test('permissive_mode_neutralises_bare_cr', fn (t) {
    let parser = EmailParser.new
    let raw = 'Subject: hello\rBcc: victim@example.com\n\nBody'

    match parser.parse(raw) {
      case Ok(msg) -> {
        t.false(msg.subject.contains?('\r'))
        t.true(msg.subject.contains?('hello'))
        t.equal(msg.addresses.bcc.size, 0)
      }
      case Error(e) -> t.equal('should parse', 'got error: ' + e.to_message)
    }
  })

  t.test('strict_mode_rejects_bare_cr', fn (t) {
    let parser = EmailParser.new.with_strict_mode(true)
    let raw = 'Subject: hello\rBcc: victim@example.com\n\nBody'

    match parser.parse_headers(raw) {
      case Ok(_) -> t.false(true)
      case Error(e) -> t.true(e.to_message.contains?('carriage return'))
    }
  })

  t.test('strict_mode_allows_repeatable_headers', fn (t) {
    let parser = EmailParser.new.with_strict_mode(true)
    let raw = 'Received: from a by b\nReceived: from c by d\nComments: one\nComments: two\n\nBody'

    match parser.parse_headers(raw) {
      case Ok(headers) -> t.equal(headers.size, 4)
      case Error(_) -> t.true(false)
    }
  })

  t.test('folded_content_type_parameter_is_accepted', fn (t) {
    let parser = EmailParser.new

    let raw = 'From: sender@example.com\nTo: recipient@example.com\nSubject: Folded\nContent-Type: text/plain; charset=\n utf-8\n\nBody'

    match parser.parse(raw) {
      case Ok(_) -> t.true(true)
      case Error(e) -> panic('Parse failed: ${e.to_message}')
    }
  })

  t.test('oversized_folded_header_keeps_following_headers', fn (t) {
    let parser = EmailParser.new

    let mut continuation = ''

    while continuation.size < 9000 { continuation = continuation + 'x' }

    let raw = 'Subject: start
 '
      + continuation
      + '
From: sender@example.com
To: recipient@example.com

Body'

    match parser.parse_headers(raw) {
      case Ok(headers) -> t.equal(headers.size, 3)
      case Error(e) -> panic('parse_headers failed: ${e.to_message}')
    }
  })

  t.test('find_header_separator_bytes_handles_lf_and_crlf', fn (t) {
    let lf = 'A: b\n\nbody'.to_byte_array

    match find_header_separator_bytes(ref lf, 0) {
      case Some((pos, size)) -> {
        t.equal(pos, 4)
        t.equal(size, 2)
      }
      case None -> t.false(true)
    }

    let crlf = 'A: b\r\n\r\nbody'.to_byte_array

    match find_header_separator_bytes(ref crlf, 0) {
      case Some((pos, size)) -> {
        t.equal(pos, 4)
        t.equal(size, 4)
      }
      case None -> t.false(true)
    }
  })

  t.test('invalid_content_type_falls_back_in_permissive_mode', fn (t) {
    match parse_content_type_impl('not-a-mime-type', false) {
      case Ok((main, params)) -> {
        t.equal(main, 'text/plain')
        t.equal(params.size, 0)
      }
      case Error(_) -> t.equal('expected a fallback', 'got error')
    }

    match parse_content_type_impl('text', true) {
      case Ok(_) -> t.equal('expected an error', 'got ok')
      case Error(_) -> t.true(true)
    }
  })
}
