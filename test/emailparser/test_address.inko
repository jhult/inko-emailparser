# Tests for address parsing functions

import emailparser.address (
  extract_display_name, is_valid_email_format, parse_comma_separated_addresses,
  remove_comments, unquote_string,
)
import std.test (Tests)

fn pub tests(t: mut Tests) {
  t.test('remove_comments_simple', fn (t) {
    let result = remove_comments('John (comment) Doe')

    t.equal(result, 'John  Doe')
  })

  t.test('remove_comments_multiple', fn (t) {
    let result = remove_comments('John (first) (second) Doe')

    t.equal(result, 'John   Doe')
  })

  t.test('remove_comments_nested', fn (t) {
    let result = remove_comments('John (outer (inner)) Doe')

    t.equal(result, 'John  Doe')
  })

  t.test('remove_comments_empty', fn (t) {
    let result = remove_comments('')

    t.equal(result, '')
  })

  t.test('remove_comments_no_comments', fn (t) {
    let result = remove_comments('John Doe')

    t.equal(result, 'John Doe')
  })

  t.test('remove_comments_only_comment', fn (t) {
    let result = remove_comments('(comment)')

    t.equal(result, '')
  })

  t.test('remove_comments_with_quotes', fn (t) {
    let result = remove_comments('John "(quoted)" (comment) Doe')

    t.equal(result, 'John "(quoted)"  Doe')
  })

  t.test('remove_comments_unbalanced', fn (t) {
    let result = remove_comments('John (comment Doe')

    t.equal(result, 'John ')
  })

  t.test('remove_comments_email', fn (t) {
    let result = remove_comments('John (personal) <john@example.com>')

    t.equal(result, 'John  <john@example.com>')
  })

  t.test('remove_comments_paren_in_quotes', fn (t) {
    let result = remove_comments('John "(paren)" Doe')

    t.equal(result, 'John "(paren)" Doe')
  })

  t.test('unquote_string_simple', fn (t) {
    let result = unquote_string('"Hello World"')

    t.equal(result, 'Hello World')
  })

  t.test('unquote_string_empty_quotes', fn (t) {
    let result = unquote_string('""')

    t.equal(result, '')
  })

  t.test('unquote_string_not_quoted', fn (t) {
    let result = unquote_string('Hello')

    t.equal(result, 'Hello')
  })

  t.test('unquote_string_escaped_quote', fn (t) {
    let result = unquote_string('"He said \\"hello\\""')

    t.equal(result, 'He said "hello"')
  })

  t.test('unquote_string_escaped_backslash', fn (t) {
    let result = unquote_string('"path\\\\to\\\\file"')

    t.equal(result, 'path\\to\\file')
  })

  t.test('unquote_string_single_quote', fn (t) {
    let result = unquote_string('"test"')

    t.equal(result, 'test')
  })

  t.test('unquote_string_special_chars', fn (t) {
    let result = unquote_string('"test\\n\\r\\t"')

    t.equal(result, 'testnrt')
  })

  t.test('unquote_string_trailing_backslash', fn (t) {
    let result = unquote_string('"test\\"')

    t.equal(result, 'test\\')
  })

  t.test('unquote_string_escaped_at_end', fn (t) {
    let result = unquote_string('"test\\"')

    t.equal(result, 'test\\')
  })

  t.test('unquote_string_empty_input', fn (t) {
    let result = unquote_string('')

    t.equal(result, '')
  })

  t.test('extract_display_name_with_angle', fn (t) {
    let (name, _) = extract_display_name('John Doe <john@example.com>')

    t.equal(name, Option.Some('John Doe'))
  })

  t.test('extract_display_name_without_angle', fn (t) {
    let (name, _) = extract_display_name('john@example.com')

    t.equal(name, Option.None)
  })

  t.test('extract_display_name_quoted', fn (t) {
    let (name, _) = extract_display_name('"John Doe" <john@example.com>')

    t.equal(name, Option.Some('John Doe'))
  })

  t.test('extract_display_name_empty_name', fn (t) {
    let (name, _) = extract_display_name('<john@example.com>')

    t.equal(name, Option.None)
  })

  t.test('extract_display_name_with_spaces', fn (t) {
    let (name, _) = extract_display_name('  John Doe  <john@example.com>  ')

    t.equal(name, Option.Some('John Doe'))
  })

  t.test('extract_display_name_empty', fn (t) {
    let (name, _) = extract_display_name('')

    t.equal(name, Option.None)
  })

  t.test('extract_display_name_escaped', fn (t) {
    let (name, _) = extract_display_name(
      '"John \\"The Rock\\" Doe" <john@example.com>',
    )

    t.equal(name, Option.Some('John "The Rock" Doe'))
  })

  t.test('extract_display_name_only_name', fn (t) {
    let (name, _) = extract_display_name('John Doe')

    t.equal(name, Option.None)
  })

  t.test('is_valid_email_format_simple', fn (t) {
    t.true(is_valid_email_format('test@example.com'))
  })

  t.test('is_valid_email_format_with_plus', fn (t) {
    t.true(is_valid_email_format('user+tag@example.com'))
  })

  t.test('is_valid_email_format_with_dots', fn (t) {
    t.true(is_valid_email_format('first.last@example.com'))
  })

  t.test('is_valid_email_format_with_underscore', fn (t) {
    t.true(is_valid_email_format('user_name@example.com'))
  })

  t.test('is_valid_email_format_with_hyphen', fn (t) {
    t.true(is_valid_email_format('user-name@example.com'))
  })

  t.test('is_valid_email_format_subdomain', fn (t) {
    t.true(is_valid_email_format('user@mail.example.com'))
  })

  t.test('is_valid_email_format_empty', fn (t) {
    t.false(is_valid_email_format(''))
  })

  t.test('is_valid_email_format_no_at', fn (t) {
    t.false(is_valid_email_format('userexample.com'))
  })

  t.test('is_valid_email_format_no_local', fn (t) {
    t.false(is_valid_email_format('@example.com'))
  })

  t.test('is_valid_email_format_no_domain', fn (t) {
    t.false(is_valid_email_format('user@'))
  })

  t.test('is_valid_email_format_multiple_at', fn (t) {
    t.false(is_valid_email_format('user@name@example.com'))
  })

  t.test('is_valid_email_format_space', fn (t) {
    t.false(is_valid_email_format('user @example.com'))
  })

  t.test('is_valid_email_format_special_char', fn (t) {
    t.true(is_valid_email_format('user!name@example.com'))
  })

  t.test('is_valid_email_format_domain_starts_dot', fn (t) {
    t.false(is_valid_email_format('user@.example.com'))
  })

  t.test('is_valid_email_format_domain_ends_dot', fn (t) {
    t.false(is_valid_email_format('user@example.com.'))
  })

  t.test('is_valid_email_format_domain_starts_hyphen', fn (t) {
    t.false(is_valid_email_format('user@-example.com'))
  })

  t.test('is_valid_email_format_domain_ends_hyphen', fn (t) {
    t.false(is_valid_email_format('user@example.com-'))
  })

  t.test('is_valid_email_format_invalid_domain_char', fn (t) {
    t.false(is_valid_email_format('user@ex!ample.com'))
  })

  t.test('is_valid_email_format_numeric', fn (t) {
    t.true(is_valid_email_format('123@example.com'))
  })

  t.test('is_valid_email_format_all_numeric_local', fn (t) {
    t.true(is_valid_email_format('123456@example.com'))
  })

  t.test('is_valid_email_format_single_char', fn (t) {
    t.true(is_valid_email_format('a@b.c'))
  })

  t.test('parse_comma_separated_simple', fn (t) {
    let addrs = parse_comma_separated_addresses(
      'user1@example.com, user2@example.com',
    )

    t.equal(addrs.size, 2)
  })

  t.test('parse_comma_separated_with_names', fn (t) {
    let addrs = parse_comma_separated_addresses(
      'John <john@example.com>, Jane <jane@example.com>',
    )

    t.equal(addrs.size, 2)
  })

  t.test('parse_comma_separated_quoted', fn (t) {
    let addrs = parse_comma_separated_addresses(
      '"John Doe" <john@example.com>, "Jane Smith" <jane@example.com>',
    )

    t.equal(addrs.size, 2)
  })

  t.test('parse_comma_separated_single', fn (t) {
    let addrs = parse_comma_separated_addresses('user@example.com')

    t.equal(addrs.size, 1)
  })

  t.test('parse_comma_separated_empty', fn (t) {
    let addrs = parse_comma_separated_addresses('')

    t.equal(addrs.size, 0)
  })

  t.test('parse_comma_separated_whitespace', fn (t) {
    let addrs = parse_comma_separated_addresses(
      'user1@example.com, user2@example.com, user3@example.com',
    )

    t.equal(addrs.size, 3)
  })

  t.test('parse_comma_separated_with_comments', fn (t) {
    let addrs = parse_comma_separated_addresses(
      'John (work) <john@example.com>, Jane (home) <jane@example.com>',
    )

    t.equal(addrs.size, 2)
  })

  t.test('parse_comma_separated_comma_in_quotes', fn (t) {
    let addrs = parse_comma_separated_addresses(
      '"Doe, John" <john@example.com>',
    )

    t.equal(addrs.size, 1)
  })

  t.test('parse_comma_separated_group', fn (t) {
    let addrs = parse_comma_separated_addresses(
      'team: alice@example.com, bob@example.com;',
    )

    t.equal(addrs.size, 0)
  })

  t.test('parse_comma_separated_mixed', fn (t) {
    let addrs = parse_comma_separated_addresses(
      'simple@example.com, Named <named@example.com>, "Quoted" <quoted@example.com>',
    )

    t.equal(addrs.size, 3)
  })

  t.test('parse_comma_separated_trailing_comma', fn (t) {
    let addrs = parse_comma_separated_addresses(
      'user1@example.com, user2@example.com,',
    )

    t.equal(addrs.size, 2)
  })

  t.test('parse_comma_separated_leading_comma', fn (t) {
    let addrs = parse_comma_separated_addresses(
      ', user1@example.com, user2@example.com',
    )

    t.equal(addrs.size, 2)
  })

  t.test('parse_comma_separated_multiple_commas', fn (t) {
    let addrs = parse_comma_separated_addresses(
      'user1@example.com,, user2@example.com',
    )

    t.equal(addrs.size, 2)
  })

  t.test('parse_comma_separated_no_separator', fn (t) {
    let addrs = parse_comma_separated_addresses('user@example.com')

    t.equal(addrs.size, 1)
  })

  t.test('parse_comma_separated_with_parens', fn (t) {
    let addrs = parse_comma_separated_addresses(
      'user@example.com (comment), user2@example.com (another)',
    )

    t.equal(addrs.size, 2)
  })

  t.test('parse_comma_separated_complex_quotes', fn (t) {
    let addrs = parse_comma_separated_addresses(
      '"Last, First" <first@example.com>, "Smith, Jane" <jane@example.com>',
    )

    t.equal(addrs.size, 2)
  })
}
