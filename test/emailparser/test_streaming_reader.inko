# Tests for streaming reader (AsyncReader trait and ByteArrayReader)

import emailparser.error (Error)
import emailparser.streaming (
  AttachmentInfo, StreamHandler, StreamingConfig, StreamingParser,
)
import emailparser.streaming_reader (ByteArrayReader)
import std.option (Option)
import std.result (Result)
import std.test (Tests)

# Handler that records delivered text
type pub CollectingHandler {
  let pub mut @text: String
  let pub mut @headers_received: Bool
  let pub mut @ended: Bool
  let pub mut @attachment_count: Int
  let pub mut @attachment_data: ByteArray
  let pub mut @attachment_started: Bool
  let pub mut @attachment_filename: Option[String]
  let pub mut @attachment_ended: Bool
  let pub mut @errors_received: Int
}

impl CollectingHandler {
  fn pub static new -> CollectingHandler {
    CollectingHandler(
      text: '',
      headers_received: false,
      ended: false,
      attachment_count: 0,
      attachment_data: recover ByteArray.new,
      attachment_started: false,
      attachment_filename: Option.None,
      attachment_ended: false,
      errors_received: 0,
    )
  }
}

impl StreamHandler for CollectingHandler {
  fn pub mut on_begin -> Result[Int, String] {
    Result.Ok(0)
  }

  fn pub mut on_headers(
    headers: ref Array[(String, String)],
  ) -> Result[Int, String] {
    @headers_received = headers.size > 0
    Result.Ok(0)
  }

  fn pub mut on_text_chunk(chunk: String) -> Result[Int, String] {
    @text = @text + chunk
    Result.Ok(0)
  }

  fn pub mut on_html_chunk(chunk: String) -> Result[Int, String] {
    Result.Ok(0)
  }

  fn pub mut on_attachment_begin(
    info: ref AttachmentInfo,
  ) -> Result[Int, String] {
    @attachment_count = @attachment_count + 1
    @attachment_started = true
    @attachment_filename = info.filename.clone
    Result.Ok(0)
  }

  fn pub mut on_attachment_chunk(
    chunk: ByteArray,
    info: ref AttachmentInfo,
  ) -> Result[Int, String] {
    @attachment_data.append(chunk)

    Result.Ok(0)
  }

  fn pub mut on_attachment_end(info: ref AttachmentInfo) -> Result[Int, String]
  {
    @attachment_ended = true
    Result.Ok(0)
  }

  fn pub mut on_end -> Result[Int, String] {
    @ended = true
    Result.Ok(0)
  }

  fn pub mut on_error(error: ref Error) -> Result[Int, String] {
    @errors_received = @errors_received + 1
    Result.Ok(0)
  }
}

fn pub tests(t: mut Tests) {
  t.test('byte_array_reader_new', fn (t) {
    let data = 'Hello World'.to_byte_array
    let reader = ByteArrayReader.new(data)

    t.equal(reader.position, 0)
    t.equal(reader.size, 11)
    t.false(reader.eof?)
  })

  t.test('byte_array_reader_from_string', fn (t) {
    let reader = ByteArrayReader.from_string('Hello')

    t.equal(reader.position, 0)
    t.equal(reader.size, 5)
    t.false(reader.eof?)
  })

  t.test('byte_array_reader_read_partial', fn (t) {
    let mut reader = ByteArrayReader.from_string('Hello World')

    match reader.read(5) {
      case Ok(chunk) -> {
        t.equal(chunk.size, 5)
        t.equal(chunk.into_string, 'Hello')
        t.equal(reader.position, 5)
      }
      case Error(e) -> panic('Failed: ${e}')
    }
  })

  t.test('byte_array_reader_read_full', fn (t) {
    let mut reader = ByteArrayReader.from_string('Hello')

    match reader.read(10) {
      case Ok(chunk) -> {
        t.equal(chunk.size, 5)
        t.equal(chunk.into_string, 'Hello')
        t.equal(reader.position, 5)
      }
      case Error(e) -> panic('Failed: ${e}')
    }
  })

  t.test('byte_array_reader_read_multiple', fn (t) {
    let mut reader = ByteArrayReader.from_string('Hello World')

    match reader.read(5) {
      case Ok(chunk) -> t.equal(chunk.into_string, 'Hello')
      case Error(e) -> panic('Failed: ${e}')
    }

    match reader.read(6) {
      case Ok(chunk) -> t.equal(chunk.into_string, ' World')
      case Error(e) -> panic('Failed: ${e}')
    }

    t.equal(reader.position, 11)
  })

  t.test('byte_array_reader_eof', fn (t) {
    let mut reader = ByteArrayReader.from_string('Hi')

    match reader.read(10) {
      case Ok(chunk) -> t.equal(chunk.into_string, 'Hi')
      case Error(e) -> panic('Failed: ${e}')
    }

    t.true(reader.eof?)

    match reader.read(10) {
      case Ok(chunk) -> t.equal(chunk.size, 0)
      case Error(e) -> panic('Failed: ${e}')
    }
  })

  t.test('byte_array_reader_empty_data', fn (t) {
    let mut reader = ByteArrayReader.new(ByteArray.new)

    t.equal(reader.size, 0)
    t.true(reader.eof?)

    match reader.read(10) {
      case Ok(chunk) -> t.equal(chunk.size, 0)
      case Error(e) -> panic('Failed: ${e}')
    }
  })

  t.test('byte_array_reader_zero_size_read', fn (t) {
    let mut reader = ByteArrayReader.from_string('Hello')

    match reader.read(0) {
      case Ok(chunk) -> {
        t.equal(chunk.size, 0)
        t.equal(reader.position, 0)
      }
      case Error(e) -> panic('Failed: ${e}')
    }
  })

  t.test('byte_array_reader_single_byte_reads', fn (t) {
    let mut reader = ByteArrayReader.from_string('ABC')

    match reader.read(1) {
      case Ok(chunk) -> t.equal(chunk.into_string, 'A')
      case Error(e) -> panic('Failed: ${e}')
    }

    match reader.read(1) {
      case Ok(chunk) -> t.equal(chunk.into_string, 'B')
      case Error(e) -> panic('Failed: ${e}')
    }

    match reader.read(1) {
      case Ok(chunk) -> t.equal(chunk.into_string, 'C')
      case Error(e) -> panic('Failed: ${e}')
    }

    t.true(reader.eof?)
  })

  t.test('byte_array_reader_binary_data', fn (t) {
    let mut data = ByteArray.new

    data.push(0)
    data.push(255)
    data.push(128)
    data.push(1)

    let mut reader = ByteArrayReader.new(data)

    match reader.read(4) {
      case Ok(chunk) -> {
        t.equal(chunk.size, 4)

        match chunk.get(0) {
          case Ok(b) -> t.equal(b, 0)
          case Error(_) -> panic('Failed')
        }

        match chunk.get(1) {
          case Ok(b) -> t.equal(b, 255)
          case Error(_) -> panic('Failed')
        }

        match chunk.get(2) {
          case Ok(b) -> t.equal(b, 128)
          case Error(_) -> panic('Failed')
        }

        match chunk.get(3) {
          case Ok(b) -> t.equal(b, 1)
          case Error(_) -> panic('Failed')
        }
      }
      case Error(e) -> panic('Failed: ${e}')
    }
  })

  t.test('parse_async_reader_lf_headers', fn (t) {
    let mut parser = StreamingParser.new
    let mut handler = CollectingHandler.new
    let raw = 'From: a@example.com\nTo: b@example.com\nSubject: LF test\nContent-Type: text/plain\n\nHello LF body'
    let mut reader = ByteArrayReader.from_string(raw)

    match parser.parse_async_reader(mut reader, mut handler) {
      case Ok(result) -> {
        t.equal(result.subject, 'LF test')
        t.true(handler.headers_received)
        t.true(handler.text.contains?('Hello LF body'))
      }
      case Error(e) -> panic('parse_async_reader failed: ${e.to_message}')
    }
  })

  t.test('parse_async_reader_crlf_headers', fn (t) {
    let mut parser = StreamingParser.new
    let mut handler = CollectingHandler.new
    let raw = 'From: a@example.com\r\nTo: b@example.com\r\nSubject: CRLF test\r\nContent-Type: text/plain\r\n\r\nHello CRLF body'
    let mut reader = ByteArrayReader.from_string(raw)

    match parser.parse_async_reader(mut reader, mut handler) {
      case Ok(result) -> {
        t.equal(result.subject, 'CRLF test')
        t.true(handler.headers_received)
        t.true(handler.text.contains?('Hello CRLF body'))
      }
      case Error(e) -> panic('parse_async_reader failed: ${e.to_message}')
    }
  })

  t.test('parse_async_reader_single_binary_body', fn (t) {
    let mut parser = StreamingParser.new
    let mut handler = CollectingHandler.new
    let raw = 'From: a@example.com
To: b@example.com
Subject: Binary
Content-Type: application/pdf
Content-Disposition: attachment; filename="doc.pdf"
Content-Transfer-Encoding: base64

JVBERi0='

    let mut reader = ByteArrayReader.from_string(raw)

    match parser.parse_async_reader(mut reader, mut handler) {
      case Ok(result) -> {
        t.equal(result.attachment_count, 1)
        t.equal(handler.attachment_count, 1)
        t.true(handler.attachment_started)
        t.true(handler.attachment_ended)
        t.equal(handler.attachment_data.clone.into_string, '%PDF-')
      }
      case Error(e) -> panic('parse_async_reader failed: ${e.to_message}')
    }
  })

  t.test('single_part_stream_attachment_filename_is_sanitized', fn (t) {
    let mut parser = StreamingParser.new
    let mut handler = CollectingHandler.new
    let raw = 'From: a@example.com
To: b@example.com
Subject: Traversal
Content-Type: application/octet-stream
Content-Disposition: attachment; filename="../../etc/passwd"

data'
    let mut reader = ByteArrayReader.from_string(raw)

    match parser.parse_async_reader(mut reader, mut handler) {
      case Ok(_) -> t.equal(handler.attachment_filename, Option.Some('passwd'))
      case Error(e) -> panic('parse_async_reader failed: ${e.to_message}')
    }
  })

  t.test('parse_async_reader_eof_without_separator_keeps_headers', fn (t) {
    let mut parser = StreamingParser.new
    let mut handler = CollectingHandler.new
    # Truncated stream: no blank line separating headers from the body
    let raw = 'From: a@example.com\nTo: b@example.com\nSubject: Truncated'
    let mut reader = ByteArrayReader.from_string(raw)

    match parser.parse_async_reader(mut reader, mut handler) {
      case Ok(result) -> {
        t.equal(result.subject, 'Truncated')
        t.true(handler.headers_received)
        t.true(handler.ended)
      }
      case Error(e) -> panic('parse_async_reader failed: ${e.to_message}')
    }
  })

  t.test('parse_async_reader_reports_boundary_error_to_handler', fn (t) {
    let mut parser = StreamingParser.new
    let mut handler = CollectingHandler.new
    let mut invalid_boundary = ''

    while invalid_boundary.size < 100 {
      invalid_boundary = invalid_boundary + 'a'
    }

    let raw = 'From: a@example.com\nTo: b@example.com\nSubject: x\nContent-Type: multipart/mixed; boundary="${invalid_boundary}"\n\n--${invalid_boundary}\n\nbody'
    let mut reader = ByteArrayReader.from_string(raw)

    match parser.parse_async_reader(mut reader, mut handler) {
      case Ok(_) -> t.false(true)
      case Error(_) -> t.equal(handler.errors_received, 1)
    }
  })

  t.test('parse_async_reader_header_section_limit', fn (t) {
    let mut parser = StreamingParser.new
    let mut handler = CollectingHandler.new

    # No blank line, so the parser keeps buffering headers past the 64 KiB cap
    let mut raw = 'From: a@example.com\nX-Fill: '

    while raw.size < 70_000 { raw = raw + 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' }

    let mut reader = ByteArrayReader.from_string(raw)

    match parser.parse_async_reader(mut reader, mut handler) {
      case Ok(_) -> t.false(true)
      case Error(e) -> {
        t.equal(e.variant, 'HeaderSectionTooLarge')
        t.equal(handler.errors_received, 1)
      }
    }
  })

  t.test('parse_async_reader_rejects_zero_chunk_size', fn (t) {
    let mut config = StreamingConfig.new

    config.stream_chunk_size = 0

    let mut parser = StreamingParser.with_config(config)
    let mut handler = CollectingHandler.new
    let raw = 'From: a@example.com\nTo: b@example.com\nSubject: x\nContent-Type: text/plain\n\nbody'
    let mut reader = ByteArrayReader.from_string(raw)

    match parser.parse_async_reader(mut reader, mut handler) {
      case Ok(_) -> t.false(true)
      case Error(e) -> t.true(e.to_message.contains?('stream_chunk_size'))
    }
  })
}
