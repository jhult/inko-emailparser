# Tests for streaming reader (AsyncReader trait and ByteArrayReader)

import emailparser.error (Error)
import emailparser.streaming (AttachmentInfo, StreamHandler, StreamingParser)
import emailparser.streaming_reader (ByteArrayReader)
import std.result (Result)
import std.test (Tests)

# Handler that records delivered text
type pub CollectingHandler {
  let pub mut @text: String
  let pub mut @headers_received: Bool
  let pub mut @ended: Bool
}

impl CollectingHandler {
  fn pub static new -> CollectingHandler {
    CollectingHandler(text: '', headers_received: false, ended: false)
  }
}

impl StreamHandler for CollectingHandler {
  fn pub mut on_begin -> Result[Int, String] {
    Result.Ok(0)
  }

  fn pub mut on_headers(
    headers: ref Array[(String, String)],
  ) -> Result[Int, String] {
    @headers_received = headers.size > 0
    Result.Ok(0)
  }

  fn pub mut on_text_chunk(chunk: String) -> Result[Int, String] {
    @text = @text + chunk
    Result.Ok(0)
  }

  fn pub mut on_html_chunk(chunk: String) -> Result[Int, String] {
    Result.Ok(0)
  }

  fn pub mut on_attachment_begin(
    info: ref AttachmentInfo,
  ) -> Result[Int, String] {
    Result.Ok(0)
  }

  fn pub mut on_attachment_chunk(
    chunk: ByteArray,
    info: ref AttachmentInfo,
  ) -> Result[Int, String] {
    Result.Ok(0)
  }

  fn pub mut on_attachment_end(info: ref AttachmentInfo) -> Result[Int, String]
  {
    Result.Ok(0)
  }

  fn pub mut on_end -> Result[Int, String] {
    @ended = true
    Result.Ok(0)
  }

  fn pub mut on_error(error: ref Error) -> Result[Int, String] {
    Result.Ok(0)
  }
}

fn pub tests(t: mut Tests) {
  t.test('byte_array_reader_new', fn (t) {
    let data = 'Hello World'.to_byte_array
    let reader = ByteArrayReader.new(data)

    t.equal(reader.position, 0)
    t.equal(reader.size, 11)
    t.false(reader.eof?)
  })

  t.test('byte_array_reader_from_string', fn (t) {
    let reader = ByteArrayReader.from_string('Hello')

    t.equal(reader.position, 0)
    t.equal(reader.size, 5)
    t.false(reader.eof?)
  })

  t.test('byte_array_reader_read_partial', fn (t) {
    let mut reader = ByteArrayReader.from_string('Hello World')

    match reader.read(5) {
      case Ok(chunk) -> {
        t.equal(chunk.size, 5)
        t.equal(chunk.into_string, 'Hello')
        t.equal(reader.position, 5)
      }
      case Error(e) -> panic('Failed: ${e}')
    }
  })

  t.test('byte_array_reader_read_full', fn (t) {
    let mut reader = ByteArrayReader.from_string('Hello')

    match reader.read(10) {
      case Ok(chunk) -> {
        t.equal(chunk.size, 5)
        t.equal(chunk.into_string, 'Hello')
        t.equal(reader.position, 5)
      }
      case Error(e) -> panic('Failed: ${e}')
    }
  })

  t.test('byte_array_reader_read_multiple', fn (t) {
    let mut reader = ByteArrayReader.from_string('Hello World')

    match reader.read(5) {
      case Ok(chunk) -> t.equal(chunk.into_string, 'Hello')
      case Error(e) -> panic('Failed: ${e}')
    }

    match reader.read(6) {
      case Ok(chunk) -> t.equal(chunk.into_string, ' World')
      case Error(e) -> panic('Failed: ${e}')
    }

    t.equal(reader.position, 11)
  })

  t.test('byte_array_reader_eof', fn (t) {
    let mut reader = ByteArrayReader.from_string('Hi')

    match reader.read(10) {
      case Ok(chunk) -> t.equal(chunk.into_string, 'Hi')
      case Error(e) -> panic('Failed: ${e}')
    }

    t.true(reader.eof?)

    match reader.read(10) {
      case Ok(chunk) -> t.equal(chunk.size, 0)
      case Error(e) -> panic('Failed: ${e}')
    }
  })

  t.test('byte_array_reader_empty_data', fn (t) {
    let mut reader = ByteArrayReader.new(ByteArray.new)

    t.equal(reader.size, 0)
    t.true(reader.eof?)

    match reader.read(10) {
      case Ok(chunk) -> t.equal(chunk.size, 0)
      case Error(e) -> panic('Failed: ${e}')
    }
  })

  t.test('byte_array_reader_zero_size_read', fn (t) {
    let mut reader = ByteArrayReader.from_string('Hello')

    match reader.read(0) {
      case Ok(chunk) -> {
        t.equal(chunk.size, 0)
        t.equal(reader.position, 0)
      }
      case Error(e) -> panic('Failed: ${e}')
    }
  })

  t.test('byte_array_reader_single_byte_reads', fn (t) {
    let mut reader = ByteArrayReader.from_string('ABC')

    match reader.read(1) {
      case Ok(chunk) -> t.equal(chunk.into_string, 'A')
      case Error(e) -> panic('Failed: ${e}')
    }

    match reader.read(1) {
      case Ok(chunk) -> t.equal(chunk.into_string, 'B')
      case Error(e) -> panic('Failed: ${e}')
    }

    match reader.read(1) {
      case Ok(chunk) -> t.equal(chunk.into_string, 'C')
      case Error(e) -> panic('Failed: ${e}')
    }

    t.true(reader.eof?)
  })

  t.test('byte_array_reader_binary_data', fn (t) {
    let mut data = ByteArray.new

    data.push(0)
    data.push(255)
    data.push(128)
    data.push(1)

    let mut reader = ByteArrayReader.new(data)

    match reader.read(4) {
      case Ok(chunk) -> {
        t.equal(chunk.size, 4)

        match chunk.get(0) {
          case Ok(b) -> t.equal(b, 0)
          case Error(_) -> panic('Failed')
        }

        match chunk.get(1) {
          case Ok(b) -> t.equal(b, 255)
          case Error(_) -> panic('Failed')
        }

        match chunk.get(2) {
          case Ok(b) -> t.equal(b, 128)
          case Error(_) -> panic('Failed')
        }

        match chunk.get(3) {
          case Ok(b) -> t.equal(b, 1)
          case Error(_) -> panic('Failed')
        }
      }
      case Error(e) -> panic('Failed: ${e}')
    }
  })

  t.test('parse_async_reader_lf_headers', fn (t) {
    let mut parser = StreamingParser.new
    let mut handler = CollectingHandler.new
    let raw = 'From: a@example.com\nTo: b@example.com\nSubject: LF test\nContent-Type: text/plain\n\nHello LF body'
    let mut reader = ByteArrayReader.from_string(raw)

    match parser.parse_async_reader(mut reader, mut handler) {
      case Ok(result) -> {
        t.equal(result.subject, 'LF test')
        t.true(handler.headers_received)
        t.true(handler.text.contains?('Hello LF body'))
      }
      case Error(e) -> panic('parse_async_reader failed: ${e.to_message}')
    }
  })

  t.test('parse_async_reader_crlf_headers', fn (t) {
    let mut parser = StreamingParser.new
    let mut handler = CollectingHandler.new
    let raw = 'From: a@example.com\r\nTo: b@example.com\r\nSubject: CRLF test\r\nContent-Type: text/plain\r\n\r\nHello CRLF body'
    let mut reader = ByteArrayReader.from_string(raw)

    match parser.parse_async_reader(mut reader, mut handler) {
      case Ok(result) -> {
        t.equal(result.subject, 'CRLF test')
        t.true(handler.headers_received)
        t.true(handler.text.contains?('Hello CRLF body'))
      }
      case Error(e) -> panic('parse_async_reader failed: ${e.to_message}')
    }
  })
}
